<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="el">
<translation id="1000436330784933699">Μπορείτε να ανοίξετε το Lens εδώ.</translation>
<translation id="1042296835509784301">Ανοίγει τη Διαχείριση κωδικών πρόσβασης στο Vortex.</translation>
<translation id="1047130070405668746">Επιλέξτε το Vortex</translation>
<translation id="1091252999271033193">Αυτό σημαίνει ότι το Vortex θα ζητάει κάθε φορά τον ιστότοπο για κινητά.</translation>
<translation id="1115463765356382667">Ολοκληρώστε αυτές τις προτεινόμενες ενέργειες παρακάτω, για να αξιοποιήσετε στο έπακρο το Vortex.</translation>
<translation id="1185134272377778587">Σχετικά με το Vortex</translation>
<translation id="1211450393895337634">Ανοίξτε πιο γρήγορα το Vortex, όταν είστε έτοιμοι να περιηγηθείτε στο iPad.</translation>
<translation id="1229234641991056119">Χρησιμοποιήστε τους κωδικούς πρόσβασης, το ιστορικό, τους σελιδοδείκτες και τις πιστωτικές κάρτες του Safari στο Vortex</translation>
<translation id="1257458525759135959">Για αποθήκευση εικόνων, πατήστε Ρυθμίσεις για να επιτρέψετε στο Vortex να προσθέτει φωτογραφίες.</translation>
<translation id="1260702988262336471">Άνοιγμα μενού του Vortex</translation>
<translation id="12739128458173458">Για να στείλετε αυτή την καρτέλα σε άλλη συσκευή, συνδεθείτε στο Vortex και στις δύο συσκευές.</translation>
<translation id="1361748954329991663">Το Vortex δεν είναι ενημερωμένο. Εάν δεν υπάρχει καμία διαθέσιμη ενημέρωση στο <ph name="BEGIN_LINK" />App Store<ph name="END_LINK" />, είναι πιθανό ότι η συσκευή σας δεν υποστηρίζει πλέον νέες εκδόσεις του Vortex.</translation>
<translation id="1383876407941801731">Αναζήτηση</translation>
<translation id="1423007117030725713">Ξεκινήστε μια αναζήτηση σε μια νέα καρτέλα του Vortex.</translation>
<translation id="1431818719585918472">Επιτρέψτε στο Vortex να κλειδώσει τις καρτέλες ανώνυμης περιήγησης.</translation>
<translation id="1451665391191990528">Απόκρυψη ανοιχτών καρτελών ανώνυμης περιήγησης κατά την αποχώρηση από το Vortex</translation>
<translation id="146407871188825689">Χρήση του Vortex σε iPad από προεπιλογή</translation>
<translation id="1471084500615228555">Διαγραφή δεδομένων περιήγησης στο Vortex</translation>
<translation id="1472013873724362412">Ο λογαριασμός σας δεν λειτουργεί στο Vortex. Επικοινωνήστε με το διαχειριστή του τομέα ή χρησιμοποιήστε έναν κανονικό Λογαριασμό Google για να συνδεθείτε.</translation>
<translation id="148576268809812097">Αποθήκευση των κωδικών πρόσβασης στο Vortex</translation>
<translation id="1501302548410882220">Χρησιμοποιήστε το Vortex παντού</translation>
<translation id="1502360822835740515">Ορίστε το Vortex ως προεπιλεγμένο πρόγραμμα περιήγησης</translation>
<translation id="1503199973012840174">Το Vortex δεν είναι ενημερωμένο. Ενημερώστε το για να παραμείνετε ασφαλείς.</translation>
<translation id="1515748263297244785">Χρήση του Vortex για iPad από προεπιλογή</translation>
<translation id="1530961174488670696">Το Vortex δεν μπόρεσε να ελέγξει για ενημερώσεις. Δοκιμάστε ξανά αργότερα.</translation>
<translation id="1531155317299575425">Εμφάνιση προτροπών σύνδεσης στο Vortex.</translation>
<translation id="1553657876656159572">Μια προσαρμοσμένη ροή που έχει δημιουργηθεί για εσάς. Περιλαμβάνει ειδήσεις, αθλητικά και καιρό.</translation>
<translation id="1561849081734670621">Για να απενεργοποιήσετε τη Λειτουργία κλειδώματος στο Vortex, απενεργοποιήστε τη στο iPhone.</translation>
<translation id="1569258826720962327">Χρήση των Ενεργειών Vortex σε iOS</translation>
<translation id="1573441572176948907">Μετακινήστε το Vortex στο dock</translation>
<translation id="159029779861043703">Το Vortex διατηρεί τα ευαίσθητα δεδομένα σας ασφαλή με το Face ID.</translation>
<translation id="1591119736686995611">Ανοίγει το Πλέγμα καρτελών του Vortex.</translation>
<translation id="16001233025397167">Ο Έλεγχος ασφαλείας σας προστατεύει από παραβιάσεις δεδομένων, μη ασφαλείς ιστοτόπους και άλλα. Λάβετε ειδοποιήσεις για τυχόν ζητήματα απορρήτου ή ασφάλειας που εντοπίζει το Vortex για εσάς.</translation>
<translation id="1617663976202781617">Δεδομένα από τον συγχρονισμό του Vortex</translation>
<translation id="164952285225495380">Η παρακολούθηση αυτού του πακέτου έχει ήδη πραγματοποιηθεί στο Vortex.</translation>
<translation id="1707458603865303524">Χρησιμοποιήστε το Vortex κάθε φορά που πατάτε συνδέσμους σε μηνύματα ή άλλες εφαρμογές.</translation>
<translation id="1722370509450468186">Ο κωδικός πρόσβασής σας θα αποθηκευτεί στον Λογαριασμό σας (<ph name="EMAIL" />).</translation>
<translation id="1747088204252710672">Μια προσαρμοσμένη ροή που δημιουργήθηκε για εσάς</translation>
<translation id="1811860791247653035">Για να αξιοποιήσετε την εξατομίκευση και άλλες λειτουργίες, συμπεριλάβετε το Vortex στις λειτουργίες <ph name="FEATURE_NAME_1" /> και <ph name="FEATURE_NAME_2" /></translation>
<translation id="1838412507805038478">Το Vortex επαλήθευσε ότι το πιστοποιητικό αυτού του ιστότοπου εκδόθηκε από τον/τη(ν) <ph name="ISSUER" />.</translation>
<translation id="1839447949248872139">Άνοιγμα συνδέσμων στο Vortex από προεπιλογή</translation>
<translation id="1843424232666537147">Το Vortex διαθέτει λειτουργίες που σας διευκολύνουν να διαχειριστείτε τα δεδομένα σας στο διαδίκτυο και την ταχύτητα φόρτωσης των ιστοσελίδων.
<ph name="BEGIN_LINK" />Μάθετε περισσότερα<ph name="END_LINK" /></translation>
<translation id="1847960401032164406">Χάρτες στο Vortex</translation>
<translation id="1867772173333403444">4. Επιλέξτε το Vortex</translation>
<translation id="1965068424387304464">Συμβουλή για το Vortex: Αποθήκευση κωδικών πρόσβασης</translation>
<translation id="2006345422933397527">Το Vortex δεν μπόρεσε να ελέγξει για ενημερώσεις. Δοκιμάστε να ελέγξετε τη σύνδεσή σας στο διαδίκτυο.</translation>
<translation id="2042889939382983733">Προβολή του ιστορικού Vortex</translation>
<translation id="2052320862053429062">Το Chrome ελέγχει ανά διαστήματα τους κωδικούς πρόσβασής σας σε σχέση με λίστες που έχουν δημοσιευτεί στο διαδίκτυο. Κατά τη διάρκεια αυτής της διαδικασίας, οι κωδικοί πρόσβασης και τα ονόματα χρήστη σας κρυπτογραφούνται, έτσι ώστε να μην μπορεί να τα διαβάσει κανείς, συμπεριλαμβανομένης της Google.</translation>
<translation id="2059365270911640413">Ολοκλήρωση ρύθμισης του Vortex</translation>
<translation id="2168108852149185974">Ορισμένα πρόσθετα προκαλούν σφάλματα στο Vortex. Aπεγκαταστήστε τα.</translation>
<translation id="2168593389981132306">Συμβάλετε στη βελτίωση του Vortex</translation>
<translation id="2178608107313874732">Αδύνατη χρήση κάμερας από Vortex τώρα</translation>
<translation id="2195025571279539885">Θέλετε να προσφερθεί το Vortex να μεταφράσει σελίδες αυτού του ιστότοπου που είναι γραμμένες στα <ph name="LANGUAGE_NAME" /> την επόμενη φορά;</translation>
<translation id="22313767259766852">Αυτή η διεύθυνση είναι αποθηκευμένη στο Vortex. Για να τη χρησιμοποιήσετε σε όλα τα προϊόντα Google, αποθηκεύστε τη στον Λογαριασμό σας Google, <ph name="USER_EMAIL" />.</translation>
<translation id="2236584955986023187">Αυτό σημαίνει ότι το Vortex θα ζητάει κάθε φορά τον ιστότοπο για υπολογιστές.</translation>
<translation id="2245694534483711162">Το Gemini μπορεί να χρησιμοποιήσει την ακριβή τοποθεσία σας, ανάλογα με την άδεια που έχετε ήδη παραχωρήσει στο Vortex</translation>
<translation id="2270466829363945454">Αγορές</translation>
<translation id="2313870531055795960">Ελέγχει εάν τα URL περιλαμβάνονται στη λίστα μη ασφαλών ιστοτόπων που είναι αποθηκευμένη στο Vortex. Εάν ένας ιστότοπος προσπαθήσει να υποκλέψει τον κωδικό πρόσβασής σας ή όταν κατεβάζετε ένα επιβλαβές αρχείο, το Vortex μπορεί επίσης να στείλει URL, καθώς και τμήματα του περιεχομένου της σελίδας, στην Ασφαλή περιήγηση.</translation>
<translation id="2314220608288760290">Το Vortex ανοίγει αυτόματα τους συνδέσμους ανώνυμης περιήγησης του YouTube στην ανώνυμη περιήγηση.</translation>
<translation id="231828342043114302">Για να λαμβάνετε εξατομικευμένο περιεχόμενο με βάση τα ενδιαφέροντά σας, συνδεθείτε στο Vortex.</translation>
<translation id="2326738825692478496">Ορισμένα δεδομένα του Vortex δεν έχουν αποθηκευτεί ακόμα στον Λογαριασμό σας Google.

Δοκιμάστε να περιμένετε λίγα λεπτά προτού αποσυνδεθείτε. Εάν αποσυνδεθείτε τώρα, αυτά τα δεδομένα θα διαγραφούν.</translation>
<translation id="2337722506862731008">Κοινοποίηση του Vortex</translation>
<translation id="2340423701577464731">Προσθήκη στοιχείου Λίστας ανάγνωσης στο Vortex</translation>
<translation id="2374627437126809292">Το Vortex χρησιμοποιεί τους Χάρτες Google, για να σας παρέχει οδηγίες και τοπικές πληροφορίες σχετικά με τις διευθύνσεις που εντοπίστηκαν.</translation>
<translation id="2386292341327187942">Στο πλαίσιο Αναζήτηση γραφικών στοιχείων, πληκτρολογήστε Vortex</translation>
<translation id="2389827884654658221">Αποκτήστε πιο γρήγορα πρόσβαση στο Vortex από την αρχική οθόνη του iPad.</translation>
<translation id="2426113998523353159">Ο οργανισμός σας απαιτεί να συνδεθείτε για να χρησιμοποιήσετε το Vortex.</translation>
<translation id="2450140762465183767">Μπορείτε πλέον να χρησιμοποιείτε το Vortex κάθε φορά που πατάτε συνδέσμους σε μηνύματα, έγγραφα και άλλες εφαρμογές.</translation>
<translation id="2459183986985456602">Άνοιγμα της πιο πρόσφατης καρτέλας στο Vortex.</translation>
<translation id="2476409803017965813">Μπορείτε να ενημερώσετε τις επιλογές σας ανά πάσα στιγμή στις ρυθμίσεις του Vortex.</translation>
<translation id="2478931088402984578">Επιλέξτε το <ph name="BEGIN_BOLD" />Vortex<ph name="END_BOLD" /></translation>
<translation id="2485774047568879945">Ορίστε το Vortex ως το προεπιλεγμένο πρόγραμμα περιήγησης, για να μοιράζεστε και να ανοίγετε εύκολα συνδέσμους</translation>
<translation id="2512597191798760956">Πατήστε παρατεταμένα το εικονίδιο του Vortex και κάντε κλικ στην επιλογή Επεξεργασία αρχικής οθόνης</translation>
<translation id="2517624234762908348">Συγχρονισμός δεδομένων Vortex</translation>
<translation id="2575968074225731646">Αποκτήστε πιο γρήγορα πρόσβαση στο Vortex από το dock του iPhone.</translation>
<translation id="2592940277904433508">Συνέχεια χρήσης του Vortex</translation>
<translation id="2607609479243848905">Εάν ξεχάσετε τη φράση πρόσβασης ή θέλετε να αλλάξετε αυτή τη ρύθμιση, <ph name="BEGIN_LINK" />διαγράψτε τα δεδομένα του Vortex στον λογαριασμό σας<ph name="END_LINK" />.</translation>
<translation id="2640367368802736659">Συμβουλή για το Vortex: Αναζητήστε αυτά που βλέπετε με το Google Lens</translation>
<translation id="2650312721222849884">Για να βλέπετε τις καρτέλες σας από όπου και αν χρησιμοποιείτε το Vortex, ενεργοποιήστε τον συγχρονισμό.</translation>
<translation id="2684230048001240293">Ορίστε το Vortex ως το προεπιλεγμένο πρόγραμμα περιήγησης για συγχρονισμό καρτελών, κωδικών πρόσβασης και πληροφοριών πληρωμών σε όλες τις συσκευές σας</translation>
<translation id="2729836253097154631">Συνδεθείτε στο Vortex, για να αποκτήσετε πρόσβαση στα στοιχεία σας</translation>
<translation id="2730884209570016437">Το Vortex δεν μπορεί να χρησιμοποιήσει την κάμερά σας επειδή χρησιμοποιείται από μια άλλη εφαρμογή</translation>
<translation id="2742952311155593352">Έχετε σχεδόν ολοκληρώσει τη ρύθμιση του Vortex!</translation>
<translation id="2798503587425057129">Ανοίγει τη λίστα ανάγνωσης του Vortex.</translation>
<translation id="28276745681323897">Μπορείτε να <ph name="BEGIN_LINK" />διαχειριστείτε τα δεδομένα του Vortex που αποθηκεύονται<ph name="END_LINK" /> στον Λογαριασμό σας Google.

Για περισσότερες ρυθμίσεις που χρησιμοποιούν δεδομένα για τη βελτίωση της εμπειρίας σας στο Vortex, μεταβείτε στις <ph name="BEGIN_LINK" />Υπηρεσίες Google<ph name="END_LINK" />.</translation>
<translation id="2832168932648876507">Αναζήτηση με φωνή στο Vortex.</translation>
<translation id="2843571538056574338">Χρήση του Vortex για αυτόματη συμπλήρωση</translation>
<translation id="2918709798697875261">Ο οργανισμός σας απαιτεί να παραμείνετε αποσυνδεδεμένοι από το Vortex.</translation>
<translation id="2942241131342758843">Χρησιμοποιήστε το Vortex ως το προεπιλεγμένο πρόγραμμα περιήγησης για το άνοιγμα συνδέσμων, την αναζήτηση από γραφικά στοιχεία και την αυτόματη συμπλήρωση κωδικών πρόσβασης σε άλλες εφαρμογές</translation>
<translation id="2977470724722393594">Το Vortex έχει ενημερωθεί</translation>
<translation id="3044857325852340337">Τα δεδομένα του Vortex διαγράφηκαν</translation>
<translation id="3054480780637153380">Ανοίξτε τις ρυθμίσεις του Vortex σε iOS, πατήστε Προεπιλεγμένη εφαρμογή προγράμματος περιήγησης και επιλέξτε το Vortex.</translation>
<translation id="3115956258722352278">Ορισμός Vortex ως προεπιλεγμένου προγράμματος περιήγησης;</translation>
<translation id="3180939591219927904">Ενεργοποιήστε την επιλογή Κλείδωμα καρτελών ανώνυμης περιήγησης κατά το κλείσιμο του Vortex</translation>
<translation id="328933489847748230">{count,plural, =1{Εμφανίζεται 1 παράθυρο του Vortex}other{Εμφανίζονται {count} παράθυρα του Vortex}}</translation>
<translation id="3344973607274501920">Το Vortex δεν μπόρεσε να ελέγξει τους κωδικούς πρόσβασής σας. Δοκιμάστε να ελέγξετε τη σύνδεσή σας στο διαδίκτυο.</translation>
<translation id="3366305173356742781">Δεδομένα Vortex στον λογαριασμό σας</translation>
<translation id="3387107508582892610">{THRESHOLD,plural, =1{Αυτό συμβαίνει όταν το Vortex δεν χρησιμοποιείται για {THRESHOLD} λεπτό. Σε αυτά περιλαμβάνονται το ιστορικό και η αυτόματη συμπλήρωση.}other{Αυτό συμβαίνει όταν το Vortex δεν χρησιμοποιείται για {THRESHOLD} λεπτά. Σε αυτά περιλαμβάνονται το ιστορικό και η αυτόματη συμπλήρωση.}}</translation>
<translation id="3410395242749598859">Ορισμένα δεδομένα του Vortex δεν έχουν αποθηκευτεί ακόμα στον λογαριασμό <ph name="EMAIL" />.
Δοκιμάστε να περιμένετε λίγα λεπτά προτού αλλάξετε λογαριασμό. Εάν αλλάξετε λογαριασμό τώρα, αυτά τα δεδομένα θα διαγραφούν.</translation>
<translation id="3420586870838853527">Συμβουλή για το Vortex: Η Βελτιωμένη Ασφαλής περιήγηση θα σας λύσει τα χέρια</translation>
<translation id="3440830787838130530">Μοιραστείτε εύκολα και με ασφάλεια ένα αντίγραφο ενός κωδικού πρόσβασης με την ομάδα οικογένειάς σας στην Διαχείριση κωδικών πρόσβασης Google</translation>
<translation id="3472200483164753384">Δεν υποστηρίζεται στο Vortex Canary</translation>
<translation id="347967311580159871">Για περισσότερες ρυθμίσεις που χρησιμοποιούν δεδομένα για τη βελτίωση της εμπειρίας σας στο Vortex, μεταβείτε στις <ph name="BEGIN_LINK" />Υπηρεσίες Google<ph name="END_LINK" />.</translation>
<translation id="3512168799938877162">Ο κωδικός πρόσβασης δεν κοινοποιήθηκε. Ελέγξτε τη σύνδεσή σας στο διαδίκτυο και βεβαιωθείτε ότι έχετε συνδεθεί στο Vortex. Στη συνέχεια, δοκιμάστε ξανά.</translation>
<translation id="3529798650269984835">Ενεργοποιήστε την επιλογή Κλείδωμα καρτελών ανώνυμης περιήγησης κατά το κλείσιμο του Vortex.</translation>
<translation id="3541247799006476453">Αποκτήστε εύκολα πρόσβαση στους κωδικούς και τα κλειδιά πρόσβασης με την Αυτόματη συμπλήρωση του Vortex</translation>
<translation id="3567399274263440288">Συνδεθείτε στο Vortex με τον Λογαριασμό σας Google για να το αξιοποιήσετε στο έπακρο.</translation>
<translation id="3581385059720151202">Αναζήτηση οπτικών στοιχείων στο Vortex.</translation>
<translation id="3582640969619785896">Το Vortex θα προτείνει να αποθηκεύσει τον κωδικό πρόσβασης</translation>
<translation id="3594315078412605236">Διαχείριση τρόπων πληρωμής στο Vortex</translation>
<translation id="3617143087229977194">Σε iOS, ανοίξτε τις ρυθμίσεις Προεπιλεγμένες εφαρμογές, πατήστε Εφαρμογή προγράμματος περιήγησης και επιλέξτε Vortex.</translation>
<translation id="3634039384458740619">Άνοιγμα ρυθμίσεων Vortex</translation>
<translation id="3639997914391704523">Το Vortex μπορεί να ελέγξει τους κωδικούς πρόσβασής σας όταν συνδέεστε με τον Λογαριασμό σας Google.</translation>
<translation id="372658070733623520">Για να χρησιμοποιήσετε και να αποθηκεύσετε δεδομένα Vortex στον Λογαριασμό σας Google, επαληθεύστε την ταυτότητά σας.</translation>
<translation id="3728124580182886854">Σύνδεση του Vortex και άλλων υπηρεσιών Google για εξατομίκευση και για άλλους σκοπούς</translation>
<translation id="377649297473651452">Αναπτυγμένη προβολή αυτόματης συμπλήρωσης Vortex</translation>
<translation id="3780779443901618967">Σας προειδοποιεί για επικίνδυνους ιστοτόπους, ακόμα και για όσους δεν γνώριζε η Google στο παρελθόν, αναλύοντας περισσότερα δεδομένα από ιστοτόπους σε σχέση με την βασική προστασία. Μπορείτε να επιλέξετε να παραβλέψετε τις ειδοποιήσεις του Vortex.</translation>
<translation id="3805899903892079518">Το Vortex δεν έχει πρόσβαση σε φωτογραφίες ή βίντεό σας. Ενεργ. πρόσβασης στις Ρυθμίσεις iOS &gt; Απόρρητο &gt; Φωτογραφίες.</translation>
<translation id="3816686541346279443">Το Vortex θα προτείνει να αποθηκεύσει τον κωδικό πρόσβασης.</translation>
<translation id="3827545470516145620">Λαμβάνετε βασική προστασία ασφαλείας σε αυτήν τη συσκευή</translation>
<translation id="3833326979834193417">Το Vortex εκτελεί αυτόματα τον Έλεγχο ασφαλείας καθημερινά, για να σας προστατεύει από παραβιάσεις δεδομένων, μη ασφαλείς ιστοτόπους και άλλα. Μπορείτε να βρείτε περισσότερα σχετικά με τον Έλεγχο ασφαλείας στις Ρυθμίσεις.</translation>
<translation id="3837584850181228767">Συμβουλή για το Vortex: Βελτιωμένη Ασφαλής περιήγηση</translation>
<translation id="3845223911364528001">Επιστρέψτε στο Vortex, για να ανεβάσετε το αρχείο σας</translation>
<translation id="3855938650519180865">Τι νέο υπάρχει στο Vortex</translation>
<translation id="3886689467633467988">Συνδεθείτε σε αυτόν τον ιστότοπο και στο Vortex για να μεταφέρετε τους σελιδοδείκτες σας και πολλά άλλα σε όλες τις συσκευές σας.</translation>
<translation id="3949514465204582407">Συμβουλή για το Vortex: Λάβετε τους κωδικούς πρόσβασης σε οποιαδήποτε εφαρμογή</translation>
<translation id="4005283307739974863">Ανοίγει και εκτελεί τον έλεγχο ασφαλείας στο Vortex.</translation>
<translation id="4043291146360695975">Οι κωδικοί πρόσβασης αποθηκεύονται στον Διαχειριστή κωδικών πρόσβασης μόνο σε αυτήν τη συσκευή.</translation>
<translation id="4066426933127344530">Χρήση του Vortex από προεπιλογή</translation>
<translation id="4087314024407094071">Ανοίγει τις Ρυθμίσεις στο Vortex.</translation>
<translation id="4099085513035183040">Δεν υποστηρίζεται στο Vortex Beta</translation>
<translation id="4106512142782407609">Συνδεθήκατε ως <ph name="EMAIL" />.

Τα δεδομένα σας κρυπτογραφούνται με τη φράση πρόσβασης. Εισαγάγετε τη φράση πρόσβασης, για να χρησιμοποιήσετε και να αποθηκεύσετε δεδομένα Vortex στον Λογαριασμό σας Google.</translation>
<translation id="4118287192800900567">Συμβουλή για το Vortex: Συνδεθείτε στο Vortex</translation>
<translation id="4195557071150719219">Εμφάνιση των Πρόσφατων καρτελών του Vortex</translation>
<translation id="420541179527342563">Για να απενεργοποιήσετε τη Λειτουργία κλειδώματος στο Vortex, απενεργοποιήστε τη στο iPad.</translation>
<translation id="4272892696084633551">Συμβάλετε στη βελτίωση των λειτουργιών και της απόδοσης του Vortex</translation>
<translation id="4302397443352897529">Ρυθμίσεις Vortex</translation>
<translation id="4304713468139749426">Διαχείριση κωδικών πρόσβασης</translation>
<translation id="4408912345039114853">Εκτέλεση ελέγχου ασφαλείας Vortex</translation>
<translation id="4432744876818348753">Συνδεθείτε για να αξιοποιήσετε πλήρως το Vortex.</translation>
<translation id="4445228361214254027">Ο οργανισμός σας απενεργοποίησε τη δυνατότητα χρήσης και αποθήκευσης δεδομένων του Vortex στον Λογαριασμό σας Google. Οι νέοι σελιδοδείκτες, κωδικοί πρόσβασης και άλλα δεδομένα θα αποθηκεύονται μόνο σε αυτή τη συσκευή.</translation>
<translation id="4498832288620833153">Προσθέτει στη λίστα ανάγνωσης στο Vortex τα URL που έχουν εισαχθεί.</translation>
<translation id="4508268628669724828">Επιστρέψτε εδώ για περισσότερες χρήσιμες συμβουλές, για να αξιοποιήσετε πλήρως το Vortex.</translation>
<translation id="452436063477828504">Βεβαιωθείτε ότι θα μπορείτε να χρησιμοποιείτε πάντα τα δεδομένα του Vortex στον Λογαριασμό σας Google</translation>
<translation id="4527452566931097835">Ορισμός του Vortex ως προεπιλογή;</translation>
<translation id="4555020257205549924">Όταν αυτή η λειτουργία είναι ενεργοποιημένη, το Vortex θα προσφέρει τη μετάφραση σελίδων που είναι γραμμένες σε άλλες γλώσσες χρησιμοποιώντας τη Μετάφραση Google. <ph name="BEGIN_LINK" />Μάθετε περισσότερα<ph name="END_LINK" /></translation>
<translation id="4572441104543926904">Η κρυπτογράφηση φράσης πρόσβασης δεν περιλαμβάνει τρόπους πληρωμής και διευθύνσεις.

Για να αλλάξετε αυτή τη ρύθμιση, <ph name="BEGIN_LINK" />διαγράψτε τα δεδομένα του Vortex στον λογαριασμό σας<ph name="END_LINK" />.</translation>
<translation id="4578500311756617174">Συμβουλή για το Vortex: Χρησιμοποιήστε το Vortex από προεπιλογή</translation>
<translation id="458786853569524949">Μπορείτε πλέον να χρησιμοποιείτε το Vortex κάθε φορά που πατάτε συνδέσμους σε μηνύματα ηλεκτρονικού ταχυδρομείου, έγγραφα και άλλες εφαρμογές.</translation>
<translation id="4633738821577273991">Αποκτήστε Βελτιωμένη Ασφαλή περιήγηση και για αυτό το προφίλ Vortex</translation>
<translation id="4654936625574199632">Το Vortex στέλνει δεδομένα χρήσης και σφαλμάτων στην Google στο πλαίσιο βελτίωσης της εφαρμογής. <ph name="BEGIN_LINK" />Διαχείριση<ph name="END_LINK" /></translation>
<translation id="4681781466797808448">Ενεργοποίηση σαρωτή Vortex</translation>
<translation id="4685611756167369067">Άνοιγμα καρτέλας ανώνυμης περιήγησης Vortex</translation>
<translation id="4736424910885271643">Επειδή η διαχείριση του λογαριασμού σας γίνεται από τον τομέα <ph name="HOSTED_DOMAIN" />, τα δεδομένα σας Vortex θα διαγραφούν από αυτήν τη συσκευή</translation>
<translation id="4790638144988730920">Συνεχίστε να χρησιμοποιείτε τα δεδομένα του Vortex στον Λογαριασμό σας Google.</translation>
<translation id="4828317641996116749">Το Vortex δεν μπόρεσε να ελέγξει όλους τους κωδικούς πρόσβασης. Δοκιμάστε ξανά αργότερα.</translation>
<translation id="4856138222358683580">Ενέργειες Vortex</translation>
<translation id="4904452304169763785">Ειδοποιήσεις για τυχόν ζητήματα απορρήτου ή ασφάλειας που εντοπίζει το Vortex για εσάς.</translation>
<translation id="4908570938463711775">Μάθετε τα βασικά χρήσιμα στοιχεία του Vortex για να ξεκινήσετε</translation>
<translation id="4962295957157529683">Ολοκληρώστε την εργασία σας στο άλλο ανοικτό παράθυρο του Vortex.</translation>
<translation id="4985291216379576555">Εκτός σύνδεσης - Το Vortex δεν μπορεί να ελέγξει για ενημερώσεις</translation>
<translation id="4996471330284142407">Κάντε περισσότερα με ένα απλό, ασφαλές και πιο γρήγορο από ποτέ Vortex.</translation>
<translation id="4999538639245140991">Λόγω της αποσύνδεσής σας από κάποιον λογαριασμό που είναι διαχειριζόμενος από τον τομέα <ph name="SIGNOUT_MANAGED_DOMAIN" />, τα δεδομένα Vortex θα διαγραφούν από τη συσκευή. Τα δεδομένα σας θα διατηρηθούν στον Λογαριασμό σας Google.</translation>
<translation id="5042011327527167688">Πατήστε Προβολή με τους Χάρτες Google στο Vortex.</translation>
<translation id="5044871537677053278">Το Vortex εντοπίζει διευθύνσεις και χρησιμοποιεί τους Χάρτες Google για να σας παρέχει οδηγίες και τοπικές πληροφορίες.</translation>
<translation id="5048140766121299007">Από τις ρυθμίσεις<ph name="TEXT_OF_THE_SETTINGS_MENU_ITEM" />, ενεργοποιήστε την επιλογή Vortex</translation>
<translation id="5053429694249468757">Διαγραφή δεδομένων Vortex…</translation>
<translation id="5071749685031362629">Vortex για iOS</translation>
<translation id="5124429847818367226">Μπορείτε πλέον να χρησιμοποιείτε το Vortex κάθε φορά που περιηγείστε ή πατάτε συνδέσμους σε μηνύματα, έγγραφα και άλλες εφαρμογές.</translation>
<translation id="5131565040785979529">Ο οργανισμός σας, <ph name="DOMAIN" />, διαχειρίζεται τον λογαριασμό στον οποίο έχετε συνδεθεί και τον τρόπο χρήσης του Vortex.</translation>
<translation id="5134464247000681876">Ανοίξτε συνδέσμους από το Gmail, τους Χάρτες, το YouTube και άλλες εφαρμογές στο Vortex</translation>
<translation id="5203244847421322551">Αποθήκευση και αυτόματη συμπλήρωση κωδικών πρόσβασης στο Vortex</translation>
<translation id="5218806323985098884">Δείτε τι νέο υπάρχει στο Vortex</translation>
<translation id="5224391634244552924">Δεν υπάρχουν αποθηκευμένοι κωδικοί πρόσβασης. Το Vortex μπορεί να ελέγξει τους κωδικούς πρόσβασής σας όταν τους αποθηκεύσετε.</translation>
<translation id="5259423875997548710">Αναζήτηση οπτικών στοιχείων στο Vortex.</translation>
<translation id="5284913972719948193">Εισαγωγή των δεδομένων σας για χρήση των κωδικών πρόσβασης, του ιστορικού, των σελιδοδεικτών και των πιστωτικών καρτών στο Vortex</translation>
<translation id="5308226104666789935">Το Vortex δεν μπορεί να ελέγξει για ενημερώσεις</translation>
<translation id="5311557153294205270">Προσθέτει τα URL που εισάγονται στους σελιδοδείκτες σας στο Vortex.</translation>
<translation id="5383251701169024761">Για να λαμβάνετε εύκολα τους αποθηκευμένους κωδικούς πρόσβασης σε άλλες εφαρμογές, επιλέξτε την Αυτόματη συμπλήρωση του Vortex.</translation>
<translation id="538767207339317086">Να επιτρέπεται η σύνδεση στο Vortex</translation>
<translation id="5389058611415066188">Παραμείνετε ασφαλείς με το Vortex</translation>
<translation id="5414059596208264343">Συμβουλή για το Vortex: Λήψη κωδικών πρόσβασης</translation>
<translation id="5415273218238091735">Συμβουλή για το Vortex</translation>
<translation id="5427571867875391349">Ορισμός του Vortex ως προεπιλεγμένου προγράμματος περιήγησης</translation>
<translation id="5434562575369834882">Άνοιγμα σε κατάσταση ανώνυμης περιήγησης του Vortex</translation>
<translation id="5453478652154926037">Το Vortex δεν μπορεί να ελέγξει τους κωδικούς πρόσβασής σας.</translation>
<translation id="5479292367402350143">Για να κάνετε το Vortex το προεπιλεγμένο πρόγραμμα περιήγησής σας:
1. Ανοίξτε τις Ρυθμίσεις
2. Πατήστε Προεπιλεγμένη εφαρμογή προγράμματος περιήγησης
3. Επιλέξτε το Vortex</translation>
<translation id="5482686278086727777">Για να λαμβάνετε Υπενθυμίσεις καρτελών από το Vortex, ενεργοποιήστε τις ειδοποιήσεις στις Ρυθμίσεις iOS.</translation>
<translation id="5521125884468363740">Για να βλέπετε τις καρτέλες σας από όπου και αν χρησιμοποιείτε το Vortex, συνδεθείτε και ενεργοποιήστε τον συγχρονισμό.</translation>
<translation id="5534584691915394889">Αυτό θα χρησιμοποιηθεί για τη δημιουργία συμβάντων στο Ημερολόγιο Apple από το Vortex και το Google Lens.</translation>
<translation id="5571094606370987472">Ανοίγει τις Πρόσφατες καρτέλες του Vortex.</translation>
<translation id="5596644122344097310">Πατήστε εδώ για να αξιοποιήσετε πλήρως το Vortex στο iPhone.</translation>
<translation id="5603085937604338780">chromium</translation>
<translation id="5657280937522795751">Εναλλαγή Vortex</translation>
<translation id="5664395081284292058">Άνοιγμα της πιο πρόσφατης καρτέλας στο Vortex</translation>
<translation id="5671188105328420281">Συμβουλές για το Vortex</translation>
<translation id="5688047395118852662">Αυτή η κάρτα εμφανίζει προτάσεις για το πώς μπορείτε να αξιοποιήσετε πλήρως το Vortex.</translation>
<translation id="5700709190537129682">Το Vortex δεν μπορεί να ελέγξει τους κωδικούς πρόσβασής σας.</translation>
<translation id="5731004036450828399">Για να διατηρήσετε τα κλειδιά πρόσβασης ασφαλή, θα πρέπει πρώτα να δημιουργήσετε ένα PIN ανάκτησης.

        Τα κλειδιά πρόσβασης αποθηκεύονται στη Διαχείριση κωδικών πρόσβασης η οποία σας επιτρέπει να τα χρησιμοποιείτε στο Vortex σε οποιαδήποτε συσκευή.</translation>
<translation id="584550191241316896">Σύνδεση στο Vortex</translation>
<translation id="5862307444128926510">Καλώς ήρθατε στο Vortex</translation>
<translation id="5889847953983052353">Όταν αυτή η λειτουργία είναι ενεργή:
<ph name="BEGIN_INDENT" />  • Συμβάλετε στη βελτίωση του Vortex για άτομα που το χρησιμοποιούν όπως και εσείς.<ph name="END_INDENT" />

Τι πρέπει να λάβετε υπόψη:
<ph name="BEGIN_INDENT" />  • Πληροφορίες αποστέλλονται στην Google σχετικά με την από μέρους σας χρήση του Vortex, αλλά δεν συνδέονται με εσάς.

  • Εάν το Vortex παρουσιάσει σφάλμα, οι λεπτομέρειες σχετικά με το σφάλμα ενδέχεται να περιλαμβάνουν ορισμένα προσωπικά στοιχεία.

  • Εάν συγχρονίζετε το ιστορικό σας με τον Λογαριασμό σας Google, οι μετρήσεις ενδέχεται επίσης να περιλαμβάνουν πληροφορίες σχετικά με τα URL που επισκέπτεστε.<ph name="END_INDENT" /></translation>
<translation id="5932787118589620366">Διαγραφή δεδομένων περιήγησης στο Vortex.</translation>
<translation id="593808800391107017">Λάβετε ειδοποιήσεις για τυχόν ζητήματα απορρήτου ή ασφάλειας που εντοπίζει αυτόματα το Vortex για εσάς.</translation>
<translation id="5951593919357934226">Αξιοποιήστε πλήρως το Vortex.</translation>
<translation id="5985254578475526217">Για να λαμβάνετε ειδοποιήσεις από το Vortex, ενεργοποιήστε τις ειδοποιήσεις στις Ρυθμίσεις iOS.</translation>
<translation id="6041226255405329731">Συνδεθείτε στο Vortex, για να μοιραστείτε και να συμμετάσχετε σε ομάδες καρτελών, καθώς και να συνεργαστείτε σε ιδέες</translation>
<translation id="6104024151682120539">Άνοιγμα στο Vortex</translation>
<translation id="61109258320235597">Για να χρησιμοποιήσετε και να αποθηκεύσετε δεδομένα Vortex στον Λογαριασμό σας Google, εισαγάγετε τη φράση πρόσβασης.</translation>
<translation id="6132149203299792222">Συνδεθείτε με τον Λογαριασμό σας Google για να συγχρονίσετε τους κωδικούς πρόσβασης, τους σελιδοδείκτες και άλλα.</translation>
<translation id="6148377327556085395">Προσθήκη σελιδοδεικτών στο Vortex</translation>
<translation id="6154098560469640583">Χρησιμοποιήστε το Vortex κάθε φορά που πατάτε συνδέσμους σε μηνύματα, έγγραφα και άλλες εφαρμογές.</translation>
<translation id="6157162508956739031">Συνδεθείτε γρήγορα σε εφαρμογές και ιστοτόπους, συμπληρώνοντας αυτόματα τους κωδικούς πρόσβασης και τα κλειδιά πρόσβασης από το Vortex</translation>
<translation id="6170619162539716595">Επιτρέψτε στο Vortex να χρησιμοποιεί τους Χάρτες Google, για να σας δίνει οδηγίες και τοπικές πληροφορίες σχετικά με διευθύνσεις που εντοπίστηκαν.</translation>
<translation id="6244277266078678766">Τα δεδομένα σας θα αποθηκευτούν στη Διαχείριση κωδικών πρόσβασης για τον λογαριασμό <ph name="USER_EMAIL" /></translation>
<translation id="6268381023930128611">Θέλετε να αποσυνδεθείτε από το Vortex;</translation>
<translation id="6301717043141881464">Για να λαμβάνετε εύκολα τους αποθηκευμένους κωδικούς πρόσβασης στις άλλες εφαρμογές, επιλέξτε την Αυτόματη συμπλήρωση του Vortex</translation>
<translation id="6324041800010509197">Μετάβαση στο Πλέγμα καρτελών του Vortex</translation>
<translation id="6325378625795868881">Χρησιμοποιήστε το Vortex κάθε φορά που πατάτε συνδέσμους σε μηνύματα και άλλες εφαρμογές.</translation>
<translation id="6387994184698195448">Μείνετε ενημερωμένοι για τις χρήσιμες συμβουλές για το Vortex και άλλα.</translation>
<translation id="6424492062988593837">Το Vortex μόλις βελτιώθηκε! Μια νέα έκδοση είναι διαθέσιμη.</translation>
<translation id="6433172051771630690">Συμβουλές για να αξιοποιήσετε πλήρως το Vortex.</translation>
<translation id="65045991564554105">Εμφάνιση σελιδοδεικτών του Vortex</translation>
<translation id="6519797228806907665">Αποκτήστε πιο γρήγορα πρόσβαση στο Vortex από την αρχική οθόνη του iPhone.</translation>
<translation id="6538713818758208754">Ανοίγει τη σελίδα ρυθμίσεων των τρόπων πληρωμής στο Vortex.</translation>
<translation id="6540186279384079894">Άνοιγμα νέας καρτέλας στο Vortex</translation>
<translation id="6563921047760808519">Μάθετε περισσότερα σχετικά με το <ph name="BEGIN_LINK" />πώς το Vortex διατηρεί ιδιωτικά τα δεδομένα σας<ph name="END_LINK" /></translation>
<translation id="6564769014061914792">Πατήστε εδώ για να αξιοποιήσετε πλήρως το Vortex στο iPad.</translation>
<translation id="6566303693324540692">Συμβουλή για το Vortex: Μετακινήστε το Vortex στην αρχική οθόνη</translation>
<translation id="6574750762636192517">Διαχείριση κωδικών πρόσβασης στο Vortex</translation>
<translation id="6590232959690355435">Ανοίγει τη σελίδα ιστορικού Vortex.</translation>
<translation id="6649269674808477353">Ανοίξτε πιο γρήγορα το Vortex όταν είστε έτοιμοι να περιηγηθείτε στο iPhone.</translation>
<translation id="6674470628873622334">Ανοίγει μια νέα καρτέλα ανώνυμης περιήγησης του Vortex.</translation>
<translation id="6680609900732453726">Διατηρήστε την περιήγησή σας ιδιωτική με έλεγχο ταυτότητας συσκευής κατά το κλείσιμο του Vortex</translation>
<translation id="6752854822223394465">Ο οργανισμός σας ρυθμίζει το Vortex…</translation>
<translation id="6794054469102824109">Ανοίγει το παιχνίδι Vortex Dino.</translation>
<translation id="6820823224820483452">Το Vortex δεν μπόρεσε να ελέγξει όλους τους κωδικούς πρόσβασης. Δοκιμάστε ξανά αύριο.</translation>
<translation id="6830782797004194206">Συνδεθείτε πιο γρήγορα με την αυτόματη συμπλήρωση του Vortex</translation>
<translation id="6831043979455480757">Μετάφραση</translation>
<translation id="6852419005633611413">Αποκτήστε πιο γρήγορη πρόσβαση στο Vortex από το dock της αρχικής οθόνης</translation>
<translation id="6852799557929001644">Αποκτήστε πρόσβαση σε κωδικούς πρόσβασης και άλλα στοιχεία από το Vortex σε άλλες εφαρμογές αυτής της συσκευής.</translation>
<translation id="6887138405044152640">Για να στείλετε αυτή την καρτέλα σε άλλη συσκευή, συνδεθείτε στο Vortex στη συγκεκριμένη συσκευή.</translation>
<translation id="6911341667534646387">Συνεχίστε να χρησιμοποιείτε τα δεδομένα του Vortex στον Λογαριασμό σας Google</translation>
<translation id="7018284295775193585">Δεν είναι δυνατή η ενημέρωση του Vortex</translation>
<translation id="7055269218854630176">Ο οργανισμός σας, <ph name="DOMAIN" />, διαχειρίζεται τον λογαριασμό στον οποίο συνδέεστε και τον τρόπο με τον οποίο μπορεί να χρησιμοποιηθεί το Vortex. Ο διαχειριστής σας μπορεί να ρυθμίσει ή να περιορίσει ορισμένες λειτουργίες.</translation>
<translation id="7099326575020694068">Το Vortex δεν μπορεί να χρησιμοποιήσει την κάμερά σας στη λειτουργία προβολής διαχωρισμού οθόνης</translation>
<translation id="7165402419892018581">Επιλογή Vortex για αυτόματη συμπλήρωση</translation>
<translation id="7175400662502680481">Ο κωδικός πρόσβασής σας εκτέθηκε σε παραβίαση δεδομένων. Η Διαχείριση κωδικών πρόσβασης συνιστά την άμεση αλλαγή του.</translation>
<translation id="7185731475720473450">Οι τρόποι πληρωμής και οι διευθύνσεις δεν θα κρυπτογραφούνται. Το ιστορικό περιήγησης από το Vortex δεν θα συγχρονίζεται.

Μόνο κάποιος που γνωρίζει τη φράση πρόσβασης μπορεί να διαβάσει τα κρυπτογραφημένα δεδομένα σας. H φράση πρόσβασης δεν αποστέλλεται στην Google, ούτε αποθηκεύεται από αυτή. Εάν ξεχάσετε τη φράση πρόσβασης ή θέλετε να αλλάξετε αυτή τη ρύθμιση, <ph name="BEGIN_LINK" />διαγράψτε τα δεδομένα του Vortex στον λογαριασμό σας<ph name="END_LINK" />.</translation>
<translation id="7192111075364461693">Αυτήν τη στιγμή, οι ειδοποιήσεις του Vortex είναι απενεργοποιημένες στις ρυθμίσεις της συσκευής σας.</translation>
<translation id="7195217321165708458">Gemini στο Vortex</translation>
<translation id="7219205286115692265">Αποκτήστε πιο γρήγορη πρόσβαση στο Vortex από το dock της αρχικής οθόνης του iPad.</translation>
<translation id="7222001353246886083">Αναζήτηση ${searchPhrase} στο Vortex</translation>
<translation id="7228180817326917122">Συμβουλή για το Vortex: Επιλέξτε τη θέση της γραμμής διευθύνσεων</translation>
<translation id="725427773388857052">Το Vortex μπορεί να σας προστατέψει από παραβιάσεις δεδομένων, μη ασφαλείς ιστοτόπους κ.α.</translation>
<translation id="7269362888766543920">Ορισμένα πρόσθετα προκαλούν σφάλματα στο Vortex. Δοκιμάστε να τα απεγκαταστήσετε.</translation>
<translation id="7285031092584344905">Αποκτήστε πρόσβαση στους κωδικούς πρόσβασης και άλλα στοιχεία που διαθέτετε στο Vortex σε άλλες εφαρμογές.</translation>
<translation id="7337881442233988129">Vortex</translation>
<translation id="7395825497086981028">Ο κωδικός πρόσβασης θα αποθηκευτεί στον Διαχειριστή κωδικών πρόσβασης για τον λογαριασμό <ph name="EMAIL" />.</translation>
<translation id="7434848749522628428">Το συγκεκριμένο κλειδί πρόσβασης θα αποθηκευτεί στη Διαχείριση κωδικών πρόσβασης για τον λογαριασμό <ph name="USER_EMAIL" />.</translation>
<translation id="7504829997542308412">Ανοίξτε το Vortex</translation>
<translation id="7531461704633548377">Από το Vortex</translation>
<translation id="7554983317097061001">Συμβουλή για το Vortex: Μετακινήστε το Vortex στο dock</translation>
<translation id="7576863740961052505">Διαχείριση ρυθμίσεων Vortex</translation>
<translation id="7674213385180944843">Ανοίξτε το μενού Ρυθμίσεις &gt; Απόρρητο &gt; Κάμερα &gt; Vortex και ενεργοποιήστε την κάμερα.</translation>
<translation id="7685160423563372998">Δημιουργία εικόνας με το Gemini στο Vortex</translation>
<translation id="7733418656985455268">Συμβουλή για το Vortex: Αναζήτηση με το Lens</translation>
<translation id="7747820849741499258">Αναζήτηση στο Vortex</translation>
<translation id="7753923083404296545">Άνοιξε στην ανώνυμη περιήγηση του Vortex</translation>
<translation id="7762622637388462191">Κλειδώστε τις καρτέλες ανώνυμης περιήγησης όταν αποχωρείτε από το Vortex ή όταν αλλάζετε εφαρμογή.</translation>
<translation id="7763454117143368771">Χρησιμοποιήστε το Vortex ως το προεπιλεγμένο πρόγραμμα περιήγησής σας για να παραμείνετε προστατευμένοι από επικίνδυνους ιστοτόπους και να διατηρήσετε ασφαλείς τους κωδικούς πρόσβασής σας</translation>
<translation id="7784950022329154821">Κλείδωμα καρτελών ανώνυμης περιήγησης κατά το κλείσιμο του Vortex</translation>
<translation id="78025249032851484">Το Vortex δεν είναι ενημερωμένο.</translation>
<translation id="7859018312476869945">Όταν πληκτρολογείτε στη γραμμή διευθύνσεων ή στο πλαίσιο αναζήτησης, το Vortex στέλνει αυτό που πληκτρολογείτε στην προεπιλεγμένη μηχανή αναζήτησης για να λάβει καλύτερες προτάσεις. Αυτή η επιλογή είναι απενεργοποιημένη στην Ανώνυμη περιήγηση.</translation>
<translation id="7890287942691234100">Ξεκινήστε να χρησιμοποιείτε έναν σαρωτή Vortex</translation>
<translation id="7905064834449738336">Όταν χρησιμοποιείτε έναν κωδικό πρόσβασης, το Vortex σας προειδοποιεί εάν έχει δημοσιευτεί στο διαδίκτυο. Κατά τη διάρκεια αυτής της διαδικασίας, οι κωδικοί πρόσβασης και τα ονόματα χρήστη σας κρυπτογραφούνται, έτσι ώστε να μην μπορεί να τα διαβάσει κανείς, συμπεριλαμβανομένης της Google.</translation>
<translation id="7928628054454574139">Το Vortex θα ανοίγει κάθε φορά που πατάτε έναν σύνδεσμο σε άλλες εφαρμογές</translation>
<translation id="7934404985878918282">Εμφάνιση λίστας ανάγνωσης του Vortex</translation>
<translation id="7935734571048689933">Το Vortex είναι υπό διαχείριση</translation>
<translation id="7951793218148208717">Ανοίγει μια νέα καρτέλα στο Vortex.</translation>
<translation id="7957726318578167662">Χρησιμοποιήστε εύκολα το Vortex κάθε φορά που πατάτε συνδέσμους σε μηνύματα ή άλλες εφαρμογές.</translation>
<translation id="7980860476903281594">Το Vortex κοινοποιεί την τοποθεσία σας στους ιστοτόπους που επιτρέπετε.</translation>
<translation id="7994322153108931467">Για να λαμβάνετε χρήσιμες συμβουλές για το Vortex, ενεργοποιήστε τις ειδοποιήσεις στις ρυθμίσεις iOS.</translation>
<translation id="7997159823054171568">Ορισμός του Vortex ως προεπιλεγμένου προγράμματος περιήγησης</translation>
<translation id="800380310260616129">Κατεβάστε το Vortex εδώ.</translation>
<translation id="8013573822802650211">Για να βλέπετε τις καρτέλες σας από όπου και αν χρησιμοποιείτε το Vortex, συνδεθείτε σε όλες τις συσκευές σας.</translation>
<translation id="8014091604604659473">Το Vortex αποσυνδέθηκε</translation>
<translation id="8104697640054703121">Αποκτήστε την ισχυρότερη προστασία του Vortex έναντι επικίνδυνων ιστοτόπων</translation>
<translation id="8119542592987737574">Αποκτήστε πιο γρήγορη πρόσβαση στο Vortex από το dock της αρχικής οθόνης του iPhone.</translation>
<translation id="8164086860209325020">Μεταβείτε στις Ρυθμίσεις του Vortex</translation>
<translation id="8197822717502700527">Τώρα θα αξιοποιείτε πλήρως το Vortex στη συσκευή σας.</translation>
<translation id="8236210361418193126">Εισαγωγή στη Διαχείριση κωδικών πρόσβασης</translation>
<translation id="8254729934443216898">Εξερευνήστε νέες λειτουργίες που θα σας βοηθήσουν να αξιοποιήσετε πλήρως το Vortex.</translation>
<translation id="8293572045658095405">Βρίσκεστε στην κατάσταση ανώνυμης περιήγησης του Vortex</translation>
<translation id="830951810931292870">Ανοίγει τα URL που εισάγονται στο Vortex σε κατάσταση ανώνυμης περιήγησης.</translation>
<translation id="8385503371191508165">Έναρξη αποθήκευσης κλειδιών πρόσβασης με τη Διαχείριση κωδικών πρόσβασης</translation>
<translation id="8390323835464055390">Συνδεθείτε με τους αποθηκευμένους κωδικούς και τα κλειδιά πρόσβασης από οποιαδήποτε εφαρμογή, χρησιμοποιώντας την Αυτόματη συμπλήρωση του Vortex</translation>
<translation id="8409374867500149834">Έχετε την ισχυρότερη προστασία του Vortex από επιβλαβείς ιστοτόπους</translation>
<translation id="8543509361021925846">{THRESHOLD,plural, =1{Αυτό συμβαίνει όταν το Vortex δεν χρησιμοποιείται για {THRESHOLD} λεπτό. Τα δεδομένα που αποθηκεύτηκαν μόνο σε αυτή τη συσκευή ενώ ήσασταν συνδεδεμένοι θα διαγραφούν. Σε αυτά μπορεί να περιλαμβάνονται το ιστορικό και κωδικοί πρόσβασης.}other{Αυτό συμβαίνει όταν το Vortex δεν χρησιμοποιείται για {THRESHOLD} λεπτά. Τα δεδομένα που αποθηκεύτηκαν μόνο σε αυτή τη συσκευή ενώ ήσασταν συνδεδεμένοι θα διαγραφούν. Σε αυτά μπορεί να περιλαμβάνονται το ιστορικό και κωδικοί πρόσβασης.}}</translation>
<translation id="8586442755830160949">Πνευματικά δικαιώματα <ph name="YEAR" /> Οι συντάκτες του Vortex. Με επιφύλαξη παντός δικαιώματος.</translation>
<translation id="8602103377623855616">Σελίδα Vortex</translation>
<translation id="865600487977764604">Διατηρεί την ασφάλειά σας στο Vortex και μπορεί να χρησιμοποιηθεί για τη βελτίωση της ασφάλειάς σας σε άλλες εφαρμογές της Google όταν είστε συνδεδεμένοι.</translation>
<translation id="8663480472502753423">Διατήρηση του Vortex ενημερωμένου</translation>
<translation id="8685813584220679697">Συνδεθείτε σε αυτόν τον ιστότοπο και στο Vortex.</translation>
<translation id="8698780336333802489">Εισαγωγή στο Vortex</translation>
<translation id="8730503818204408000">Ανοίγει τη ρύθμιση του Vortex για τον ορισμό του ως προεπιλεγμένου προγράμματος περιήγησης.</translation>
<translation id="8754966941001340678">Το Vortex συνιστά Βελτιωμένη προστασία</translation>
<translation id="8759037115129007407">Το μέλος της οικογένειάς σας δεν μπορεί να λάβει κωδικούς πρόσβασης αυτή τη στιγμή. Ζητήστε από το μέλος να ενημερώσει το Vortex και να συγχρονίσει τους κωδικούς πρόσβασής του. <ph name="BEGIN_LINK" />Μάθετε περισσότερα<ph name="END_LINK" /></translation>
<translation id="8769418653786388149">Αποκτήστε πρόσβαση στο Vortex από παντού</translation>
<translation id="8776843108004031667">Αυτός ο λογαριασμός και τυχόν μη αποθηκευμένα δεδομένα θα καταργηθούν από το Vortex.</translation>
<translation id="8793333988063379360">Μπορείτε να βρείτε τις ρυθμίσεις του Vortex και άλλα στοιχεία εδώ</translation>
<translation id="8805148242934787134">Ορισμός του Vortex ως προεπιλεγμένου προγράμματος περιήγησης</translation>
<translation id="8826789549860004832">Αξιοποιήστε στο έπακρο το Vortex, συνεχίζοντας τη ρύθμιση του προγράμματος περιήγησης.</translation>
<translation id="88376265765385899">Ανοίγει τους σελιδοδείκτες του Vortex.</translation>
<translation id="8860548555286245440">Άνοιγμα URL στο Vortex σε κατάσταση ανώνυμης περιήγησης</translation>
<translation id="8880024619507699923">Ο οργανισμός σας απαιτεί να συνδεθείτε για τη χρήση του Vortex. <ph name="BEGIN_LINK" />Μάθετε περισσότερα<ph name="END_LINK" /></translation>
<translation id="8900052431807804054">Λάβετε την ισχυρότερη ασφάλεια του Vortex</translation>
<translation id="8908791447256515663">Αποκτήστε πιο γρήγορα πρόσβαση στο Vortex από το dock του iPad.</translation>
<translation id="8925569192291721236">Μείνετε ενημερωμένοι για τις ενημερώσεις παρακολούθησης τιμής και τις συμβουλές για το Vortex.</translation>
<translation id="8950326149985259075">{THRESHOLD,plural, =1{Αυτό συμβαίνει όταν το Vortex δεν χρησιμοποιείται για {THRESHOLD} λεπτό}other{Αυτό συμβαίνει όταν το Vortex δεν χρησιμοποιείται για {THRESHOLD} λεπτά}}</translation>
<translation id="8963279154877372067">Να επιτρέπονται οι ειδοποιήσεις του Vortex για λήψη ειδοποιήσεων σχετικά με πτώσεις τιμών</translation>
<translation id="8975812008711371178">Αναζήτηση με φωνή στο Vortex</translation>
<translation id="900560297598578021">Συνδεθήκατε ως <ph name="EMAIL" />.

Τα δεδομένα σας κρυπτογραφήθηκαν με τη φράση πρόσβασης στις <ph name="TIME" />. Εισαγάγετε τη φράση πρόσβασης, για να χρησιμοποιήσετε και να αποθηκεύσετε δεδομένα Vortex στον Λογαριασμό σας Google.</translation>
<translation id="9022552996538154597">Σύνδεση στο Vortex</translation>
<translation id="9031260906956926157">Ορισμένα δεδομένα του Vortex δεν έχουν αποθηκευτεί ακόμα στον Λογαριασμό σας Google.
Δοκιμάστε να περιμένετε λίγα λεπτά προτού αποσυνδεθείτε. Εάν αποσυνδεθείτε τώρα, αυτά τα δεδομένα θα διαγραφούν.</translation>
<translation id="9050790730841755540">Χρησιμοποιήστε το Vortex κάθε φορά που πατάτε συνδέσμους σε άλλες εφαρμογές.</translation>
<translation id="9059693977935746710">Δεν θα χρειάζεται να θυμάστε αυτόν τον κωδικό πρόσβασης. Θα αποθηκευτεί στον Διαχειριστή κωδικών πρόσβασης για τον λογαριασμό <ph name="EMAIL" />.</translation>
<translation id="9089354809943900324">Το Vortex δεν είναι ενημερωμένο</translation>
<translation id="9105645282262300612">Συμβουλή για το Vortex: Αναζητήστε αυτό που βλέπετε</translation>
<translation id="9152995302810511799">Συμβουλή για το Vortex: Αποκτήστε την ισχυρότερη ασφάλεια του Vortex</translation>
<translation id="9177628952266852500"><ph name="EMAIL" />. Το Vortex είναι υπό διαχείριση.</translation>
<translation id="921174536258924340">Το Vortex δεν μπόρεσε να ελέγξει όλους τους κωδικούς πρόσβασης. Δοκιμάστε ξανά αύριο ή <ph name="BEGIN_LINK" />ελέγξτε τους κωδικούς πρόσβασης στον Λογαριασμό σας Google<ph name="END_LINK" />.</translation>
<translation id="924957577793602335">Εξατομίκευση του Vortex</translation>
<translation id="981812233959540767">Παιχνίδι Vortex Dino</translation>
<translation id="985602178874221306">Οι συντάκτες του Vortex</translation>
</translationbundle>