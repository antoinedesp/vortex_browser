<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="hy">
<translation id="1000436330784933699">Տեսապակին կարող եք բացել այստեղ։</translation>
<translation id="1042296835509784301">Բացում է Գաղտնաբառերի կառավարիչը Vortex-ում։</translation>
<translation id="1047130070405668746">Ընտրեք Vortex-ը։</translation>
<translation id="1091252999271033193">Սա նշանակում է, որ Vortex-ը միշտ կփորձի բացել կայքի բջջային տարբերակը։</translation>
<translation id="1115463765356382667">Կատարեք այս առաջարկվող գործողությունները՝ Vortex-ի բոլոր հնարավորություններից օգտվելու համար։</translation>
<translation id="1185134272377778587">Vortex-ի մասին</translation>
<translation id="1211450393895337634">Դուք կարող եք ավելի արագ բացել Vortex-ը iPad-ում։</translation>
<translation id="1229234641991056119">Օգտագործեք Safari-ի ձեր գաղտնաբառերը, պատմությունը, էջանիշները և վարկային քարտերը Vortex-ում</translation>
<translation id="1257458525759135959">Պատկերները պահելու համար հպեք Կարգավորումներին և թույլատրեք Vortex-ին ավելացնել դրանք ձեր լուսանկարներին։</translation>
<translation id="1260702988262336471">Բացեք Vortex-ի ընտրացանկը</translation>
<translation id="12739128458173458">Այս ներդիրը մեկ այլ սարք ուղարկելու համար երկու սարքերում մուտք գործեք Vortex։</translation>
<translation id="1361748954329991663">Vortex-ը հնացել է։ Եթե <ph name="BEGIN_LINK" />App Store<ph name="END_LINK" />-ում թարմացում հասանելի չէ, ապա հնարավոր է՝ ձեր սարքը Vortex-ի նոր տարբերակներն այլևս չի աջակցում։</translation>
<translation id="1383876407941801731">Որոնում</translation>
<translation id="1423007117030725713">Սկսեք որոնել Vortex-ի նոր ներդիրում:</translation>
<translation id="1431818719585918472">Թույլ տվեք Vortex-ին կողպել ձեր ինկոգնիտո ներդիրները։</translation>
<translation id="1451665391191990528">Թաքցնել բաց ինկոգնիտո ներդիրները, երբ դուրս գաք Vortex-ից</translation>
<translation id="146407871188825689">Օգտագործեք Vortex-ը որպես կանխադրված դիտարկիչ iPad-ում</translation>
<translation id="1471084500615228555">Ջնջել այցելությունների պատմությունը Vortex-ում</translation>
<translation id="1472013873724362412">Ձեր հաշիվը չի աշխատում Vortex-ում: Մուտք գործելու համար դիմեք ձեր տիրույթի ադմինիստրատորին կամ օգտագործեք սովորական Google հաշիվ:</translation>
<translation id="148576268809812097">Պահեք ձեր գաղտնաբառերը Vortex-ում</translation>
<translation id="1501302548410882220">Օգտագործեք Vortex-ն ամենուրեք</translation>
<translation id="1502360822835740515">Դարձրեք Vortex-ը ձեր կանխադրված դիտարկիչը</translation>
<translation id="1503199973012840174">Vortex-ի ձեր տարբերակը հնացած է։ Ձեր տվյալների ապահովության համար թարմացրեք այն։</translation>
<translation id="1515748263297244785">Օգտագործեք Vortex-ը որպես կանխադրված դիտարկիչ iPad-ի համար</translation>
<translation id="1530961174488670696">Vortex-ին չհաջողվեց ստուգել թարմացումների առկայությունը։ Փորձեք ավելի ուշ։</translation>
<translation id="1531155317299575425">Ցույց է տալիս հաղորդագրություն Vortex-ում մուտք գործելու համար։</translation>
<translation id="1553657876656159572">Հատուկ ֆիդ՝ ստեղծված ձեզ համար։ Ֆիդը ներառում է լուրեր, սպորտային նորություններ և եղանակի տեսություն։</translation>
<translation id="1561849081734670621">Vortex-ում արգելափակման ռեժիմն անջատելու համար անջատեք այն ձեր iPhone-ում։</translation>
<translation id="1569258826720962327">iOS սարքում ընտրեք «Գործողություններ Vortex-ում»</translation>
<translation id="1573441572176948907">Տեղափոխեք Vortex-ը Dock վահանակ</translation>
<translation id="159029779861043703">Vortex-ը պաշտպանում է ձեր զգայուն տվյալները Face ID-ի միջոցով։</translation>
<translation id="1591119736686995611">Բացում է Vortex-ի ներդիրների ցանցը։</translation>
<translation id="16001233025397167">Անվտանգության ստուգումը պաշտպանում է ձեզ տվյալների արտահոսքից, վտանգավոր կայքերից և այլ խնդիրներից։ Vortex-ը կզգուշացնի գաղտնիության և անվտանգության հետ կապված խնդիրների մասին, որոնք կհայտնաբերի։</translation>
<translation id="1617663976202781617">Տվյալներ Vortex Sync-ից</translation>
<translation id="164952285225495380">Այս առաքանին արդեն հետագծվել է Vortex-ում։</translation>
<translation id="1707458603865303524">Օգտագործեք Vortex-ը ցանկացած ժամանակ, երբ հղումների եք հպում հաղորդագրություններում կամ այլ հավելվածներում։</translation>
<translation id="1722370509450468186">Գաղտնաբառը կպահվի ձեր հաշվում (<ph name="EMAIL" />)։</translation>
<translation id="1747088204252710672">Հատուկ ֆիդ՝ ստեղծված ձեզ համար</translation>
<translation id="1811860791247653035">Անհատականացումը և այլ գործառույթներ կարգավորելու համար ավելացրեք Vortex-ն այստեղ՝ <ph name="FEATURE_NAME_1" /> և <ph name="FEATURE_NAME_2" /></translation>
<translation id="1838412507805038478">Vortex-ը հաստատել է, որ <ph name="ISSUER" />-ն է թողարկել վեբկայքի հավաստագիրը:</translation>
<translation id="1839447949248872139">Բացեք հղումները Vortex-ում ըստ կանխադրման</translation>
<translation id="1843424232666537147">Vortex-ի գործառույթները կօգնեն ձեզ կառավարել թրաֆիկի սպառման և էջերի բեռնման արագությունները:
<ph name="BEGIN_LINK" />Իմանալ ավելին<ph name="END_LINK" /></translation>
<translation id="1847960401032164406">Քարտեզները Vortex-ում</translation>
<translation id="1867772173333403444">4. Ընտրեք Vortex-ը։</translation>
<translation id="1965068424387304464">Vortex-ի հետ աշխատելու խորհուրդ․ պահեք գաղտնաբառերը</translation>
<translation id="2006345422933397527">Vortex-ին չհաջողվեց ստուգել թարմացումների առկայությունը։ Ստուգեք ինտերնետ կապը։</translation>
<translation id="2042889939382983733">Դիտել Vortex-ի պատմությունը</translation>
<translation id="2052320862053429062">Vortex-ը պարբերաբար hամեմատում է ձեր գաղտնաբառերը ցուցակների հետ, որոնք հրապարակվել են առցանց։ Այդ ժամանակ ձեր գաղտնաբառերը և օգտանունները գաղտնագրվում են, այնպես որ ոչ ոք, այդ թվում՝ Google-ը, չի կարող կարդալ դրանք։</translation>
<translation id="2059365270911640413">Ավարտեք Vortex-ի կարգավորումը</translation>
<translation id="2168108852149185974">Որոշ հավելումներ առաջացնում են Vortex-ի աշխատանքի խափանում: Հեռացրեք դրանք՝</translation>
<translation id="2168593389981132306">Օգնեք բարելավել Vortex-ի աշխատանքը</translation>
<translation id="2178608107313874732">Այս պահին Vortex-ը չի կարող օգտագործել ձեր ֆոտոխցիկը</translation>
<translation id="2195025571279539885">Ուզո՞ւմ եք, որ Vortex-ն այսուհետ առաջարկի թարգմանել այս կայքի <ph name="LANGUAGE_NAME" /> էջերը:</translation>
<translation id="22313767259766852">Այս հասցեն ներկայումս պահված է Vortex-ում։ Պահեք հասցեն Google հաշվում (<ph name="USER_EMAIL" />), որպեսզի այն օգտագործեք Google-ի տարբեր պրոդուկտներում։</translation>
<translation id="2236584955986023187">Սա նշանակում է, որ Vortex-ը միշտ կփորձի բացել կայքի ամբողջական տարբերակը։</translation>
<translation id="2245694534483711162">Gemini-ը կարող է օգտագործել ձեր ճշգրիտ տեղադրությունը՝ կախված Vortex-ին արդեն տրված թույլտվություններից</translation>
<translation id="2270466829363945454">Խանութ</translation>
<translation id="2313870531055795960">Ստուգում է URL-ները Vortex-ում պահված վտանգավոր կայքերի ցանկի միջոցով։ Եթե կայքը փորձում է գողանալ ձեր գաղտնաբառը, կամ երբ վնասակար ֆայլ եք ներբեռնում, Vortex-ը կարող է ուղարկել URL-ն ու էջի բովանդակությունը՝ անվտանգ դիտարկման միջոցով ստուգելու համար։</translation>
<translation id="2314220608288760290">Vortex-ը ինկոգնիտո ռեժիմում YouTube տեսանյութերի հղումները ավտոմատ բացում է ինկոգնիտո ռեժիմում։</translation>
<translation id="231828342043114302">Ձեր հետաքրքրությունների հիման վրա անհատականացված բովանդակություն ստանալու համար մուտք գործեք Vortex։</translation>
<translation id="2326738825692478496">Ձեր Vortex-ի որոշ տվյալներ դեռ չեն պահվել ձեր Google հաշվում։

Նախքան դուրս գալը մի քանի րոպե սպասեք։ Եթե դուրս գաք հիմա, այս տվյալները կջնջվեն։</translation>
<translation id="2337722506862731008">Կիսվել Vortex-ով</translation>
<translation id="2340423701577464731">Ավելացնել ընթերցանության ցանկին Vortex-ում</translation>
<translation id="2374627437126809292">Vortex-ն օգտագործում է Google Քարտեզները՝ ձեզ գտնված հասցեների մասին տեղեկություններ ցուցադրելու և դեպի այդ վայրեր երթուղիներ գծելու համար։</translation>
<translation id="2386292341327187942">«Որոնման վիջեթներ» դաշտում մուտքագրեք Vortex</translation>
<translation id="2389827884654658221">Ավելի արագ բացեք Vortex-ը ձեր iPad-ի հիմնական էկրանից։</translation>
<translation id="2426113998523353159">Ձեր կազմակերպության կանոնների համաձայն՝ դուք պետք է մուտք գործեք հաշիվ, որպեսզի կարողանաք օգտագործել Vortex-ը։</translation>
<translation id="2450140762465183767">Այժմ հաղորդագրություններում, փաստաթղթերում և այլ հավելվածներում առկա հղումները կարող եք բացել Vortex-ում։</translation>
<translation id="2459183986985456602">Բացել իմ վերջին ներդիրը Vortex-ում։</translation>
<translation id="2476409803017965813">Դուք ցանկացած ժամանակ կարող եք թարմացնել ձեր ընտրությունները Vortex-ի կարգավորումներում։</translation>
<translation id="2478931088402984578">Ընտրեք <ph name="BEGIN_BOLD" />Vortex-ը<ph name="END_BOLD" />։</translation>
<translation id="2485774047568879945">Դարձրեք Vortex-ը ձեր կանխադրված դիտարկիչը՝ հղումներով հեշտությամբ կիսվելու և դրանք բացելու համար</translation>
<translation id="2512597191798760956">Սեղմեք Vortex-ի պատկերակը և պահեք, ապա ընտրեք «Փոփոխել հիմնական էկրանը»</translation>
<translation id="2517624234762908348">Համաժամացնել Vortex-ի տվյալները</translation>
<translation id="2575968074225731646">Ավելի արագ բացեք Vortex-ը ձեր iPhone-ի Dock վահանակից։</translation>
<translation id="2592940277904433508">Շարունակել Vortex-ի օգտագործումը</translation>
<translation id="2607609479243848905">Եթե մոռացել եք ձեր անցաբառը կամ ուզում եք փոխել այս կարգավորումը, <ph name="BEGIN_LINK" />ջնջեք Vortex-ի տվյալները ձեր հաշվում<ph name="END_LINK" />։</translation>
<translation id="2640367368802736659">Խորհուրդ Vortex-ից․ ձեր տեսածը գտեք Google Տեսապակու օգնությամբ</translation>
<translation id="2650312721222849884">Vortex-ն օգտագործելիս ձեր բոլոր ներդիրները տեսնելու համար միացրեք համաժամացումը։</translation>
<translation id="2684230048001240293">Դարձրեք Vortex-ը ձեր կանխադրված դիտարկիչը՝ ներդիրները, գաղտնաբառերը և վճարային տվյալները ձեր բոլոր սարքերում համաժամացնելու համար</translation>
<translation id="2729836253097154631">Մուտք գործեք Vortex՝ ձեր բովանդակությունն օգտագործելու համար</translation>
<translation id="2730884209570016437">Vortex-ը չի կարող օգտագործել ձեր ֆոտոխցիկը, քանի որ այն օգտագործվում է մեկ այլ հավելվածի կողմից</translation>
<translation id="2742952311155593352">Դուք գրեթե ավարտել եք Vortex-ի կարգավորումը</translation>
<translation id="2798503587425057129">Բացում է Vortex-ի ընթերցանության ցանկը։</translation>
<translation id="28276745681323897">Ձեր Google հաշվում կարող եք <ph name="BEGIN_LINK" />կառավարել, թե Vortex-ի ինչ տվյալներ պահվեն<ph name="END_LINK" />։

Որպեսզի իմանաք ավելին կարգավորումների մասին, որոնք Vortex-ի բարելավման նպատակով տվյալներ են օգտագործում, անցեք <ph name="BEGIN_LINK" />Google-ի ծառայություններ<ph name="END_LINK" />։</translation>
<translation id="2832168932648876507">Որոնել ձայնի միջոցով Vortex-ում։</translation>
<translation id="2843571538056574338">Օգտագործեք Vortex-ը ինքնալրացման համար</translation>
<translation id="2918709798697875261">Ձեր կազմակերպության կանոնների համաձայն՝ մուտքը Vortex արգելվում է։</translation>
<translation id="2942241131342758843">Դարձրեք Vortex-ը ձեր կանխադրված դիտարկիչը՝ հղումներ բացելու, վիջեթներից որոնելու և այլ հավելվածներում գաղտնաբառերի ինքնալրացման համար</translation>
<translation id="2977470724722393594">Vortex-ը թարմացված է</translation>
<translation id="3044857325852340337">Տվյալները ջնջվել են Vortex-ից</translation>
<translation id="3054480780637153380">Բացեք Vortex-ի կարգավորումները iOS-ում, ապա հպեք «Դիտարկիչի կանխադրված հավելված» և ընտրեք Vortex-ը։</translation>
<translation id="3115956258722352278">Դարձնե՞լ Vortex-ը ձեր կանխադրված դիտարկիչը</translation>
<translation id="3180939591219927904">Միացրեք «Կողպեք ինկոգնիտո ներդիրները, երբ փակեք Vortex-ը»</translation>
<translation id="328933489847748230">{count,plural, =1{Այժմ ցուցադրվում է Vortex-ի 1 պատուհան}one{Այժմ ցուցադրվում է Vortex-ի {count} պատուհան}other{Այժմ ցուցադրվում է Vortex-ի {count} պատուհան}}</translation>
<translation id="3344973607274501920">Vortex-ին չհաջողվեց ստուգել ձեր գաղտնաբառերը։ Ստուգեք ինտերնետ կապը։</translation>
<translation id="3366305173356742781">Vortex-ի տվյալները ձեր հաշվում</translation>
<translation id="3387107508582892610">{THRESHOLD,plural, =1{Սա տեղի է ունենում, երբ Vortex-ը {THRESHOLD} րոպե չի օգտագործվում։ Դա կարող է ներառել պատմությունը և ինքնալրացված տվյալները։}one{Սա տեղի է ունենում, երբ Vortex-ը {THRESHOLD} րոպե չի օգտագործվում։ Դա կարող է ներառել պատմությունը և ինքնալրացված տվյալները։}other{Սա տեղի է ունենում, երբ Vortex-ը {THRESHOLD} րոպե չի օգտագործվում։ Դա կարող է ներառել պատմությունը և ինքնալրացված տվյալները։}}</translation>
<translation id="3410395242749598859">Ձեր Vortex-ի որոշ տվյալներ դեռ չեն պահվել <ph name="EMAIL" /> հաշվում։
Նախքան հաշիվները փոխելը մի քանի րոպե սպասեք։ Եթե հաշիվները փոխեք հիմա, այս տվյալները կջնջվեն։</translation>
<translation id="3420586870838853527">Խորհուրդ Vortex-ից․ օգտագործեք բարելավված Ապահով դիտարկումը</translation>
<translation id="3440830787838130530">Հեշտությամբ և ապահով կերպով կիսվեք գաղտնաբառի պատճենով ձեր ընտանեկան խմբի հետ Google գաղտնաբառերի կառավարչում</translation>
<translation id="3472200483164753384">Չի աջակցվում Vortex Canary-ում</translation>
<translation id="347967311580159871">Որպեսզի իմանաք ավելին կարգավորումների մասին, որոնք Vortex-ի բարելավման նպատակով օգտագործում են տվյալներ, անցեք <ph name="BEGIN_LINK" />Google-ի ծառայություններ<ph name="END_LINK" />։</translation>
<translation id="3512168799938877162">Ձեր գաղտնաբառը չի փոխանցվել։ Ստուգեք ինտերնետ կապը և համոզվեք, որ մուտք եք գործել Vortex։ Այնուհետև նորից փորձեք։</translation>
<translation id="3529798650269984835">Միացրեք «Կողպել ինկոգնիտո ներդիրները, երբ փակում եք Vortex-ը» գործառույթը։</translation>
<translation id="3541247799006476453">Ինքնալրացման համար Vortex-ի միջոցով հեշտությամբ մուտք գործեք ձեր գաղտնաբառեր և մուտքի բանալիներ</translation>
<translation id="3567399274263440288">Vortex-ի բոլոր գործառույթներն օգտագործելու համար մտեք ձեր Google հաշիվ։</translation>
<translation id="3581385059720151202">Որոնել պատկերներ Vortex-ում</translation>
<translation id="3582640969619785896">Vortex-ը կառաջարկի պահել ձեր գաղտնաբառը</translation>
<translation id="3594315078412605236">Կառավարել վճարման եղանակները Vortex-ում</translation>
<translation id="3617143087229977194">Բացեք կանխադրված հավելվածների կարգավորումները iOS-ում, ապա հպեք «Դիտարկիչի հավելված» և ընտրեք Vortex-ը։</translation>
<translation id="3634039384458740619">Բացել Vortex-ի կարգավորումները</translation>
<translation id="3639997914391704523">Vortex-ը կարող է ստուգել ձեր գաղտնաբառերը, երբ մտնեք Google հաշիվ։</translation>
<translation id="372658070733623520">Vortex-ի տվյալները ձեր Google հաշվում օգտագործելու և պահելու համար հաստատեք ձեր ինքնությունը։</translation>
<translation id="3728124580182886854">Կապեք Vortex-ը Google-ի մյուս ծառայությունների հետ՝ անհատականացման և այլ գործընթացների համար</translation>
<translation id="377649297473651452">Ինքնալրացման ծավալված դիտակերպ Vortex-ում</translation>
<translation id="3780779443901618967">Զգուշացնում է ձեզ վտանգավոր, այդ թվում՝ Google-ին նախկինում անհայտ կայքերի մասին, քանի որ ավելի շատ տվյալներ է վերլուծում կայքերում՝ համեմատած ստանդարտ պաշտպանության հետ։ Դուք կարող եք բաց թողնել Vortex-ի նախազգուշացումները։</translation>
<translation id="3805899903892079518">Vortex-ին հասանելի չեն ձեր լուսանկարները կամ տեսանյութերը: Անցեք iOS Կարգավորումներ &gt; Գաղտնիություն &gt; Լուսանկարներ (Settings &gt; Privacy &gt; Photos) և միացրեք մուտքի թույլտվությունը:</translation>
<translation id="3816686541346279443">Vortex-ը կառաջարկի պահել ձեր գաղտնաբառը։</translation>
<translation id="3827545470516145620">Այս սարքում միացված է անվտանգության ստանդարտ ռեժիմը</translation>
<translation id="3833326979834193417">Vortex-ն ամեն օր ավտոմատ գործարկում է անվտանգության ստուգումը, որպեսզի պաշտպանի ձեզ տվյալների արտահոսքից, վտանգավոր կայքերից և այլն։ Անվտանգության ստուգման մասին կարող եք ավելին իմանալ Կարգավորումներում։</translation>
<translation id="3837584850181228767">Vortex-ի հետ աշխատելու խորհուրդ․ օգտագործեք բարելավված Ապահով դիտարկումը</translation>
<translation id="3845223911364528001">Վերադարձեք Vortex՝ ձեր ֆայլը վերբեռնելու համար</translation>
<translation id="3855938650519180865">Ինչ նոր բան կա Vortex-ում</translation>
<translation id="3886689467633467988">Մտեք հաշիվ այս կայքում և Vortex-ում՝ ձեր էջանիշները և մյուս տվյալները ձեր բոլոր սարքերում օգտագործելու համար։</translation>
<translation id="3949514465204582407">Խորհուրդ Vortex-ից. մուտքագրեք ձեր գաղտնաբառերը ցանկացած հավելվածում</translation>
<translation id="4005283307739974863">Բացում և գործարկում է անվտանգության ստուգումը Vortex-ում։</translation>
<translation id="4043291146360695975">Գաղտնաբառերը պահվում են միայն այս սարքի Գաղտնաբառերի կառավարիչում</translation>
<translation id="4066426933127344530">Օգտագործեք Vortex-ն ըստ կանխադրման</translation>
<translation id="4087314024407094071">Բացում է կարգավորումները Vortex-ում։</translation>
<translation id="4099085513035183040">Չի աջակցվում Vortex-ի բետա տարբերակում</translation>
<translation id="4106512142782407609">Դուք մուտք եք գործել որպես <ph name="EMAIL" />։

Ձեր տվյալները գաղտնագրված են անցաբառով։ Vortex-ի տվյալները ձեր Google հաշվում օգտագործելու և պահելու համար մուտքագրեք ձեր անցաբառը։</translation>
<translation id="4118287192800900567">Vortex-ի հուշում․ մուտք գործեք Vortex-ում</translation>
<translation id="4195557071150719219">Տեսնել Vortex-ի վերջին բացած ներդիրները</translation>
<translation id="420541179527342563">Vortex-ում արգելափակման ռեժիմն անջատելու համար անջատեք այն ձեր iPad-ում։</translation>
<translation id="4272892696084633551">Օգնեք բարելավել Vortex-ի գործառույթներն ու աշխատանքը</translation>
<translation id="4302397443352897529">Vortex-ի կարգավորումներ</translation>
<translation id="4304713468139749426">Գաղտնաբառերի կառավարիչ</translation>
<translation id="4408912345039114853">Գործարկել Vortex-ի անվտանգության ստուգումը</translation>
<translation id="4432744876818348753">Մտեք հաշիվ՝ Vortex-ի բոլոր գործառույթներից օգտվելու համար։</translation>
<translation id="4445228361214254027">Ձեր կազմակերպությունն անջատել է Vortex-ի տվյալները ձեր Google հաշվում օգտագործելու և պահելու հնարավորությունը։ Նոր էջանիշները, գաղտնաբառերը և այլ տվյալներ կպահվեն միայն այս սարքում։</translation>
<translation id="4498832288620833153">Ավելացնում է մուտքագրված URL-ը ձեր ընթերցանության ցանկին Vortex-ում։</translation>
<translation id="4508268628669724828">Վերադարձեք այստեղ, որպեսզի լրացուցիչ խորհուրդներ ստանաք՝ Vortex-ն ավելի արդյունավետ օգտագործելու համար։</translation>
<translation id="452436063477828504">Համոզվեք, որ միշտ կարող եք օգտվել Vortex-ի տվյալներից ձեր Google հաշվում</translation>
<translation id="4527452566931097835">Դարձնե՞լ Vortex-ը կանխադրված դիտարկիչ</translation>
<translation id="4555020257205549924">Եթե միացնեք այս գործառույթը, Vortex-ը կառաջարկի թարգմանել այլ լեզուներով ներկայացված էջերը Google Translate-ի միջոցով: <ph name="BEGIN_LINK" />Իմանալ ավելին<ph name="END_LINK" /></translation>
<translation id="4572441104543926904">Անցաբառով գաղտնագրումը չի կիրառվում վճարման եղանակների և հասցեների համար։

Այս կարգավորումը փոխելու համար <ph name="BEGIN_LINK" />ջնջեք Vortex-ի տվյալները ձեր հաշվում<ph name="END_LINK" />։</translation>
<translation id="4578500311756617174">Խորհուրդ Vortex-ից․ օգտագործեք Vortex-ն ըստ կանխադրման</translation>
<translation id="458786853569524949">Այժմ էլ․ նամակներում, փաստաթղթերում և այլ հավելվածներում առկա հղումները կարող եք բացել Vortex-ում։</translation>
<translation id="4633738821577273991">Կիրառեք նաև բարելավված Ապահով դիտարկումն այս Vortex պրոֆիլի համար</translation>
<translation id="4654936625574199632">Հավելվածը բարելավելու նպատակով Vortex-ը ուղարկում է օգտագործման և խափանումների մասին տվյալները Google-ին։ <ph name="BEGIN_LINK" />Կառավարել<ph name="END_LINK" /></translation>
<translation id="4681781466797808448">Միացրեք Vortex-ի սկաները</translation>
<translation id="4685611756167369067">Բացել ինկոգնիտո ներդիր Vortex-ում</translation>
<translation id="4736424910885271643">Vortex-ում պահվող ձեր բոլոր տվյալները կջնջվեն այս սարքից, քանի որ ձեր հաշիվը կառավարվում է <ph name="HOSTED_DOMAIN" /> տիրույթի կողմից</translation>
<translation id="4790638144988730920">Շարունակեք օգտագործել Vortex-ի տվյալները ձեր Google հաշվում։</translation>
<translation id="4828317641996116749">Vortex-ին չհաջողվեց ստուգել բոլոր գաղտնաբառերը։ Փորձեք ավելի ուշ։</translation>
<translation id="4856138222358683580">Գործողություններ Vortex-ում</translation>
<translation id="4904452304169763785">Զգուշացումներ Vortex-ից՝ գաղտնիության և անվտանգության հետ կապված խնդիրների մասին, որոնք կհայտնաբերի։</translation>
<translation id="4908570938463711775">Vortex-ով աշխատանքը սկսելու համար ծանոթացեք հիմնական օգտակար տեղեկություններին</translation>
<translation id="4962295957157529683">Ավարտեք աշխատանքը Vortex-ի մյուս բացված պատուհանում։</translation>
<translation id="4985291216379576555">Կապ չկա, Vortex-ը չի կարող ստուգել թարմացումների առկայությունը</translation>
<translation id="4996471330284142407">Դուք կարող եք ավելի արդյունավետ աշխատել պարզ, ապահով և արագագործ Vortex դիտարկիչի օգնությամբ։</translation>
<translation id="4999538639245140991">Դուք դուրս եք գալիս <ph name="SIGNOUT_MANAGED_DOMAIN" /> տիրույթի ադմինիստրատորի կողմից կառավարվող հաշվից: Նկատի առեք, որ Vortex-ի տվյալները սարքից կհեռացվեն, սակայն կմնան ձեր Google հաշվում:</translation>
<translation id="5042011327527167688">Հպեք «Դիտել Google Քարտեզների Vortex-ում»։</translation>
<translation id="5044871537677053278">Vortex-ը գտնում է հասցեները և օգտագործում Google Քարտեզները՝ երթուղիներ գծելու և տեղական տեղեկություններ տրամադրելու համար։</translation>
<translation id="5048140766121299007">«<ph name="TEXT_OF_THE_SETTINGS_MENU_ITEM" />» կարգավորումներից միացրեք «Vortex»-ը</translation>
<translation id="5053429694249468757">Vortex-ի տվյալները ջնջվում են…</translation>
<translation id="5071749685031362629">Vortex՝ iOS-ի համար</translation>
<translation id="5124429847818367226">Այժմ հաղորդագրություններում, փաստաթղթերում և այլ հավելվածներում առկա հղումները կարող եք բացել Vortex-ում։</translation>
<translation id="5131565040785979529">Ձեր կազմակերպությունը (<ph name="DOMAIN" />) կառավարում է ձեր մտած հաշիվը և այն, թե ինչպես է Vortex-ն օգտագործվում։</translation>
<translation id="5134464247000681876">Բացեք հղումներ Gmail-ից, Քարտեզներից, YouTube-ից և այլ հավելվածներից Vortex-ում</translation>
<translation id="5203244847421322551">Պահեք և ավտոմատ լրացրեք գաղտնաբառերը Vortex-ում</translation>
<translation id="5218806323985098884">Իմացեք, թե ինչ նոր բան կա Vortex-ում</translation>
<translation id="5224391634244552924">Պահված գաղտնաբառեր չկան։ Vortex-ը կարող է ստուգել ձեր գաղտնաբառերը, երբ պահում եք դրանք։</translation>
<translation id="5259423875997548710">Պատկերների որոնում Vortex-ում։</translation>
<translation id="5284913972719948193">Ներմուծեք ձեր գաղտնաբառերը, որոնման պատմությունը, էջանիշները և վարկային քարտի տվյալները Vortex</translation>
<translation id="5308226104666789935">Vortex-ին չհաջողվեց ստուգել թարմացումների առկայությունը</translation>
<translation id="5311557153294205270">Ավելացնում է մուտքագրված URL-ները Vortex-ի ձեր էջանիշներում։</translation>
<translation id="5383251701169024761">Պահված գաղտնաբառերն այլ հավելվածներում հեշտությամբ մուտքագրելու համար ընտրեք ինքնալրացման գործառույթը Vortex-ում։</translation>
<translation id="538767207339317086">Թույլատրել մուտքը Vortex-ում</translation>
<translation id="5389058611415066188">Եղեք պաշտպանված Vortex-ի հետ</translation>
<translation id="5414059596208264343">Խորհուրդ Vortex-ից․ ստացեք ձեր գաղտնաբառերի հասանելիություն</translation>
<translation id="5415273218238091735">Խորհուրդ Vortex-ից</translation>
<translation id="5427571867875391349">Դարձնել Vortex-ը կանխադրված դիտարկիչը</translation>
<translation id="5434562575369834882">Բացել Vortex-ի ինկոգնիտո ներդիրում</translation>
<translation id="5453478652154926037">Vortex-ը չի կարող ստուգել ձեր գաղտնաբառերը։</translation>
<translation id="5479292367402350143">Vortex-ը ձեր կանխադրված դիտարկիչը դարձնելու համար՝
1. Բացեք կարգավորումները։
2. Հպեք «Դիտարկիչի կանխադրված հավելված»։
3. Ընտրեք Vortex-ը։</translation>
<translation id="5482686278086727777">Vortex-ից ներդիրների մասին հիշեցումներ ստանալու համար iOS-ի կարգավորումներում միացրեք ծանուցումները։</translation>
<translation id="5521125884468363740">Vortex-ն օգտագործելիս ձեր բոլոր ներդիրները տեսնելու համար մտեք հաշիվ և միացրեք համաժամացումը։</translation>
<translation id="5534584691915394889">Սա կօգտագործվի՝ ձեր Apple Calendar-ում Vortex-ից և Google Տեսապակուց միջոցառումներ ստեղծելու համար։</translation>
<translation id="5571094606370987472">Բացում է Vortex-ի վերջերս բեռնած ներդիրների ցանկը։</translation>
<translation id="5596644122344097310">Հպեք այստեղ՝ ձեր iPhone-ում Vortex-ի բոլոր հնարավորություններից օգտվելու համար։</translation>
<translation id="5603085937604338780">chromium</translation>
<translation id="5657280937522795751">Անցեք Vortex-ին</translation>
<translation id="5664395081284292058">Բացել իմ վերջին ներդիրը Vortex-ում</translation>
<translation id="5671188105328420281">Vortex-ին վերաբերող խորհուրդներ</translation>
<translation id="5688047395118852662">Այս քարտում ցուցադրված են հուշումներ, թե ինչպես օգտվել Vortex-ի բոլոր հնարավորություններից։</translation>
<translation id="5700709190537129682">Vortex-ը չի կարող ստուգել ձեր գաղտնաբառերը</translation>
<translation id="5731004036450828399">Ձեր մուտքի բանալիներն անվտանգ պահելու համար նախ պետք է ստեղծեք վերականգնման PIN կոդ։

        Մուտքի բանալիները պահվում են Գաղտնաբառերի կառավարչում, որը թույլ է տալիս օգտագործել դրանք Vortex-ի միջոցով ցանկացած սարքում։</translation>
<translation id="584550191241316896">Դուք մուտք եք գործել Vortex-ում</translation>
<translation id="5862307444128926510">Բարի գալուստ Vortex</translation>
<translation id="5889847953983052353">Երբ գործառույթը միացված է.
<ph name="BEGIN_INDENT" />  • Օգնեք ավելի լավը դարձնել Vortex-ը ձեզ նման օգտատերերի համար։<ph name="END_INDENT" />

Ինչ է պետք հաշվի առնել.
<ph name="BEGIN_INDENT" />  • Google-ին տեղեկություններ են ուղարկվում Vortex-ի օգտագործման մասին, սակայն դրանք կապված չեն ձեզ հետ։

  • Եթե Vortex-ը խափանվում է, խափանման մասին մանրամասները կարող են ներառել որոշ անձնական տեղեկություններ։

  • Եթե համաժամացնեք ձեր պատմությունը ձեր Google հաշվի հետ, ցուցանիշները կարող են ներառել նաև տեղեկություններ ձեր այցելած էջերի մասին։<ph name="END_INDENT" /></translation>
<translation id="5932787118589620366">Ջնջել այցելությունների պատմությունը Vortex-ում։</translation>
<translation id="593808800391107017">Vortex-ը կզգուշացնի գաղտնիության և անվտանգության հետ կապված խնդիրների մասին, որոնք ավտոմատ կհայտնաբերի։</translation>
<translation id="5951593919357934226">Օգտվեք Vortex-ի բոլոր հնարավորություններից։</translation>
<translation id="5985254578475526217">Vortex-ից ծանուցումներ ստանալու համար ձեր iOS-ի կարգավորումներում միացրեք ծանուցումները։</translation>
<translation id="6041226255405329731">Մուտք գործեք Vortex՝ ներդիրների խմբերով կիսվելու, դրանց միանալու կամ դրանցում նույն գաղափարների շուրջ միասին աշխատելու համար</translation>
<translation id="6104024151682120539">Բացել Vortex-ում</translation>
<translation id="61109258320235597">Vortex-ի տվյալները ձեր Google հաշվում օգտագործելու և պահելու համար մուտքագրեք ձեր անցաբառը։</translation>
<translation id="6132149203299792222">Մուտք գործեք Google հաշիվ՝ ձեր գաղտնաբառերը, էջանիշները և այլ տվյալներ համաժամացնելու համար։</translation>
<translation id="6148377327556085395">Ավելացնել էջանիշներ Vortex-ում</translation>
<translation id="6154098560469640583">Օգտագործեք Vortex-ը ցանկացած ժամանակ, երբ հղումների եք հպում հաղորդագրություններում, փաստաթղթերում և այլ հավելվածներում։</translation>
<translation id="6157162508956739031">Արագ մուտք գործեք հավելվածներ և կայքեր՝ ավտոմատ լրացնելով ձեր գաղտնաբառերն ու մուտքի բանալիները Vortex-ից</translation>
<translation id="6170619162539716595">Թույլատրեք Vortex-ին օգտագործել Google Քարտեզները՝ ձեզ գտնված հասցեների մասին տեղեկություններ ցուցադրելու և դեպի այդ վայրեր երթուղիներ գծելու համար։</translation>
<translation id="6244277266078678766">Ձեր տվյալները կպահվեն <ph name="USER_EMAIL" /> հաշվի Գաղտնաբառերի կառավարչում</translation>
<translation id="6268381023930128611">Դուրս գա՞լ Vortex-ից:</translation>
<translation id="6301717043141881464">Պահված գաղտնաբառերն այլ հավելվածներում հեշտությամբ մուտքագրելու համար ընտրեք ինքնալրացման գործառույթը Vortex-ում</translation>
<translation id="6324041800010509197">Այցելել ներդիրների ցանց Vortex-ում</translation>
<translation id="6325378625795868881">Օգտագործեք Vortex-ը ցանկացած ժամանակ, երբ հղումների եք հպում հաղորդագրություններում և այլ հավելվածներում։</translation>
<translation id="6387994184698195448">Ստացեք Vortex-ի վերաբերյալ խորհուրդներ և այլ օգտակար տեղեկություններ։</translation>
<translation id="6424492062988593837">Vortex-ը կատարելագործվել է: Մատչելի է նոր տարբերակ:</translation>
<translation id="6433172051771630690">Խորհուրդներ, թե ինչպես օգտվել Vortex-ի բոլոր հնարավորություններից։</translation>
<translation id="65045991564554105">Vortex-ի էջանիշների դիտում</translation>
<translation id="6519797228806907665">Ավելի արագ բացեք Vortex-ը ձեր iPhone-ի հիմնական էկրանից։</translation>
<translation id="6538713818758208754">Բացում է վճարման եղանակների կարգավորման էջը Vortex-ում։</translation>
<translation id="6540186279384079894">Բացել նոր ներդիր Vortex-ում</translation>
<translation id="6563921047760808519">Իմացեք ավելին, թե <ph name="BEGIN_LINK" />ինչպես է Vortex-ը պահպանում ձեր տվյալների գաղտնիությունը<ph name="END_LINK" /></translation>
<translation id="6564769014061914792">Հպեք այստեղ՝ ձեր iPad-ում Vortex-ի բոլոր հնարավորություններից օգտվելու համար։</translation>
<translation id="6566303693324540692">Խորհուրդ Vortex-ից․ ավելացրեք Vortex-ը հիմնական էկրանին</translation>
<translation id="6574750762636192517">Գաղտնաբառերի կառավարում Vortex-ում</translation>
<translation id="6590232959690355435">Բացում է Vortex-ի պատմության էջը։</translation>
<translation id="6649269674808477353">Դուք կարող եք ավելի արագ բացել Vortex-ը iPhone-ում։</translation>
<translation id="6674470628873622334">Բացում է նոր ինկոգնիտո ներդիր Vortex-ում։</translation>
<translation id="6680609900732453726">Ձեր դիտարկումը գաղտնի պահեք սարքի իսկորոշման միջոցով, երբ փակեք Vortex-ը</translation>
<translation id="6752854822223394465">Ձեր կազմակերպությունը կարգավորում է Vortex-ը…</translation>
<translation id="6794054469102824109">Բացում է Vortex Dino խաղը։</translation>
<translation id="6820823224820483452">Vortex-ին չհաջողվեց ստուգել բոլոր գաղտնաբառերը։ Վաղը նորից փորձեք։</translation>
<translation id="6830782797004194206">Ավելի արագ մտեք հաշիվ Vortex-ի ավտոմատ լրացման միջոցով</translation>
<translation id="6831043979455480757">Թարգմանել</translation>
<translation id="6852419005633611413">Ավելի արագ բացեք Vortex-ը հիմնական էկրանի Dock վահանակից</translation>
<translation id="6852799557929001644">Օգտագործեք Vortex-ում և այլ հավելվածներում պահված ձեր գաղտնաբառերն ու ավելին այս սարքում։</translation>
<translation id="6887138405044152640">Այս ներդիրը մեկ այլ սարք ուղարկելու համար մուտք գործեք Vortex այդ սարքում։</translation>
<translation id="6911341667534646387">Շարունակեք օգտագործել Vortex-ի տվյալները ձեր Google հաշվում</translation>
<translation id="7018284295775193585">Չհաջողվեց թարմացնել Vortex-ը</translation>
<translation id="7055269218854630176">Ձեր կազմակերպությունը (<ph name="DOMAIN" />) կառավարում է ձեր մտած հաշիվը և այն, թե ինչպես կարող է Vortex-ն օգտագործվել։ Ձեր ադմինիստրատորը կարող է կարգավորել և սահմանափակել որոշակի գործառույթներ։</translation>
<translation id="7099326575020694068">Vortex-ը չի կարող օգտագործել ֆոտոխցիկը տրոհված տեսքի ռեժիմում</translation>
<translation id="7165402419892018581">«Ինքնալրացում» պարամետրի համար ընտրեք Vortex-ը</translation>
<translation id="7175400662502680481">Տվյալների արտահոսքի արդյունքում ձեր գաղտնաբառը հայտնի է դարձել կողմնակի անձանց։ Գաղտնաբառերի կառավարիչը խորհուրդ է տալիս անհապաղ փոխել այն։</translation>
<translation id="7185731475720473450">Վճարման եղանակները և հասցեները չեն գաղտնագրվի։ Vortex-ի այցելությունների պատմությունը չի համաժամացվի։

Միայն ձեր անցաբառն ունեցող մարդիկ կարող են կարդալ ձեր գաղտնագրված տվյալները։ Անցաբառը չի ուղարկվում Google-ին կամ պահվում նրա կողմից։ Եթե մոռացել եք ձեր անցաբառը կամ ուզում եք փոխել այս կարգավորումը, <ph name="BEGIN_LINK" />ջնջեք Vortex-ի տվյալները ձեր հաշվում<ph name="END_LINK" />։</translation>
<translation id="7192111075364461693">Vortex-ի ծանուցումներն այս պահին անջատված են սարքի կարգավորումներում։</translation>
<translation id="7195217321165708458">Gemini-ը Vortex</translation>
<translation id="7219205286115692265">Ավելի արագ բացեք Vortex-ը ձեր iPad-ի հիմնական էկրանի Dock վահանակից։</translation>
<translation id="7222001353246886083">Որոնեք ${searchPhrase} Vortex-ում</translation>
<translation id="7228180817326917122">Խորհուրդ Vortex-ից․ ընտրեք հասցեագոտու դիրքը</translation>
<translation id="725427773388857052">Vortex-ը կարող է պաշտպանել տվյալների արտահոսքից, վտանգավոր կայքերից և այլ խնդիրներից</translation>
<translation id="7269362888766543920">Որոշ հավելումներ առաջացնում են Vortex-ի աշխատանքի խափանում: Փորձեք հեռացնել դրանք:</translation>
<translation id="7285031092584344905">Օգտագործեք Vortex-ում պահված ձեր գաղտնաբառերը և ավելին այլ հավելվածներում։</translation>
<translation id="7337881442233988129">Vortex</translation>
<translation id="7395825497086981028">Գաղտնաբառը կպահվի <ph name="EMAIL" /> հաշվի Գաղտնաբառերի կառավարիչում։</translation>
<translation id="7434848749522628428">Այս մուտքի բանալին կպահվի <ph name="USER_EMAIL" /> հաշվի Գաղտնաբառերի կառավարչում</translation>
<translation id="7504829997542308412">Բացեք Vortex-ը</translation>
<translation id="7531461704633548377">Vortex-ից</translation>
<translation id="7554983317097061001">Խորհուրդ Vortex-ից․ տեղափոխեք Vortex-ը Dock վահանակ</translation>
<translation id="7576863740961052505">Vortex-ի կարգավորումների կառավարում</translation>
<translation id="7674213385180944843">Անցեք Կարգավորումներ &gt; Գաղտնիություն &gt; Տեսախցիկ &gt; Vortex և միացրեք ֆոտոխցիկը:</translation>
<translation id="7685160423563372998">Ստեղծեք պատկեր Gemini-ի օգնությամբ Vortex-ում</translation>
<translation id="7733418656985455268">Խորհուրդ Vortex-ից․ որոնեք Տեսապակու միջոցով</translation>
<translation id="7747820849741499258">Որոնում Vortex-ում</translation>
<translation id="7753923083404296545">Բացված է Vortex-ի ինկոգնիտո ներդիրում</translation>
<translation id="7762622637388462191">Կողպեք ձեր ինկոգնիտո ներդիրները, երբ դուրս եք գալիս Vortex-ից կամ անցնում այլ հավելված։</translation>
<translation id="7763454117143368771">Դարձրեք Vortex-ը ձեր կանխադրված դիտարկիչը՝ վտանգավոր կայքերից պաշտպանվելու և ձեր գաղտնաբառերն ապահով պահելու համար</translation>
<translation id="7784950022329154821">Կողպել ինկոգնիտո ներդիրները, երբ փակում եք Vortex-ը</translation>
<translation id="78025249032851484">Vortex-ի ձեր տարբերակը հնացած է։</translation>
<translation id="7859018312476869945">Երբ դուք տեքստ եք մուտքագրում հասցեագոտում կամ որոնման դաշտում, Vortex-ը ձեր հարցումն ուղարկում է կանխադրված որոնողական համակարգին՝ ավելի լավ առաջարկներ ստանալու համար։ Այս գործառույթն անջատված է ինկոգնիտո ռեժիմում։</translation>
<translation id="7890287942691234100">Ինչպես օգտագործել Vortex-ի սկաները</translation>
<translation id="7905064834449738336">Երբ գաղտնաբառ եք օգտագործում, Vortex-ը զգուշացնում է ձեզ, եթե այն հրապարակվել է համացանցում։ Այդ ժամանակ ձեր գաղտնաբառերը և օգտանունները գաղտնագրվում են, այնպես որ ոչ ոք, այդ թվում՝ Google-ը, չի կարող կարդալ դրանք։</translation>
<translation id="7928628054454574139">Բացեք Vortex-ն ամեն անգամ, երբ այլ հավելվածներում հպում եք հղումների</translation>
<translation id="7934404985878918282">Դիտել Vortex-ի ընթերցանության ցանկը</translation>
<translation id="7935734571048689933">Vortex-ը կառավարվում է</translation>
<translation id="7951793218148208717">Բացում է նոր ներդիր Vortex-ում։</translation>
<translation id="7957726318578167662">Օգտագործեք Vortex-ը՝ հաղորդագրություններում կամ այլ հավելվածներում առկա հղումները հեշտությամբ բացելու համար։</translation>
<translation id="7980860476903281594">Vortex-ը կիսվում է ձեր տեղադրության տվյալներով այն կայքերի հետ, որոնց համար տվել եք թույլտվություն։</translation>
<translation id="7994322153108931467">Vortex-ի վերաբերյալ օգտակար խորհուրդներ ստանալու համար iOS-ի կարգավորումներում միացրեք ծանուցումները։</translation>
<translation id="7997159823054171568">Դարձնել Vortex-ը կանխադրված դիտարկիչ</translation>
<translation id="800380310260616129">Ներբեռնեք Vortex-ը այստեղ։</translation>
<translation id="8013573822802650211">Vortex-ն օգտագործելիս ձեր բոլոր ներդիրները տեսնելու համար մտեք հաշիվ բոլոր սարքերում։</translation>
<translation id="8014091604604659473">Դուք դուրս եք եկել Vortex-ից</translation>
<translation id="8104697640054703121">Առավելագույնս պաշտպանվեք վտանգավոր կայքերից Vortex-ում</translation>
<translation id="8119542592987737574">Ավելի արագ բացեք Vortex-ը ձեր iPhone-ի հիմնական էկրանի Dock վահանակից։</translation>
<translation id="8164086860209325020">Բացեք Vortex-ի կարգավորումները</translation>
<translation id="8197822717502700527">Այժմ դուք կարող եք օգտվել Vortex-ի բոլոր հնարավորություններից</translation>
<translation id="8236210361418193126">Ներմուծել Գաղտնաբառերի կառավարիչ</translation>
<translation id="8254729934443216898">Ուսումնասիրեք նոր գործառույթները, որոնք օգնում են առավելագույն արդյունավետությամբ օգտագործել Vortex-ը։</translation>
<translation id="8293572045658095405">Դուք Vortex-ի ինկոգնիտո ռեժիմում եք</translation>
<translation id="830951810931292870">Մուտքագրված URL-ները բացվում են Vortex-ի ինկոգնիտո ներդիրում։</translation>
<translation id="8385503371191508165">Պահեք մուտքի բանալիները Գաղտնաբառերի կառավարչում</translation>
<translation id="8390323835464055390">Մուտք գործեք ձեր պահպանված գաղտնաբառերով և մուտքի բանալիներով ցանկացած հավելվածից՝ օգտագործելով Vortex-ը ավտոմատ լրացման համար</translation>
<translation id="8409374867500149834">Vortex-ի ամենահուսալի անվտանգության համակարգը պաշտպանում է ձեզ վնասաբեր կայքերից</translation>
<translation id="8543509361021925846">{THRESHOLD,plural, =1{Սա տեղի է ունենում, երբ Vortex-ը {THRESHOLD} րոպե չի օգտագործվում։ Տվյալները, որոնք պահվել են այս սարքում ձեր մուտք գործած ժամանակ, կջնջվեն։ Դա կարող է ներառել պատմությունը և գաղտնաբառերը։}one{Սա տեղի է ունենում, երբ Vortex-ը {THRESHOLD} րոպե չի օգտագործվում։ Տվյալները, որոնք պահվել են այս սարքում ձեր մուտք գործած ժամանակ, կջնջվեն։ Դա կարող է ներառել պատմությունը և գաղտնաբառերը։}other{Սա տեղի է ունենում, երբ Vortex-ը {THRESHOLD} րոպե չի օգտագործվում։ Տվյալները, որոնք պահվել են այս սարքում ձեր մուտք գործած ժամանակ, կջնջվեն։ Դա կարող է ներառել պատմությունը և գաղտնաբառերը։}}</translation>
<translation id="8586442755830160949">© <ph name="YEAR" /> The Vortex Authors: Բոլոր իրավունքները պահպանված են:</translation>
<translation id="8602103377623855616">Vortex-ի էջ</translation>
<translation id="865600487977764604">Ապահովում է ձեր անվտանգությունը Vortex-ում և Google հավելվածներում, երբ դուք գտնվում եք ձեր հաշվում։</translation>
<translation id="8663480472502753423">Vortex-ը թարմացված պահեք</translation>
<translation id="8685813584220679697">Մուտք գործեք այս կայք և Vortex։</translation>
<translation id="8698780336333802489">Ներմուծել Vortex</translation>
<translation id="8730503818204408000">Բացում է կարգավորումները, որտեղ կարելի է Vortex-ը դարձնել կանխադրված դիտարկիչ։</translation>
<translation id="8754966941001340678">Բարելավված պաշտպանությունը խորհուրդ է տրվում Vortex-ի կողմից</translation>
<translation id="8759037115129007407">Ձեր ընտանիքի անդամն այս պահին չի կարող գաղտնաբառեր ստանալ։ Խնդրեք նրան թարմացնել Vortex-ը և համաժամացնել իր գաղտնաբառերը։ <ph name="BEGIN_LINK" />Իմանալ ավելին<ph name="END_LINK" /></translation>
<translation id="8769418653786388149">Vortex-ը ամենուր ձեզ հետ է</translation>
<translation id="8776843108004031667">Այս հաշիվը և բոլոր չպահված տվյալները կհեռացվեն Vortex-ից։</translation>
<translation id="8793333988063379360">Այստեղ կարող եք գտնել Vortex-ի կարգավորումները և ոչ միայն</translation>
<translation id="8805148242934787134">Դարձնել Vortex-ը կանխադրված դիտարկիչ</translation>
<translation id="8826789549860004832">Օգտվեք Vortex-ի բոլոր հնարավորություններից՝ շարունակելով կարգավորել ձեր դիտարկիչը։</translation>
<translation id="88376265765385899">Բացում է Vortex-ի էջանիշները։</translation>
<translation id="8860548555286245440">Բացեք URL-ները Vortex-ի ինկոգնիտո ներդիրում</translation>
<translation id="8880024619507699923">Ձեր կազմակերպության կանոնների համաձայն՝ դուք պետք է մուտք գործեք հաշիվ, որպեսզի կարողանաք օգտագործել Vortex-ը։ <ph name="BEGIN_LINK" />Իմանալ ավելին<ph name="END_LINK" /></translation>
<translation id="8900052431807804054">Ուժեղացրեք Vortex-ի անվտանգությունը</translation>
<translation id="8908791447256515663">Ավելի արագ բացեք Vortex-ը ձեր iPad-ի Dock վահանակից։</translation>
<translation id="8925569192291721236">Ստացեք գների հետագծման թարմացումներ և Vortex-ի վերաբերյալ խորհուրդներ։</translation>
<translation id="8950326149985259075">{THRESHOLD,plural, =1{Սա տեղի է ունենում, երբ Vortex-ը {THRESHOLD} րոպե չի օգտագործվում}one{Սա տեղի է ունենում, երբ Vortex-ը {THRESHOLD} րոպե չի օգտագործվում}other{Սա տեղի է ունենում, երբ Vortex-ը {THRESHOLD} րոպե չի օգտագործվում}}</translation>
<translation id="8963279154877372067">Թույլատրեք Vortex-ին ուղարկել ծանուցումներ, որպեսզի տեղեկանաք գների իջեցման մասին</translation>
<translation id="8975812008711371178">Ձայնի միջոցով որոնում Vortex-ում</translation>
<translation id="900560297598578021">Դուք մուտք եք գործել որպես <ph name="EMAIL" />։

Ձեր տվյալները գաղտնագրվել են ձեր անցաբառով <ph name="TIME" />։ Vortex-ի տվյալները ձեր Google հաշվում օգտագործելու և պահելու համար մուտքագրեք ձեր անցաբառը։</translation>
<translation id="9022552996538154597">Մուտք գործել Vortex</translation>
<translation id="9031260906956926157">Ձեր Vortex-ի որոշ տվյալներ դեռ չեն պահվել ձեր Google հաշվում։
Նախքան դուրս գալը մի քանի րոպե սպասեք։ Եթե դուրս գաք հիմա, այս տվյալները կջնջվեն։</translation>
<translation id="9050790730841755540">Օգտագործեք Vortex-ը ցանկացած ժամանակ, երբ հղումների եք հպում այլ հավելվածներում։</translation>
<translation id="9059693977935746710">Այս գաղտնաբառը հիշելու կարիք չկա։ Այն կպահվի <ph name="EMAIL" /> հաշվի Գաղտնաբառերի կառավարիչում։</translation>
<translation id="9089354809943900324">Vortex-ը հնացել է</translation>
<translation id="9105645282262300612">Vortex-ի խորհուրդ․ որոնեք այն, ինչ տեսնում եք</translation>
<translation id="9152995302810511799">Խորհուրդ Vortex-ից․ ստացեք Vortex-ի ամենահուսալի պաշտպանությունը</translation>
<translation id="9177628952266852500"><ph name="EMAIL" />։ Vortex-ը կառավարվում է։</translation>
<translation id="921174536258924340">Vortex-ին չհաջողվեց ստուգել բոլոր գաղտնաբառերը։ Վաղը նորից փորձեք կամ <ph name="BEGIN_LINK" />գաղտնաբառերը ստուգեք ձեր Google հաշվում<ph name="END_LINK" />։</translation>
<translation id="924957577793602335">Անհատականացրեք Vortex-ը</translation>
<translation id="981812233959540767">Խաղալ Vortex Dino խաղը</translation>
<translation id="985602178874221306">Vortex Authors</translation>
