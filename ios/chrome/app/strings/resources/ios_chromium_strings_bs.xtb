<!DOCTYPE translationbundle>
<translationbundle lang="bs">
<translation id="1000436330784933699">Ovdje možete otvoriti Objektiv.</translation>
<translation id="1042296835509784301">Otvara Upravitelj lozinki u Vortexu.</translation>
<translation id="1047130070405668746">Odaberite Vortex</translation>
<translation id="1091252999271033193">Ovo znači da će Vortex svaki put zatražiti web lokaciju za mobilni uređaj.</translation>
<translation id="1115463765356382667">Izvršite predložene radnje u nastavku da iskoristite sve prednosti Vortexa.</translation>
<translation id="1185134272377778587">O programu Vortex</translation>
<translation id="1211450393895337634">Brže otvorite Vortex kada ste spremni da pregledate na iPadu.</translation>
<translation id="1229234641991056119">U Vortexu koristite lozinke, historiju, oznake i kreditne kartice iz Safarija</translation>
<translation id="1257458525759135959">Da sačuvate slike, dodirnite Postavke da omogućite Vortexu dodavanje u vaše fotografije</translation>
<translation id="1260702988262336471">Otvorite meni Vortexa.</translation>
<translation id="12739128458173458">Da pošaljete ovu karticu na drugi uređaj, prijavite se u Vortex na oba uređaja.</translation>
<translation id="1361748954329991663">Vortex je zastario. Ako ažuriranje nije dostupno u <ph name="BEGIN_LINK" />App Storeu<ph name="END_LINK" />, moguće je da vaš uređaj više ne podržava nove verzije Vortexa.</translation>
<translation id="1383876407941801731">Traži</translation>
<translation id="1423007117030725713">Započnite pretraživanje na novoj kartici Vortexa.</translation>
<translation id="1431818719585918472">Omogućite Vortexu da zaključa vaše anonimne kartice.</translation>
<translation id="1451665391191990528">Sakrijte otvorene anonimne kartice prilikom napuštanja Vortexa</translation>
<translation id="146407871188825689">Koristite Vortex na iPadu prema zadanim postavkama</translation>
<translation id="1471084500615228555">Brisanje podataka pregledanja u Vortexu</translation>
<translation id="1472013873724362412">Vaš račun ne funkcionira na Vortexu. Obratite se administratoru domene ili koristite obični Google račun za prijavu.</translation>
<translation id="148576268809812097">Sačuvajte lozinke u Vortexu</translation>
<translation id="1501302548410882220">Koristite Vortex svugdje</translation>
<translation id="1502360822835740515">Postavite Vortex kao zadani preglednik</translation>
<translation id="1503199973012840174">Vortex je zastario. Ažurirajte ga da ostanete sigurni.</translation>
<translation id="1515748263297244785">Koristite Vortex za iPad prema zadanim postavkama</translation>
<translation id="1530961174488670696">Vortex nije mogao provjeriti ima li ažuriranja. Pokušajte ponovo kasnije.</translation>
<translation id="1531155317299575425">Prikazuje upite za prijavu pomoću Vortexa.</translation>
<translation id="1553657876656159572">Prilagođeni sažetak sadržaja za vas. Uključujući vijesti, sport i vrijeme.</translation>
<translation id="1561849081734670621">Da onemogućite način rada sa zaključavanjem u Vortexu, isključite ga na iPhoneu.</translation>
<translation id="1569258826720962327">Koristite radnje u Vortexu u iOS-u</translation>
<translation id="1573441572176948907">Premjestite Vortex na donju traku</translation>
<translation id="159029779861043703">Vortex štiti vaše osjetljive podatke putem Face ID-a.</translation>
<translation id="1591119736686995611">Otvaranje mreže kartica u Vortexu.</translation>
<translation id="16001233025397167">Sigurnosna provjera vas štiti od narušavanja podataka, nesigurnih web lokacija i drugih prijetnji. Primajte upozorenja o problemima s privatnošću ili sigurnošću koje Vortex otkrije za vas.</translation>
<translation id="1617663976202781617">Sinhronizacija podataka s Vortexa</translation>
<translation id="164952285225495380">Ovaj paket se već prati u Vortexu.</translation>
<translation id="1707458603865303524">Koristite Vortex svaki put kada dodirnete linkove u porukama ili drugim aplikacijama.</translation>
<translation id="1722370509450468186">Vaša lozinka će se sačuvati na vašem računu (<ph name="EMAIL" />).</translation>
<translation id="1747088204252710672">Prilagođeni sažetak sadržaja za vas</translation>
<translation id="1811860791247653035">Da dobijete personalizaciju i druge funkcije, uključite Vortex u funkcijama <ph name="FEATURE_NAME_1" /> i <ph name="FEATURE_NAME_2" /></translation>
<translation id="1838412507805038478">Vortex je potvrdio da je <ph name="ISSUER" /> izdao certifikat ove web lokacije.</translation>
<translation id="1839447949248872139">Otvara linkove u Vortexu prema zadanim postavkama</translation>
<translation id="1843424232666537147">Vortex sadrži funkcije koje vam pomažu kod upravljanja internetskim podacima i brzine učitavanja web lokacija.
<ph name="BEGIN_LINK" />Saznajte više<ph name="END_LINK" /></translation>
<translation id="1847960401032164406">Mape u Vortexu</translation>
<translation id="1867772173333403444">4. Odaberite Vortex</translation>
<translation id="1965068424387304464">Savjet za Vortex: sačuvajte lozinke</translation>
<translation id="2006345422933397527">Vortex nije mogao provjeriti ima li ažuriranja. Predlažemo da provjerite internetsku vezu.</translation>
<translation id="2042889939382983733">Pregledajte svoju historiju Vortexa</translation>
<translation id="2052320862053429062">Vortex povremeno provjerava nalaze li se vaše lozinke na listama koje su objavljene online. Prilikom toga, vaše lozinke i korisnička imena su šifrirani i niko, uključujući Google, ih ne može pročitati.</translation>
<translation id="2059365270911640413">Završite postavljanje Vortexa</translation>
<translation id="2168108852149185974">Neki programski dodaci uzrokuju pad aplikacije Vortex. Deinstalirajte:</translation>
<translation id="2168593389981132306">Poboljšajte Vortex</translation>
<translation id="2178608107313874732">Vortex trenutno ne može koristiti kameru</translation>
<translation id="2195025571279539885">Želite li da vam Vortex sljedeći put ponudi prijevod stranica na <ph name="LANGUAGE_NAME" /> jeziku s ove web lokacije?</translation>
<translation id="22313767259766852">Adresa je trenutno sačuvana u Vortexu. Da je koristite na Googleovim proizvodima, sačuvajte je na Google računu <ph name="USER_EMAIL" />.</translation>
<translation id="2236584955986023187">Ovo znači da će Vortex svaki put zatražiti web lokaciju za računar.</translation>
<translation id="2245694534483711162">Gemini će možda koristiti vašu tačnu lokaciju ovisno o odobrenju koje ste već dali Vortexu</translation>
<translation id="2270466829363945454">Kupovina</translation>
<translation id="2313870531055795960">Provjerava URL-ove s listom nesigurnih web lokacija pohranjenih u Vortexu. Ako web lokacija pokuša ukrasti vašu lozinku ili kada preuzimate štetan fajl, Vortex može slati i URL-ove, uključujući dijelove sadržaja stranice, u Sigurno pregledanje.</translation>
<translation id="2314220608288760290">Vortex automatski otvara anonimne linkove YouTubea u anonimnom načinu rada.</translation>
<translation id="231828342043114302">Da primate personaliziran sadržaj na osnovu svojih interesovanja, prijavite se u Vortex.</translation>
<translation id="2326738825692478496">Određeni podaci Vortexa još uvijek nisu sačuvani na Google račun.

Pričekajte nekoliko minuta prije odjave. Ako se sada odjavite, ovi podaci će se izbrisati.</translation>
<translation id="2337722506862731008">Dijelite Vortex</translation>
<translation id="2340423701577464731">Dodavanje stavke na listu za čitanje u Vortexu</translation>
<translation id="2374627437126809292">Vortex koristi Google Mape da vam dâ upute i lokalne informacije o otkrivenim adresama.</translation>
<translation id="2386292341327187942">U polju Vidžeti za pretraživanje unesite Vortex</translation>
<translation id="2389827884654658221">Brže pristupajte Vortexu s početnog ekrana iPada.</translation>
<translation id="2426113998523353159">Vaša organizacija zahtijeva da se prijavite da koristite Vortex.</translation>
<translation id="2450140762465183767">Sada možete koristiti Vortex svaki put kada dodirnete linkove u porukama, dokumentima i drugim aplikacijama.</translation>
<translation id="2459183986985456602">Otvaranje posljednje kartice u Vortexu.</translation>
<translation id="2476409803017965813">Možete ažurirati odabire bilo kada u postavkama Vortexa.</translation>
<translation id="2478931088402984578">Odaberite <ph name="BEGIN_BOLD" />Vortex<ph name="END_BOLD" /></translation>
<translation id="2485774047568879945">Postavite Vortex kao zadani preglednik da lako dijelite i otvarate linkove</translation>
<translation id="2512597191798760956">Pritisnite i zadržite ikonu Vortexa i kliknite na "Uredite početni ekran".</translation>
<translation id="2517624234762908348">Sinhroniziraj Vortex podatke</translation>
<translation id="2575968074225731646">Brže pristupajte Vortexu s donje trake iPhonea.</translation>
<translation id="2592940277904433508">Nastavi koristiti Vortex</translation>
<translation id="2607609479243848905">Ako ste zaboravili pristupni izraz ili želite promijeniti ovu postavku, <ph name="BEGIN_LINK" />izbrišite podatke Vortexa na računu<ph name="END_LINK" />.</translation>
<translation id="2640367368802736659">Savjet za Vortex: pretražite ono što vidite putem Google Objektiva</translation>
<translation id="2650312721222849884">Da vidite kartice s bilo kojeg uređaja na kojem koristite Vortex, uključite sinhronizaciju</translation>
<translation id="2684230048001240293">Postavite Vortex kao zadani preglednik da sinhronizirate kartice, lozinke i podatke o plaćanju na svim uređajima</translation>
<translation id="2729836253097154631">Prijavite se u Vortex da dobijete svoje stvari</translation>
<translation id="2730884209570016437">Vortex ne može koristiti kameru jer je koristi druga aplikacija</translation>
<translation id="2742952311155593352">Skoro ste završili postavljanje Vortexa!</translation>
<translation id="2798503587425057129">Otvaranje Liste za čitanje u Vortexu.</translation>
<translation id="28276745681323897">Možete <ph name="BEGIN_LINK" />upravljati podacima Vortexa koji se pohranjuju<ph name="END_LINK" /> na Google račun.

Za više postavki koje koriste podatke radi poboljšanja iskustva u Vortexu idite na <ph name="BEGIN_LINK" />Googleove usluge<ph name="END_LINK" />.</translation>
<translation id="2832168932648876507">Pretraživanje glasovnim komandama u Vortexu.</translation>
<translation id="2843571538056574338">Koristite Vortex za automatsko popunjavanje</translation>
<translation id="2918709798697875261">Vaša organizacija zahtijeva da ostanete odjavljeni s Vortexa.</translation>
<translation id="2942241131342758843">Koristite Vortex prema zadanim postavkama da otvarate linkove, pretražujete iz vidžeta i automatski popunjavate lozinke u drugim aplikacijama</translation>
<translation id="2977470724722393594">Vortex je ažuriran</translation>
<translation id="3044857325852340337">Izbrisani su podaci Vortexa</translation>
<translation id="3054480780637153380">Otvorite postavke Vortexa u iOS-u, a zatim dodirnite "Zadana aplikacija preglednika" i odaberite Vortex.</translation>
<translation id="3115956258722352278">Postaviti Vortex kao zadani preglednik?</translation>
<translation id="3180939591219927904">Uključite "Zaključaj anonimne kartice prilikom zatvaranja Vortexa"</translation>
<translation id="328933489847748230">{count,plural, =1{Trenutno se prikazuje 1 prozor Vortexa}one{Trenutno se prikazuje {count} prozor Vortexa}few{Trenutno se prikazuju {count} prozora Vortexa}other{Trenutno se prikazuje {count} prozora Vortexa}}</translation>
<translation id="3344973607274501920">Vortex nije mogao provjeriti vaše lozinke. Predlažemo da provjerite internetsku vezu.</translation>
<translation id="3366305173356742781">Podaci Vortexa na vašem računu</translation>
<translation id="3387107508582892610">{THRESHOLD,plural, =1{Ovo se dešava kad se Vortex ne koristi {THRESHOLD} minutu. Ovo može uključivati historiju i automatsko popunjavanje.}one{Ovo se dešava kad se Vortex ne koristi {THRESHOLD} minutu. Ovo može uključivati historiju i automatsko popunjavanje.}few{Ovo se dešava kad se Vortex ne koristi {THRESHOLD} minute. Ovo može uključivati historiju i automatsko popunjavanje.}other{Ovo se dešava kad se Vortex ne koristi {THRESHOLD} minuta. Ovo može uključivati historiju i automatsko popunjavanje.}}</translation>
<translation id="3410395242749598859">Neki podaci Vortexa još uvijek nisu sačuvani na <ph name="EMAIL" />.
Pričekajte nekoliko minuta prije nego što promijenite račun. Ako promijenite račun sada, ti podaci će se izbrisati.</translation>
<translation id="3420586870838853527">Savjet za Vortex: poboljšano Sigurno pregledanje će vam pomoći</translation>
<translation id="3440830787838130530">Jednostavno i sigurno dijelite kopiju lozinke s porodičnom grupom na Google upravitelju lozinki</translation>
<translation id="3472200483164753384">Nije podržano na Vortex Canaryju</translation>
<translation id="347967311580159871">Za više postavki koje koriste podatke radi poboljšanja iskustva u Vortexu idite na <ph name="BEGIN_LINK" />Googleove usluge<ph name="END_LINK" />.</translation>
<translation id="3512168799938877162">Lozinka nije podijeljena. Provjerite internetsku vezu i jeste li prijavljeni u Vortex. Nakon toga pokušajte ponovo.</translation>
<translation id="3529798650269984835">Uključite "Zaključaj anonimne kartice prilikom zatvaranja Vortexa".</translation>
<translation id="3541247799006476453">Ostvarite jednostavan pristup lozinkama i pristupnim ključevima koristeći Vortex za automatsko popunjavanje</translation>
<translation id="3567399274263440288">Da iskoristite sve prednosti Vortexa, prijavite se na Vortex pomoću Google računa.</translation>
<translation id="3581385059720151202">Pretraživanje vizuelnih elemenata u Vortexu</translation>
<translation id="3582640969619785896">Vortex će ponuditi opciju da sačuva lozinku</translation>
<translation id="3594315078412605236">Upravljanje načinima plaćanja u Vortexu</translation>
<translation id="3617143087229977194">Otvorite postavke Zadanih aplikacija u iOS-u, a zatim dodirnite "Aplikacija preglednika" i odaberite Vortex.</translation>
<translation id="3634039384458740619">Otvori postavke Vortexa</translation>
<translation id="3639997914391704523">Vortex može provjeravati vaše lozinke kada se prijavljujete pomoću Google računa.</translation>
<translation id="372658070733623520">Da koristite i sačuvate podatke Vortexa na Google računu, potvrdite identitet.</translation>
<translation id="3728124580182886854">Povežite Vortex i druge Googleove usluge radi personalizacije i u druge svrhe</translation>
<translation id="377649297473651452">Prošireni prikaz automatskog popunjavanja u Vortexu</translation>
<translation id="3780779443901618967">Upozorava vas o opasnim web lokacijama, čak i onim za koje Google nije ranije znao, analizirajući više podataka s web lokacija nego što se analizira standardnom zaštitom. Možete odabrati preskakanje Vortexovih upozorenja.</translation>
<translation id="3805899903892079518">Vortex nema pristup vašim fotografijama ili videozapisima. Omogućite pristup u meniju iOS postavke &gt; Privatnost &gt; Fotografije.</translation>
<translation id="3816686541346279443">Vortex će ponuditi opciju da sačuva lozinku.</translation>
<translation id="3827545470516145620">Dobijate standardnu sigurnosnu zaštitu na ovom uređaju</translation>
<translation id="3833326979834193417">Vortex automatski pokreće sigurnosnu provjeru svakog dana da vas zaštiti od narušavanja podataka, nesigurnih web lokacija i drugog. U Postavkama možete pronaći više informacija o sigurnosnoj provjeri.</translation>
<translation id="3837584850181228767">Savjet za Vortex: poboljšano Sigurno pregledanje</translation>
<translation id="3845223911364528001">Vratite se u Vortex da otpremite fajl</translation>
<translation id="3855938650519180865">Šta je novo u Vortexu</translation>
<translation id="3886689467633467988">Prijavite se na ovu web lokaciju i u Vortex da dobijete svoje oznake i još mnogo toga na svim svojim uređajima.</translation>
<translation id="3949514465204582407">Savjet za Vortex: dobijte lozinke u bilo kojoj aplikaciji</translation>
<translation id="4005283307739974863">Otvara i pokreće sigurnosnu provjeru u Vortexu.</translation>
<translation id="4043291146360695975">Lozinke se pohranjuju u Upravitelju lozinki samo na ovom uređaju.</translation>
<translation id="4066426933127344530">Koristite Vortex prema zadanim postavkama</translation>
<translation id="4087314024407094071">Otvara postavke u Vortexu.</translation>
<translation id="4099085513035183040">Nije podržano u Beta verziji Vortexa</translation>
<translation id="4106512142782407609">Prijavljeni ste kao <ph name="EMAIL" />.

Vaši podaci su šifrirani pristupnim izrazom. Unesite ga da koristite i sačuvate podatke Vortexa na Google računu.</translation>
<translation id="4118287192800900567">Savjet za Vortex: prijavite se u Vortex</translation>
<translation id="4195557071150719219">Pogledajte nedavne kartice u Vortexu</translation>
<translation id="420541179527342563">Da onemogućite način rada sa zaključavanjem u Vortexu, isključite ga na iPadu.</translation>
<translation id="4272892696084633551">Pomozite na da poboljšamo Vortexove funkcije i performanse</translation>
<translation id="4302397443352897529">Postavke Vortexa</translation>
<translation id="4304713468139749426">Upravitelj lozinki</translation>
<translation id="4408912345039114853">Pokrenite Sigurnosnu provjeru Vortexa</translation>
<translation id="4432744876818348753">Prijavite se da iskoristite prednosti Vortexa.</translation>
<translation id="4445228361214254027">Vaša organizacija je isključila mogućnost korištenja i pohranjivanja podataka Vortexa na vaš Google račun. Nove oznake, lozinke i još mnogo toga će se pohranjivati samo na ovaj uređaj.</translation>
<translation id="4498832288620833153">Dodaje unesene URL-ove na listu za čitanje u Vortexu.</translation>
<translation id="4508268628669724828">Provjerite ponovo ovdje za više korisnih savjeta za iskorištavanje svih prednosti Vortexa.</translation>
<translation id="452436063477828504">Pobrinite se da uvijek možete koristiti podatke Vortexa na Google računu</translation>
<translation id="4527452566931097835">Postaviti Vortex kao zadani preglednik?</translation>
<translation id="4555020257205549924">Kada je ova funkcija uključena, Vortex će ponuditi prevođenje stranica koje su napisane na drugim jezicima, pomoću Google Prevodioca. <ph name="BEGIN_LINK" />Saznajte više<ph name="END_LINK" /></translation>
<translation id="4572441104543926904">Šifriranje pristupnim izrazom ne obuhvata načine plaćanja i adrese.

Da promijenite ovu postavku, <ph name="BEGIN_LINK" />izbrišite podatke Vortexa na računu<ph name="END_LINK" />.</translation>
<translation id="4578500311756617174">Savjet za Vortex: koristite Vortex prema zadanim postavkama</translation>
<translation id="458786853569524949">Sada možete koristiti Vortex svaki put kada dodirnete linkove u e-porukama, dokumentima i drugim aplikacijama.</translation>
<translation id="4633738821577273991">Preuzmite i poboljšano Sigurno pregledanje za ovaj Vortex profil</translation>
<translation id="4654936625574199632">Radi poboljšanja aplikacije, Vortex šalje Googleu izvještaje o korištenju i padovima. <ph name="BEGIN_LINK" />Upravljajte<ph name="END_LINK" /></translation>
<translation id="4681781466797808448">Uključite Vortex skener</translation>
<translation id="4685611756167369067">Otvaranje anonimne kartice u Vortexu</translation>
<translation id="4736424910885271643">Računom upravlja <ph name="HOSTED_DOMAIN" />, stoga će se vaši podaci Vortexa obrisati s ovog uređaja</translation>
<translation id="4790638144988730920">Nastavite koristiti podatke Vortexa na Google računu.</translation>
<translation id="4828317641996116749">Vortex nije mogao provjeriti sve lozinke. Pokušajte ponovo kasnije.</translation>
<translation id="4856138222358683580">Radnje u Vortexu</translation>
<translation id="4904452304169763785">Upozorenja o problemima s privatnošću ili sigurnošću koje Vortex otkrije za vas.</translation>
<translation id="4908570938463711775">Da započnete, saznajte korisne osnove o Vortexu</translation>
<translation id="4962295957157529683">Završite započetu radnju u drugom otvorenom prozoru Vortexa.</translation>
<translation id="4985291216379576555">Van mreže, Vortex ne može provjeravati ima li ažuriranja</translation>
<translation id="4996471330284142407">Obavite više s jednostavnim i sigurnim Vortexom koji je brži nego ikad.</translation>
<translation id="4999538639245140991">Pošto se odjavljujete s računa kojim upravlja <ph name="SIGNOUT_MANAGED_DOMAIN" />, vaši podaci iz Vortexa će se izbrisati s ovog uređaja. Vaši podaci će ostati na vašem Google računu.</translation>
<translation id="5042011327527167688">Dodirnite "Pregledajte putem Google Mapa u Vortexu".</translation>
<translation id="5044871537677053278">Vortex otkriva adrese i koristi Google Mape da vam daje smjernice i lokalne informacije.</translation>
<translation id="5048140766121299007">U postavkama "<ph name="TEXT_OF_THE_SETTINGS_MENU_ITEM" />" uključite "Vortex"</translation>
<translation id="5053429694249468757">Brisanje podataka Vortexa…</translation>
<translation id="5071749685031362629">Vortex za iOS</translation>
<translation id="5124429847818367226">Sada možete koristiti Vortex svaki put kada pregledate ili dodirnete linkove u porukama, dokumentima i drugim aplikacijama.</translation>
<translation id="5131565040785979529">Vaša organizacija, <ph name="DOMAIN" />, upravlja računom na kojem ste prijavljeni i načinom na koji koristite Vortex.</translation>
<translation id="5134464247000681876">Otvarajte linkove s Gmaila, Mapa, YouTubea i iz drugih aplikacija u Vortexu</translation>
<translation id="5203244847421322551">Pohranjujte i automatski popunjavajte lozinke u Vortexu</translation>
<translation id="5218806323985098884">Pogledajte šta je novo u Vortexu</translation>
<translation id="5224391634244552924">Nema sačuvanih lozinki. Vortex može provjeravati vaše lozinke kada ih sačuvate.</translation>
<translation id="5259423875997548710">Pretraživanje vizuelnih elemenata u Vortexu.</translation>
<translation id="5284913972719948193">Uvezite podatke da koristite lozinke, historiju, oznake i kreditne kartice u Vortexu</translation>
<translation id="5308226104666789935">Vortex ne može provjeriti ima li ažuriranja</translation>
<translation id="5311557153294205270">Dodaje unesene URL-ove u vaše oznake u Vortexu.</translation>
<translation id="5383251701169024761">Da lako dobijate sačuvane lozinke u drugim aplikacijama, odaberite Vortex za automatsko popunjavanje.</translation>
<translation id="538767207339317086">Dozvoli prijavljivanje u Vortex</translation>
<translation id="5389058611415066188">Budite sigurni uz Vortex</translation>
<translation id="5414059596208264343">Savjet za Vortex: preuzmite lozinke</translation>
<translation id="5415273218238091735">Savjet za Vortex</translation>
<translation id="5427571867875391349">Postavite Vortex kao zadani preglednik</translation>
<translation id="5434562575369834882">Otvori u Vortexu u anonimnom načinu rada</translation>
<translation id="5453478652154926037">Vortex ne može provjeriti vaše lozinke.</translation>
<translation id="5479292367402350143">Da postavite Vortex kao zadani preglednik:
1. Otvorite Postavke.
2. Dodirnite Zadana aplikacija preglednika.
3. Odaberite Vortex.</translation>
<translation id="5482686278086727777">Da primate podsjetnike za kartice od Vortexa, uključite obavještenja u Postavkama iOS-a.</translation>
<translation id="5521125884468363740">Da vidite svoje kartice s bilo kojeg uređaja na kojem koristite Vortex, prijavite se i uključite sinhronizaciju</translation>
<translation id="5534584691915394889">Ovo će se koristiti za kreiranje događaja u vašem Apple Calendaru iz Vortexa i Google Objektiva.</translation>
<translation id="5571094606370987472">Otvaranje nedavnih kartica u Vortexu.</translation>
<translation id="5596644122344097310">Dodirnite ovdje da iskoristite sve prednosti Vortexa na iPhoneu.</translation>
<translation id="5603085937604338780">chromium</translation>
<translation id="5657280937522795751">Uključite ili isključite Vortex</translation>
<translation id="5664395081284292058">Otvaranje posljednje kartice u Vortexu</translation>
<translation id="5671188105328420281">Savjeti za Vortex</translation>
<translation id="5688047395118852662">Kartica prikazuje prijedloge o tome kako iskoristiti sve prednosti Vortexa.</translation>
<translation id="5700709190537129682">Vortex ne može provjeriti vaše lozinke</translation>
<translation id="5731004036450828399">Da zaštitite pristupne ključeve, prvo morate kreirati PIN za oporavak.

        Pristupni ključevi se pohranjuju na Upravitelju lozinki, što vam omogućava da ih koristite u Vortexu na bilo kojem uređaju.</translation>
<translation id="584550191241316896">Prijavljeni ste u Vortex</translation>
<translation id="5862307444128926510">Dobro došli u Vortex</translation>
<translation id="5889847953983052353">Kada je uključeno:
<ph name="BEGIN_INDENT" />  • Pomažete da Vortex postane bolji za osobe koje ga koriste na isti način kao vi.<ph name="END_INDENT" />

Stvari za razmatranje:
<ph name="BEGIN_INDENT" />  • Informacije o vašem korištenju Vortexa se šalju Googleu, ali se ne povezuju s vama.

  • Ako dođe do pada Vortexa, detalji o padu mogu uključivati neke lične informacije.

  • Ako sinhronizirate historiju s Google računom, pokazatelji mogu uključivati i informacije o URL-ovima koje ste posjetili.<ph name="END_INDENT" /></translation>
<translation id="5932787118589620366">Brisanje podataka pregledanja u Vortexu.</translation>
<translation id="593808800391107017">Primajte upozorenja o problemima s privatnošću ili sigurnošću koje Vortex automatski otkrije za vas.</translation>
<translation id="5951593919357934226">Iskoristite sve prednosti Vortexa.</translation>
<translation id="5985254578475526217">Da primate obavještenja od Vortexa, uključite obavještenja u Postavkama iOS-a.</translation>
<translation id="6041226255405329731">Prijavite se u Vortex da dijelite grupe kartica, pridružujete im se i sarađujete na idejama</translation>
<translation id="6104024151682120539">Otvori u Vortexu</translation>
<translation id="61109258320235597">Da koristite i sačuvate podatke Vortexa na Google računu, unesite pristupni izraz.</translation>
<translation id="6132149203299792222">Prijavite se putem Google računa da sinhronizirate lozinke, oznake i drugo.</translation>
<translation id="6148377327556085395">Dodavanje oznaka u Vortex</translation>
<translation id="6154098560469640583">Koristite Vortex svaki put kada dodirnete linkove u porukama, dokumentima i drugim aplikacijama.</translation>
<translation id="6157162508956739031">Brzo se prijavite u aplikacije i na web lokacije automatskim popunjavanjem lozinki i pristupnih ključeva iz Vortexa</translation>
<translation id="6170619162539716595">Dozvolite Vortexu da koristi Google Mape da vam daje smjernice i lokalne informacije o otkrivenim adresama.</translation>
<translation id="6244277266078678766">Podaci će se sačuvati na Upravitelju lozinki za <ph name="USER_EMAIL" /></translation>
<translation id="6268381023930128611">Odjaviti se iz Vortexa?</translation>
<translation id="6301717043141881464">Da lako dobijete sačuvane lozinke u drugim aplikacijama, odaberite Vortex za automatsko popunjavanje</translation>
<translation id="6324041800010509197">Otvorite mrežu kartica u Vortexu</translation>
<translation id="6325378625795868881">Koristite Vortex svaki put kada dodirnete linkove u porukama i drugim aplikacijama.</translation>
<translation id="6387994184698195448">Pratite korisne savjete za Vortex i drugo.</translation>
<translation id="6424492062988593837">Vortex je sada još bolji! Dostupna je nova verzija.</translation>
<translation id="6433172051771630690">Savjeti za iskorištavanje svih prednosti Vortexa.</translation>
<translation id="65045991564554105">Prikazivanje oznaka u Vortexu</translation>
<translation id="6519797228806907665">Brže pristupajte Vortexu s početnog ekrana iPhonea.</translation>
<translation id="6538713818758208754">Otvara stranicu s postavkama načina plaćanja u Vortexu.</translation>
<translation id="6540186279384079894">Otvaranje nove kartice u Vortexu</translation>
<translation id="6563921047760808519">Saznajte više o tome <ph name="BEGIN_LINK" />kako Vortex štiti privatnost vaših podataka<ph name="END_LINK" /></translation>
<translation id="6564769014061914792">Dodirnite ovdje da iskoristite sve prednosti Vortexa na iPadu.</translation>
<translation id="6566303693324540692">Savjet za Vortex: premjestite Vortex na početni ekran</translation>
<translation id="6574750762636192517">Upravljanje lozinkama u Vortexu</translation>
<translation id="6590232959690355435">Otvara stranicu historije Vortexa.</translation>
<translation id="6649269674808477353">Brže otvorite Vortex kada ste spremni da pregledate na iPhoneu.</translation>
<translation id="6674470628873622334">Otvara novu anonimnu karticu u Vortexu.</translation>
<translation id="6680609900732453726">Zadržite privatnost pregledanja pomoću autentifikacije uređaja prilikom zatvaranja Vortexa</translation>
<translation id="6752854822223394465">Vaša organizacija postavlja Vortex...</translation>
<translation id="6794054469102824109">Otvara igru Dinosaur u Vortexu.</translation>
<translation id="6820823224820483452">Vortex nije mogao provjeriti sve lozinke. Pokušajte ponovo sutra.</translation>
<translation id="6830782797004194206">Brže se prijavite putem automatskog popunjavanja u Vortexu</translation>
<translation id="6831043979455480757">Prevedi</translation>
<translation id="6852419005633611413">Brže pristupajte Vortexu s trake na početnom ekranu</translation>
<translation id="6852799557929001644">Pristupajte lozinkama u Vortexu i ostalom u drugim aplikacijama na ovom uređaju.</translation>
<translation id="6887138405044152640">Da pošaljete ovu karticu na drugi uređaj, na njemu se prijavite u Vortex.</translation>
<translation id="6911341667534646387">Nastavite koristiti podatke Vortexa na Google računu</translation>
<translation id="7018284295775193585">Nije moguće ažurirati Vortex</translation>
<translation id="7055269218854630176">Vaša organizacija, <ph name="DOMAIN" />, upravlja računom na koji se prijavljujete i načinom na koji se Vortex može koristiti. Vaš administrator može postaviti ili ograničiti određene funkcije.</translation>
<translation id="7099326575020694068">Vortex ne može koristiti kameru u načinu rada podijeljenog prikaza</translation>
<translation id="7165402419892018581">Odaberite Vortex za automatsko popunjavanje</translation>
<translation id="7175400662502680481">Vaša lozinka je bila izložena prilikom narušavanja podataka. Upravitelj lozinki preporučuje da odmah promijenite lozinku.</translation>
<translation id="7185731475720473450">Načini plaćanja i adrese se neće šifrirati. Historija pregledanja iz Vortexa se neće sinhronizirati.

Vaše šifrirane podatke može čitati samo osoba koja ima vaš pristupni izraz. Pristupni izraz se ne šalje Googleu niti ga on pohranjuje. Ako zaboravite pristupni izraz ili želite promijeniti ovu postavku, <ph name="BEGIN_LINK" />izbrišite podatke Vortexa na računu<ph name="END_LINK" />.</translation>
<translation id="7192111075364461693">Obavještenja Vortexa su trenutno isključena u postavkama uređaja.</translation>
<translation id="7195217321165708458">Gemini u Vortexu</translation>
<translation id="7219205286115692265">Brže pristupajte Vortexu s donje trake na početnom ekranu iPada.</translation>
<translation id="7222001353246886083">Pretražite frazu ${searchPhrase} u Vortexu</translation>
<translation id="7228180817326917122">Savjet za Vortex: odaberite položaj trake za adresu</translation>
<translation id="725427773388857052">Vortex vam može pomoći da se zaštitite od narušavanja podataka, nesigurnih web lokacija i još mnogo toga.</translation>
<translation id="7269362888766543920">Neki programski dodaci uzrokuju pad aplikacije Vortex. Pokušajte ih deinstalirati.</translation>
<translation id="7285031092584344905">Pristupajte lozinkama u Vortexu i ostalom u drugim aplikacijama.</translation>
<translation id="7337881442233988129">Vortex</translation>
<translation id="7395825497086981028">Vaša lozinka će se sačuvati u Upravitelj lozinki za račun <ph name="EMAIL" />.</translation>
<translation id="7434848749522628428">Pristupni ključ će se sačuvati na Upravitelju lozinki za <ph name="USER_EMAIL" /></translation>
<translation id="7504829997542308412">Otvorite Vortex</translation>
<translation id="7531461704633548377">Iz Vortexa</translation>
<translation id="7554983317097061001">Savjet za Vortex: premjestite Vortex na donju traku</translation>
<translation id="7576863740961052505">Upravljanje postavkama Vortexa</translation>
<translation id="7674213385180944843">Otvorite Postavke &gt; Privatnost &gt; Kamera &gt; Vortex i uključite kameru.</translation>
<translation id="7685160423563372998">Kreirajte sliku putem Geminija u Vortexu</translation>
<translation id="7733418656985455268">Savjet za Vortex: pretražujte putem Objektiva</translation>
<translation id="7747820849741499258">Pretraži u Vortexu</translation>
<translation id="7753923083404296545">Otvoreno je u anonimnom načinu rada u Vortexu</translation>
<translation id="7762622637388462191">Zaključajte anonimne kartice kada napustite Vortex ili se prebacite u drugu aplikaciju.</translation>
<translation id="7763454117143368771">Koristite Vortex kao zadani preglednik da se zaštitite od opasnih web lokacija i da zaštitite lozinke</translation>
<translation id="7784950022329154821">Zaključaj anonimne kartice prilikom zatvaranja Vortexa</translation>
<translation id="78025249032851484">Vortex je zastario.</translation>
<translation id="7859018312476869945">Kad pišete u traci za adresu ili u okviru za pretraživanje, Vortex šalje ono što upišete zadanom pretraživaču radi dobijanja boljih prijedloga. Ovo je isključeno u anonimnom načinu rada.</translation>
<translation id="7890287942691234100">Počnite koristiti Vortex skener</translation>
<translation id="7905064834449738336">Kada koristite lozinku, Vortex vas upozorava ako je objavljena online. Prilikom toga, vaše lozinke i korisnička imena su šifrirani i niko, uključujući Google, ih ne može pročitati.</translation>
<translation id="7928628054454574139">Otvorite Vortex kad god dodirnete linkove u drugim aplikacijama</translation>
<translation id="7934404985878918282">Prikazivanje Liste za čitanje u Vortexu</translation>
<translation id="7935734571048689933">Vortexom se upravlja</translation>
<translation id="7951793218148208717">Otvara novu karticu u Vortexu.</translation>
<translation id="7957726318578167662">Lako koristite Vortex svaki put kada dodirnete linkove u porukama ili drugim aplikacijama.</translation>
<translation id="7980860476903281594">Vortex dijeli vašu lokaciju s web lokacijama koje vi odobrite.</translation>
<translation id="7994322153108931467">Da dobijate korisne savjete za Vortex, uključite obavještenja u postavkama iOS-a.</translation>
<translation id="7997159823054171568">Postavljanje Vortexa kao zadanog preglednika</translation>
<translation id="800380310260616129">Ovdje možete preuzeti Vortex.</translation>
<translation id="8013573822802650211">Da vidite kartice s bilo kojeg uređaja na kojem koristite Vortex, prijavite se na svim uređajima</translation>
<translation id="8014091604604659473">Odjavljeni ste iz Vortexa</translation>
<translation id="8104697640054703121">Dobijte Vortexovu najjaču zaštitu od opasnih web lokacija</translation>
<translation id="8119542592987737574">Brže pristupajte Vortexu s donje trake na početnom ekranu iPhonea.</translation>
<translation id="8164086860209325020">Idite u Postavke Vortexa</translation>
<translation id="8197822717502700527">Sada možete iskoristiti sve prednosti Vortexa na uređaju.</translation>
<translation id="8236210361418193126">Uvezite na Upravitelj lozinki</translation>
<translation id="8254729934443216898">Istražite nove funkcije koje će vam pomoći da iskoristite sve prednosti Vortexa.</translation>
<translation id="8293572045658095405">U anonimnom ste načinu rada u Vortexu</translation>
<translation id="830951810931292870">Otvara unesene URL-ove u Vortexu u anonimnom načinu rada.</translation>
