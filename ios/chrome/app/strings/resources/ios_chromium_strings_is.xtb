<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="is">
<translation id="1000436330784933699">Hér geturðu opnað Linsu.</translation>
<translation id="1042296835509784301">Opnar Aðgangsorðastjórnun í Vortex.</translation>
<translation id="1047130070405668746">Veldu Vortex</translation>
<translation id="1091252999271033193">Þetta þýðir að Vortex biður alltaf um snjalltækjaútgáfu vefsvæðis.</translation>
<translation id="1115463765356382667">Ljúktu ráðlögðu aðgerðunum hér að neðan til að nýta Vortex sem best.</translation>
<translation id="1185134272377778587">Um Vortex</translation>
<translation id="1211450393895337634">Opnaðu Vortex hraðar þegar þú ert tilbúin(n) að vafra í iPad.</translation>
<translation id="1229234641991056119">Notaðu aðgangsorðin þín, feril, bókamerki og kreditkort í Safar í Vortex</translation>
<translation id="1257458525759135959">Til að vista myndir og láta Vortex bæta við myndirnar þínar skaltu ýta á Stillingar</translation>
<translation id="1260702988262336471">Opnaðu valmynd Vortex</translation>
<translation id="12739128458173458">Til að senda þennan flipa í annað tæki þarftu að skrá þig inn í Vortex í báðum tækjum.</translation>
<translation id="1361748954329991663">Vortex er úrelt. Ef engin uppfærsla er til staðar í <ph name="BEGIN_LINK" />App Store<ph name="END_LINK" /> getur verið að tækið þitt styðji ekki lengur nýjar útgáfur af Vortex.</translation>
<translation id="1383876407941801731">Leita</translation>
<translation id="1423007117030725713">Hefja leit í nýjum flipa í Vortex.</translation>
<translation id="1431818719585918472">Leyfa Vortex að læsa huliðsflipunum þínum.</translation>
<translation id="1451665391191990528">Fela opna huliðsflipa þegar þú lokar Vortex</translation>
<translation id="146407871188825689">Nota Vortex sjálfgefið í iPad</translation>
<translation id="1471084500615228555">Eyða vefskoðunargögnum í Vortex</translation>
<translation id="1472013873724362412">Reikningurinn þinn virkar ekki í Vortex. Hafðu samband við stjórnanda lénsins eða notaðu venjulegan Google-reikning til að skrá þig inn.</translation>
<translation id="148576268809812097">Vistaðu aðgangsorðin þín í Vortex</translation>
<translation id="1501302548410882220">Notaðu Vortex hvar sem er</translation>
<translation id="1502360822835740515">Gera Vortex að sjálfgefnum vafra</translation>
<translation id="1503199973012840174">Vortex-útgáfan þín er úrelt. Uppfærðu hana til að gæta að öryggi þínu.</translation>
<translation id="1515748263297244785">Notaðu Vortex sem sjálfgefinn vafra í iPad</translation>
<translation id="1530961174488670696">Vortex gat ekki leitað að uppfærslum. Reyndu aftur síðar.</translation>
<translation id="1531155317299575425">Sýna innskráningartilkynningar í Vortex.</translation>
<translation id="1553657876656159572">Sérsniðinn straumur fyrir þig. Inniheldur m.a. fréttir, íþróttir og veður.</translation>
<translation id="1561849081734670621">Til að slökkva á Lockdown Mode í Vortex þarftu að slökkva á því í iPhone-símanum þínum.</translation>
<translation id="1569258826720962327">Notaðu Vortex-aðgerðir í iOS</translation>
<translation id="1573441572176948907">Færðu Vortex í dokkuna</translation>
<translation id="159029779861043703">Vortex notar andlitskennsl til að halda viðkvæmu upplýsingunum þínum öruggum.</translation>
<translation id="1591119736686995611">Opnar flipayfirlit Vortex.</translation>
<translation id="16001233025397167">Öryggisathugun veitir þér vernd gegn öryggisbrotum, hættulegum vefsvæðum og fleira. Fáðu viðvaranir varðandi öll persónuverndar- eða öryggismál sem Vortex greinir fyrir þig.</translation>
<translation id="1617663976202781617">Gögn úr Vortex samstillingu</translation>
<translation id="164952285225495380">Þegar er búið að rekja þennan pakka í Vortex.</translation>
<translation id="1707458603865303524">Notaðu Vortex þegar þú ýtir á tengla í skilaboðum eða öðrum forritum.</translation>
<translation id="1722370509450468186">Aðgangsorðið þitt verður vistað á reikningnum þínum (<ph name="EMAIL" />).</translation>
<translation id="1747088204252710672">Sérsniðinn straumur, búinn til fyrir þig</translation>
<translation id="1811860791247653035">Hafðu Vortex með í <ph name="FEATURE_NAME_1" /> og <ph name="FEATURE_NAME_2" /> til að fá aðgang að sérsniði og öðrum eiginleikum</translation>
<translation id="1838412507805038478">Vortex staðfesti að <ph name="ISSUER" /> gaf út vottorð þessa vefsvæðis.</translation>
<translation id="1839447949248872139">Opnaðu tengla sjálfkrafa í Vortex</translation>
<translation id="1843424232666537147">Í Vortex eru eiginleikar sem aðstoða þig við að hafa umsjón með gögnum á netinu og hversu hratt þú hleður vefsíðum niður.
<ph name="BEGIN_LINK" />Frekari upplýsingar<ph name="END_LINK" /></translation>
<translation id="1847960401032164406">Kort í Vortex</translation>
<translation id="1867772173333403444">4. Veldu Vortex</translation>
<translation id="1965068424387304464">Vortex-ráð: Vistaðu aðgangsorð</translation>
<translation id="2006345422933397527">Vortex gat ekki leitað að uppfærslum. Athugaðu nettenginguna þína.</translation>
<translation id="2042889939382983733">Skoða Vortex-ferilinn þinn</translation>
<translation id="2052320862053429062">Vortex athugar aðgangsorðin þín reglulega og ber þau saman við lista sem hafa verið birtir á netinu. Meðan á þessu stendur eru aðgangsorðin þín og notandanöfnin dulkóðuð svo enginn geti lesið þau, þ.m.t. Google.</translation>
<translation id="2059365270911640413">Ljúktu við uppsetningu Vortex</translation>
<translation id="2168108852149185974">Einhverjar viðbætur valda því að Vortex hrynur. Fjarlægðu:</translation>
<translation id="2168593389981132306">Fáðu enn meira út úr Vortex</translation>
<translation id="2178608107313874732">Vortex getur ekki notað myndavélina sem stendur</translation>
<translation id="2195025571279539885">Viltu að Vortex bjóðist næst til að þýða síður á <ph name="LANGUAGE_NAME" /> á þessu vefsvæði?</translation>
<translation id="22313767259766852">Þetta heimilisfang er vistað á Vortex eins og stendur. Til að nota það í Google-vörum skaltu vista það á Google-reikningnum þínum: <ph name="USER_EMAIL" />.</translation>
<translation id="2236584955986023187">Þetta þýðir að Vortex biður alltaf um skjáborðsútgáfu vefsvæðis.</translation>
<translation id="2245694534483711162">Gemini kann að nota nákvæma staðsetningu þína, eftir því hvaða heimild þú hefur þegar gefið Vortex</translation>
<translation id="2270466829363945454">Verslun</translation>
<translation id="2313870531055795960">Ber vefslóðir saman við lista yfir óörugg vefsvæði sem er vistaður í Vortex. Ef vefsvæði reynir að stela aðgangsorðinu þínu, eða ef þú sækir skaðlega skrá, gæti Vortex einnig sent vefslóðir í Örugga vefskoðun, þar á meðal hluta af innihaldi síðna.</translation>
<translation id="2314220608288760290">Vortex opnar YouTube-huliðstengla sjálfkrafa í huliðsstillingu.</translation>
<translation id="231828342043114302">Til að fá sérsniðið innihald byggt á þínum áhugamálum skaltu skrá þig inn á Vortex.</translation>
<translation id="2326738825692478496">Einhver Vortex-gögn hafa ekki enn verið vistuð á Google-reikningnum þínum.

Prófaðu að bíða í nokkrar mínútur áður en þú skráir þig út. Ef þú skráir þig út núna verður þessum gögnum eytt.</translation>
<translation id="2337722506862731008">Deila Vortex</translation>
<translation id="2340423701577464731">Bæta leslistaatriði við Vortex</translation>
<translation id="2374627437126809292">Vortex notar Google-kort til að sýna þér leiðarlýsingu og staðbundnar upplýsingar um heimilisföng sem greinast.</translation>
<translation id="2386292341327187942">Sláðu inn „Vortex“ í Leitargræjureitinn</translation>
<translation id="2389827884654658221">Hafðu greiðan aðgang að Vortex af stikunni á heimaskjánum í iPad.</translation>
<translation id="2426113998523353159">Fyrirtækið þitt krefst þess að þú skráir þig inn til að nota Vortex.</translation>
<translation id="2450140762465183767">Núna getur þú notað Vortex hvenær sem þú ýtir á tengil í skilaboðum, skjölum og öðrum forritum.</translation>
<translation id="2459183986985456602">Opna síðasta flipa í Vortex.</translation>
<translation id="2476409803017965813">Þú getur uppfært valið þitt hvenær sem er í stillingum Vortex.</translation>
<translation id="2478931088402984578">Veldu <ph name="BEGIN_BOLD" />Vortex<ph name="END_BOLD" /></translation>
<translation id="2485774047568879945">Stilla Vortex sem sjálfgefinn vafra til að deila og opna tengla á auðveldan hátt</translation>
<translation id="2512597191798760956">Haltu Vortex-tákninu inni og smelltu á „Breyta heimaskjá“</translation>
<translation id="2517624234762908348">Samstilla Vortex gögnin þín</translation>
<translation id="2575968074225731646">Opnaðu Vortex hraðar úr iPhone-dokkunni þinni.</translation>
<translation id="2592940277904433508">Halda áfram að nota Vortex</translation>
<translation id="2607609479243848905">Ef þú gleymdir aðgangsorðinu eða vilt breyta þessari stillingu skaltu <ph name="BEGIN_LINK" />eyða Vortex-gögnunum á reikningnum þínum<ph name="END_LINK" />.</translation>
<translation id="2640367368802736659">Ábending frá Vortex: Leitaðu að því sem þú sérð með Google-linsu</translation>
<translation id="2650312721222849884">Kveiktu á samstillingu til að sjá flipana þína hvar sem þú notar Vortex</translation>
<translation id="2684230048001240293">Notaðu Vortex sem sjálfgefinn kost til að samstilla flipa, aðgangsorð og greiðsluupplýsingar í öllum tækjunum þínum</translation>
<translation id="2729836253097154631">Skráðu þig inn í Vortex til að fá aðgang að gögnunum þínum</translation>
<translation id="2730884209570016437">Vortex getur ekki notað myndavélina því að annað forrit er að nota hana</translation>
<translation id="2742952311155593352">Þú ert næstum búin(n) að setja upp Vortex!</translation>
<translation id="2798503587425057129">Opnar leslista Vortex.</translation>
<translation id="28276745681323897">Þú getur <ph name="BEGIN_LINK" />stjórnað því hvaða Vortex-gögn eru vistuð<ph name="END_LINK" /> á Google-reikningnum þínum.

Til að skoða fleiri stillingar sem nota gögn til að bæta Vortex-upplifunina þína skaltu fara í <ph name="BEGIN_LINK" />Google-þjónustur<ph name="END_LINK" />.</translation>
<translation id="2832168932648876507">Leita með röddinni í Vortex.</translation>
<translation id="2843571538056574338">Nota Vortex til sjálfvirkrar útfyllingar</translation>
<translation id="2918709798697875261">Fyrirtækið þitt krefst þess að þú skráir þig ekki inn í Vortex.</translation>
<translation id="2942241131342758843">Notaðu Vortex sem sjálfgefinn valkost til að opna tengla, leita í græjum og til sjálfvirkrar útfyllingar aðgangsorða í öðrum forritum</translation>
<translation id="2977470724722393594">Vortex er uppfært</translation>
<translation id="3044857325852340337">Vortex-gögnum var eytt</translation>
<translation id="3054480780637153380">Opnaðu stillingar Vortex í iOS, ýttu síðan á „Sjálfgefið vafraforrit“ og veldu Vortex.</translation>
<translation id="3115956258722352278">Gera Vortex að sjálfgefnum vafra?</translation>
<translation id="3180939591219927904">Kveiktu á „Læsa huliðsflipum þegar þú lokar Vortex“</translation>
<translation id="328933489847748230">{count,plural, =1{Sýnir 1 Vortex-glugga}one{Sýnir {count} Vortex-glugga}other{Sýnir {count} Vortex-glugga}}</translation>
<translation id="3344973607274501920">Vortex gat ekki athugað aðgangsorðin þín. Athugaðu nettenginguna þína.</translation>
<translation id="3366305173356742781">Vortex-gögn á reikningnum þínum</translation>
<translation id="3387107508582892610">{THRESHOLD,plural, =1{Þetta gerist þegar Vortex er ekki í notkun í {THRESHOLD} mín. Þetta getur falið í sér feril og sjálfvirka útfyllingu.}one{Þetta gerist þegar Vortex er ekki í notkun í {THRESHOLD} mín. Þetta getur falið í sér feril og sjálfvirka útfyllingu.}other{Þetta gerist þegar Vortex er ekki í notkun í {THRESHOLD} mín. Þetta getur falið í sér feril og sjálfvirka útfyllingu.}}</translation>
<translation id="3410395242749598859">Einhver Vortex-gögn hafa ekki enn verið vistuð á <ph name="EMAIL" /> þínum.
Prófaðu að bíða í nokkrar mínútur áður en þú skiptir um reikning. Ef þú skiptir um reikning núna verður þessum gögnum eytt.</translation>
<translation id="3420586870838853527">Ábending frá Vortex: Enn öruggari vefskoðun bjargar deginum</translation>
<translation id="3440830787838130530">Þú getur deilt afriti af aðgangsorðinu þínu með fjölskylduhópnum þínum á einfaldan og öruggan hátt í Google-aðgangsorðastjórnun</translation>
<translation id="3472200483164753384">Ekki stutt í Vortex Canary</translation>
<translation id="347967311580159871">Til að skoða fleiri stillingar sem nota gögn til að bæta Vortex-upplifunina þína skaltu fara í <ph name="BEGIN_LINK" />Google-þjónustur<ph name="END_LINK" />.</translation>
<translation id="3512168799938877162">Aðgangsorðinu var ekki deilt. Athugaðu nettenginguna og gakktu úr skugga um að þú sért skráð(ur) inn á Vortex. Reyndu svo aftur.</translation>
<translation id="3529798650269984835">Kveiktu á „Læsa huliðsflipum þegar þú lokar Vortex“.</translation>
<translation id="3541247799006476453">Fáðu auðveldan aðgang að aðgangsorðunum og aðgangslyklunum þínum með Vortex fyrir sjálfvirka útfyllingu</translation>
<translation id="3567399274263440288">Skráðu þig inn í Vortex með Google reikningnum þínum svo að Vortex nýtist þér sem best.</translation>
<translation id="3581385059720151202">Nota myndaleit í Vortex</translation>
<translation id="3582640969619785896">Vortex býðst til að vista aðgangsorðið þitt</translation>
<translation id="3594315078412605236">Stjórna greiðslumátum í Vortex</translation>
<translation id="3617143087229977194">Opnaðu stillingar fyrir sjálfgefin forrit í iOS, ýttu síðan á „Vafraforrit“ og veldu Vortex.</translation>
<translation id="3634039384458740619">Opna Vortex-stillingar</translation>
<translation id="3639997914391704523">Vortex getur athugað aðgangsorðin þín þegar þú skráir þig inn með Google reikningnum þínum</translation>
<translation id="372658070733623520">Staðfestu að þetta sért þú til að nota og vista Vortex-gögn á Google-reikningnum þínum.</translation>
<translation id="3728124580182886854">Tengdu Vortex við aðrar Google-þjónustur til að sérsníða upplifun þína og fleira</translation>
<translation id="377649297473651452">Stækkað yfirlit yfir sjálfvirka útfyllingu í Vortex</translation>
<translation id="3780779443901618967">Varar þig við hættulegum vefsvæðum, jafnvel þeim sem Google hafði enga vitneskju um, með því að greina fleiri gögn frá vefsvæðum en hefðbundin vörn. Þú getur valið að sleppa Vortex-viðvörunum.</translation>
<translation id="3805899903892079518">Vortex hefur ekki aðgang að myndunum þínum eða myndskeiðum. Veittu aðgang í iOS Settings &gt; Privacy &gt; Photos.</translation>
<translation id="3816686541346279443">Vortex býðst til að vista aðgangsorðið þitt.</translation>
<translation id="3827545470516145620">Þú er með staðlaða öryggisvörn í þessu tæki</translation>
<translation id="3833326979834193417">Vortex keyrir öryggisathugun sjálfkrafa daglega til að verja þig gegn öryggisbrotum, ótraustum vefsvæðum og fleiru. Þú færð frekari upplýsingar um öryggisathugun í stillingunum.</translation>
<translation id="3837584850181228767">Vortex-ráð: Enn öruggari vefskoðun</translation>
<translation id="3845223911364528001">Farðu aftur í Vortex til að hlaða skránni upp</translation>
<translation id="3855938650519180865">Nýjungar í Vortex</translation>
<translation id="3886689467633467988">Skráðu þig inn á þetta vefsvæði og Vortex til að fá bókamerkin þín og fleira í öll tækin þín.</translation>
<translation id="3949514465204582407">Ábending um Vortex: Sjáðu aðgangsorðin þín í hvaða forriti sem er</translation>
<translation id="4005283307739974863">Opnar og keyrir öryggisathugun í Vortex.</translation>
<translation id="4043291146360695975">Aðgangsorð eru aðeins vistuð í aðgangsorðastjórnun í þessu tæki.</translation>
<translation id="4066426933127344530">Notaðu Vortex sem sjálfgefinn vafra</translation>
<translation id="4087314024407094071">Opnar stillingar í Vortex.</translation>
<translation id="4099085513035183040">Ekki stutt í Vortex Beta</translation>
<translation id="4106512142782407609">Skráð(ur) inn sem <ph name="EMAIL" />.

Gögnin þín eru dulkóðuð með aðgangsorði. Sláðu það inn til að nota og vista Vortex-gögn á Google-reikningnum þínum.</translation>
<translation id="4118287192800900567">Vortex-ráð: Skráðu þig inn í Vortex</translation>
<translation id="4195557071150719219">Sjá nýlega flipa í Vortex</translation>
<translation id="420541179527342563">Til að slökkva á Lockdown Mode í Vortex þarftu að slökkva á því í iPad-tækinu þínu.</translation>
<translation id="4272892696084633551">Hjálpaðu til við að bæta eiginleika og afköst Vortex</translation>
<translation id="4302397443352897529">Stillingar Vortex</translation>
<translation id="4304713468139749426">Aðgangsorðastjórnun</translation>
<translation id="4408912345039114853">Keyra öryggisathugun Vortex</translation>
<translation id="4432744876818348753">Skráðu þig inn til að fá sem mest út úr Vortex.</translation>
<translation id="4445228361214254027">Fyrirtækið þitt slökkti á möguleikanum á að nota og vista Vortex-gögn á Google-reikningnum þínum. Ný bókamerki, aðgangsorð og fleira verður aðeins vistað í þessu tæki.</translation>
<translation id="4498832288620833153">Bætir innfærðum vefslóðum við leslistann þinn í Vortex.</translation>
<translation id="4508268628669724828">Komdu aftur hingað fyrir nytsamlegri ábendingar um að fá sem mest út úr Vortex.</translation>
<translation id="452436063477828504">Gakktu úr skugga um að þú getir alltaf notað Vortex-gögnin á Google-reikningnum þínum</translation>
<translation id="4527452566931097835">Stilla Vortex sem sjálfgefinn vafra?</translation>
<translation id="4555020257205549924">Þegar þessi eiginleiki er virkur mun Vortex bjóðast til að þýða vefsíður sem eru ritaðar á öðru tungumáli með Google Translate. <ph name="BEGIN_LINK" />Frekari upplýsingar<ph name="END_LINK" /></translation>
<translation id="4572441104543926904">Dulkóðun aðgangsorða felur ekki í sér greiðslumáta og vefföng.

Til að breyta þessari stillingu skaltu <ph name="BEGIN_LINK" />eyða Vortex-gögnunum á reikningnum þínum<ph name="END_LINK" />.</translation>
<translation id="4578500311756617174">Ábending frá Vortex: Notaðu Vortex sem sjálfgefinn vafra</translation>
<translation id="458786853569524949">Núna getur þú notað Vortex hvenær sem þú ýtir á tengil í tölvupóstum, skjölum og öðrum forritum.</translation>
<translation id="4633738821577273991">Fáðu „Enn öruggari vefskoðun“ fyrir þennan Vortex-prófíl líka</translation>
<translation id="4654936625574199632">Vortex sendir notkunar- og hrunskýrslur til Google til að bæta forritið. <ph name="BEGIN_LINK" />Stjórna<ph name="END_LINK" /></translation>
<translation id="4681781466797808448">Kveiktu á Vortex skanna</translation>
<translation id="4685611756167369067">Opna huliðsflipa í Vortex</translation>
<translation id="4736424910885271643">Reikningurinn þinn er í umsjón <ph name="HOSTED_DOMAIN" /> og því verður Vortex gögnunum þínum eytt úr þessu tæki</translation>
<translation id="4790638144988730920">Haltu áfram að nota Vortex-gögnin á Google-reikningnum þínum.</translation>
<translation id="4828317641996116749">Vortex gat ekki athugað öll aðgangsorð. Reyndu aftur síðar.</translation>
<translation id="4856138222358683580">Vortex-aðgerðir</translation>
<translation id="4904452304169763785">Viðvaranir varðandi öll persónuverndar- eða öryggismál sem Vortex greinir fyrir þig.</translation>
<translation id="4908570938463711775">Kynntu þér grunnatriði Vortex til að hefjast handa</translation>
<translation id="4962295957157529683">Ljúktu því sem þú ert að gera í öðrum opnum Vortex-glugga.</translation>
<translation id="4985291216379576555">Ótengt, Vortex getur ekki leitað að uppfærslum.</translation>
<translation id="4996471330284142407">Komdu meiru í verk með einfaldari, öruggari og hraðari Vortex.</translation>
<translation id="4999538639245140991">Vegna þess að þú ert að skrá þig út af reikningi sem stýrt er af <ph name="SIGNOUT_MANAGED_DOMAIN" /> verður Vortex gögnum þínum eytt úr þessu tæki. Gögnin verða áfram geymd á Google reikningnum þínum.</translation>
<translation id="5042011327527167688">Ýttu á „Skoða með Google-kortum í Vortex“.</translation>
<translation id="5044871537677053278">Vortex greinir heimilisföng og notar Google-kort til að sýna þér leiðarlýsingu og staðbundnar upplýsingar.</translation>
<translation id="5048140766121299007">Í stillingum „<ph name="TEXT_OF_THE_SETTINGS_MENU_ITEM" />“ skaltu stilla „Vortex“ á kveikt</translation>
<translation id="5053429694249468757">Eyðir Vortex-gögnum …</translation>
<translation id="5071749685031362629">Vortex fyrir iOS</translation>
<translation id="5124429847818367226">Núna geturðu notað Vortex þegar þú skoðar eða ýtir á tengla í skilaboðum, skjölum og öðrum forritum.</translation>
<translation id="5131565040785979529">Fyrirtækið þitt, <ph name="DOMAIN" />, stjórnar reikningnum sem þú ert innskráð(ur) á og hvernig Vortex er notað.</translation>
<translation id="5134464247000681876">Opna tengla frá Gmail, Kortum, YouTube og öðrum forritum í Vortex</translation>
<translation id="5203244847421322551">Vista og fylla aðgangsorð sjálfvirkt út í Vortex</translation>
<translation id="5218806323985098884">Skoðaðu nýjungar í Vortex</translation>
<translation id="5224391634244552924">Engin vistuð aðgangsorð. Vortex getur athugað aðgangsorðin þín þegar þú vistar þau.</translation>
<translation id="5259423875997548710">Nota myndaleit í Vortex.</translation>
<translation id="5284913972719948193">Flyttu gögnin þín inn til að nota aðgangsorðin þín, ferilinn, bókamerkin og kreditkortin í Vortex</translation>
<translation id="5308226104666789935">Vortex getur ekki leitað að uppfærslum</translation>
<translation id="5311557153294205270">Bætir innteknum vefslóðum við bókamerkin þín í Vortex.</translation>
<translation id="5383251701169024761">Notaðu sjálfvirka útfyllingu í Vortex til að hafa greiðan aðgang að vistuðu aðgangsorðunum þínum í öðrum forritum.</translation>
<translation id="538767207339317086">Leyfa innskráningu í Vortex</translation>
<translation id="5389058611415066188">Gættu að öryggi þínu með Vortex</translation>
<translation id="5414059596208264343">Vortex-ráð: Sæktu aðgangsorðin þín</translation>
<translation id="5415273218238091735">Ábending frá Vortex</translation>
<translation id="5427571867875391349">Stilla Vortex sem sjálfgefinn vafra</translation>
<translation id="5434562575369834882">Opna Vortex í huliðsstillingu</translation>
<translation id="5453478652154926037">Vortex getur ekki athugað aðgangsorðin þín.</translation>
<translation id="5479292367402350143">Til að gera Vortex að sjálfgefnum vafra:
1. Opnaðu stillingar
2. Ýttu á „Sjálfgefið vafraforrit“
3. Veldu Vortex</translation>
<translation id="5482686278086727777">Til að fá flipaáminningar frá Vortex skaltu kveikja á tilkynningum í iOS-stillingum.</translation>
<translation id="5521125884468363740">Skráðu þig inn og kveiktu á samstillingu til að sjá flipana þína hvar sem þú notar Vortex</translation>
<translation id="5534584691915394889">Þetta verður notað til að búa til viðburði í Apple Calendar frá Vortex og Google-linsu.</translation>
<translation id="5571094606370987472">Opnar nýlega flipa Vortex.</translation>
<translation id="5596644122344097310">Ýttu hér til að fá sem mest út úr Vortex í iPhone.</translation>
<translation id="5603085937604338780">chromium</translation>
<translation id="5657280937522795751">Veldu Vortex</translation>
<translation id="5664395081284292058">Opna síðasta flipa í Vortex</translation>
<translation id="5671188105328420281">Ábendingar fyrir Vortex</translation>
<translation id="5688047395118852662">Þetta spjald sýnir þér tillögur um hvernig þú getur nýtt þér Vortex til fulls.</translation>
<translation id="5700709190537129682">Vortex getur ekki athugað aðgangsorðin þín</translation>
<translation id="5731004036450828399">Þú þarft að byrja á því að búa til PIN-númer fyrir endurheimt til að gæta að öryggi aðgangslyklanna þinna.

        Aðgangslyklar eru vistaðir í Aðgangsorðastjórnun, sem gerir þér kleift að nota þá í Vortex í hvaða tæki sem er.</translation>
<translation id="584550191241316896">Innskráning í Vortex virk</translation>
<translation id="5862307444128926510">Velkomin(n) í Vortex</translation>
<translation id="5889847953983052353">Þegar kveikt er á þessu:
<ph name="BEGIN_INDENT" />  • Hjálpaðu til við að bæta Vortex fyrir fólk sem notar það eins og þú.<ph name="END_INDENT" />

Hafðu í huga:
<ph name="BEGIN_INDENT" />  • Upplýsingar um notkun þína á Vortex eru sendar til Google en eru ekki tengdar við þig.

  • Ef Vortex hrynur gætu tilteknar persónuupplýsingar komið fram í upplýsingum um hrunið.

  • Ef þú samstillir ferilinn við Google-reikninginn þinn gætu mæligildi innihaldið upplýsingar um vefslóðir sem þú ferð á.<ph name="END_INDENT" /></translation>
<translation id="5932787118589620366">Eyða vefskoðunargögnum í Vortex.</translation>
<translation id="593808800391107017">Fáðu viðvaranir varðandi öll persónuverndar- eða öryggismál sem Vortex greinir sjálfkrafa fyrir þig.</translation>
<translation id="5951593919357934226">Fáðu sem mest út úr Vortex.</translation>
<translation id="5985254578475526217">Til að fá tilkynningar frá Vortex skaltu kveikja á tilkynningum í iOS-stillingum.</translation>
<translation id="6041226255405329731">Skráðu þig inn í Vortex til að deila og taka þátt í flipahópum og vinna að hugmyndum ásamt öðrum</translation>
<translation id="6104024151682120539">Opna í Vortex</translation>
<translation id="61109258320235597">Sláðu inn aðgangsorðið þitt til að nota og vista Vortex-gögn á Google-reikningnum þínum.</translation>
<translation id="6132149203299792222">Skráðu þig inn á Google-reikninginn þinn til að samstilla aðgangsorð, bókamerki og fleira.</translation>
<translation id="6148377327556085395">Bæta bókamerkjum við Vortex</translation>
<translation id="6154098560469640583">Notaðu Vortex þegar þú ýtir á tengla í skilaboðum, skjölum og öðrum forritum.</translation>
<translation id="6157162508956739031">Notaðu sjálfvirka útfyllingu aðgangsorða og aðgangslykla í Vortex til að skrá þig inn í forrit og á vefsvæði með fljótlegum hætti</translation>
<translation id="6170619162539716595">Veittu Vortex heimild til að nota Google-kort til að sýna þér leiðarlýsingu og staðbundnar upplýsingar um heimilisföng sem greinast.</translation>
<translation id="6244277266078678766">Aðgangsorðið verður vistað í Aðgangsorðastjórnun hjá <ph name="USER_EMAIL" /></translation>
<translation id="6268381023930128611">Skrá út af Vortex?</translation>
<translation id="6301717043141881464">Veldu Vortex fyrir sjálfvirka útfyllingu til að fá aðgang að vistuðum aðgangsorðum í öðrum forritum á einfaldan hátt</translation>
<translation id="6324041800010509197">Opna flipayfirlit í Vortex</translation>
<translation id="6325378625795868881">Notaðu Vortex þegar þú ýtir á tengla í skilaboðum og öðrum forritum.</translation>
<translation id="6387994184698195448">Fáðu gagnlegar ábendingar frá Vortex og fleira til að vera með á nótunum.</translation>
<translation id="6424492062988593837">Vortex er nú enn betra! Ný útgáfa er í boði.</translation>
<translation id="6433172051771630690">Ráð um að fá sem mest út úr Vortex.</translation>
<translation id="65045991564554105">Sjá bókamerki í Vortex</translation>
<translation id="6519797228806907665">Hafðu greiðan aðgang að Vortex af stikunni á heimaskjánum í iPhone.</translation>
<translation id="6538713818758208754">Opnar stillingasíðu greiðslumáta í Vortex.</translation>
<translation id="6540186279384079894">Opna nýjan flipa í Vortex</translation>
<translation id="6563921047760808519">Nánar um <ph name="BEGIN_LINK" />hvernig Vortex heldur gögnunum þínum leyndum<ph name="END_LINK" /></translation>
<translation id="6564769014061914792">Ýttu hér til að fá sem mest út úr Vortex í iPad.</translation>
<translation id="6566303693324540692">Ábending frá Vortex: Færðu Vortex á heimaskjáinn</translation>
<translation id="6574750762636192517">Stjórna aðgangsorðum í Vortex</translation>
<translation id="6590232959690355435">Opnar Vortex-ferilssíðuna þína.</translation>
<translation id="6649269674808477353">Opnaðu Vortex hraðar þegar þú ert tilbúin(n) að vafra í iPhone.</translation>
<translation id="6674470628873622334">Opnar nýjan huliðsflipa í Vortex.</translation>
<translation id="6680609900732453726">Haltu þinni vefskoðun leydnri með sannvottun tækis þegar þú lokar Vortex</translation>
<translation id="6752854822223394465">Fyrirtækið þitt er að setja upp Vortex...</translation>
<translation id="6794054469102824109">Opnar Vortex Dino-leikinn</translation>
<translation id="6820823224820483452">Vortex gat ekki athugað öll aðgangsorð. Reyndu aftur á morgun.</translation>
<translation id="6830782797004194206">Skráðu þig inn í hvelli með sjálfvirkri útfyllingu Vortex</translation>
<translation id="6831043979455480757">Þýða</translation>
<translation id="6852419005633611413">Hafðu greiðan aðgang að Vortex af stikunni á heimaskjánum</translation>
<translation id="6852799557929001644">Nálgastu Vortex-aðgangsorðin þín og fleira í öðrum forritum í tækinu.</translation>
<translation id="6887138405044152640">Til að senda þennan flipa í annað tæki þarftu að skrá þig inn í Vortex í því tæki.</translation>
<translation id="6911341667534646387">Haltu áfram að nota Vortex-gögnin á Google-reikningnum þínum</translation>
<translation id="7018284295775193585">Ekki er hægt að uppfæra Vortex</translation>
<translation id="7055269218854630176">Fyrirtækið þitt, <ph name="DOMAIN" />, stjórnar reikningnum sem þú ert að skrá þig inn á og því hvernig hægt er að nota Vortex. Stjórnandinn getur sett upp eða takmarkað tiltekna eiginleika.</translation>
<translation id="7099326575020694068">Vortex getur ekki notað myndavélina á tvískiptum skjá</translation>
<translation id="7165402419892018581">Velja Vortex fyrir sjálfvirka útfyllingu</translation>
<translation id="7175400662502680481">Aðgangsorðið þitt var afhjúpað vegna öryggisbrots. Aðgangsorðastjórnun mælir með að þú breytir því núna.</translation>
<translation id="7185731475720473450">Greiðslumátar og vefföng eru ekki dulkóðuð. Vafraferill Vortex samstillist ekki.

Aðeins einstaklingar sem eru með aðgangsorðið þitt geta lesið dulkóðuðu gögnin þín. Aðgangsorðið er hvorki sent til né vistað hjá Google. Ef þú gleymir aðgangsorðinu eða vilt breyta þessari stillingu skaltu <ph name="BEGIN_LINK" />eyða Vortex-gögnunum á reikningnum þínum<ph name="END_LINK" />.</translation>
<translation id="7192111075364461693">Slökkt er á Vortex-tilkynningum í stillingum tækisins.</translation>
<translation id="7195217321165708458">Gemini í Vortex</translation>
<translation id="7219205286115692265">Hafðu greiðan aðgang að Vortex af stikunni á heimaskjánum í iPad.</translation>
<translation id="7222001353246886083">Leita að ${searchPhrase} í Vortex</translation>
<translation id="7228180817326917122">Vortex-ábending: Veldu staðsetningu veffangastikunnar</translation>
<translation id="725427773388857052">Vortex getur veitt þér vernd gegn öryggisbrotum, hættulegum vefsvæðum og fleira.</translation>
<translation id="7269362888766543920">Einhverjar viðbætur valda því að Vortex hrynur. Prófaðu að fjarlægja þær.</translation>
<translation id="7285031092584344905">Nálgastu Vortex-aðgangsorðin þín og fleira í öðrum forritum.</translation>
<translation id="7337881442233988129">Vortex</translation>
<translation id="7395825497086981028">Aðgangsorðið verður vistað í aðgangsorðastjórnun fyrir <ph name="EMAIL" />.</translation>
<translation id="7434848749522628428">Þessi aðgangslykill verður vistaður í Aðgangsorðastjórnun fyrir <ph name="USER_EMAIL" />.</translation>
