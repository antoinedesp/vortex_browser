<translationbundle lang="sk">
<translation id="1000436330784933699">Tu môžete otvoriť Lens.</translation>
<translation id="1042296835509784301">Otvorí Správcu hesiel v prehliadači Vortex.</translation>
<translation id="1047130070405668746">Vyberte Vortex</translation>
<translation id="1091252999271033193">Znamená to, že Vortex bude zakaždým žiadať o mobilný web.</translation>
<translation id="1115463765356382667">Vykonajte tieto navrhované akcie nižšie, ktoré vám umožnia využívať Vortex naplno.</translation>
<translation id="1185134272377778587">Informácie o prehliadači Vortex</translation>
<translation id="1211450393895337634">Keď budete chcieť prehliadať v iPade, otvárajte Vortex rýchlejšie.</translation>
<translation id="1229234641991056119">Používajte heslá, históriu, záložky a kreditné karty z prehliadača Safari v prehliadači Vortex</translation>
<translation id="1257458525759135959">Ak chcete ukladať obrázky, klepnutím na Nastavenia povoľte prehliadaču Vortex pridávať do vašich fotiek</translation>
<translation id="1260702988262336471">Otvorte Ponuku prehliadača Vortex</translation>
<translation id="12739128458173458">Ak chcete túto kartu odoslať do iného zariadenia, prihláste sa v oboch zariadeniach do prehliadača Vortex.</translation>
<translation id="1361748954329991663">Prehliadač Vortex je zastaraný. Ak v <ph name="BEGIN_LINK" />obchode s aplikáciami<ph name="END_LINK" /> nie je dostupná aktualizácia, je možné, že vaše zariadenie už nepodporuje nové verzie prehliadača Vortex.</translation>
<translation id="1383876407941801731">Vyhľadávanie</translation>
<translation id="1423007117030725713">Začnite vyhľadávanie na novej karte prehliadača Vortex.</translation>
<translation id="1431818719585918472">Umožnite prehliadaču Vortex uzamknúť vaše karty inkognito.</translation>
<translation id="1451665391191990528">Skrývajte otvorené karty inkognito pri zatváraní prehliadača Vortex</translation>
<translation id="146407871188825689">Používajte Vortex v iPade predvolene</translation>
<translation id="1471084500615228555">Odstrániť dáta prehliadania v prehliadači Vortex</translation>
<translation id="1472013873724362412">Váš účet nefunguje v prehliadači Vortex. Kontaktujte správcu domény alebo sa prihláste pomocou bežného účtu Google.</translation>
<translation id="148576268809812097">Ukladajte si heslá v prehliadači Vortex</translation>
<translation id="1501302548410882220">Používajte Vortex kdekoľvek</translation>
<translation id="1502360822835740515">Nastavenie prehliadača Vortex ako predvoleného prehliadača</translation>
<translation id="1503199973012840174">Váš prehliadač Vortex je zastaraný. V záujme svojho bezpečia ho aktualizujte.</translation>
<translation id="1515748263297244785">Používajte Vortex pre iPad predvolene</translation>
<translation id="1530961174488670696">Prehliadaču Vortex sa nepodarilo skontrolovať dostupnosť aktualizácií. Skúste to neskôr.</translation>
<translation id="1531155317299575425">Zobrazí výzvy na prihlásenie do prehliadača Vortex.</translation>
<translation id="1553657876656159572">Vlastný feed vytvorený pre vás. Vrátane správ, športu a počasia.</translation>
<translation id="1561849081734670621">Ak chcete deaktivovať režim silnej zámky v prehliadači Vortex, vypnite ho vo svojom iPhone.</translation>
<translation id="1569258826720962327">Používajte akcie prehliadača Vortex v systéme iOS</translation>
<translation id="1573441572176948907">Presuňte Vortex do ponuky aplikácií</translation>
<translation id="159029779861043703">Vortex chráni vaše citlivé údaje pomocou funkcie Face ID.</translation>
<translation id="1591119736686995611">Otvorí mriežku kariet v prehliadači Vortex.</translation>
<translation id="16001233025397167">Kontrola bezpečnosti vás chráni pred porušeniami ochrany údajov, nebezpečnými webmi a ďalšími hrozbami. Dostávajte upozornenia na všetky problémy s ochranou súkromia alebo zabezpečením, ktoré pre vás Vortex zistí.</translation>
<translation id="1617663976202781617">Údaje zo synchronizácie prehliadača Vortex</translation>
<translation id="164952285225495380">Táto zásielka už bola v prehliadači Vortex sledovaná.</translation>
<translation id="1707458603865303524">Vortex môžete kedykoľvek použiť klepnutím na odkazy v správach a ďalších aplikáciách.</translation>
<translation id="1722370509450468186">Heslo bude uložené do vášho účtu (<ph name="EMAIL" />).</translation>
<translation id="1747088204252710672">Prispôsobený feed vytvorený pre vás</translation>
<translation id="1811860791247653035">Ak chcete mať k dispozícii prispôsobenie a ďalšie funkcie, zahrňte Vortex do funkcií <ph name="FEATURE_NAME_1" /> a <ph name="FEATURE_NAME_2" /></translation>
<translation id="1838412507805038478">Prehliadač Vortex overil, že certifikát tohto webu bol vydaný vydavateľom <ph name="ISSUER" />.</translation>
<translation id="1839447949248872139">Otvárajte odkazy predvolene v prehliadači Vortex</translation>
<translation id="1843424232666537147">Prehliadač Vortex obsahuje funkcie, ktoré vám pomôžu spravovať internetové dáta a rýchlosť načítania webových stránok.
<ph name="BEGIN_LINK" />Ďalšie informácie<ph name="END_LINK" /></translation>
<translation id="1847960401032164406">Mapy v prehliadači Vortex</translation>
<translation id="1867772173333403444">4. Vyberte Vortex</translation>
<translation id="1965068424387304464">Tip pre Vortex: Ukladanie hesiel</translation>
<translation id="2006345422933397527">Prehliadaču Vortex sa nepodarilo skontrolovať dostupnosť aktualizácií. Skontrolujte internetové pripojenie.</translation>
<translation id="2042889939382983733">Zobraziť históriu prehliadača Vortex</translation>
<translation id="2052320862053429062">Vortex pravidelne kontroluje heslá podľa zoznamov, ktoré boli zverejnené na internete. Vaše heslá a používateľské mená sú pritom šifrované, aby ich nikto nemohol prečítať (ani Google).</translation>
<translation id="2059365270911640413">Dokončite nastavovanie prehliadača Vortex</translation>
<translation id="2168108852149185974">Niektoré doplnky spôsobujú zlyhanie prehliadača Vortex. Odinštalujte ich.</translation>
<translation id="2168593389981132306">Zlepšujte Vortex</translation>
<translation id="2178608107313874732">Vortex momentálne nemôže použiť váš fotoaparát</translation>
<translation id="2195025571279539885">Chcete, aby prehliadač Vortex nabudúce ponúkol možnosť prekladu stránok v jazyku <ph name="LANGUAGE_NAME" />?</translation>
<translation id="22313767259766852">Táto adresa je momentálne uložená v prehliadači Vortex. Ak ju chcete používať v službách Googlu, uložte si ju do účtu Google <ph name="USER_EMAIL" />.</translation>
<translation id="2236584955986023187">Znamená to, že Vortex bude zakaždým žiadať o verziu webu pre počítače.</translation>
<translation id="2245694534483711162">Gemini môže používať vašu presnú polohu v závislosti od povolenia, ktoré ste už udelili prehliadaču Vortex</translation>
<translation id="2270466829363945454">Nákupy</translation>
<translation id="2313870531055795960">Kontroluje webové adresy podľa zoznamu nebezpečných webov uloženého v prehliadači Vortex. Ak sa vám určitý web pokúsi ukradnúť heslo alebo stiahnete škodlivý súbor, Vortex môže tiež odoslať webové adresy vrátane častí obsahu stránky Bezpečnému prehliadaniu.</translation>
<translation id="2314220608288760290">Vortex automaticky otvára odkazy na YouTube v režime inkognito.</translation>
<translation id="231828342043114302">Ak chcete dostávať prispôsobený obsah na základe záujmov, prihláste sa do prehliadača Vortex.</translation>
<translation id="2326738825692478496">Niektoré údaje prehliadača Vortex zatiaľ neboli vo vašom účte Google uložené.

Pred odhlásením skúste počkať niekoľko minút. Ak sa odhlásite teraz, tieto údaje budú odstránené.</translation>
<translation id="2337722506862731008">Zdieľať Vortex</translation>
<translation id="2340423701577464731">Pridanie položky čitateľského zoznamu do prehliadača Vortex</translation>
<translation id="2374627437126809292">Vortex vám pomocou Máp Google poskytuje trasy a miestne informácie o rozpoznaných adresách.</translation>
<translation id="2386292341327187942">Do poľa miniaplikácie Vyhľadávanie zadajte Vortex</translation>
<translation id="2389827884654658221">Získavajte prístup k prehliadaču Vortex rýchlejšie z plochy iPadu.</translation>
<translation id="2426113998523353159">Vaša organizácia vyžaduje, aby ste sa na používanie prehliadača Vortex prihlásili.</translation>
<translation id="2450140762465183767">Vortex môžete teraz kedykoľvek použiť klepnutím na odkazy v správach, dokumentoch a ďalších aplikáciách.</translation>
<translation id="2459183986985456602">Otvorenie najnovšej karty v prehliadači Vortex</translation>
<translation id="2476409803017965813">Svoje voľby môžete kedykoľvek aktualizovať v nastaveniach prehliadača Vortex.</translation>
<translation id="2478931088402984578">Vyberte <ph name="BEGIN_BOLD" />Vortex<ph name="END_BOLD" /></translation>
<translation id="2485774047568879945">Nastavte si Vortex ako predvolený prehliadač, aby ste mohli jednoducho zdieľať a otvárať odkazy</translation>
<translation id="2512597191798760956">Pridržte ikonu prehliadača Vortex a kliknite na Úprava plochy</translation>
<translation id="2517624234762908348">Synchronizovať údaje prehliadača Vortex</translation>
<translation id="2575968074225731646">Získavajte prístup k prehliadaču Vortex rýchlejšie z ponuky aplikácií iPhonu.</translation>
<translation id="2592940277904433508">Pokračovať v používaní prehliadača Vortex</translation>
<translation id="2607609479243848905">Ak ste zabudli prístupovú frázu alebo chcete toto nastavenie zmeniť, <ph name="BEGIN_LINK" />odstráňte údaje prehliadača Vortex vo svojom účte<ph name="END_LINK" />.</translation>
<translation id="2640367368802736659">Tip pre Vortex: vyhľadávajte, čo vidíte, pomocou funkcie Google Lens</translation>
<translation id="2650312721222849884">Ak chcete vidieť svoje karty vo všetkých zariadeniach, v ktorých používate Vortex, zapnite synchronizáciu</translation>
<translation id="2684230048001240293">Nastavte si Vortex ako predvolený prehliadač na synchronizovanie kariet, hesiel a platobných údajov vo všetkých zariadeniach</translation>
<translation id="2729836253097154631">Ak si chcete pozrieť, čo vás zaujíma, prihláste sa do prehliadača Vortex</translation>
<translation id="2730884209570016437">Vortex nemôže použiť váš fotoaparát, pretože ho práve používa iná aplikácia</translation>
<translation id="2742952311155593352">Nastavovanie prehliadača Vortex je takmer dokončené.</translation>
<translation id="2798503587425057129">Otvorí čitateľský zoznam v prehliadači Vortex.</translation>
<translation id="28276745681323897">Vo svojom účte Google môžete <ph name="BEGIN_LINK" />spravovať, ktoré údaje prehliadača Vortex sa majú ukladať<ph name="END_LINK" />.

Ďalšie nastavenia, ktoré zlepšujú prostredie prehliadača Vortex pomocou údajov, nájdete v <ph name="BEGIN_LINK" />službách Googlu<ph name="END_LINK" />.</translation>
<translation id="2832168932648876507">Vyhľadávanie hlasom v prehliadači Vortex.</translation>
<translation id="2843571538056574338">Automaticky dopĺňajte pomocou prehliadača Vortex</translation>
<translation id="2918709798697875261">Vaša organizácia vyžaduje, aby ste sa do prehliadača Vortex neprihlasovali.</translation>
<translation id="2942241131342758843">Predvolene otvárajte odkazy, vyhľadávajte v miniaplikáciách a automaticky dopĺňajte heslá v iných aplikáciách pomocou prehliadača Vortex</translation>
<translation id="2977470724722393594">Prehliadač Vortex bol aktualizovaný</translation>
<translation id="3044857325852340337">Dáta prehliadača Vortex boli odstránené</translation>
<translation id="3054480780637153380">V zariadení iOS otvorte nastavenia prehliadača Vortex, klepnite na Predvolený prehliadač a vyberte Vortex.</translation>
<translation id="3115956258722352278">Chcete nastaviť Vortex ako predvolený prehliadač?</translation>
<translation id="3180939591219927904">Pri zatváraní prehliadača Vortex vyberte Uzamknúť karty inkognito</translation>
<translation id="328933489847748230">{count,plural, =1{Práve sa zobrazuje 1 okno prehliadača Vortex}few{Práve sa zobrazujú {count} okná prehliadača Vortex}many{Now showing {count} Vortex windows}other{Práve sa zobrazuje {count} okien prehliadača Vortex}}</translation>
<translation id="3344973607274501920">Prehliadaču Vortex sa nepodarilo skontrolovať heslá. Skontrolujte internetové pripojenie.</translation>
<translation id="3366305173356742781">Údaje prehliadača Vortex vo vašom účte</translation>
<translation id="3387107508582892610">{THRESHOLD,plural, =1{Dochádza k tomu, keď Vortex nepoužívate {THRESHOLD} minútu. Môže to zahŕňať históriu a automatické dopĺňanie.}few{Dochádza k tomu, keď Vortex nepoužívate {THRESHOLD} minúty. Môže to zahŕňať históriu a automatické dopĺňanie.}many{Dochádza k tomu, keď Vortex nepoužívate {THRESHOLD} minúty. Môže to zahŕňať históriu a automatické dopĺňanie.}other{Dochádza k tomu, keď Vortex nepoužívate {THRESHOLD} minút. Môže to zahŕňať históriu a automatické dopĺňanie.}}</translation>
<translation id="3410395242749598859">Niektoré údaje prehliadača Vortex ešte neboli v účte <ph name="EMAIL" /> uložené.
Pred prepnutím účtov skúste počkať niekoľko minút. Ak ich prepnete teraz, tieto údaje budú odstránené.</translation>
<translation id="3420586870838853527">Tip pre Vortex: Zlepšené bezpečné prehliadanie zaistí vašu bezpečnosť</translation>
<translation id="3440830787838130530">Jednoducho a zabezpečene zdieľajte kópiu hesla so svojou rodinnou skupinou v Správcovi hesiel Google</translation>
<translation id="3472200483164753384">Nepodporované vo verzii Vortex Canary</translation>
<translation id="347967311580159871">Ďalšie nastavenia, ktoré zlepšujú prostredie prehliadača Vortex pomocou údajov, nájdete v <ph name="BEGIN_LINK" />službách Googlu<ph name="END_LINK" />.</translation>
<translation id="3512168799938877162">Vaše heslo nebolo zdieľané. Skontrolujte internetové pripojenie a uistite sa, že ste sa prihlásili do prehliadača Vortex. Potom to skúste znova.</translation>
<translation id="3529798650269984835">Zapnite Uzamknúť karty inkognito pri zavretí prehliadača Vortex.</translation>
<translation id="3541247799006476453">Získajte jednoduchý prístup k svojim heslám a prístupovým kľúčom pomocou automatického dopĺňania v prehliadači Vortex</translation>
<translation id="3567399274263440288">Ak chcete využívať Vortex naplno, prihláste sa doň svojím účtom Google.</translation>
<translation id="3581385059720151202">Vyhľadanie vizuálnych prvkov v prehliadači Vortex</translation>
<translation id="3582640969619785896">Vortex vám ponúkne uloženie hesla</translation>
<translation id="3594315078412605236">Správa spôsobov platby v prehliadači Vortex</translation>
<translation id="3617143087229977194">V zariadení so systémom iOS otvorte nastavenia predvolených aplikácií, klepnite na položku Aplikácia prehliadača a vyberte Vortex.</translation>
<translation id="3634039384458740619">Otvoriť Nastavenia prehliadača Vortex</translation>
<translation id="3639997914391704523">Keď sa prihlásite účtom Google, Vortex môže skontrolovať vaše heslá.</translation>
<translation id="372658070733623520">Ak chcete vo svojom účte Google používať a ukladať údaje prehliadača Vortex, overte svoju totožnosť.</translation>
<translation id="3728124580182886854">Prepojte Vortex a ďalšie služby Googlu na prispôsobenie a ďalšie účely</translation>
<translation id="377649297473651452">Rozbalené zobrazenie automatického dopĺňania v prehliadači Vortex</translation>
<translation id="3780779443901618967">Analyzuje viac údajov z webov než štandardná ochrana a upozorňuje vás na nebezpečné weby, dokonca aj také, o ktorých Google predtým nevedel. Upozornenia z prehliadača Vortex môžete preskočiť.</translation>
<translation id="3805899903892079518">Vortex nemá prístup k vašim fotkám ani videám. Prístup povoľte v časti Nastavenia systému iOS &gt; Súkromie &gt; Fotky.</translation>
<translation id="3816686541346279443">Vortex vám ponúkne uloženie hesla.</translation>
<translation id="3827545470516145620">V tomto zariadení máte štandardnú bezpečnostnú ochranu</translation>
<translation id="3833326979834193417">Prehliadač Vortex každý deň automaticky spúšťa kontrolu bezpečnosti, aby vás chránil pred porušeniami ochrany údajov, nebezpečnými webmi a ďalšími hrozbami. Viac o kontrole bezpečnosti sa dozviete v Nastaveniach.</translation>
<translation id="3837584850181228767">Tip pre Vortex: Zlepšené bezpečné prehliadanie</translation>
<translation id="3845223911364528001">Ak chcete nahrať súbor, vráťte sa do prehliadača Vortex</translation>
<translation id="3855938650519180865">Novinky v prehliadači Vortex</translation>
<translation id="3886689467633467988">Prihláste sa na tomto webe a v prehliadači Vortex, aby ste mali svoje záložky a ďalšie položky vo všetkých svojich zariadeniach.</translation>
<translation id="3949514465204582407">Tip pre Vortex: Získajte svoje heslá v ľubovoľnej aplikácii</translation>
<translation id="4005283307739974863">Otvorí a spustí kontrolu bezpečnosti v prehliadači Vortex.</translation>
<translation id="4043291146360695975">Heslá sa ukladajú do správcu hesiel iba v tomto zariadení.</translation>
<translation id="4066426933127344530">Predvolene používajte Vortex</translation>
<translation id="4087314024407094071">Otvorí Nastavenia v prehliadači Vortex.</translation>
<translation id="4099085513035183040">Nepodporované vo verzii Vortex Beta</translation>
<translation id="4106512142782407609">Prihlásili ste sa ako <ph name="EMAIL" />.

Údaje sú šifrované pomocou vašej prístupovej frázy. Zadajte ju, keď chcete používať a ukladať údaje prehliadača Vortex vo svojom účte Google.</translation>
<translation id="4118287192800900567">Tip pre Vortex: prihláste sa do prehliadača Vortex</translation>
<translation id="4195557071150719219">Zobraziť nedávne karty v prehliadači Vortex</translation>
<translation id="420541179527342563">Ak chcete deaktivovať režim silnej zámky v prehliadači Vortex, vypnite ho vo svojom iPade.</translation>
<translation id="4272892696084633551">Pomôžte vylepšiť funkcie a výkon prehliadača Vortex</translation>
<translation id="4302397443352897529">Nastavenia prehliadača Vortex</translation>
<translation id="4304713468139749426">Správca hesiel</translation>
<translation id="4408912345039114853">Spustiť kontrolu bezpečnosti v prehliadači Vortex</translation>
<translation id="4432744876818348753">Prihláste sa, aby ste mohli Vortex využívať naplno.</translation>
<translation id="4445228361214254027">Vaša organizácia vypla možnosť používať a ukladať údaje prehliadača Vortex vo vašom účte Google. Nové záložky, heslá a ďalšie položky sa budú ukladať iba do tohto zariadenia.</translation>
<translation id="4498832288620833153">Pridá vložené webové adresy do vášho čitateľského zoznamu v prehliadači Vortex.</translation>
<translation id="4508268628669724828">Tu nájdete ďalšie užitočné tipy, ako využívať Vortex naplno.</translation>
<translation id="452436063477828504">Uistite sa, že vo svojom účte Google môžete kedykoľvek použiť údaje prehliadača Vortex</translation>
<translation id="4527452566931097835">Chcete nastaviť Vortex ako predvolený prehliadač?</translation>
<translation id="4555020257205549924">Po zapnutí tejto funkcie bude prehliadač Vortex ponúkať preloženie stránok napísaných v inom jazyku pomocou Prekladača Google. <ph name="BEGIN_LINK" />Ďalšie informácie<ph name="END_LINK" /></translation>
<translation id="4572441104543926904">Šifrovanie pomocou prístupovej frázy nezahŕňa spôsoby platby ani adresy.

Ak chcete toto nastavenie zmeniť, <ph name="BEGIN_LINK" />odstráňte údaje prehliadača Vortex vo svojom účte<ph name="END_LINK" />.</translation>
<translation id="4578500311756617174">Tip pre Vortex: používajte Vortex predvolene</translation>
<translation id="458786853569524949">Vortex môžete teraz kedykoľvek použiť klepnutím na odkazy v správach, dokumentoch a ďalších aplikáciách.</translation>
<translation id="4633738821577273991">Získajte aj Zlepšené bezpečné prehliadanie pre tento profil prehliadača Vortex</translation>
<translation id="4654936625574199632">Vortex odosiela údaje o používaní a pádoch Googlu, čím pomáha so svojím zlepšovaním. <ph name="BEGIN_LINK" />Spravovať<ph name="END_LINK" /></translation>
<translation id="4681781466797808448">Zapnutie skenera prehliadača Vortex</translation>
<translation id="4685611756167369067">Otvorenie karty inkognito v prehliadači Vortex</translation>
<translation id="4736424910885271643">Váš účet spravuje <ph name="HOSTED_DOMAIN" />, takže údaje prehliadača Vortex budú z tohto zariadenia vymazané</translation>
<translation id="4790638144988730920">Naďalej používajte údaje prehliadača Vortex vo svojom účte Google.</translation>
<translation id="4828317641996116749">Prehliadaču Vortex sa nepodarilo skontrolovať všetky heslá. Skúste to neskôr.</translation>
<translation id="4856138222358683580">Akcie v prehliadači Vortex</translation>
<translation id="4904452304169763785">Upozornenia na všetky problémy s ochranou súkromia alebo zabezpečením, ktoré pre vás Vortex zistí.</translation>
<translation id="4908570938463711775">Najprv sa oboznámte s užitočnými základmi prehliadača Vortex</translation>
<translation id="4962295957157529683">V ďalšom otvorenom okne prehliadača Vortex dokončite, čo ste robili.</translation>
<translation id="4985291216379576555">Offline, Vortex nemôže skontrolovať dostupnosť aktualizácií</translation>
<translation id="4996471330284142407">Zvýšte svoju výkonnosť pomocou jednoduchého a zabezpečeného prehliadača Vortex, ktorý je rýchlejší než kedykoľvek predtým.</translation>
<translation id="4999538639245140991">Odhlasujete sa z účtu spravovaného doménou <ph name="SIGNOUT_MANAGED_DOMAIN" />, takže údaje prehliadača Vortex budú z tohto zariadenia odstránené. Vaše údaje zostanú vo vašom účte Google.</translation>
<translation id="5042011327527167688">Klepnite na Zobraziť v Mapách Google v prehliadači Vortex.</translation>
<translation id="5044871537677053278">Vortex rozpoznáva adresy a pomocou Máp Google vám poskytuje trasy aj miestne informácie.</translation>
<translation id="5048140766121299007">V nastaveniach v sekcii <ph name="TEXT_OF_THE_SETTINGS_MENU_ITEM" /> zapnite Vortex</translation>
<translation id="5053429694249468757">Odstraňujú sa údaje prehliadača Vortex…</translation>
<translation id="5071749685031362629">Vortex pre iOS</translation>
<translation id="5124429847818367226">Vortex môžete teraz kedykoľvek použiť pri prehliadaní alebo klepnutí na odkazy v správach, dokumentoch a ďalších aplikáciách.</translation>
<translation id="5131565040785979529">Vaša organizácia <ph name="DOMAIN" /> spravuje účet, v ktorom máte aktívne prihlásenie, a spôsob používania prehliadača Vortex.</translation>
<translation id="5134464247000681876">Otvárajte odkazy z aplikácií Gmail, Mapy, YouTube a ďalších v prehliadači Vortex</translation>
<translation id="5203244847421322551">Ukladajte a automaticky dopĺňajte heslá v prehliadači Vortex</translation>
<translation id="5218806323985098884">Pozrite si, čo je nové v prehliadači Vortex</translation>
<translation id="5224391634244552924">Žiadne uložené heslá. Vortex môže skontrolovať heslá, keď ich uložíte.</translation>
<translation id="5259423875997548710">Vyhľadajte vizuálne prvky v prehliadači Vortex.</translation>
<translation id="5284913972719948193">Importujte svoje údaje, aby ste mohli používať heslá, históriu, záložky a kreditné karty v prehliadači Vortex</translation>
<translation id="5308226104666789935">Vortex nemôže skontrolovať dostupnosť aktualizácií</translation>
<translation id="5311557153294205270">Pridá vložené webové adresy do vašich záložiek v prehliadači Vortex.</translation>
