<!DOCTYPE translationbundle>
<translationbundle lang="am">
<translation id="1000436330784933699">ሌንስ እዚህ መክፈት ይችላሉ።</translation>
<translation id="1042296835509784301">በVortex ውስጥ የሚስጥር ቁልፍ አስተዳዳሪውን ይከፍታል።</translation>
<translation id="1047130070405668746">Vortexን ይምረጡ</translation>
<translation id="1091252999271033193">ይህ ማለት Vortex የተንቀሳቃሽ ስልክ ጣቢያውን በእያንዳንዱ ጊዜ ይጠይቃል ማለት ነው።</translation>
<translation id="1115463765356382667">ከVortex ላይ ምርጡን ለማግኘት ከታች ያሉትን እነዚህን የተጠቆሙ እርምጃዎች ያጠናቅቁ።</translation>
<translation id="1185134272377778587">ስለVortex</translation>
<translation id="1211450393895337634">በእርስዎ iPad ላይ ለማሰስ ዝግጁ ሲሆኑ Vortexን ይበልጥ በፍጥነት ይክፈቱ።</translation>
<translation id="1229234641991056119">የእርስዎን Safari የይለፍ ቃላት፣ ዕልባቶች እና ክሬዲት ካርዶች Vortex ውስጥ ይጠቀሙ</translation>
<translation id="1257458525759135959">ምስሎችን ለማስቀመጥ፣ Vortex ወደ የእርስዎ ፎቶዎች ማከል እንዲችል ለማድረግ ቅንብሮች ላይ መታ ያድርጉ</translation>
<translation id="1260702988262336471">የVortex ምናሌውን ይክፈቱ</translation>
<translation id="12739128458173458">ይህን ትር ወደ ሌላ መሣሪያ ለመላክ፣ በሁለቱም መሣሪያዎች ላይ ወደ Vortex ይግቡ።</translation>
<translation id="1361748954329991663">Vortex ጊዜው አልፎበታል። በ<ph name="BEGIN_LINK" />App Store<ph name="END_LINK" /> ውስጥ ምንም ዝማኔ ከሌለ የእርስዎ መሣሪያ አዲስ የVortex ስሪቶችን ከእንግዲህ ላይደግፍ ይችላል።</translation>
<translation id="1383876407941801731">ፍለጋ </translation>
<translation id="1423007117030725713">በአዲስ የVortex ትር ውስጥ ፍለጋ ጀምር።</translation>
<translation id="1431818719585918472">Vortex የእርስዎን ማንነት የማያሳውቁ ትሮች እንዲቆልፍ ይፍቀዱለት።</translation>
<translation id="1451665391191990528">Vortexን ለቀው ሲወጡ የተከፈቱ ማንነት የማያሳውቁ ትሮችን ይደብቁ</translation>
<translation id="146407871188825689">Vortexን በiPad ላይ በነባሪ ተጠቀም</translation>
<translation id="1471084500615228555">በVortex ውስጥ የአሰሳ ውሂብን ሰርዝ</translation>
<translation id="1472013873724362412">የእርስዎ መለያ በVortex ላይ አይሠራም። እባክዎ የእርስዎን የጎራ አስተዳዳሪ ያነጋግሩ ወይም ለመግባት መደበኛ Google መለያ ይጠቀሙ።</translation>
<translation id="148576268809812097">የይለፍ ቃላትዎን Vortex ውስጥ ያስቀምጡ</translation>
<translation id="1501302548410882220">በሁሉም ቦታ Vortex ይጠቀሙ</translation>
<translation id="1502360822835740515">Vortexን የእርስዎ ነባሪ አሳሽ ያድርጉ</translation>
<translation id="1503199973012840174">የእርስዎ Vortex ጊዜው አልፎበታል። ደህንነትዎን ለመጠበቅ ያዘምኑት።</translation>
<translation id="1515748263297244785">Vortex ለiPad በነባሪ ይጠቀሙ</translation>
<translation id="1530961174488670696">Vortex ዝማኔዎች መኖራቸውን መፈተሽ አልቻለም። ቆይተው እንደገና ይሞክሩ።</translation>
<translation id="1531155317299575425">ወደ Vortex የመግባት ጥያቄዎችን ያሳያል።</translation>
<translation id="1553657876656159572">ለእርስዎ የተሠራ ብጁ ምግብ። ዜና፣ ስፖርት እና የአየር ሁኔታን ጨምሮ።</translation>
<translation id="1561849081734670621">የመቆለፊያ ሁነታን ለማሰናከል በVortex ውስጥ በእርስዎ iPhone ላይ ያጥፉት።</translation>
<translation id="1569258826720962327">በiOS ላይ Vortex እርምጃዎችን ይጠቀሙ</translation>
<translation id="1573441572176948907">Vortexን ወደ መትከያዎ ያንቀሳቅሱ</translation>
<translation id="159029779861043703">Vortex አደጋ ሊያስከትል የሚችል ውሂብዎን በፊት መታወቂያ ደህንነቱን ይጠብቃል።</translation>
<translation id="1591119736686995611">የVortex ትር ፍርግርግን ይከፍታል።</translation>
<translation id="16001233025397167">የደህንነት ፍተሻ እርስዎን ከውሂብ ጥሰቶች፣ ደህንነታቸው ካልተጠበቁ ድር ጣቢያዎች እና ከተጨማሪ ነገሮች ይጠብቅዎታል። Vortex ለእርስዎ በሚያገኛቸው ማናቸውም የግላዊነት ወይም የደህንነት ችግሮች ላይ ማንቂያዎችን ይቀበሉ።</translation>
<translation id="1617663976202781617">ከVortex ስምረት የመጣ ውሂብ</translation>
<translation id="164952285225495380">ይህ ጥቅል አስቀድሞ Vortex ላይ ክትትል ተደርጎበታል።</translation>
<translation id="1707458603865303524">በመልዕክቶች ወይም በሌሎች መተግበሪያዎች ውስጥ ያሉ አገናኞችን መታ በሚያደርጉበት ማንኛውም ጊዜ Vortexን ይጠቀሙ።</translation>
<translation id="1722370509450468186">የይለፍ ቃልዎ በመለያዎ (<ph name="EMAIL" />) ላይ ይቀመጣል።</translation>
<translation id="1747088204252710672">ለእርስዎ የተሰራ ብጁ ምግብ</translation>
<translation id="1811860791247653035">ግላዊነት ማላበስን እና ሌሎች ባህሪያትን ለማግኘት Vortexን በ<ph name="FEATURE_NAME_1" /> እና <ph name="FEATURE_NAME_2" /> ውስጥ ያካትቱ</translation>
<translation id="1838412507805038478">Vortex የዚህ ድር ጣቢያ እውቅና ማረጋገጫ ያወጣው <ph name="ISSUER" /> መሆኑን አረጋግጧል።</translation>
<translation id="1839447949248872139">አገናኞችን በነባሪ Vortex ውስጥ ይክፈቱ</translation>
<translation id="1843424232666537147">Vortex እርስዎ የበይነመረብ ውሂብዎን እና ድረ-ገጾችን በምን ያህል ፍጥነት መጫን እንደሚችሉ እንዲያቀናብሩ የሚያስችሉዎት ባህሪያት አሉት። <ph name="BEGIN_LINK" />የበለጠ ለመረዳት<ph name="END_LINK" /></translation>
<translation id="1847960401032164406">በVortex ውስጥ ያሉ ካርታዎች</translation>
<translation id="1867772173333403444">4. Vortexን ይምረጡ</translation>
<translation id="1965068424387304464">የVortex ጠቃሚ ምክር፦ የተቀመጡ የይለፍ ቃላት</translation>
<translation id="2006345422933397527">Vortex ዝማኔዎች ካሉ መፈተሽ አልቻለም። የበይነመረብ ግንኙነትዎን ለመፈተሽ ይሞክሩ።</translation>
<translation id="2042889939382983733">የእርስዎን የVortex ታሪክ ይመልከቱ</translation>
<translation id="2052320862053429062">Vortex በየጊዜው የእርስዎን የይለፍ ቃላት መስመር ላይ ከታተሙ ዝርዝሮች ጋር እያነጻጸረ ይፈትሻል። ይህን በሚያደርግበት ጊዜ የእርስዎ የይለፍ ቃላት እና የተጠቃሚ ስሞች Googleን ጨምሮ በሌላ ማንም ወገን እንዳይነበቡ ይመሠጠራሉ።</translation>
<translation id="2059365270911640413">Vortex ማዋቀርን ያጠናቅቁ</translation>
<translation id="2168108852149185974">አንዳንድ ተጨማሪዎች Vortex እንዲበላሽ ያደርጋሉ። እባክዎ የሚከተለውን ያራግፉ፦</translation>
<translation id="2168593389981132306">Vortex የተሻለ ያድርጉት</translation>
<translation id="2178608107313874732">Vortex አሁን ካሜራዎን መጠቀም አይችልም</translation>
<translation id="2195025571279539885">Vortex በሚቀጥለው ጊዜ ከዚህ ጣቢያ የመጡ የ<ph name="LANGUAGE_NAME" /> ገጾችን እንዲተረጎምልዎ ይፈልጋሉ?</translation>
<translation id="22313767259766852">ይህ አድራሻ በአሁኑ ጊዜ Vortex ላይ ተቀምጧል። በሁሉም የGoogle ምርቶች ላይ እሱን ለመጠቀም በGoogle መለያዎ <ph name="USER_EMAIL" /> ውስጥ ያስቀምጡት።</translation>
<translation id="2236584955986023187">ይህ ማለት Vortex የዴስክቶፕ ጣቢያውን በእያንዳንዱ ጊዜ ይጠይቃል ማለት ነው።</translation>
<translation id="2245694534483711162">Gemini ቀድሞውኑ ለVortex በሰጡት ፈቃድ መሠረት የእርስዎን ትክክለኛ አካባቢ ሊጠቀም ይችላል</translation>
<translation id="2270466829363945454">ይግዙ</translation>
<translation id="2313870531055795960">በVortex ላይ በተከማቹ ደህንነታቸው ያልተጠበቁ ጣቢያዎች ዝርዝር ጋር ዩአርኤሎችን ይፈትሻል። አንድ ጣቢያ የእርስዎን የይለፍ ቃል ለመስረቅ ከሞከረ ወይም ጎጂ ፋይል ሲያወርዱ Vortex እንዲሁም የገጽ ይዘት ቢትስንም ጨምሮ ዩአርኤሎችን ወደ የጥንቃቄ አሰሳ ሊልክ ይችላል።</translation>
<translation id="2314220608288760290">Vortex የYouTube ማንነት የማያሳውቁ አገናኞችን በራስ-ሰር በማንነት የማያሳውቅ ይከፍታል።</translation>
<translation id="231828342043114302">በፍላጎቶችዎ ላይ የተመሠረተ ግላዊነት የተላበሰ ይዘትን ለመቀበል ወደ Vortex ይግቡ።</translation>
<translation id="2326738825692478496">አንዳንድ የVortex ውሂብዎ በGoogle መለያዎ ውስጥ ገና አልተቀመጠም።

ዘግተው ከመውጣትዎ በፊት ጥቂት ደቂቃዎች ለመጠበቅ ይሞክሩ። አሁን ዘግተው ከወጡ ይህ ውሂብ ይሰረዛል።</translation>
<translation id="2337722506862731008">Vortex ያጋሩ</translation>
<translation id="2340423701577464731">የንባብ ዝርዝር ንጥልን ወደ Vortex ያክሉ</translation>
<translation id="2374627437126809292">Vortex በታወቁ አድራሻዎች ላይ አቅጣጫዎችን እና አካባቢያዊ መረጃ ለእርስዎ ለመስጠት Google ካርታዎችን ይጠቀማል።</translation>
<translation id="2386292341327187942">በምግብሮች ፈልግ ሳጥን ውስጥ Vortexን ያስገቡ</translation>
<translation id="2389827884654658221">ከእርስዎ iPad መነሻ ማያ ገጽ ላይ Vortex ይበልጥ በፍጥነት ይድረሱ።</translation>
<translation id="2426113998523353159">Vortexን ለመጠቀም የእርስዎ ድርጅት እርስዎ በመለያ እንዲገቡ ይጠይቃል።</translation>
<translation id="2450140762465183767">አገናኞችን በመልዕክቶች፣ በሰነዶች እና በሌሎች መተግበሪያዎች ውስጥ መታ በሚያደርጉበት ጊዜ ሁሉ Vortexን አሁን መጠቀም ይችላሉ።</translation>
<translation id="2459183986985456602">በVortex ውስጥ የእኔ የቅርብ ጊዜ ትርን ክፈት።</translation>
<translation id="2476409803017965813">ምርጫዎችዎን በማንኛውም ጊዜ በVortex ቅንብሮች ውስጥ ማዘመን ይችላሉ።</translation>
<translation id="2478931088402984578"><ph name="BEGIN_BOLD" />Vortex<ph name="END_BOLD" />ን ይምረጡ</translation>
<translation id="2485774047568879945">አገናኞችን በቀላሉ ለማጋራት እና ለመክፈት Vortexን እንደ ነባሪ አሳሽዎ ያቀናብሩ</translation>
<translation id="2512597191798760956">የVortex አዶውን ተጭነው ይያዙ እና «የመነሻ ማያ ገፅን አርትዕ» ላይ ጠቅ ያድርጉ</translation>
<translation id="2517624234762908348">የVortex ውሂብዎን ያሳምሩ</translation>
<translation id="2575968074225731646">ከእርስዎ iPhone መትከያ ላይ Vortexን ይበልጥ በፍጥነት ይድረሱ።</translation>
<translation id="2592940277904433508">Vortexን መጠቀምዎን ይቀጥሉ</translation>
<translation id="2607609479243848905">የይለፍ ሐረግዎን ከረሱ ወይም ይህን ቅንብር መለወጥ ከፈለጉ <ph name="BEGIN_LINK" />በመለያዎ ውስጥ ያለውን የVortex ውሂብ ይሰርዙ<ph name="END_LINK" />።</translation>
<translation id="2640367368802736659">የVortex ጠቃሚ ምክር፦ በGoogle ሌንስ የሚያዩትን ይፈልጉ</translation>
<translation id="2650312721222849884">Vortexን ከሚጠቀሙበት የትኛዉም ቦታ ትሮችን ለማየት ስምረትን ያብሩ</translation>
<translation id="2684230048001240293">በሁሉም መሣሪያዎችዎ ላይ ትሮችዎን፣ የይለፍ ቃላትዎን እና የክፍያ መረጃዎን ለማስመር Vortexን እንደ ነባሪ ያዘጋጁ</translation>
<translation id="2729836253097154631">ነገሮችዎን ለማግኘት ወደ Vortex በመለያ ይግቡ</translation>
<translation id="2730884209570016437">ሌላ መተግበሪያ ካሜራዎን እየተጠቀመበት ስለሆነ Vortex ካሜራዎን መጠቀም አይችልም</translation>
<translation id="2742952311155593352">Vortexን ማዋቀር ሊጨርሱ ነው!</translation>
<translation id="2798503587425057129">የVortex የንባብ ዝርዝርን ይከፍታል።</translation>
<translation id="28276745681323897">በGoogle መለያዎ ውስጥ <ph name="BEGIN_LINK" />ምን ዓይነት የVortex ውሂብ እንደሚቀመጥ<ph name="END_LINK" /> ማስተዳደር ይችላሉ።

የVortex ተሞክሮዎን ለማሻሻል ውሂብን ለሚጠቀሙ ተጨማሪ ቅንብሮች ወደ <ph name="BEGIN_LINK" />የGoogle አገልግሎቶች<ph name="END_LINK" /> ይሂዱ።</translation>
<translation id="2832168932648876507">በVortex ውስጥ በድምፅ ይፈልጉ</translation>
<translation id="2843571538056574338">Vortexን ለራስ-ሙላ ይጠቀሙ</translation>
<translation id="2918709798697875261">የእርስዎ ድርጅት ከVortex ዘግተው እንደወጡ እንዲቆዩ ይፈልጋል።</translation>
<translation id="2942241131342758843">አገናኞችን ለመክፈት፣ ከመግብሮች ለመፈለግ እና የይለፍ ቃሎችን በራስ-ለመሙላት በሌሎች መተግበሪያዎች ውስጥ በነባሪነት Vortex ይጠቀሙ</translation>
<translation id="2977470724722393594">Vortex የተዘመነ ነው</translation>
<translation id="3044857325852340337">የተሰረዘ Vortex ውሂብ</translation>
<translation id="3054480780637153380">በiOS ውስጥ የVortex ቅንብሮችን ይክፈቱ ከዚያ «ነባሪ አሳሽ መተግበሪያ» ላይ መታ ያድርጉ እና Vortex ይምረጡ።</translation>
<translation id="3115956258722352278">Vortex የእርስዎ ነባሪ አሳሽ ይደረግ?</translation>
<translation id="3180939591219927904">Vortex በሚዘጉበት ጊዜ «ማንነት የማያሳውቁ ትሮችን ይቆልፉ» የሚለውን ያብሩ</translation>
<translation id="328933489847748230">{count,plural, =1{አሁን 1 Vortex መስኮትን በማሳየት ላይ}one{አሁን {count} Vortex መስኮቶችን በማሳየት ላይ}other{አሁን {count} Vortex መስኮቶችን በማሳየት ላይ}}</translation>
<translation id="3344973607274501920">Vortex የእርስዎን የይለፍ ቃላት መፈተሽ አይችልም። የበይነመረብ ግንኙነትዎን ለመፈተሽ ይሞክሩ።</translation>
<translation id="3366305173356742781">በመለያዎ ውስጥ ያለው የVortex ውሂብ</translation>
<translation id="3387107508582892610">{THRESHOLD,plural, =1{ይህ የሚሆነው Vortex ለ{THRESHOLD} ደቂቃ ጥቅም ላይ ሳይውል ሲቀር ነው። ይህ ታሪክን እና ራስ-ሙላን ሊያካትት ይችላል።}one{ይህ የሚሆነው Vortex ለ{THRESHOLD} ደቂቃዎች ጥቅም ላይ ሳይውል ሲቀር ነው። ይህ ታሪክን እና ራስ-ሙላን ሊያካትት ይችላል።}other{ይህ የሚሆነው Vortex ለ{THRESHOLD} ደቂቃዎች ጥቅም ላይ ሳይውል ሲቀር ነው። ይህ ታሪክን እና ራስ-ሙላን ሊያካትት ይችላል።}}</translation>
<translation id="3410395242749598859">አንዳንድ የVortex ውሂብዎ <ph name="EMAIL" /> ውስጥ ገና አልተቀመጠም።
መለያ ከመቀየር በፊት ጥቂት ደቂቃዎች ለመጠበቅ ይሞክሩ። አሁን መለያዎችን ከቀየሩ ይህ ውሂብ ይሰረዛል።</translation>
<translation id="3420586870838853527">የVortex ጠቃሚ ምክር፦ የተሻሻለ የደህንነት አሰሳ ቀንዎን ይቆጥባል</translation>
<translation id="3440830787838130530">በGoogle የይለፍ ቃል አስተዳዳሪ ውስጥ በቀላሉ እና ደህንነቱ በተጠበቀ መልኩ የይለፍ ቃል ቅጂ ለቤተሰብ ቡድንዎ ያጋሩ</translation>
<translation id="3472200483164753384">በVortex Canary ላይ አይደገፍም</translation>
<translation id="347967311580159871">የVortex ተሞክሮዎን ለማሻሻል ውሂብን ለሚጠቀሙ ተጨማሪ ቅንብሮች ወደ <ph name="BEGIN_LINK" />የGoogle አገልግሎቶች<ph name="END_LINK" /> ይሂዱ።</translation>
<translation id="3512168799938877162">የይለፍ ቃልዎ አልተጋራም። የበይነመረብ ግንኙነትዎን ይፈትሹ እና ወደ Vortex መግባትዎን ያረጋግጡ። ከዚያም፣ እንደገና ይሞክሩ።</translation>
<translation id="3529798650269984835">«Vortex በሚዘጉበት ጊዜ ማንነት የማያሳውቁ ትሮችን ይቆልፉ» የሚለውን ያብሩ።</translation>
<translation id="3541247799006476453">ለራስ-ሙላ በVortex ለእርስዎ የይለፍ ቃላት እና የይለፍ ቁልፎች ቀላል መዳረሻ ያግኙ</translation>
<translation id="3567399274263440288">ከVortex የበለጠ ለማግኘት በGoogle መለያዎ ወደ Vortex ይግቡ።</translation>
<translation id="3581385059720151202">በVortex ውስጥ የሚታዩ ነገሮችን ይፈልጉ።</translation>
<translation id="3582640969619785896">Vortex የይለፍ ቃልዎን ለማስቀመጥ ጥያቄ ያቀርባል</translation>
<translation id="3594315078412605236">በVortex ውስጥ የመክፈያ ዘዴዎችን ያስተዳድሩ</translation>
<translation id="3617143087229977194">ነባሪ መተግበሪያዎች ቅንብሮችን iOS ውስጥ ይክፈቱ፣ ከዚያ «አሳሽ መተግበሪያ» ላይ መታ ያድርጉ እና Vortexን ይምረጡ።</translation>
<translation id="3634039384458740619">የVortex ቅንብሮችን ይክፈቱ</translation>
<translation id="3639997914391704523">Vortex በእርስዎ የGoogle መለያ በሚገቡበት ጊዜ የእርስዎን የይለፍ ቃላትን ሊፈትሽ ይችላል።</translation>
<translation id="372658070733623520">በGoogle መለያዎ ውስጥ የVortex ውሂብን ለመጠቀም እና ለማስቀመጥ እርስዎ መሆንዎን ያረጋግጡ።</translation>
<translation id="3728124580182886854">Vortexን እና ሌሎች የGoogle አገልግሎቶችን ግላዊነት ለማላበስ እና ለሌሎች ዓላማዎች ያገናኟቸው</translation>
<translation id="377649297473651452">Vortex ራስ-ሙላ የተዘረጋ ዕይታ</translation>
<translation id="3780779443901618967">ከመደበኛ ጥበቃ በላይ ተጨማሪ ውሂብ ከጣቢያዎች ትንታኔ በመስጠት Google እንኳን በፊት ስላላወቃቸው አደገኛ ጣቢያዎች ያስጠነቅቅዎታል። የVortex ማስጠንቀቂያዎችን ለመዝለል መምረጥ ይችላሉ።</translation>
<translation id="3805899903892079518">Vortex የእርስዎ ፎቶዎች ወይም ቪዲዮዎች መዳረሻ የለውም። በiOS ቅንብሮች &gt; ግላዊነት &gt; ፎቶዎች ውስጥ መዳረሻን ያንቁ።</translation>
<translation id="3816686541346279443">Vortex የይለፍ ቃልዎን ለማስቀመጥ ጥያቄ ያቀርባል።</translation>
<translation id="3827545470516145620">እርስዎ በዚህ መሣሪያ ላይ መደበኛ የደህንነት ጥበቃ እያገኙ ነው</translation>
<translation id="3833326979834193417">Vortex እርስዎን ከውሂብ ጥሰቶች፣ ደህንነታቸው ካልተጠበቁ ድር ጣቢያዎች እና ሌሎችም ደህንነትዎ እንደተጠበቀ ለማቆየት በየቀኑ የደህንነት ፍተሻን በራስ-ሰር ያሄዳል። ስለ የደህንነት ፍተሻ በቅንብሮች ውስጥ የበለጠ ማግኘት ይችላሉ።</translation>
<translation id="3837584850181228767">የVortex ጠቃሚ ምክር፦ የተሻሻለ የደህንነት አሰሳ</translation>
<translation id="3845223911364528001">ፋይልዎን ለመስቀል ወደ Vortex ይመለሱ</translation>
<translation id="3855938650519180865">በVortex ውስጥ ምን አዲስ ነገር አለ</translation>
<translation id="3886689467633467988">በሁሉም መሣሪያዎችዎ ላይ የእርስዎን ዕልባቶች እና ሌሎችም ለማግኘት ወደዚህ ጣቢያ እና Vortex ይግቡ።</translation>
<translation id="3949514465204582407">Vortex ጠቃሚ ምክር፦ በማንኛውም መተግበሪያ ውስጥ የይለፍ ቃላትዎን ያግኙ</translation>
<translation id="4005283307739974863">በVortex ውስጥ የደህንነት ፍተሻን ይከፍታል እና ያሄዳል።</translation>
<translation id="4043291146360695975">የይለፍ ቃላት የሚቀመጡት በዚህ መሣሪያ ላይ ብቻ ባለው የይለፍ ቃል አስተዳዳሪ ላይ ነው።</translation>
<translation id="4066426933127344530">በነባሪ Vortex ይጠቀሙ</translation>
<translation id="4087314024407094071">በVortex ውስጥ ቅንብሮቹን ይከፍታል።</translation>
<translation id="4099085513035183040">በVortex ቅድመ-ይሁንታ ላይ አይደገፍም</translation>
<translation id="4106512142782407609">እንደ <ph name="EMAIL" /> ሆነው ገብተዋል።

የእርስዎ ውሂብ በእርስዎ የይለፍ ሐረግ የተመሰጠረ ነው። የVortex ውሂብን በGoogle መለያዎ ውስጥ ለመጠቀም እና ለማስቀመጥ እሱን ያስገቡ።</translation>
<translation id="4118287192800900567">የVortex ጠቃሚ ምክር፦ ወደ Vortex ይግቡ</translation>
<translation id="4195557071150719219">የVortex የቅርብ ጊዜ ትሮችን ይመልከቱ</translation>
<translation id="420541179527342563">በVortex ውስጥ የመቆለፊያ ሁነታን ለማሰናከል iPadዎን ያጥፉት።</translation>
<translation id="4272892696084633551">የVortex ባህሪያት እና አፈጻጸም እንዲሻሻል ያግዙ</translation>
<translation id="4302397443352897529">የVortex ቅንብሮች</translation>
<translation id="4304713468139749426">የይለፍ ቃል አስተዳዳሪ</translation>
<translation id="4408912345039114853">Vortex የደህንነት ፍተሻን ያሂዱ</translation>
<translation id="4432744876818348753">ከVortex የሚችሉትን ሁሉ ለማግኘት በመለያ ይግቡ።</translation>
<translation id="4445228361214254027">ድርጅትዎ በእርስዎ የGoogle መለያ ውስጥ Vortex ውሂብ የመጠቀም እና የማስቀመጥ አቅምን አጥፍቷል። አዳዲስ ዕልባቶች፣ የይለፍ ቃላት እና ሌሎችም በዚህ መሣሪያ ላይ ብቻ ይቀመጣሉ።</translation>
<translation id="4498832288620833153">የገባውን ዩአርኤል በ Vortex ውስጥ ባለው የንባብ ዝርዝር ውስጥ ያክላል።</translation>
<translation id="4508268628669724828">ከVortex ምርጡን ለማግኘት ለተጨማሪ ጠቃሚ ምክሮች ተመልሰው እዚህ ይምጡ።</translation>
<translation id="452436063477828504">በGoogle መለያዎ ውስጥ በማንኛውም ጊዜ የVortex ውሂብን መጠቀም መቻልዎን ያረጋግጡ</translation>
<translation id="4527452566931097835">Vortex እንደ ነባሪ ይቀናበር?</translation>
<translation id="4555020257205549924">ይህ ባህሪ ሲበራ Vortex በሌሎች ቋንቋዎች የተጻፉ ገጾች Google ትርጉምን በመጠቀም እንዲተረጎምልዎ ይጠይቀዎታል። <ph name="BEGIN_LINK" />የበለጠ ለመረዳት<ph name="END_LINK" /></translation>
<translation id="4572441104543926904">የይለፍ ሐረግ ምስጠራ የመክፈያ ዘዴዎችን እና አድራሻዎችን አያካትትም።

ይህን ቅንብር ለመለወጥ <ph name="BEGIN_LINK" />በመለያዎ ውስጥ ያለውን የVortex ውሂብ ይሰርዙ<ph name="END_LINK" />።</translation>
<translation id="4578500311756617174">የVortex ጠቃሚ ምክር፦ Vortex በነባሪ ይጠቀሙ</translation>
<translation id="458786853569524949">አገናኞችን በኢሜይሎች፣ በሰነዶች እና በሌሎች መተግበሪያዎች ውስጥ መታ በሚያደርጉበት ጊዜ ሁሉ Vortexን አሁን መጠቀም ይችላሉ።</translation>
<translation id="4633738821577273991">ለዚህ የVortex መገለጫ የተሻሻለ የደህንነት አሰሳንም ያግኙ</translation>
<translation id="4654936625574199632">መተግበሪያውን ለማሻሻል ለማገዝ Vortex የአጠቃቀም እና የስንክል ውሂብን ወደ Google ይልካል። <ph name="BEGIN_LINK" />አቀናብር<ph name="END_LINK" /></translation>
<translation id="4681781466797808448">የVortex ቃኚን ያብሩ</translation>
<translation id="4685611756167369067">የVortex ማንነት የማያሳውቅ ትርን ይክፈቱ</translation>
<translation id="4736424910885271643">የእርስዎ መለያ በ<ph name="HOSTED_DOMAIN" /> የሚተዳደር ነው፣ ስለሆነም የእርስዎ የVortex ውሂብ ከዚህ መሣሪያ ይጸዳል</translation>
<translation id="4790638144988730920">በGoogle መለያዎ ውስጥ የVortex ውሂብን መጠቀምዎን ይቀጥሉ።</translation>
<translation id="4828317641996116749">Vortex ሁሉንም የይለፍ ቃላት ማረጋገጥ አልቻለም። ቆይተው እንደገና ይሞክሩ።</translation>
<translation id="4856138222358683580">የVortex እርምጃዎች</translation>
<translation id="4904452304169763785">Vortex ለእርስዎ በሚያገኛቸው ማናቸውም የግላዊነት ወይም የደህንነት ችግሮች ላይ ያሉ ማንቂያዎች።</translation>
<translation id="4908570938463711775">ለመጀመር አጋዥ የሆኑትን የVortex መሠረታዊ ነገሮች ይወቁ</translation>
<translation id="4962295957157529683">በእርስዎ ሌላኛው ክፍት የVortex መስኮት ላይ እያደረጉ ያሉትን ነገር ያጠናቅቁ።</translation>
<translation id="4985291216379576555">ከመስመር ውጭ፣ Vortex ዝማኔዎች ካሉ መፈተሽ አልቻለም</translation>
<translation id="4996471330284142407">ከመቼውም ጊዜ በበለጠ ቀላል፣ ደህንነቱ በተጠበቀ እና ፈጣን በሆነ Vortex አማካኝነት ተጨማሪ ነገሮችን ያከናውኑ።</translation>
<translation id="4999538639245140991">በ<ph name="SIGNOUT_MANAGED_DOMAIN" /> ከሚተዳደር መለያ ዘግተው እየወጡ ስለሆነ የእርስዎ Vortex ውሂብ ከዚህ መሣሪያ ላይ ይሰረዛል። የእርስዎ ውሂብ በGoogle መለያዎ ውስጥ ይቆያል።</translation>
<translation id="5042011327527167688">«በVortex ላይ በGoogle ካርታዎች ይመልከቱ» የሚለው ላይ መታ ያድርጉ።</translation>
<translation id="5044871537677053278">Vortex አድራሻዎችን ያገኛል እና ለእርስዎ አቅጣጫዎችን እና አካባቢያዊ መረጃ ለመስጠት Google ካርታዎችን ይጠቀማል።</translation>
<translation id="5048140766121299007">ከ«<ph name="TEXT_OF_THE_SETTINGS_MENU_ITEM" />» ቅንብሮች «Vortex»ን ያብሩ</translation>
<translation id="5053429694249468757">የVortex ውሂብን በመሰረዝ ላይ…</translation>
<translation id="5071749685031362629">Vortex ለiOS</translation>
<translation id="5124429847818367226">አሁን በሚያስሱበት ወይም በመልዕክቶች ውስጥ አገናኞችን መታ በሚያደርጉበት በማንኛውም ጊዜ Vortex እና ሌሎች መተግበሪያዎችን መጠቀም ይችላሉ።</translation>
<translation id="5131565040785979529">ድርጅትዎ፣ <ph name="DOMAIN" />፣ የገቡበትን መለያ እና Vortex እንዴት ጥቅም ላይ እንደሚውል ያስተዳድራል።</translation>
<translation id="5134464247000681876">ከGmail፣ Maps፣ YouTube እና ሌሎች መተግበሪያዎች ላይ አገናኞችን Vortex ውስጥ ይክፈቱ</translation>
<translation id="5203244847421322551">Vortex ውስጥ የይለፍ ቃላትን ያስቀምጡ እና በራስ ይሙሉ</translation>
<translation id="5218806323985098884">Vortex ውስጥ ምን አዲስ ነገር እንዳለ ይመልከቱ</translation>
<translation id="5224391634244552924">ምንም የተቀመጡ የይለፍ ቃላት የሉም። እርስዎ የይለፍ ቃላትዎን ሲያስቀምጧቸው Vortex መፈተሽ ይችላል።</translation>
<translation id="5259423875997548710">በVortex ውስጥ የሚታዩ ነገሮችን ይፈልጉ።</translation>
<translation id="5284913972719948193">Vortex ላይ የእርስዎን የይለፍ ቃሎች፣ ታሪክ፣ ዕልባቶች እና ክሬዲት ካርዶች ለመጠቀም ውሂብዎን ያምጡ</translation>
<translation id="5308226104666789935">Vortex ዝማኔዎች ካሉ መፈተሽ አልቻለም</translation>
<translation id="5311557153294205270">በVortex ውስጥ የገቡትን ዩአርኤሎች ወደ ዕልባቶችዎ ያክላል።</translation>
<translation id="5383251701169024761">በሌሎች መተግበሪያዎች ውስጥ የተቀመጡ የይለፍ ቃላትዎን በቀላሉ ለማግኘት Vortex ለራስ-ሙላን ይምረጡ።</translation>
<translation id="538767207339317086">የVortex በመለያ መግባትን ይፍቀዱ</translation>
<translation id="5389058611415066188">በVortex ደህንነትዎን ይጠብቁ</translation>
<translation id="5414059596208264343">የVortex ጠቃሚ ምክር፦ የይለፍ ቃላትዎን ያግኙ</translation>
<translation id="5415273218238091735">የVortex ጠቃሚ ምክር</translation>
<translation id="5427571867875391349">Vortex እንደ ነባሪ አሳሽዎ አድርገው ያዋቅሩት</translation>
<translation id="5434562575369834882">ማንነት የማያሳውቅ Vortex ውስጥ ይክፈቱ</translation>
<translation id="5453478652154926037">Vortex የይለፍ ቃላትዎን መፈተሽ አይችልም።</translation>
<translation id="5479292367402350143">Vortex የእርስዎ ነባሪ ለማድረግ፦
1. ቅንብሮችን ይክፈቱ
2. ነባሪ የአሳሽ መተግበሪያን መታ ያድርጉ
3. Vortex ይምረጡ</translation>
<translation id="5482686278086727777">ከVortex የትር አስታዋሾችን ለመቀበል የiOS ቅንብሮችዎ ውስጥ ማሳወቂያዎችን ያብሩ።</translation>
<translation id="5521125884468363740">Vortexን ከሚጠቀሙበት የትኛዉም ቦታ ሆነዉ ትሮችዎን ለማየት በመለያ ይግቡ እና ስምረትን ያብሩ</translation>
<translation id="5534584691915394889">ይህ ከVortex እና Google ሌንስ በእርስዎ Apple ቀን መቁጠሪያ ውስጥ ክስተቶችን ለመፍጠር ሥራ ላይ ይውላል።</translation>
<translation id="5571094606370987472">የVortex የቅርብ ጊዜ ትሮችን ይከፍታል።</translation>
<translation id="5596644122344097310">በእርስዎ iPhone ላይ ከVortex ምርጡን ለማግኘት እዚህ መታ ያድርጉ።</translation>
<translation id="5603085937604338780">chromium</translation>
<translation id="5657280937522795751">Vortex ቀያይር</translation>
<translation id="5664395081284292058">በVortex ውስጥ የእኔ የቅርብ ጊዜ ትርን ክፈት</translation>
<translation id="5671188105328420281">የVortex ጠቃሚ ምክሮች</translation>
<translation id="5688047395118852662">ይህ ካርድ እንዴት ከVortex ምርጡን ማግኘት እንደሚችሉ ጥቆማዎችን ያሳይዎታል።</translation>
<translation id="5700709190537129682">Vortex የእርስዎን የይለፍ ቃላት መፈተሽ አይችልም</translation>
<translation id="5731004036450828399">የይለፍ ቁልፎችዎን ደህንነት ለመጠበቅ መጀመሪያ የመልሶ ማግኛ ፒን መፍጠር ያስፈልግዎታል።

        የይለፍ ቃሎች በይለፍ ቃል አስተዳዳሪ ውስጥ ይቀመጣሉ፣ ይህም በማንኛውም መሣሪያ ላይ በVortex ውስጥ እንዲጠቀሙባቸው ያስችልዎታል።</translation>
<translation id="584550191241316896">ወደ Vortex ገብተዋል</translation>
<translation id="5862307444128926510">ወደ Vortex እንኳን በደህና መጡ</translation>
<translation id="5889847953983052353">ሲበራ፦
<ph name="BEGIN_INDENT" />  • እርስዎ Vortex በሚጠቀሙት መንገድ ለሚጠቀሙ ሰዎች የተሻለ እንዲሆን ያግዙ።<ph name="END_INDENT" />

ከግምት ውስጥ መግባት ያለባቸው ነገሮች
<ph name="BEGIN_INDENT" />  • ስለ እርስዎ የVortex አጠቃቀም መረጃ ወደ Google ይላካል፣ ነገር ግን ከእርስዎ ጋር የተሳሰረ አይደለም።

  • Vortex ከተበላሸ የብልሽቱ ዝርዝሮች አንዳንድ የግል መረጃን ሊያካትቱ ይችላሉ።

  • የእርስዎን ታሪክ ከGoogle መለያዎ ጋር ካሰመሩ እንዲሁም መለኪያዎች ስለሚጎበኟቸው ዩአርኤሎች መረጃ ሊያካትቱ ይችላሉ።<ph name="END_INDENT" /></translation>
<translation id="5932787118589620366">በVortex ውስጥ የአሰሳ ውሂብን ሰርዝ</translation>
<translation id="593808800391107017">Vortex ለእርስዎ በራስ-ሰር በሚያገኛቸው ማናቸውም የግላዊነት ወይም የደህንነት ችግሮች ላይ ማንቂያዎችን ይቀበሉ።</translation>
<translation id="5951593919357934226">ከVortex ምርጡን ያግኙ።</translation>
<translation id="5985254578475526217">ከVortex ማሳወቂያዎችን ለመቀበል በiOS ቅንብሮችዎ ውስጥ ማሳወቂያዎችን ያብሩ።</translation>
<translation id="6041226255405329731">የትር ቡድኖችን ለማጋራት እና ለመቀላቀል እና በሐሳቦች ላይ አንድ ላይ ለመሥራት ወደ Vortex ይግቡ</translation>
<translation id="6104024151682120539">በVortex ይክፈቱ</translation>
<translation id="61109258320235597">በGoogle መለያዎ ውስጥ የVortex ውሂብን ለመጠቀም እና ለማስቀመጥ የእርስዎን የይለፍ ሐረግ ያስገቡ።</translation>
<translation id="6132149203299792222">የእርስዎን የይለፍ ቃላት፣ እልባቶች እና ሌሎችንም ለማስመር በGoogle መለያዎ ይግቡ።</translation>
<translation id="6148377327556085395">ዕልባቶችን ወደ Vortex ያክሉ</translation>
<translation id="6154098560469640583">በመልዕክቶች፣ ሰነዶች እና ሌሎች መተግበሪያዎች ውስጥ ያሉ አገናኞች ላይ መታ በሚያደርጉበት ማንኛውም ጊዜ Vortexን ይጠቀሙ።</translation>
<translation id="6157162508956739031">የይለፍ ቃላትዎን እና የይለፍ ቁልፎችዎን ከVortex በራስ-ሰር በመሙላት ወደ መተግበሪያዎች እና ጣቢያዎች በፍጥነት ይግቡ</translation>
<translation id="6170619162539716595">በታወቁ አድራሻዎች ላይ አቅጣጫዎችን እና አካባቢያዊ መረጃ ለእርስዎ ለመስጠት Vortex Google ካርታዎችን እንዲጠቀም ይፍቀዱ።</translation>
<translation id="6244277266078678766">ውሂብዎ ለ<ph name="USER_EMAIL" /> የይለፍ ቃል አስተዳዳሪ ላይ ይቀመጣል።</translation>
<translation id="6268381023930128611">ከVortex ተዘግቶ ይውጣ?</translation>
<translation id="6301717043141881464">በሌሎች መተግበሪያዎችዎ ውስጥ የተቀመጡ የይለፍ ቃላትዎን በቀላሉ ለማግኘት Vortex ለራስ-ሙላን ይምረጡ</translation>
<translation id="6324041800010509197">በVortex ውስጥ የትር ፍርግርን ይጎብኙ</translation>
<translation id="6325378625795868881">በመልዕክቶች እና ሌሎች መተግበሪያዎች ውስጥ ያሉ አገናኞች ላይ መታ በሚያደርጉበት ማንኛውም ጊዜ Vortexን ይጠቀሙ።</translation>
<translation id="6387994184698195448">አጋዥ Vortex ጠቃሚ ምክሮችን እና ሌሎችንም ይከታተሉ።</translation>
<translation id="6424492062988593837">Vortex አሁን ተሻሽሏል! አዲስ ስሪት አለ።</translation>
<translation id="6433172051771630690">ከVortex ምርጡን ለማግኘት ጠቃሚ ምክሮች።</translation>
<translation id="65045991564554105">የVortex ዕልባቶችን ይመልከቱ</translation>
<translation id="6519797228806907665">ከእርስዎ iPhone መነሻ ማያ ገጽ ላይ Vortexን ይበልጥ በፍጥነት ይድረሱ።</translation>
<translation id="6538713818758208754">በVortex ውስጥ የመክፈያ ዘዴዎች ቅንብር ገፅን ይከፍታል።</translation>
<translation id="6540186279384079894">በVortex ውስጥ አዲስ ትር ይክፈቱ</translation>
<translation id="6563921047760808519"><ph name="BEGIN_LINK" />Vortex እንዴት የእርስዎን ውሂብ በግል እንደሚያስቀምጥ<ph name="END_LINK" /> የበለጠ ይወቁ</translation>
<translation id="6564769014061914792">በእርስዎ iPad ላይ ከVortex ምርጡን ለማግኘት እዚህ መታ ያድርጉ።</translation>
<translation id="6566303693324540692">የVortex ጠቃሚ ምክር፦ Vortexን ወደ መነሻ ማያ ገጽዎ ያንቀሳቅሱ</translation>
<translation id="6574750762636192517">በVortex ውስጥ የይለፍ ቃላትን ያስተዳድሩ</translation>
<translation id="6590232959690355435">የእርስዎን Vortex የታሪክ ገፅ ይከፍታል።</translation>
<translation id="6649269674808477353">በእርስዎ iPhone ላይ ለማሰስ ዝግጁ ሲሆኑ Vortexን ይበልጥ በፍጥነት ይክፈቱ።</translation>
<translation id="6674470628873622334">አዲስ የVortex ማንነት የማያሳውቅ ትር ይከፍታል።</translation>
<translation id="6680609900732453726">Vortex በሚዘጉበት ጊዜ በመሣሪያ ማረጋገጫ አሰሳዎን በመሣሪያ ማረጋገጫ ግላዊ አድርገው ይቆዩ</translation>
<translation id="6752854822223394465">የእርስዎ ድርጅት Vortexን እያዋቀረ ነው...</translation>
<translation id="6794054469102824109">የVortex Dino ጨዋታውን ይከፍታል።</translation>
<translation id="6820823224820483452">Vortex ሁሉንም የይለፍ ቃሎች ማረጋገጥ አልቻለም። ነገ እንደገና ይሞክሩ።</translation>
<translation id="6830782797004194206">በVortex ራስ-ሙላ ይበልጥ በፍጥነት ይግቡ</translation>
<translation id="6831043979455480757">መተርጎም</translation>
<translation id="6852419005633611413">ከመነሻ ማያ ገፅዎ መትከያ Vortex በፍጥነት ይድረሱ</translation>
<translation id="6852799557929001644">የእርስዎን የVortex የይለፍ ቃላት እና ሌሎችንም በዚህ መሣሪያ ላይ ባሉ ሌሎች መተግበሪያዎች ላይ ይድረሱ።</translation>
<translation id="6887138405044152640">ይህን ትር ወደ ሌላ መሣሪያ ለመላክ፣ እዚያ ላይ ወደ Vortex ይግቡ።</translation>
<translation id="6911341667534646387">በGoogle መለያዎ ውስጥ የVortex ውሂብን መጠቀምዎን ይቀጥሉ</translation>
<translation id="7018284295775193585">Vortex መዘምን አልቻለም</translation>
<translation id="7055269218854630176">ድርጅትዎ <ph name="DOMAIN" />፣ የሚገቡበትን መለያ እና Vortex እንዴት ጥቅም ላይ እንደሚውል ያስተዳድራል። አስተዳዳሪዎ የተወሰኑ ባህሪያትን ማዋቀር ወይም መገደብ ይችላል።</translation>
<translation id="7099326575020694068">Vortex ካሜራዎን በተከፈለ ዕይታ ሁነታ ላይ መጠቀም አይችልም</translation>
<translation id="7165402419892018581">ለራስ-ሙላ Vortexን ይምረጡ</translation>
<translation id="7175400662502680481">የይለፍ ቃልዎ በውሂብ ጥሰት ውስጥ ተጋልጧል። የይለፍ ቃል አስተዳዳሪ አሁን እንዲቀይሩት ይመክራል።</translation>
<translation id="7185731475720473450">የመክፈያ ዘዴዎች እና አድራሻዎች አይመሰጠሩም። የVortex የአሰሳ ታሪክ አይሰምርም።

የእርስዎን የተመሰጠረ ውሂብ ማንበብ የሚችለው የይለፍ ሐረግዎ ያለው ሰው ብቻ ነው። የይለፍ ሐረጉ ወደ Google አይላክም ወይም በGoogle አይከማችም። የይለፍ ሐረግዎን ከረሱ ወይም ይህን ቅንብር መለወጥ ከፈለጉ <ph name="BEGIN_LINK" />በመለያዎ ውስጥ ያለውን የVortex ውሂብን ይሰርዙ<ph name="END_LINK" />።</translation>
<translation id="7192111075364461693">አሁን ላይ በመሣሪያዎ ቅንብሮች ውስጥ የVortex ማሳወቂያዎች ጠፍተዋል።</translation>
<translation id="7195217321165708458">Gemini በVortex ውስጥ</translation>
<translation id="7219205286115692265">ከእርስዎ iPad መነሻ ማያ ገፅ መትከያ ላይ Vortex ይበልጥ በፍጥነት ይድረሱ።</translation>
<translation id="7222001353246886083">በVortex ውስጥ ${searchPhrase}ን ይፈልጉ</translation>
<translation id="7228180817326917122">Vortex ጠቃሚ ምክር፦ የአድራሻ አሞሌዎን ቦታ ይምረጡ</translation>
<translation id="725427773388857052">Vortex እርስዎን ከውሂብ ጥሰቶች፣ ደህንነታቸው ካልተጠበቁ ድር ጣቢያዎች እና ከተጨማሪ ነገሮች ለመጠበቅ ሊያግዘዎት ይችላል።</translation>
<translation id="7269362888766543920">አንዳንድ ተጨማሪዎች Vortex እንዲበላሽ ያደርጋሉ። እባክዎ እነሱን ለማራገፍ ይሞክሩ።</translation>
<translation id="7285031092584344905">የእርስዎን የVortex የይለፍ ቃላት እና ሌሎችንም በሌሎች መተግበሪያዎች ላይ ይድረሱ።</translation>
<translation id="7337881442233988129">Vortex</translation>
<translation id="7395825497086981028">የይለፍ ቃልዎ ለ<ph name="EMAIL" /> በይለፍ ቃል አስተዳዳሪ ላይ ይቀመጣል።</translation>
<translation id="7434848749522628428">ይህ የይለፍ ቁልፍ የይለፍ ቃል አስተዳዳሪ ላይ ለ<ph name="USER_EMAIL" /> ይቀመጣል።</translation>
<translation id="7504829997542308412">Vortex ይክፈቱ</translation>
<translation id="7531461704633548377">ከVortex</translation>
<translation id="7554983317097061001">Vortex ጠቃሚ ምክር፦ Vortex ወደ መትከያው ያንቀሳቅሱ</translation>
<translation id="7576863740961052505">የVortex ቅንብሮችን ያስተዳድሩ</translation>
<translation id="7674213385180944843">ቅንብሮች &gt; ግላዊነት &gt; ካሜራ &gt; Vortex ይክፈቱ እና ማይክሮፎን ያብሩ።</translation>
<translation id="7685160423563372998">በVortex ውስጥ በGemini ምስል ይፍጠሩ</translation>
<translation id="7733418656985455268">የVortex ጠቃሚ ምክር፦ በሌንስ ይፈልጉ</translation>
<translation id="7747820849741499258">በVortex ውስጥ ይፈልጉ</translation>
<translation id="7753923083404296545">Vortex ማንነት የማያሳውቅ ውስጥ ተከፍቷል</translation>
<translation id="7762622637388462191">ከVortex ሲወጡ ወይም ወደ ሌላ መተግበሪያ ሲቀይሩ የእርስዎን ማንነት የማያሳውቁ ትሮች ይቆልፉ።</translation>
<translation id="7763454117143368771">ከአደገኛ ጣቢያዎች እንዲጠበቁ እና የይለፍ ቃላትዎን ደህንነት ለመጠበቅ Vortexን እንደ ነባሪ አሳሽዎ ይጠቀሙ</translation>
<translation id="7784950022329154821">Vortex ሲዘጉ ማንነት የማያሳውቁ ትሮችን ይቆልፉ</translation>
<translation id="78025249032851484">የእርስዎ Vortex ጊዜው ያለፈበት ነው።</translation>
<translation id="7859018312476869945">የአድራሻ አሞሌ ወይም የፍለጋ ሳጥን ውስጥ ሲተይቡ የተሻሉ ጥቆማዎችን ለማግኘት Vortex የሚተይቡትን ለእርስዎ ነባሪ የፍለጋ ፕሮግራም ይልካል። ይህ ማንነት የማያሳውቅ ውስጥ ጠፍቷል።</translation>
<translation id="7890287942691234100">የVortex ቃኚውን መጠቀም ይጀምሩ</translation>
<translation id="7905064834449738336">የይለፍ ቃል ሲጠቀሙ Vortex በመስመር ላይ ታትሞ ከነበረ ያስጠነቅቅዎታል። ይህን በሚያደርግበት ጊዜ የእርስዎ የይለፍ ቃላት እና የተጠቃሚ ስሞች Googleን ጨምሮ በሌላ ማንም ወገን እንዳይነበቡ ይመሰጠራሉ።</translation>
<translation id="7928628054454574139">በሌሎች መተግበሪያዎች ውስጥ ያሉ አገናኞችን በማንኛውም ጊዜ መታ ሲያደርጉ Vortexን ይክፈቱ</translation>
<translation id="7934404985878918282">የVortex የንባብ ዝርዝርን ይመልከቱ</translation>
<translation id="7935734571048689933">Vortex ይተዳደራል</translation>
<translation id="7951793218148208717">በVortex ውስጥ አዲስ ትር ይከፍታል።</translation>
<translation id="7957726318578167662">በመልዕክቶች ወይም በሌሎች መተግበሪያዎች ውስጥ ያሉ አገናኞችን መታ በሚያደርጉበት ማንኛውም ጊዜ Vortexን በቀላሉ ይጠቀሙ።</translation>
<translation id="7980860476903281594">Vortex እርስዎ ለሚፈቅዷቸው ጣቢያዎች አካባቢዎን ያጋራል።</translation>
<translation id="7994322153108931467">አጋዥ የሆኑ የVortex ምክሮችን ለማግኘት፣ በiOS ቅንብሮችዎ ውስጥ ማሳወቂያዎችን ያብሩ።</translation>
<translation id="7997159823054171568">Vortex እንደ ነባሪ አሳሸ ያቀናብሩ</translation>
<translation id="800380310260616129">Vortex እዚህ ያውርዱ።</translation>
<translation id="8013573822802650211">Vortexን ከሚጠቀሙበት የትኛዉም ቦታ ትሮችን ለማየት በሁሉም መሣሪያዎችዎ ላይ ይግቡ</translation>
<translation id="8014091604604659473">Vortex ዘግቶ ወጥቷል</translation>
<translation id="8104697640054703121">ከአደገኛ ጣቢያዎች የሚጠብቅ የVortex ጠንካራውን ደህንነት ያግኙ</translation>
<translation id="8119542592987737574">ከእርስዎ iPhone መነሻ ማያ ገፅ መትከያ ላይ Vortex ይበልጥ በፍጥነት ይድረሱ።</translation>
<translation id="8164086860209325020">ወደ Vortex ቅንብሮች ይሂዱ</translation>
<translation id="8197822717502700527">አሁን በመሣሪያዎ ላይ ከVortex ምርጡን ያገኛሉ።</translation>
<translation id="8236210361418193126">ወደ የይለፍ ቃል አስተዳዳሪ አምጣ</translation>
<translation id="8254729934443216898">ከVortex ማግኘት የሚቻለውን ሁሉ ለማግኘት የሚያግዙዎትን አዳዲስ ባህሪያት ያስሱ።</translation>
<translation id="8293572045658095405">Vortex ማንነት የማያሳውቅ ውስጥ ነዎት</translation>
<translation id="830951810931292870">የገቡትን ዩአርኤልዎች ማንነት በማያሳውቅ Vortex ውስጥ ይከፍታል።</translation>
<translation id="8385503371191508165">የይለፍ ቁልፎችን በይለፍ ቃል አስተዳዳሪ ማስቀመጥ ይጀምሩ</translation>
<translation id="8390323835464055390">ለራስ-ሙላ Vortex በመጠቀም በእርስዎ የተቀመጡ የይለፍ ቃላት እና የይለፍ ቁልፎች ከማንኛውም መተግበሪያ በመለያ ይግቡ</translation>
<translation id="8409374867500149834">ከጎጂ ድር ጣቢያዎች የሚከላከል የVortex በጣም ጠንካራ ጥበቃ አለዎት</translation>
<translation id="8543509361021925846">{THRESHOLD,plural, =1{ይህ የሚሆነው Vortex ለ{THRESHOLD} ደቂቃ ስራ ላይ ሳይውል ሲቀር ነው። በመለያ ገብተው ሳለ በዚህ መሣሪያ ላይ የተቀመጠ ውሂብ ብቻ ይሰረዛል። ይህ ታሪክን እና የይለፍ ቃላትን ሊያካትት ይችላል።}one{ይህ የሚሆነው Vortex ለ{THRESHOLD} ደቂቃ ስራ ላይ ሳይውል ሲቀር ነው። በመለያ ገብተው ሳለ በዚህ መሣሪያ ላይ የተቀመጠ ውሂብ ብቻ ይሰረዛል። ይህ ታሪክን እና የይለፍ ቃላትን ሊያካትት ይችላል።}other{ይህ የሚሆነው Vortex ለ{THRESHOLD} ደቂቃዎች ስራ ላይ ሳይውል ሲቀር ነው። በመለያ ገብተው ሳለ በዚህ መሣሪያ ላይ የተቀመጠ ውሂብ ብቻ ይሰረዛል። ይህ ታሪክን እና የይለፍ ቃላትን ሊያካትት ይችላል።}}</translation>
<translation id="8586442755830160949">የቅጂ መብት <ph name="YEAR" /> የVortex ደራሲያን። ሁሉም መብቶች የተጠበቁ ናቸው።</translation>
<translation id="8602103377623855616">የVortex ገፅ</translation>
<translation id="865600487977764604">በVortex ላይ ደህንነትዎን ይጠብቃል እና በመለያ በገቡባቸው ሌሎች የGoogle መተግበሪያዎች ላይ ደህንነትዎን ለማሻሻል ሥራ ላይ ሊውል ይችላል።</translation>
<translation id="8663480472502753423">Vortexን እንደተዘመነ ያቆዩ</translation>
<translation id="8685813584220679697">ወደዚህ ጣቢያ እና Vortex ይግቡ።</translation>
<translation id="8698780336333802489">ወደ Vortex አምጣ</translation>
<translation id="8730503818204408000">Vortexን እንደ ነባሪ አሳሸ ለማቀናበር የVortex ቅንብርን ይከፍታል።</translation>
<translation id="8754966941001340678">Vortex የላቀ ጥበቃን ይመክራል</translation>
<translation id="8759037115129007407">በአሁኑ ጊዜ የቤተሰብ አባልዎ የይለፍ ቃሎችን መቀበል አይችሉም። Vortex እንዲያዘምኑ እና የይለፍ ቃላቸውን እንዲያሰምሩ ይጠይቋቸው። <ph name="BEGIN_LINK" />የበለጠ ለመረዳት<ph name="END_LINK" /></translation>
<translation id="8769418653786388149">የእርስዎን Vortex ይዘው ይሂዱ</translation>
<translation id="8776843108004031667">ይህ መለያ እና ማንኛውም ያልተቀመጠ ውሂብ ከVortex ይወገዳል።</translation>
<translation id="8793333988063379360">የVortex ቅንብሮችን እና ሌሎችን እዚህ ማግኘት ይችላሉ</translation>
<translation id="8805148242934787134">Vortex እንደ ነባሪ አሳሸ ያቀናብሩ</translation>
<translation id="8826789549860004832">አሳሽዎን ማቀናበር በመቀጠል ከVortex ማግኘት የሚችሉትን ሁሉ ያግኙ።</translation>
<translation id="88376265765385899">የVortex እልባቶችን ይከፍታል።</translation>
<translation id="8860548555286245440">የማይታወቁ ዩአርኤልዎችን በማንነት የማያሳውቅ Vortex ይክፈቱ</translation>
<translation id="8880024619507699923">Vortex ለመጠቀም የእርስዎ ድርጅት እርስዎ በመለያ እንዲገቡ ይጠይቃል። <ph name="BEGIN_LINK" />የበለጠ ለመረዳት<ph name="END_LINK" /></translation>
<translation id="8900052431807804054">የVortex ጠንካራ ደህንነትን ያግኙ</translation>
<translation id="8908791447256515663">ከእርስዎ iPad መትከያ ላይ Vortexን ይበልጥ በፍጥነት ይድረሱ።</translation>
<translation id="8925569192291721236">የዋጋ ክትትል ዝማኔዎችን እና የVortex ጠቃሚ ምክሮችን ይከታተሉ።</translation>
<translation id="8950326149985259075">{THRESHOLD,plural, =1{ይህ የሚሆነው Vortex ለ{THRESHOLD} ደቂቃ ጥቅም ላይ ሳይውል ሲቀር ነው}one{ይህ የሚሆነው Vortex ለ{THRESHOLD} ደቂቃዎች ጥቅም ላይ ሳይውል ሲቀር ነው}other{ይህ የሚሆነው Vortex ለ{THRESHOLD} ደቂቃዎች ጥቅም ላይ ሳይውል ሲቀር ነው}}</translation>
<translation id="8963279154877372067">የዋጋ ቅናሽ ማንቂያዎችን ለማግኘት የVortex ማሳወቂያዎችን ይፍቀዱ</translation>
<translation id="8975812008711371178">በVortex ውስጥ በድምፅ ይፈልጉ</translation>
<translation id="900560297598578021">እንደ <ph name="EMAIL" /> ሆነው ገብተዋል።

<ph name="TIME" /> ላይ ውሂብዎ በይለፍ ሐረግዎ የተመሰጠረ ሆኗል። የVortex ውሂብን በGoogle መለያዎ ውስጥ ለመጠቀም እና ለማስቀመጥ እሱን ያስገቡ።</translation>
<translation id="9022552996538154597">Vortex ውስጥ ይግቡ</translation>
<translation id="9031260906956926157">አንዳንድ የVortex ውሂብዎ በGoogle መለያዎ ውስጥ ገና አልተቀመጠም።
ዘግተው ከመውጣትዎ በፊት ጥቂት ደቂቃዎች ለመጠበቅ ይሞክሩ። አሁን ዘግተው ከወጡ ይህ ውሂብ ይሰረዛል።</translation>
<translation id="9050790730841755540">በሌሎች መተግበሪያዎች ውስጥ ያሉ አገናኞች ላይ መታ በሚያደርጉበት ማንኛውም ጊዜ Vortexን ይጠቀሙ።</translation>
<translation id="9059693977935746710">ይህን የይለፍ ቃል ማስታወስ አያስፈልገዎትም። ለ<ph name="EMAIL" /> በይለፍ ቃል አስተዳዳሪ ላይ ይቀመጣል</translation>
<translation id="9089354809943900324">Vortex ጊዜው አልፎበታል</translation>
<translation id="9105645282262300612">የVortex ጠቃሚ ምክር፦ የሚመለከቱትን ይፈልጉ</translation>
<translation id="9152995302810511799">የVortex ጠቃሚ ምክር፦ የVortexን ጠንካራ ደህንነት ያግኙ</translation>
<translation id="9177628952266852500"><ph name="EMAIL" />። Vortex ይተዳደራል።</translation>
<translation id="921174536258924340">Vortex ሁሉንም የይለፍ ቃሎች ማረጋገጥ አልቻለም። ነገ እንደገና ይሞክሩ ወይም <ph name="BEGIN_LINK" />የGoogle መለያዎን ይለፍ ቃላት ይፈትሹ።<ph name="END_LINK" /></translation>
<translation id="924957577793602335">Vortexን የራስዎ ያድርጉት</translation>
<translation id="981812233959540767">የVortex Dino ጨዋታን ይጫወቱ</translation>
<translation id="985602178874221306">የVortex ደራሲዎች</translation>
