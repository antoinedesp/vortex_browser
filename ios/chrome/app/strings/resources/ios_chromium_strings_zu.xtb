<translation id="7531461704633548377">Ukusuka kuVortex</translation>
<translation id="7554983317097061001">Ithiphu yeVortex: Hambisa iVortex kudokhi</translation>
<translation id="7576863740961052505">Phatha amasethingi eVortex</translation>
<translation id="7674213385180944843">Vula izilungiselelo &gt; Ubumfihlo &gt; Ikhamera &gt; i-Vortex uphinde uvule ikhamera.</translation>
<translation id="7685160423563372998">Sungula isithombe ngeGemini kuVortex</translation>
<translation id="7733418656985455268">Ithiphu yeVortex: Sesha ngeLens</translation>
<translation id="7747820849741499258">Sesha ku-Vortex</translation>
<translation id="7753923083404296545">Kuvulwe kuVortex Incognito</translation>
<translation id="7762622637388462191">Khiya ithebhu ye-Incognito yakho uma ushiya iVortex noma ushintshela ku-app ehlukile.</translation>
<translation id="7763454117143368771">Sebenzisa i-Vortex njengesiphequluli sakho esiyinhloko ukuze uhlale uvikelekile kumasayithi ayingozi futhi ugcine amphasiwedi akho aphephile</translation>
<translation id="7784950022329154821">Khiya amathebhu we-Incognito lapho uvala iVortex</translation>
<translation id="78025249032851484">I-Vortex yakho isiphelelwe yisikhathi.</translation>
<translation id="7859018312476869945">Uma uthayipha ibha yekheli noma ibhokisi losesho, i-Vortex ithumela lokho okuthayiphayo kunjini yakho yosesho yokuzenzakalelayo ukuze uthole iziphakamiso ezingcono. Lokhu kuvaliwe ku-Incognito.</translation>
<translation id="7890287942691234100">Qala ukusebenzisa iskena se-Vortex</translation>
<translation id="7905064834449738336">Uma usebenzisa iphasiwedi, i-Vortex iyakuxwayisa uma ishicilelwe ku-inthanethi. Uma yenza lokhu, amaphasiwedi akho namagama abasebenzisi ayabethelwa, ukuze angakwazi ukufundwa yinoma ngubani, kubandakanya ne-Google.</translation>
<translation id="7928628054454574139">Vula i-Vortex noma kunini lapho uthepha kumalinki kwamanye ama-app</translation>
<translation id="7934404985878918282">Bona Uhlu Lokufunda Lwe-Vortex</translation>
<translation id="7935734571048689933">IVortex iphethwe</translation>
<translation id="7951793218148208717">Vula ithebhu entsha kuVortex.</translation>
<translation id="7957726318578167662">Sebenzisa kalula iVortex noma nini uma uthepha amalinki emilayezweni noma kwamanye ama-app.</translation>
<translation id="7980860476903281594">I-Vortex yabelana ngendawo yakho namasayithi owavumelayo.</translation>
<translation id="7994322153108931467">Ukuze uthole amathiphu awusizo e-Vortex, vula izaziso kumasethingi wakho e-iOS.</translation>
<translation id="7997159823054171568">Setha iVortex njengebhrawuza evuleka ngokuzenzekela</translation>
<translation id="800380310260616129">Dawuniloda iVortex lapha.</translation>
<translation id="8013573822802650211">Ukuze ubone amathebhu wakho noma kuphi lapho usebenzisa i-Vortex, ngena ngemvume kuwo wonke amadivayisi wakho</translation>
<translation id="8014091604604659473">IVortex iphume ngemvume</translation>
<translation id="8104697640054703121">Thola ukuvikeleka okuqine kakhulu kwe-Vortex kumasayithi ayingozi</translation>
<translation id="8119542592987737574">Finyelela iVortex ngokushesha ukusuka kudokhi yesikrini sasekhaya se-iPhone yakho.</translation>
<translation id="8164086860209325020">Iya kokuthi Amasethingi e-Vortex</translation>
<translation id="8197822717502700527">Manje uzozuza okuningi ku-Vortex kudivayisi yakho.</translation>
<translation id="8236210361418193126">Ngenisa kuPassword Manager</translation>
<translation id="8254729934443216898">Hlola izakhi ezintsha ezikusiza ukuthi uthole okuningi ku-Vortex.</translation>
