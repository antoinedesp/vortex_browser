<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="zu">
<translation id="1000436330784933699">Ungavula iLens lapha.</translation>
<translation id="1042296835509784301">Ivula Isiphathi Sephasiwedi kuVortex.</translation>
<translation id="1047130070405668746">Khetha i-Vortex</translation>
<translation id="1091252999271033193">Lokhu kusho ukuthi i-Vortex izocela isayithi yeselula ngaso sonke isikhathi.</translation>
<translation id="1115463765356382667">Qedela lezi zenzo eziphakanyisiwe ngezansi ukuze uthole okuningi ku-Vortex.</translation>
<translation id="1185134272377778587">Mayelana ne-Vortex</translation>
<translation id="1211450393895337634">Vula iVortex ngokushesha uma usulungele ukubhrawuza ku-iPad yakho.</translation>
<translation id="1229234641991056119">Sebenzisa amaphasiwedi, umlando, amabhukhimakhi, namakhadi akho esikweletu kuVortex</translation>
<translation id="1257458525759135959">Ukuze ulondoloze izithombe, thepha Amasethingi ukuze uvumele i-Vortex ingeze ezithombeni zakho</translation>
<translation id="1260702988262336471">Vula imenyu yeVortex</translation>
<translation id="12739128458173458">Ukuze uthumele le thebhu kwenye idivayisi, ngena ngemvume ku-Vortex kuwo womabili amadivayisi.</translation>
<translation id="1361748954329991663">I-Vortex iphelelwe isikhathi. Uma kungekho sibuyekezo esitholakalayo <ph name="BEGIN_LINK" />ku-App Store<ph name="END_LINK" />, kungenzeka ukuthi idivayisi yakho ayisazisekeli izinguqulo ezintsha ze-Vortex.</translation>
<translation id="1383876407941801731">Sesha</translation>
<translation id="1423007117030725713">Qala ukusesha kuthebhu entsha ye-Vortex.</translation>
<translation id="1431818719585918472">Vumela i-Vortex ikhiye amathebhu wakho we-Incognito.</translation>
<translation id="1451665391191990528">Fihla amathebhu e-Incognito avuliwe uma ushiya iVortex</translation>
<translation id="146407871188825689">Sebenzisa iVortex ku-iPad Ngokuzenzakalelayo</translation>
<translation id="1471084500615228555">Sula idatha yokubhrawuza kuVortex</translation>
<translation id="1472013873724362412">I-akhawunti yakho ayisebenzi ku-Vortex. Sicela uxhumane nomqondisi wesizinda noma usebenzise i-akhawunti ejwayelekile ye-Google ukuze ungene ngemvume.</translation>
<translation id="148576268809812097">Londoloza Amaphasiwedi Akho kuVortex</translation>
<translation id="1501302548410882220">Sebenzisa iVortex yonke indawo</translation>
<translation id="1502360822835740515">Yenza i-Vortex isiphequluli sakho esizenzakalelayo</translation>
<translation id="1503199973012840174">I-Vortex yakho isiphelelwe yisikhathi. Ibuyekeze ukuze uhlale uphephile.</translation>
<translation id="1515748263297244785">Sebenzisa iVortex ye-iPad ngokuzenzakalela</translation>
<translation id="1530961174488670696">IVortex ayikwazanga ukuhlola izibuyekezo. Zama futhi ngokuhamba kwesikhathi.</translation>
<translation id="1531155317299575425">Ibonisa isiqondiso sokungena ngemvume ku-Vortex.</translation>
<translation id="1553657876656159572">Okuphakelayo okungokwezifiso okwenzelwe wena. Kubandakanya izindaba, ezemidlalo kanye nesimo sezulu.</translation>
<translation id="1561849081734670621">Ukuze uvale Imodi Yokukhiya ku-Vortex yivale ku-iPhone yakho.</translation>
<translation id="1569258826720962327">Sebenzisa izenzo zeVortex ku-iOS</translation>
<translation id="1573441572176948907">Hambisa iVortex kudokhi yakho</translation>
<translation id="159029779861043703">I-Vortex igcina idatha yakho enozwelo ivikelekile nge-Face ID.</translation>
<translation id="1591119736686995611">Vula Ithebhu Ye-Grid Ye-Vortex.</translation>
<translation id="16001233025397167">Ukuhlolwa Kokuphepha kukugcina uvikelekile ekuphulweni kwesivumelwano sedatha, kumasayithi angaphephile nakokunye. Thola izexwayiso mayelana nanoma iziphi izinkinga ezithinta ubumfihlo nokuvikeleka iVortex ekutholela zona.</translation>
<translation id="1617663976202781617">Idatha kusukela ekuvunyelanisweni kwe-Vortex</translation>
<translation id="164952285225495380">Le phakheji isivele ilandelelwe ku-Vortex.</translation>
<translation id="1707458603865303524">Sebenzisa i-Vortex noma nini uma uthepha amalinki kumilayezo noma kwamanye ama-app.</translation>
<translation id="1722370509450468186">Iphasiwedi yakho izolondolozwa ku-Account yakho (<ph name="EMAIL" />).</translation>
<translation id="1747088204252710672">Okuphakelayo okumuntu ngamunye okwenzelwe wena</translation>
<translation id="1811860791247653035">Ukuze uthole ukwenza ngokomuntu ngamunye nezinye izakhi, okufaka i-Vortex ku-<ph name="FEATURE_NAME_1" /> naku-<ph name="FEATURE_NAME_2" /></translation>
<translation id="1838412507805038478">I-Vortex iqinisekise ukuthi i-<ph name="ISSUER" /> ikhiphe isitifiketi sale webhusayithi.</translation>
<translation id="1839447949248872139">Vula amalinki kuVortex Ngokuzenzakalelayo</translation>
<translation id="1843424232666537147">I-Vortex inezici ezikusiza ukuthi uphathe idatha yakho ye-inthanethi nokuthi ulayisha kanjani ngokushesha amakhasi ewebhu.
<ph name="BEGIN_LINK" />Funda kabanzi<ph name="END_LINK" /></translation>
<translation id="1847960401032164406">I-Maps ku-Vortex</translation>
<translation id="1867772173333403444">4. Khetha i-Vortex</translation>
<translation id="1965068424387304464">Ithiphu yeVortex: Londoloza Amaphasiwedi</translation>
<translation id="2006345422933397527">I-Vortex ayikwazanga ukuhlola izibuyekezo. Zama ukuhlola ukuxhumeka kwakho ku-inthanethi.</translation>
<translation id="2042889939382983733">Buka umlando wakho we-Vortex</translation>
<translation id="2052320862053429062">I-Vortex ngezikhathi ezithile ihlola amaphasiwedi akho ngokumelene nohlu olushicilelwe ku-inthanethi. Uma yenza lokhu, amaphasiwedi akho namagama abasebenzisi ayabethelwa, ukuze angakwazi ukufundwa yinoma ubani, kubandakanya ne-Google.</translation>
<translation id="2059365270911640413">Qedela ukusetha iVortex</translation>
<translation id="2168108852149185974">Ezinye izengezo zibangela i-Vortex ukuthi iphahlazeke. Sicela uzikhiphe:</translation>
<translation id="2168593389981132306">Yenza iVortex ibe ngcono</translation>
<translation id="2178608107313874732">I-Vortex ayikwazi ukusebenzisa ikhamera yakho khona manje</translation>
<translation id="2195025571279539885">Ungathanda ukuthi i-Vortex inikezele ukuhumusha amakhasi esi-<ph name="LANGUAGE_NAME" /> kusukela kuleli sayithi ngesikhathi esizayo?</translation>
<translation id="22313767259766852">Leli kheli okwamanje lilondolozwe ku-Vortex. Ukuze uyisebenzise emikhiqizweni ye-Google, yilondoloze ku-Google Account yakho, <ph name="USER_EMAIL" />.</translation>
<translation id="2236584955986023187">Lokhu kusho ukuthi i-Vortex izocela isayithi yedeskithophu ngaso sonke isikhathi.</translation>
<translation id="2245694534483711162">IGemini ingase isebenzise indawo yakho eqondile, kuye ngemvume osuvele uyinike iVortex</translation>
<translation id="2270466829363945454">Thenga</translation>
<translation id="2313870531055795960">Kuhlola ama-URL anohlu lwamasayithi angaphephile agcinwe ku-Vortex. Uma isayithi lizama ukuntshontsha iphasiwedi yakho, noma uma ulanda ifayela eliyingozi, i-Vortex ingathumela nama-URL, kuhlanganise nokuthile okuqukethwe kulelo khasi, Ekuphequluleni Okuphephile.</translation>
<translation id="2314220608288760290">IVortex ivula ngokuzenzekela amalinki eYouTube Incognito ku-Incognito.</translation>
<translation id="231828342043114302">Ukuze uthole okuqukethwe okwenzelwe wena ngokusekelwe kokuthandayo, ngena ngemvume ku-Vortex.</translation>
<translation id="2326738825692478496">Enye idatha yakho yeVortex ayikalondolozwa kuGoogle Account.

Zama ukulinda imizuzu embalwa ngaphambi kokuphuma. Uma uphuma ngemvume manje, le datha izosulwa.</translation>
<translation id="2337722506862731008">Yabelana ngeVortex</translation>
<translation id="2340423701577464731">Faka into yohlu lokufunda kuVortex</translation>
<translation id="2374627437126809292">I-Vortex isebenzisa Amamephu eGoogle ukuze ikunikeze izikhombisi-ndlela nolwazi lwasendaweni kumakheli atholiwe.</translation>
<translation id="2386292341327187942">Ebhokisini elithi Amawijethi Okusesha, faka i-Vortex</translation>
<translation id="2389827884654658221">Finyelela kuVortex ngokushesha kusuka Esikrinini sakho Sasekhaya se-iPad.</translation>
<translation id="2426113998523353159">Inhlangano yakho idinga ukuba ungene ngemvume ukuze usebenzise i-Vortex.</translation>
<translation id="2450140762465183767">Manje ungasebenzisa i-Vortex noma nini uma uthepha ama-app kumilayezo, amadokhumenti, namanye ama-app.</translation>
<translation id="2459183986985456602">Vula ithebhu yami yakamuva kuVortex.</translation>
<translation id="2476409803017965813">Ungabuyekeza okukhethile noma nini kumasethingi eVortex.</translation>
<translation id="2478931088402984578">Khetha i-<ph name="BEGIN_BOLD" />Vortex<ph name="END_BOLD" /></translation>
<translation id="2485774047568879945">Setha iVortex njengebhrawuza yakho evuleka ngokuzenzekela ukuze wabelane kalula futhi uvule amalinki</translation>
<translation id="2512597191798760956">Cindezela futhi ubambe isithonjana seVortex bese uchofoza okuthi "Hlela isikrini sasekhaya"</translation>
<translation id="2517624234762908348">Vumelanisa idatha yakho ye-Vortex</translation>
<translation id="2575968074225731646">Finyelela iVortex ngokushesha ukusuka kuDokhi ye-iPhone yakho.</translation>
<translation id="2592940277904433508">Qhubeka usebenzisa i-Vortex</translation>
<translation id="2607609479243848905">Uma ukhohlwa umushwana wakho wokungena noma ufuna ukushintsha le sethingi, <ph name="BEGIN_LINK" />sula idatha ye-Vortex e-akhawuntini yakho<ph name="END_LINK" />.</translation>
<translation id="2640367368802736659">Ithiphu yeVortex: Sesha okubonayo ngeGoogle Lens</translation>
<translation id="2650312721222849884">Ukuze ubone amathebhu wakho noma kuphi lapho usebenzisa khona i-Vortex, vula ukuvumelanisa</translation>
<translation id="2684230048001240293">Setha i-Vortex njengesiphequluli esizenzakalelayo ukuze uvumelanise amathebhu akho, amaphasiwedi, nolwazi lokukhokha kuwo wonke amadivayisi akho</translation>
<translation id="2729836253097154631">Ngena ngemvume kuVortex ukuze uthole izinto zakho</translation>
<translation id="2730884209570016437">I-Vortex ayikwazi ukusebenzisa ikhamera yakho ngoba isetshenziswa olunye uhlelo lokusebenza</translation>
<translation id="2742952311155593352">Usuzoqeda ukusetha iVortex!</translation>
<translation id="2798503587425057129">Ivula Uhlu Lokufunda Lwe-Vortex.</translation>
<translation id="28276745681323897"><ph name="BEGIN_LINK" />Ungaphatha ukuthi iyiphi idatha ye-Vortex elondolozwa<ph name="END_LINK" /> ku-Google Account yakho.

Ukuze uthole amasethingi engeziwe asebenzisa idatha ukuthuthukisa ukuzizwisa kwakho kwe-Vortex, iya <ph name="BEGIN_LINK" />Kumasevisi e-Google<ph name="END_LINK" />.</translation>
<translation id="2832168932648876507">Sesha ngezwi kuVortex.</translation>
<translation id="2843571538056574338">Sebenzisa i-Vortex kokuthi Ukugcwalisa okuzenzakalelayo</translation>
<translation id="2918709798697875261">Inhlangano yakho idinga ukuthi uhlale ukhishwe ngemvume ku-Vortex.</translation>
<translation id="2942241131342758843">Sebenzisa i-Vortex ngokuzenzekelayo ukuze uvule amalinki, ukusesha kumawijethi, kanye nokugcwalisa ngokuzenzakalelayo amaphasiwedi kwamanye ama-app</translation>
<translation id="2977470724722393594">I-Vortex isesikhathini samanje</translation>
<translation id="3044857325852340337">Idatha ye-Vortex isuliwe</translation>
<translation id="3054480780637153380">Vula amasethingi weVortex ku-iOS, bese uthepha okuthi "I-App Yebhrawuza Evuleka Ngokuzenzekela" bese ukhetha iVortex.</translation>
<translation id="3115956258722352278">Yenza i-Vortex ibe ibhrawuza yakho yokuzenzakalelayo?</translation>
<translation id="3180939591219927904">Vula okuthi "Khiya amathebhu e-Incognito uma uvala iVortex"</translation>
<translation id="328933489847748230">{count,plural, =1{Manje kuvela iwindi le-Vortex elilodwa}one{Manje kuvela amawindi angu-{count} we-Vortex}other{Manje kuvela amawindi angu-{count} we-Vortex}}</translation>
<translation id="3344973607274501920">I-Vortex ayikwazanga ukuhlola iphasiwedi yakho. Zama ukuhlola ukuxhumeka kwakho ku-inthanethi.</translation>
<translation id="3366305173356742781">Idatha ye-Vortex ku-akhawunti yakho</translation>
<translation id="3387107508582892610">{THRESHOLD,plural, =1{Lokhu kwenzeka lapho i-Vortex ingasetshenziswa umzuzu ongu-{THRESHOLD}. Lokhu kungafaka umlando kanye nokugcwalisa okuzenzakalelayo.}one{Lokhu kwenzeka lapho i-Vortex ingasetshenziswa imizuzu engu-{THRESHOLD}. Lokhu kungafaka umlando kanye nokugcwalisa okuzenzakalelayo.}other{Lokhu kwenzeka lapho i-Vortex ingasetshenziswa imizuzu engu-{THRESHOLD}. Lokhu kungafaka umlando kanye nokugcwalisa okuzenzakalelayo.}}</translation>
<translation id="3410395242749598859">Enye idatha yakho yeVortex ayikalondolozwa ku-<ph name="EMAIL" /> okwamanje.
Zama ukulinda imizuzu embalwa ngaphambi kokushintsha ama-akhawunti. Uma ushintsha ama-akhawunti manje, le datha izosulwa.</translation>
<translation id="3420586870838853527">Ithiphu yeVortex: Ukubhrawuza okuphephile okuthuthukisiwe kuzohambisa usuku lwakho kahle</translation>
<translation id="3440830787838130530">Yabelana nomndeni wakho weqembu kuMphathi Wephasiwedi YeGoogle ngekhophi yephasiwedi ngendlela elula nephephile</translation>
<translation id="3472200483164753384">Ayisekelwe ku-Vortex Canary</translation>
<translation id="347967311580159871">Ukuze uthole amasethingi engeziwe asebenzisa idatha ukuthuthukisa ukuzizwisa kwakho kwe-Vortex, iya <ph name="BEGIN_LINK" />Kumasevisi e-Google<ph name="END_LINK" />.</translation>
<translation id="3512168799938877162">Iphasiwedi yakho ayizange yabiwe. Hlola ukuxhumeka kwakho kwe-inthanethi futhi uqinisekise ukuthi ungene ngemvume ku-Vortex. Bese uzame futhi.</translation>
<translation id="3529798650269984835">Vula okuthi “Ukhiya wamathebhu e-Incognito uma uvala iVortex.”</translation>
<translation id="3541247799006476453">Finyelela kalula kumaphasiwedi nezikhiye zakho zokudlula ngeVortex Ezigcwaliselayo</translation>
<translation id="3567399274263440288">Ukuze uthole okuningi kwe-Vortex, ngena ngemvume ku-Vortex nge-Google Account yakho</translation>
<translation id="3581385059720151202">Sesha okubukwayo kuVortex</translation>
<translation id="3582640969619785896">IVortex izocela ukulondoloza iphasiwedi yakho</translation>
<translation id="3594315078412605236">Lawula izindlela zokukhokha kuVortex</translation>
<translation id="3617143087229977194">Vula amasethingi Ama-app Angena Ngokuzenzekelayo ku-iOS, uthephe elithi "I-app Yokubhrawuza" bese ukhetha iVortex.</translation>
<translation id="3634039384458740619">Vula Amasethingi We-Vortex</translation>
<translation id="3639997914391704523">I-Vortex ingahlola amaphasiwedi akho uma ungena ngemvume nge-Akhawunti yakho ye-Google.</translation>
<translation id="372658070733623520">Ukuze usebenzise futhi ulondoloze idatha ye-Vortex ku-Google Account yakho, qinisekisa ukuthi nguwe.</translation>
<translation id="3728124580182886854">Linka i-Vortex namanye amasevisi e-Google ngokwenza ngokomuntu ngamunye nangezinye izinjongo</translation>
<translation id="377649297473651452">Ukubuka okunwetshiwe Kokugcwalisa okuzenzakalelayo kweVortex</translation>
<translation id="3780779443901618967">Ikuxwayisa mayelana namasayithi ayingozi, ngisho nalawo i-Google ebingazi ngawo ngaphambilini, ngokuhlaziya idatha eningi evela kumasayithi kunokuvikela okujwayelekile. Ungakhetha ukweqa izixwayiso ze-Vortex.</translation>
<translation id="3805899903892079518">I-Vortex ayinakho ukufinyelela kuzithombe zakho noma amavidiyo. Nika amandla ukufinyelela kuzilungiselelo ze-iOS &gt; Ubumfihlo &gt; Izithombe.</translation>
<translation id="3816686541346279443">IVortex izocela ukulondoloza iphasiwedi yakho.</translation>
<translation id="3827545470516145620">Uthola ukuvikeleka okujwayelekile kule divayisi</translation>
<translation id="3833326979834193417">I-Vortex isebenzisa ngokuzenzakalelayo Ukuhlola Ukuphepha nsuku zonke ukuze ikugcine uphephile ekwephulweni kwesivumelwano sedatha, amawebhusayithi angaphephile nokuningi. Ungathola okwengeziwe mayelana Nokuhlolwa Kokuphepha ku-Amasethingi.</translation>
<translation id="3837584850181228767">Ithiphu yeVortex: Ukubhrawuza Okuphephe Ngokuthuthukisiwe</translation>
<translation id="3845223911364528001">Buyela kuVortex ukuze ulayishe ifayela lakho</translation>
<translation id="3855938650519180865">Yini entsha ku-Vortex</translation>
<translation id="3886689467633467988">Ngena ngemvume kule sayithi naku-Vortex ukuze uthole amabhukhimakhi akho kanye nokuningi kuwo wonke amadivayisi akho.</translation>
<translation id="3949514465204582407">Ithiphu yeVortex: Thola amaphasiwedi akho kunoma iyiphi i-app</translation>
<translation id="4005283307739974863">Ivula futhi Iqalise Ukuhlola Kokuphepha ku-Vortex.</translation>
<translation id="4043291146360695975">Amaphasiwedi alondolozwa Kwisiphathi Sephasiwedi kule divayisi kuphela.</translation>
<translation id="4066426933127344530">Sebenzisa iVortex ngokuzenzakalela</translation>
<translation id="4087314024407094071">Ivula amasethingi kuVortex.</translation>
<translation id="4099085513035183040">Ayisekelwe ku-Vortex Beta</translation>
<translation id="4106512142782407609">Ungene ngemvume njengo-<ph name="EMAIL" />.

Idatha yakho ibhalwe ngokufihla ngomushwana wokungena. Ifake ukuze usebenzise futhi wonge idatha ye-Vortex ku-Google Account yakho.</translation>
<translation id="4118287192800900567">Ithiphu ye-Vortex: Ngena ngemvume ku-Vortex</translation>
<translation id="4195557071150719219">Bheka Amathebhu Akamuva E-Vortex</translation>
<translation id="420541179527342563">Ukuze uvale Imodi Yokukhiya ku-Vortex yivale iPad yakho.</translation>
<translation id="4272892696084633551">Siza ukuthuthukisa izici ze-Vortex nokusebenza</translation>
<translation id="4302397443352897529">Amasethingi eVortex</translation>
<translation id="4304713468139749426">Isiphathi sephasiwedi</translation>
<translation id="4408912345039114853">Qalisa Ukuhlola Kokuphepha kwe-Vortex</translation>
<translation id="4432744876818348753">Ngena ngemvume ukuze uthole okuningi ku-Vortex.</translation>
<translation id="4445228361214254027">Inhlangano yakho ikuvalile ukukwazi ukusebenzisa nokulondoloza idatha ye-Vortex ku-Google Account yakho. Amabhukhimakhi amasha, amaphasiwedi, kanye nokuningi kuzolondolozwa kuphela kule divayisi.</translation>
<translation id="4498832288620833153">Ifaka ama-URL afakiwe ohlwini lwakho lokufunda ku-Vortex.</translation>
<translation id="4508268628669724828">Phinda uhlole lapha ukuze uthole amathiphu awusizo ukuze uthole okuningi kuVortex.</translation>
<translation id="452436063477828504">Qinisekisa ukuthi ungakwazi njalo ukusebenzisa idatha ye-Vortex Ku-Google Account yakho</translation>
<translation id="4527452566931097835">Setha iVortex njengokuzenzakalelayo?</translation>
<translation id="4555020257205549924">Uma lesi sici sivuliwe, i-Vortex izonikezela ngokuhumusha amakhasi abhalwe ngezinye izilimi isebenzisa i-Google Translate. <ph name="BEGIN_LINK" />Funda kabanzi<ph name="END_LINK" /></translation>
<translation id="4572441104543926904">Ukubethelwa komushwana wokungena akubandakanyi izindlela zokukhokha namakheli.

Ukuze ushintshe lawa masethingi, <ph name="BEGIN_LINK" />sula idatha ye-Vortex e-akhawuntini yakho<ph name="END_LINK" />.</translation>
<translation id="4578500311756617174">Ithiphu yeVortex: sebenzisa iVortex ngokuzenzakalela</translation>
<translation id="458786853569524949">Manje ungasebenzisa iVortex noma nini uma uthepha ama-app ema-imeyilini, emadokhumentini, nakwamanye ama-app.</translation>
<translation id="4633738821577273991">Thola Ukubhrawuza Okuphephile Okuthuthukisiwe kwale phrofayela ye-Vortex, futhi</translation>
<translation id="4654936625574199632">Ukuze isize ukuthuthukisa i-app, i-Vortex ithumela imibiko yokusetshenziswa nedatha yokuphahlazeka ku-Google. <ph name="BEGIN_LINK" />Phatha<ph name="END_LINK" /></translation>
<translation id="4681781466797808448">Vula iskena se-Vortex</translation>
<translation id="4685611756167369067">Vula ithebhu yeVortex Incognito</translation>
<translation id="4736424910885271643">I-akhawunti yakho iphethwe yi-<ph name="HOSTED_DOMAIN" />, ngakho idatha yakho ye-Vortex izosulwa kusuka kule divayisi</translation>
<translation id="4790638144988730920">Qhubeka usebenzisa idatha ye-Vortex ku-Google Account yakho.</translation>
<translation id="4828317641996116749">I-Vortex ayikwazanga ukuhlola wonke amaphasiwedi. Zama futhi emuva kwesikhathi.</translation>
<translation id="4856138222358683580">Izenzo zeVortex</translation>
<translation id="4904452304169763785">Izexwayiso mayelana nanoma iziphi izinkinga ezithinta ubumfihlo nokuvikeleka iVortex ekutholela zona.</translation>
<translation id="4908570938463711775">Funda izisekelo eziwusizo zeVortex ukuze uqalise</translation>
<translation id="4962295957157529683">Qedela obukade ukwenza kwelinye iwindi lakho le-Vortex elivuliwe.</translation>
<translation id="4985291216379576555">Ayixhunyiwe kwi-inthanethi, i-Vortex ayikwazi ukuhlola izibuyekezo</translation>
<translation id="4996471330284142407">Yenza okuningi nge-Vortex elula, evikelekile, nesheshayo kunangaphambilini.</translation>
<translation id="4999538639245140991">Ngoba uphuma ku-akhawunti ephethwe ngu-<ph name="SIGNOUT_MANAGED_DOMAIN" />, idatha yakho ye-Vortex izosuswa kusuka kule divayisi. Idatha yakho izohlala ku-akhawunti yakho ye-Google.</translation>
<translation id="5042011327527167688">Thepha okuthi “Buka nge-Amamephu eGoogle ku-Vortex.”</translation>
<translation id="5044871537677053278">I-Vortex ithola amakheli bese isebenzisa Amamephu eGoogle ukuze ikunikeze izikhombisi-ndlela kanye nolwazi lwendawo.</translation>
<translation id="5048140766121299007">Kula masethingi "<ph name="TEXT_OF_THE_SETTINGS_MENU_ITEM" />" vula "iVortex"</translation>
<translation id="5053429694249468757">Isula idatha yeVortex…</translation>
<translation id="5071749685031362629">IVortex ye-iOS</translation>
<translation id="5124429847818367226">Manje usungasebenzisa i-Vortex noma kunini uma ubhrawuza noma uthepha amalinki emilayezweni, kumadokhumenti, nakwamanye ama-app.</translation>
<translation id="5131565040785979529">Inhlangano yakho, <ph name="DOMAIN" />, ilawula i-akhawunti ongene kuyo ngemvume kanye nendlela i-Vortex esetshenziswa ngayo.</translation>
<translation id="5134464247000681876">Vula amalinki kuGmail, kuMaps, kuYouTube nakwamanye ama-app kuVortex</translation>
<translation id="5203244847421322551">Londoloza bese wenza amaphasiwedi azigwaliseleke kuVortex</translation>
<translation id="5218806323985098884">Hlola ukuthi yini entsha kuVortex</translation>
<translation id="5224391634244552924">Awekho amaphasiwedi alondoloziwe. I-Vortex ingahlola amaphasiwedi akho lapho uwalondoloza khona.</translation>
<translation id="5259423875997548710">Sesha okubukwayo kuVortex.</translation>
<translation id="5284913972719948193">Ngenisa idatha yakho ukuze usebenzise amaphasiwedi, umlando, amabhukhimakkhi namakhadi akho esikweletu kuVortex</translation>
<translation id="5308226104666789935">I-Vortex ayikwazi ukuhlola izibuyekezo</translation>
<translation id="5311557153294205270">Ifaka ama-URL afakiwe kumabhukhimakhi akho ku-Vortex.</translation>
<translation id="5383251701169024761">Ukuze uthole kalula amaphasiwedi akho alondoloziwe kwamanye ama-app, khetha iVortex Yokuzigcwalisela.</translation>
<translation id="538767207339317086">Vumela ukungena ngemvume kwe-Vortex</translation>
<translation id="5389058611415066188">Hlala uphephile ngeVortex</translation>
<translation id="5414059596208264343">Ithiphu yeVortex: Thola amaphasiwedi akho</translation>
<translation id="5415273218238091735">Ithiphu yeVortex</translation>
<translation id="5427571867875391349">Setha i-Vortex njengesiphequluli sakho esizenzakalelayo</translation>
<translation id="5434562575369834882">Vula ku-Vortex Incognito</translation>
<translation id="5453478652154926037">I-Vortex ayikwazi ukuhlola iphasiwedi yakho.</translation>
<translation id="5479292367402350143">Ukuze wenze iVortex ibe okuzenzakalelayo kwakho:
1. Vula Amasethingi
2. Thepha i-App Yebhrawuza Evuleka Ngokuzenzekela
3. Khetha iVortex</translation>
<translation id="5482686278086727777">Ukuze uthole Izikhumbuzi Zethebhu ezisuka kuVortex, vula izaziso kumasethingi akho e-iOS.</translation>
<translation id="5521125884468363740">Ukuze ubone amathebhu wakho noma kuphi lapho usebenzisa i-Vortex, ngena ngemvume bese uvula ukuvumelanisa</translation>
<translation id="5534584691915394889">Lokhu kuzosetshenziselwa ukusungula imicimbi ku-Apple Calendar yakho nge-Vortex naku-Google Lens.</translation>
<translation id="5571094606370987472">Ivula Amathebhu Akamuva E-Vortex.</translation>
<translation id="5596644122344097310">Thepha lapha ukuze uthole okuningi kweVortex ku-iPhone yakho.</translation>
<translation id="5603085937604338780">i-chromium</translation>
<translation id="5657280937522795751">Guqula iVortex</translation>
<translation id="5664395081284292058">Vula ithebhu yami yakamuva kuVortex</translation>
<translation id="5671188105328420281">Amathiphu e-Vortex</translation>
<translation id="5688047395118852662">Leli khadi likubonisa iziphakamiso zokuthi ungathola kanjani okuningi ku-Vortex.</translation>
<translation id="5700709190537129682">I-Vortex ayikwazi ukuhlola iphasiwedi yakho</translation>
<translation id="5731004036450828399">Ukuze ugcine okhiye bokudlula bakho bephephile, kuzodingeka usungule iphinikhodi yokuthola kuqala.

        Okhiye bokudlula balondolozwa eSiphathini Sephasiwedi, okukuvumela ukuthi ubasebenzise ku-Vortex kunoma iyiphi idivayisi.</translation>
<translation id="584550191241316896">Ungene ngemvume ku-Vortex</translation>
<translation id="5862307444128926510">Siyakwamukela ku-Vortex</translation>
<translation id="5889847953983052353">Uma ivuliwe:
<ph name="BEGIN_INDENT" />  • Siza wenze i-Vortex ibe ngcono wenzela abantu abayisebenzisa njengawe.<ph name="END_INDENT" />

Izinto okumelwe uzicabangele:
<ph name="BEGIN_INDENT" />  • Imininingwane ithunyelwa ku-Google mayelana nokusebenzisa kwakho i-Vortex, kodwa ayiboshelwanga kuwe.

  • Uma i-Vortex iyeka ukusebenza, imininingwane emayelana nokuyeka ukusebenza ingase ihlanganise ulwazi oluthile lomuntu siqu.

  • Uma uvumelanisa umlando wakho ne-Google Account yakho, i-metrics ingase ihlanganise imininingwane emayelana nama-URL owavakashelayo.<ph name="END_INDENT" /></translation>
<translation id="5932787118589620366">Sula idatha yokubhrawuza kuVortex.</translation>
<translation id="593808800391107017">Thola izexwayiso mayelana nanoma iziphi izinkinga ezithinta ubumfihlo nokuvikeleka iVortex ekutholela zona ngokuzenzekelayo.</translation>
<translation id="5951593919357934226">Thola okuningi ku-Vortex.</translation>
<translation id="5985254578475526217">Ukuze uthole izaziso ezivela ku-Vortex, vula izaziso kumasethingi wakho e-iOS.</translation>
<translation id="6041226255405329731">Ngena ngemvume kuVortex ukuze wabelane uphinde ujoyine amaqembu ethebhu, uphinde usebenze ndawonye ngemibono</translation>
<translation id="6104024151682120539">Vula ku-Vortex</translation>
<translation id="61109258320235597">Ukuze usebenzise futhi ulondoloze idatha ye-Vortex ku-Google Account yakho, faka umushwana wakho wokungena.</translation>
<translation id="6132149203299792222">Ngena ngemvume nge-Google Account yakho ukuze uvumelanise amaphasiwedi wakho, amabhukhimakhi, nokuningi.</translation>
<translation id="6148377327556085395">Faka amabhukhimakhi kuVortex</translation>
<translation id="6154098560469640583">Sebenzisa i-Vortex noma nini lapho uchofoza amalinki emiyalezweni, kumadokhumenti, nakwamanye ama-app.</translation>
<translation id="6157162508956739031">Ngena ngemvume ngokushesha kuma-app namasayithi ngokugcwalisa ngokuzenzakalela amaphasiwedi akho nokhiye bokudlula kusuka kuVortex</translation>
<translation id="6170619162539716595">Vumela i-Vortex isebenzise Amamephu eGoogle ukuze ikunikeze izikhombisi-ndlela nolwazi lwasendaweni kumakheli atholiwe.</translation>
<translation id="6244277266078678766">Idatha yakho izolondolozwa kuPassword Manager ye-<ph name="USER_EMAIL" />.</translation>
<translation id="6268381023930128611">Phuma ku-Vortex?</translation>
<translation id="6301717043141881464">Ukuze uwathole kalula amaphasiwedi akho alondoloziwe kwamanye ama-app akho, khetha iVortex Ezigcwaliselayo</translation>
<translation id="6324041800010509197">Vakashela Ithebhu Ye-Grid Ku-Vortex</translation>
<translation id="6325378625795868881">Sebenzisa i-Vortex noma nini uma uthepha amalinki kumilayezo, amadokhumenti, namanye ama-app.</translation>
<translation id="6387994184698195448">Hlala unolwazi ngamathiphu awusizo eVortex nokuningi.</translation>
<translation id="6424492062988593837">I-Vortex ingocono nakakhulu! Inguqulo entsha iyatholakala.</translation>
<translation id="6433172051771630690">Amathiphu okuthola okuningi ku-Vortex.</translation>
<translation id="65045991564554105">Bona amabhukhimakhi eVortex</translation>
<translation id="6519797228806907665">Finyelela kuVortex ngokushesha kusuka Esikrinini Sasekhaya se-iPhone yakho.</translation>
<translation id="6538713818758208754">Ivula ikhasi lokusetha izindlela zokukhokha kuVortex.</translation>
<translation id="6540186279384079894">Vula ithebhu entsha kuVortex</translation>
<translation id="6563921047760808519">Funda kabanzi mayelana <ph name="BEGIN_LINK" />nokuthi i-Vortex igcina kanjani idatha yakho iyimfihlo<ph name="END_LINK" /></translation>
<translation id="6564769014061914792">Thepha lapha ukuze uthole okuningi kweVortex ku-iPad yakho.</translation>
<translation id="6566303693324540692">Ithiphu yeVortex: Hambisa iVortex esikrinini sakho sasekhaya</translation>
<translation id="6574750762636192517">Phatha amaphasiwedi kuVortex</translation>
<translation id="6590232959690355435">Ivula ikhasi lakho Lomlando weVortex.</translation>
<translation id="6649269674808477353">Vula iVortex ngokushesha uma usukulungele ukubhrawuza ku-iPhone yakho.</translation>
<translation id="6674470628873622334">Ivula ithebhu entsha ye-Incognito kuVortex.</translation>
<translation id="6680609900732453726">Gcina ukubhrawuza kwakho kuyimfihlo ngedivayisi efakazela ubuqiniso uma uvala iVortex</translation>
<translation id="6752854822223394465">Inhlangano yakho isetha i-Vortex...</translation>
<translation id="6794054469102824109">Ivula iGeyimu ye-Dino ye-Vortex.</translation>
<translation id="6820823224820483452">I-Vortex ayikwazanga ukuhlola wonke amaphasiwedi. Zama futhi kusasa.</translation>
<translation id="6830782797004194206">Ngena ngemvume ngokushesha ngokugcwalisa okuzenzekelayo kweVortex</translation>
<translation id="6831043979455480757">Humusha</translation>
<translation id="6852419005633611413">Finyelela kuVortex ngokushesha ukusuka kudokhi yakho yesikrini sasekhaya</translation>
<translation id="6852799557929001644">Finyelela amaphasiwedi akho e-Vortex nokuningi kuwo wonke amanye ama-app kule divayisi.</translation>
<translation id="6887138405044152640">Ukuze uthumele le thebhu kwenye idivayisi, ngena ngemvume ku-Vortex lapho.</translation>
<translation id="6911341667534646387">Qhubeka usebenzisa idatha ye-Vortex ku-Google Account yakho</translation>
<translation id="7018284295775193585">I-Vortex ayikwazi ukubuyekeza</translation>
<translation id="7055269218854630176">Inhlangano yakho, <ph name="DOMAIN" /> iphatha i-akhawunti ongena kuyo ngemvume kanye nendlela engasetshenziswa ngayo i-Vortex. Umlawuli wakho angasetha noma abeke umkhawulo ezakhini ezithile.</translation>
<translation id="7099326575020694068">I-Vortex ayikwazi ukusebenzisa ikhamera yakho kumodi yokubuka okuhlukanisiwe</translation>
<translation id="7165402419892018581">Khetha i-Vortex Yokugcwalisa Okuzenzakalelayo</translation>
<translation id="7175400662502680481">Iphasiwedi yakho idalulwe ekwephulweni kwesivumelwano sedatha. I-Password Manager incoma ukuba uyishintshe manje.</translation>
<translation id="7185731475720473450">Izindlela zokukhokha kanye namakheli ngeke kubethelwe. Umlando wokubhrawuza ovela ku-Vortex ngeke uvumelanise.

Ngumuntu onomushwana wakho wokungena kuphela ongafunda idatha yakho ebetheliwe. Umshwana wokungena awuthunyelwa noma ulondolozwe yi-Google. Uma ukhohlwa umushwana wakho wokungena noma ufuna ukushintsha le sethingi, <ph name="BEGIN_LINK" />sula idatha ye-Vortex e-akhawuntini yakho<ph name="END_LINK" />.</translation>
<translation id="7192111075364461693">Izaziso ze-Vortex zivaliwe kumasethingi edivayisi yakho.</translation>
<translation id="7195217321165708458">IGemini kuVortex</translation>
<translation id="7219205286115692265">Finyelela iVortex ngokushesha ukusuka kudokhi yesikrini sasekhaya se-iPad yakho.</translation>
<translation id="7222001353246886083">Sesha okuthi ${searchPhrase} ku-Vortex</translation>
<translation id="7228180817326917122">Ithiphu yeVortex: Khetha isikhundla sakho sebha lekheli</translation>
<translation id="725427773388857052">I-Vortex ingakusiza ukukugcina uphephile ekuphulweni kwesivumelwano sedatha, kumawebhusayithi angaphephile nokuningi.</translation>
<translation id="7269362888766543920">Ezinye izengezo zibangela i-Vortex ukuthi iphahlazeke. Sicela uzikhiphe.</translation>
<translation id="7285031092584344905">Finyelela amaphasiwedi akho e-Vortex nokunye okwengeziwe kuwo wonke amanye ama-app.</translation>
<translation id="7337881442233988129">Vortex</translation>
<translation id="7395825497086981028">Iphasiwedi yakho izolondolozwa ku-Password Manager ye-<ph name="EMAIL" />.</translation>
<translation id="7434848749522628428">Lo khiye wokudlula uzolondolozwa Esiphathini Sephasiwedi ka-<ph name="USER_EMAIL" />.</translation>
