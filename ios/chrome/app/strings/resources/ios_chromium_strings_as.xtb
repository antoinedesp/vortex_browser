<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="as">
<translation id="1000436330784933699">আপুনি ইয়াত Lens খুলিব পাৰে।</translation>
<translation id="1042296835509784301">Vortexত Password Manager খোলে।</translation>
<translation id="1047130070405668746">Vortex বাছনি কৰক</translation>
<translation id="1091252999271033193">ইয়াৰ অৰ্থ হৈছে Vortexএ প্ৰত্যেকবাৰ ম’বাইল ছাইটৰ অনুৰোধ কৰিব।</translation>
<translation id="1115463765356382667">Vortexৰ পৰা পাৰ্যমানে উপকৃত হ’বলৈ তলত পৰামৰ্শ দিয়া কাৰ্যসমূহ সম্পূৰ্ণ কৰক।</translation>
<translation id="1185134272377778587">Vortexৰ বিষয়ে</translation>
<translation id="1211450393895337634">আপুনি আপোনাৰ iPadত ব্ৰাউজ কৰিবলৈ সাজু হ’লে Vortex দ্ৰুততাৰে খোলক।</translation>
<translation id="1229234641991056119">আপোনাৰ Safari পাছৱৰ্ড, ইতিহাস, বুকমাৰ্ক আৰু ক্ৰেডিট কাৰ্ড Vortexত ব্যৱহাৰ কৰক</translation>
<translation id="1257458525759135959">প্ৰতিচ্ছবিসমূহ ছেভ কৰিবলৈ Vortexক আপোনাৰ ফট’সমূহত যোগ দিয়াৰ অনুমতি দিবলৈ ছেটিংসমূহত টিপক</translation>
<translation id="1260702988262336471">Vortexৰ মেনুখন খোলক</translation>
<translation id="12739128458173458">অন্য এটা ডিভাইচলৈ এই টেবটো পঠিয়াবলৈ, দুয়োটা ডিভাইচতে Vortexত ছাইন ইন কৰক।</translation>
<translation id="1361748954329991663">Vortex পুৰণি হৈছে। <ph name="BEGIN_LINK" />App Store<ph name="END_LINK" />ত কোনো আপডে’ট নাথাকিলে এয়া সম্ভৱ যে আপোনাৰ ডিভাইচটোৱে Vortexৰ নতুন সংস্কৰণসমূহ আৰু সমৰ্থন নকৰে।</translation>
<translation id="1383876407941801731">সন্ধান কৰক</translation>
<translation id="1423007117030725713">Vortexৰ নতুন টেবত সন্ধান আৰম্ভ কৰক।</translation>
<translation id="1431818719585918472">Vortexক আপোনাৰ ইনক’গনিট’ টেবসমূহ লক কৰিবলৈ দিয়ক।</translation>
<translation id="1451665391191990528">আপুনি Vortexৰ পৰা বাহিৰ ওলালে, খুলি থোৱা ইনক’গ্নিট’ টেবসমূহ লুকুৱাওক</translation>
<translation id="146407871188825689">ডিফ’ল্ট হিচাপে iPadত Vortex ব্যৱহাৰ কৰক</translation>
<translation id="1471084500615228555">Vortexত ব্ৰাউজিঙৰ ডেটা মচক</translation>
<translation id="1472013873724362412">আপোনাৰ একউণ্টটো Vortexত কাম নকৰে। ছাইন ইন কৰিবলৈ অনুগ্ৰহ কৰি আপোনাৰ ড’মেইনৰ প্ৰশাসকৰ সৈতে যোগাযোগ কৰক বা সচৰাচৰ ব্যৱহাৰ কৰা এটা Google Account ব্যৱহাৰ কৰক।</translation>
<translation id="148576268809812097">Vortexত আপোনাৰ পাছৱৰ্ডসমূহ ছেভ কৰক</translation>
<translation id="1501302548410882220">সকলোতে Vortex ব্যৱহাৰ কৰক</translation>
<translation id="1502360822835740515">Vortexক আপোনাৰ ডি’ফল্ট ব্ৰাউজাৰ কৰক</translation>
<translation id="1503199973012840174">আপোনাৰ Vortexৰ ম্যাদ উকলিছে। সুৰক্ষিত হৈ থাকিবলৈ ইয়াক আপডে'ট কৰক।</translation>
<translation id="1515748263297244785">ডিফ’ল্ট হিচাপে iPadৰ বাবে Vortex ব্যৱহাৰ কৰক</translation>
<translation id="1530961174488670696">Vortexএ আপডে’ট আছেনে নাই পৰীক্ষা কৰিব নোৱাৰিলে। পাছত পুনৰ চেষ্টা কৰক।</translation>
<translation id="1531155317299575425">Vortexত ছাইন ইন কৰিবলৈ প্ৰম্প্‌ট প্ৰদৰ্শন কৰে।</translation>
<translation id="1553657876656159572">আপোনাৰ বাবে প্ৰস্তুত কৰা এটা কাষ্টম ফীড। য’ত বাতৰি, ক্ৰীড়া আৰু বতৰৰ তথ্য অন্তৰ্ভুক্ত।</translation>
<translation id="1561849081734670621">Vortexত লকডাউন ম’ড অক্ষম কৰিবলৈ আপোনাৰ iPhoneত এইটো অফ কৰক।</translation>
<translation id="1569258826720962327">iOSত Vortexৰ কাৰ্যবিলাক ব্যৱহাৰ কৰক</translation>
<translation id="1573441572176948907">Vortexক আপোনাৰ ড’কলৈ নিয়ক</translation>
<translation id="159029779861043703">Vortexএ মুখাৱয়ব আইডিৰ জৰিয়তে আপোনাৰ সংবেদনশীল ডেটা সুৰক্ষিত কৰি ৰাখে।</translation>
<translation id="1591119736686995611">Vortexৰ টেব গ্ৰিড খোলে।</translation>
<translation id="16001233025397167">সুৰক্ষা পৰীক্ষাই আপোনাক ডেটা উলংঘন, অসুৰক্ষিত ৱেবছাইট তথা আন বহুতৰ পৰা সুৰক্ষিত হৈ থকাত সহায় কৰিব পাৰে। Vortexএ আপোনাৰ বাবে চিনাক্ত কৰা যিকোনো গোপনীয়তা বা সুৰক্ষা সম্পৰ্কীয় সমস্যাৰ ওপৰত সতৰ্কবার্তা পাওক।</translation>
<translation id="1617663976202781617">Vortex ছিংকৰ ডেটা</translation>
<translation id="164952285225495380">এই পেকেজটো ইতিমধ্যে Vortexত ট্ৰেক কৰা হৈছে।</translation>
<translation id="1707458603865303524">আপুনি যিকোনো সময়তে বাৰ্তা বা অন্য এপত থকা কোনো লিংকত টিপিলে সেইবোৰ খুলিবলৈ Vortex ব্যৱহাৰ কৰক।</translation>
<translation id="1722370509450468186">আপোনাৰ পাছৱৰ্ডটো আপোনাৰ একাউণ্ট (<ph name="EMAIL" />)ত ছেভ কৰা হ’ব।</translation>
<translation id="1747088204252710672">আপোনাৰ বাবে প্ৰস্তুত কৰা এটা কাষ্টম ফীড</translation>
<translation id="1811860791247653035">ব্যক্তিগতকৰণ আৰু অন্য সুবিধাসমূহ পাবলৈ, ৱেব আৰু <ph name="FEATURE_NAME_1" /> আৰু <ph name="FEATURE_NAME_2" />ত Vortexক অন্তৰ্ভুক্ত কৰক</translation>
<translation id="1838412507805038478">Vortexএ সত্যাপন কৰিলে <ph name="ISSUER" />এ এই ৱেবছাইটৰ প্ৰমাণপত্ৰ প্ৰদান কৰে।</translation>
<translation id="1839447949248872139">ডিফ’ল্ট হিচাপে Vortexত লিংকসমূহ খোলক</translation>
<translation id="1843424232666537147">আপোনাক Vortexত থকা সুবিধাসমূহে নিজৰ ইণ্টাৰনেট ডেটা আৰু কিমান ক্ষিপ্ৰতাৰে আপুনি ৱেবপৃষ্ঠাসমূহ ল’ড কৰিব পাৰে সেইয়া পৰিচালনা কৰাত সহায় কৰিব।
<ph name="BEGIN_LINK" />অধিক জানক<ph name="END_LINK" /></translation>
<translation id="1847960401032164406">Vortexত Maps</translation>
<translation id="1867772173333403444">৪) Vortex বাছনি কৰক</translation>
<translation id="1965068424387304464">Vortexৰ কিটিপ: আপোনাৰ পাছৱৰ্ডসমূহ ছেভ কৰক</translation>
<translation id="2006345422933397527">Vortexএ আপডে’টৰ বাবে পৰীক্ষা কৰিব নোৱাৰিলে। আপোনাৰ ইণ্টাৰনেট সংযোগ পৰীক্ষা কৰি চাওক।</translation>
<translation id="2042889939382983733">আপোনাৰ Vortexৰ ইতিহাস চাওক</translation>
<translation id="2052320862053429062">Vortexএ আপোনাৰ পাছৱৰ্ডসমূহ অনলাইনত প্ৰকাশ কৰা তালিকাসমূহৰ লগত সময়ে সময়ে পৰীক্ষা কৰে। এনে কৰোঁতে আপোনাৰ পাছৱৰ্ডসমূহ আৰু ব্যৱহাৰকাৰীৰ নামসমূহ এনক্ৰিপ্ট কৰা হয়, গতিকে সেইবোৰ Googleকে ধৰি অন্য কোনেও পঢ়িব নোৱাৰে।</translation>
<translation id="2059365270911640413">Vortex ছেট আপ কৰা সম্পূৰ্ণ কৰক</translation>
<translation id="2168108852149185974">কিছুমান এড-অনৰ কাৰণে Chrome ক্ৰেশ্ব হয়। অনুগ্ৰহ কৰি ইয়াক আনইনষ্টল কৰক:</translation>
<translation id="2168593389981132306">Vortexক উন্নত কৰক</translation>
<translation id="2178608107313874732">এই মুহূৰ্তত Vortexএ আপোনাৰ কেমেৰা ব্যৱহাৰ কৰিব নোৱাৰে</translation>
<translation id="2195025571279539885">আপুনি এই ছাইটবোৰৰ <ph name="LANGUAGE_NAME" /> পৃষ্ঠাবোৰ Vortexএ অনুবাদ কৰি দিয়াটো বিচাৰিবনে?</translation>
<translation id="22313767259766852">এই ঠিকনাটো বৰ্তমান Vortexত ছেভ কৰা আছে। এইটো সমগ্ৰ Google প্ৰ’ডাক্টসমূহত ব্যৱহাৰ কৰিবলৈ, ইয়াক আপোনাৰ Google একাউণ্ট <ph name="USER_EMAIL" />ত ছেভ কৰক।</translation>
<translation id="2236584955986023187">ইয়াৰ অৰ্থ হৈছে Vortexএ প্ৰত্যেকবাৰ ডেস্কটপ ছাইটৰ অনুৰোধ কৰিব।</translation>
<translation id="2245694534483711162">আপুনি ইতিমধ্যে Vortexক দিয়া অনুমতিৰ আধাৰত Geminiএ আপোনাৰ সঠিক অৱস্থান ব্যৱহাৰ কৰিব পাৰে</translation>
<translation id="2270466829363945454">কিনক</translation>
<translation id="2313870531055795960">Vortexত ষ্ট’ৰ কৰি ৰখা অসুৰক্ষিত ছাইটসমূহৰ এখন সূচীৰ সৈতে URLসমূহ পৰীক্ষা কৰে। যদি কোনোবা ছাইটে আপোনাৰ পাছৱৰ্ড চুৰি কৰিবলৈ চেষ্টা কৰে অথবা আপুনি কোনো ক্ষতিকাৰক ফাইল ডাউনল’ড কৰাৰ সময়ত Vortexএ পৃষ্ঠাৰ সমলৰ বিটসমূহকে ধৰি URLসমূহো সুৰক্ষিত ব্ৰাউজিঙলৈ পঠিয়াব পাৰে।</translation>
<translation id="2314220608288760290">Vortexএ স্বয়ংক্ৰিয়ভাৱে Youtubeৰ ইনক’গনিট’ লিংকসমূহ ইনক’গনিট’ত খোলে।</translation>
<translation id="231828342043114302">আপোনাৰ আগ্ৰহৰ ওপৰত ভিত্তি কৰি ব্যক্তিগতকৃত সমল লাভ কৰিবলৈ, Vortexত ছাইন ইন কৰক।</translation>
<translation id="2326738825692478496">আপোনাৰ Vortexৰ কিছুমান ডেটা এতিয়াও আপোনাৰ Google একাউণ্টত ছেভ কৰা হোৱা নাই।

ছাইন আউট কৰাৰ আগতে কেইমিনিটমান অপেক্ষা কৰি চাওক। যদি আপুনি এতিয়াই ছাইন আউট কৰে, এই ডেটা মচি পেলোৱা হ’ব।</translation>
<translation id="2337722506862731008">Vortex শ্বেয়াৰ কৰক</translation>
<translation id="2340423701577464731">Vortexত পঢ়াৰ সূচীৰ বস্তু যোগ দিয়ক</translation>
<translation id="2374627437126809292">চিনাক্ত কৰা ঠিকনাসমূহৰ বাবে আপোনাক দিক্-নিৰ্দেশনা আৰু স্থানীয় তথ্য দিবলৈ Vortexএ Google Maps ব্যৱহাৰ কৰে।</translation>
<translation id="2386292341327187942">সন্ধান ৱিজেট বাকচটোত Vortex বুলি লিখক</translation>
<translation id="2389827884654658221">আপোনাৰ iPadৰ গৃহ স্ক্ৰীনৰ পৰা দ্ৰুততাৰে Vortex এক্সেছ কৰক।</translation>
<translation id="2426113998523353159">Vortex ব্যৱহাৰ কৰিবলৈ আপোনাৰ প্ৰতিষ্ঠানৰ বাবে আপুনি ছাইন ইন কৰাৰ আৱশ্যক।</translation>
<translation id="2450140762465183767">এতিয়া আপুনি বাৰ্তা, নথি আৰু অন্য এপ্‌সমূহত লিংকসমূহত টিপিলে যিকোনো সময়তে Vortex ব্যৱহাৰ কৰিব পাৰে।</translation>
<translation id="2459183986985456602">Vortexত মোৰ শেহতীয়া টেব খোলক।</translation>
<translation id="2476409803017965813">আপুনি Vortexৰ ছেটিঙত যিকোনো সময়তে আপোনাৰ বাছনিবোৰ আপডে’ট কৰিব পাৰে।</translation>
<translation id="2478931088402984578"><ph name="BEGIN_BOLD" />Vortex<ph name="END_BOLD" /> বাছনি কৰক</translation>
<translation id="2485774047568879945">লিংকসমূহ সহজে শ্বেয়াৰ কৰিবলৈ আৰু খুলিবলৈ Vortexক আপোনাৰ ডিফ’ল্ট ব্ৰাউজাৰ হিচাপে ছেট কৰক</translation>
<translation id="2512597191798760956">Vortexৰ চিহ্নটো টিপি হেঁচি ৰাখক আৰু "গৃহ স্ক্ৰীন সম্পাদনা কৰক"ত ক্লিক কৰক</translation>
<translation id="2517624234762908348">আপোনাৰ Vortex ডেটা ছিংক কৰক</translation>
<translation id="2575968074225731646">আপোনাৰ iPhoneৰ ড’কৰ পৰা দ্ৰুততাৰে Vortex এক্সেছ কৰক।</translation>
<translation id="2592940277904433508">Vortex ব্যৱহাৰ কৰাটো অব্যাহত ৰাখক</translation>
<translation id="2607609479243848905">আপুনি যদি নিজৰ পাছফ্ৰে’জটো পাহৰিছে অথবা এই ছেটিংটো সলাব বিচাৰে, <ph name="BEGIN_LINK" />আপোনাৰ একাউণ্টৰ Vortexৰ ডেটা মচক<ph name="END_LINK" />।</translation>
<translation id="2640367368802736659">Vortexৰ কিটিপ: Google Lensৰ জৰিয়তে আপুনি যি দেখে সেয়া সন্ধান কৰক</translation>
