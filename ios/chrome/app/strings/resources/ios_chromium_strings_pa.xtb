<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="pa">
<translation id="1000436330784933699">ਤੁਸੀਂ Lens ਨੂੰ ਇੱਥੇ ਖੋਲ੍ਹ ਸਕਦੇ ਹੋ।</translation>
<translation id="1042296835509784301">Vortex ਵਿੱਚ Password Manager ਨੂੰ ਖੋਲ੍ਹਦਾ ਹੈ।</translation>
<translation id="1047130070405668746">Vortex ਚੁਣੋ</translation>
<translation id="1091252999271033193">ਇਸਦਾ ਮਤਲਬ ਹੈ ਕਿ Vortex ਹਰ ਵਾਰ ਮੋਬਾਈਲ ਸਾਈਟ ਲਈ ਬੇਨਤੀ ਕਰੇਗਾ।</translation>
<translation id="1115463765356382667">ਹੇਠਾਂ ਸੁਝਾਈਆਂ ਗਈਆਂ ਇਨ੍ਹਾਂ ਕਾਰਵਾਈਆਂ ਨੂੰ Vortex ਦਾ ਵੱਧ ਤੋਂ ਵੱਧ ਲਾਹਾ ਲੈਣ ਲਈ ਪੂਰਾ ਕਰੋ।</translation>
<translation id="1185134272377778587">Vortex ਬਾਰੇ</translation>
<translation id="1211450393895337634">ਆਪਣੇ iPad 'ਤੇ ਬ੍ਰਾਊਜ਼ ਕਰਨ ਲਈ ਤਿਆਰ ਹੋਣ 'ਤੇ, Vortex ਨੂੰ ਤੇਜ਼ੀ ਨਾਲ ਖੋਲ੍ਹੋ।</translation>
<translation id="1229234641991056119">Vortex ਵਿੱਚ Safari ਦੇ ਪਾਸਵਰਡਾਂ, ਇਤਿਹਾਸ, ਬੁੱਕਮਾਰਕਾਂ ਅਤੇ ਕ੍ਰੈਡਿਟ ਕਾਰਡਾਂ ਦੀ ਜਾਣਕਾਰੀ ਦੀ ਵਰਤੋਂ ਕਰੋ</translation>
<translation id="1257458525759135959">ਚਿੱਤਰਾਂ ਨੂੰ ਰੱਖਿਅਤ ਕਰਨ ਲਈ, Vortex ਨੂੰ ਤੁਹਾਡੀਆਂ ਫ਼ੋਟੋਆਂ ਸ਼ਾਮਲ ਕਰਨ ਦੇਣ ਲਈ ਸੈਟਿੰਗਾਂ 'ਤੇ ਟੈਪ ਕਰੋ</translation>
<translation id="1260702988262336471">Vortex ਮੀਨੂ ਖੋਲ੍ਹੋ</translation>
<translation id="12739128458173458">ਇਸ ਟੈਬ ਨੂੰ ਕਿਸੇ ਹੋਰ ਡੀਵਾਈਸ 'ਤੇ ਭੇਜਣ ਲਈ ਦੋਵਾਂ ਡੀਵਾਈਸਾਂ 'ਤੇ Vortex ਵਿੱਚ ਸਾਈਨ-ਇਨ ਕਰੋ।</translation>
<translation id="1361748954329991663">Vortex ਦਾ ਇਹ ਵਰਜਨ ਪੁਰਾਣਾ ਹੈ। ਜੇ <ph name="BEGIN_LINK" />ਐਪ ਸਟੋਰ<ph name="END_LINK" /> ਵਿੱਚ ਕੋਈ ਅੱਪਡੇਟ ਉਪਲਬਧ ਨਹੀਂ ਹੈ, ਤਾਂ ਇਹ ਸੰਭਵ ਹੈ ਕਿ ਤੁਹਾਡਾ ਡੀਵਾਈਸ ਹੁਣ Vortex ਦੇ ਨਵੇਂ ਵਰਜਨਾਂ ਦਾ ਸਮਰਥਨ ਨਹੀਂ ਕਰਦਾ ਹੈ।</translation>
<translation id="1383876407941801731">ਖੋਜੋ</translation>
<translation id="1423007117030725713">ਇੱਕ ਨਵੀਂ Vortex ਟੈਬ ਵਿੱਚ ਕੋਈ ਖੋਜ ਸ਼ੁਰੂ ਕਰੋ।</translation>
<translation id="1431818719585918472">Vortex ਨੂੰ ਤੁਹਾਡੀਆਂ ਇਨਕੋਗਨਿਟੋ ਟੈਬਾਂ ਲਾਕ ਕਰਨ ਦਿਓ।</translation>
<translation id="1451665391191990528">ਤੁਹਾਡੇ Vortex ਤੋਂ ਬਾਹਰ ਨਿਕਲਣ 'ਤੇ, ਖੁੱਲ੍ਹੀਆਂ ਇਨਕੋਗਨਿਟੋ ਟੈਬਾਂ ਨੂੰ ਲੁਕਾਓ</translation>
<translation id="146407871188825689">iPad 'ਤੇ ਪੂਰਵ-ਨਿਰਧਾਰਿਤ ਤੌਰ 'ਤੇ Vortex ਦੀ ਵਰਤੋਂ ਕਰੋ</translation>
<translation id="1471084500615228555">Vortex ਤੋਂ ਬ੍ਰਾਊਜ਼ਿੰਗ ਡਾਟਾ ਮਿਟਾਓ</translation>
<translation id="1472013873724362412">ਤੁਹਾਡਾ ਖਾਤਾ Vortex 'ਤੇ ਕੰਮ ਨਹੀਂ ਕਰਦਾ। ਕਿਰਪਾ ਕਰਕੇ ਆਪਣੇ ਡੋਮੇਨ ਪ੍ਰਸ਼ਾਸਕ ਨੂੰ ਸੰਪਰਕ ਕਰੋ ਜਾਂ ਸਾਈਨ-ਇਨ ਲਈ ਇੱਕ ਨਿਯਮਿਤ Google ਖਾਤੇ ਦੀ ਵਰਤੋਂ ਕਰੋ।</translation>
<translation id="148576268809812097">Vortex ਵਿੱਚ ਆਪਣੇ ਪਾਸਵਰਡ ਰੱਖਿਅਤ ਕਰੋ</translation>
<translation id="1501302548410882220">Vortex ਨੂੰ ਹਰ ਥਾਂ ਵਰਤੋ</translation>
<translation id="1502360822835740515">Vortex ਨੂੰ ਆਪਣਾ ਪੂਰਵ-ਨਿਰਧਾਰਤ ਬ੍ਰਾਊਜ਼ਰ ਬਣਾਓ</translation>
<translation id="1503199973012840174">ਤੁਹਾਡੇ Vortex ਦਾ ਵਰਜਨ ਪੁਰਾਣਾ ਹੈ। ਸੁਰੱਖਿਅਤ ਰਹਿਣ ਲਈ ਇਸਨੂੰ ਅੱਪਡੇਟ ਕਰੋ।</translation>
<translation id="1515748263297244785">iPad ਲਈ ਪੂਰਵ-ਨਿਰਧਾਰਿਤ ਤੌਰ 'ਤੇ Vortex ਦੀ ਵਰਤੋਂ ਕਰੋ</translation>
<translation id="1530961174488670696">Vortex ਅੱਪਡੇਟਾਂ ਲਈ ਜਾਂਚ ਨਹੀਂ ਕਰ ਸਕਿਆ। ਬਾਅਦ ਵਿੱਚ ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰੋ।</translation>
<translation id="1531155317299575425">Vortex ਵਿੱਚ ਸਾਈਨ-ਇਨ ਕਰਨ ਲਈ ਪ੍ਰੋਂਪਟਾਂ ਨੂੰ ਦਿਖਾਉਂਦਾ ਹੈ।</translation>
<translation id="1553657876656159572">ਤੁਹਾਡੇ ਲਈ ਬਣਾਈ ਗਈ ਇੱਕ ਵਿਉਂਤੀ ਫ਼ੀਡ। ਜਿਸ ਵਿੱਚ ਖਬਰਾਂ, ਖੇਡਾਂ ਅਤੇ ਮੌਸਮ ਸੰਬੰਧੀ ਜਾਣਕਾਰੀ ਸ਼ਾਮਲ ਹੈ।</translation>
<translation id="1561849081734670621">Vortex ਵਿੱਚ ਲਾਕਡਾਊਨ ਮੋਡ ਨੂੰ ਬੰਦ ਕਰਨ ਲਈ, ਆਪਣੇ iPhone 'ਤੇ ਇਸਨੂੰ ਬੰਦ ਕਰੋ।</translation>
<translation id="1569258826720962327">iOS 'ਤੇ Vortex ਕਾਰਵਾਈਆਂ ਦੀ ਵਰਤੋਂ ਕਰੋ</translation>
<translation id="1573441572176948907">Vortex ਨੂੰ ਆਪਣੇ ਡੌਕ 'ਤੇ ਲਿਜਾਓ</translation>
<translation id="159029779861043703">Vortex ਤੁਹਾਡੇ ਸੰਵੇਦਨਸ਼ੀਲ ਡਾਟੇ ਨੂੰ ਚਿਹਰਾ ਆਈਡੀ ਨਾਲ ਸੁਰੱਖਿਅਤ ਰੱਖਦਾ ਹੈ।</translation>
<translation id="1591119736686995611">Vortex ਟੈਬ ਗਰਿੱਡ ਖੋਲ੍ਹਦਾ ਹੈ।</translation>
<translation id="16001233025397167">ਸੁਰੱਖਿਆ ਜਾਂਚ ਡਾਟਾ ਉਲੰਘਣਾਵਾਂ, ਅਸੁਰੱਖਿਅਤ ਵੈੱਬਸਾਈਟਾਂ ਅਤੇ ਹੋਰ ਚੀਜ਼ਾਂ ਤੋਂ ਸੁਰੱਖਿਅਤ ਰਹਿਣ ਵਿੱਚ ਮਦਦ ਕਰਦੀ ਹੈ। Vortex ਵੱਲੋਂ ਤੁਹਾਡੇ ਲਈ ਪਛਾਣੀਆਂ ਗਈਆਂ ਕਿਸੇ ਵੀ ਤਰ੍ਹਾਂ ਦੀਆਂ ਪਰਦੇਦਾਰੀ ਜਾਂ ਸੁਰੱਖਿਆ ਸਮੱਸਿਆਵਾਂ ਸੰਬੰਧੀ ਅਲਰਟ ਪ੍ਰਾਪਤ ਕਰੋ।</translation>
<translation id="1617663976202781617">Vortex ਸਿੰਕ ਤੋਂ ਡਾਟਾ</translation>
<translation id="164952285225495380">ਇਸ ਪੈਕੇਜ ਨੂੰ ਪਹਿਲਾਂ ਹੀ Vortex 'ਤੇ ਟਰੈਕ ਕੀਤਾ ਜਾ ਚੁੱਕਾ ਹੈ।</translation>
<translation id="1707458603865303524">ਸੁਨੇਹੇ ਜਾਂ ਹੋਰ ਐਪਾਂ ਵਿਚਲੇ ਲਿੰਕਾਂ 'ਤੇ ਟੈਪ ਕਰ ਕੇ ਕਿਸੇ ਵੇਲੇ ਵੀ Vortex ਦੀ ਵਰਤੋਂ ਕਰੋ।</translation>
<translation id="1722370509450468186">ਤੁਹਾਡੇ ਪਾਸਵਰਡ ਨੂੰ ਤੁਹਾਡੇ ਖਾਤੇ (<ph name="EMAIL" />) ਵਿੱਚ ਰੱਖਿਅਤ ਕੀਤਾ ਜਾਵੇਗਾ।</translation>
<translation id="1747088204252710672">ਤੁਹਾਡੇ ਲਈ ਬਣਾਈ ਗਈ ਇੱਕ ਵਿਉਂਤੀ ਫ਼ੀਡ</translation>
<translation id="1811860791247653035">ਵਿਅਕਤੀਗਤਕਰਨ ਅਤੇ ਹੋਰ ਵਿਸ਼ੇਸ਼ਤਾਵਾਂ ਲਈ, <ph name="FEATURE_NAME_1" /> ਅਤੇ <ph name="FEATURE_NAME_2" /> ਵਿੱਚ Vortex ਸ਼ਾਮਲ ਕਰੋ</translation>
<translation id="1838412507805038478">Vortex ਨੇ ਇਹ ਪੁਸ਼ਟੀ ਕੀਤੀ ਹੈ ਕਿ ਇਸ ਵੈੱਬਸਾਈਟ ਦਾ ਪ੍ਰਮਾਣ-ਪੱਤਰ <ph name="ISSUER" /> ਨੇ ਜਾਰੀ ਕੀਤਾ ਹੈ।</translation>
<translation id="1839447949248872139">ਪੂਰਵ-ਨਿਰਧਾਰਿਤ ਤੌਰ 'ਤੇ Vortex ਵਿੱਚ ਲਿੰਕਾਂ ਨੂੰ ਖੋਲ੍ਹੋ</translation>
<translation id="1843424232666537147">Vortex ਵਿੱਚ ਅਜਿਹੀਆਂ ਵਿਸ਼ੇਸ਼ਤਾਵਾਂ ਹਨ, ਜੋ ਤੁਹਾਨੂੰ ਤੁਹਾਡਾ ਇੰਟਰਨੈੱਟ ਡਾਟਾ ਅਤੇ ਇਹ ਵਿਵਸਥਿਤ ਕਰਨ ਵਿੱਚ ਮਦਦ ਕਰਦੀਆਂ ਹਨ ਕਿ ਤੁਸੀਂ ਕਿੰਨੀ ਜਲਦੀ ਵੈੱਬ-ਪੰਨੇ ਲੋਡ ਕਰਨ ਕਰ ਸਕਦੇ ਹੋ।
<ph name="BEGIN_LINK" />ਹੋਰ ਜਾਣੋ<ph name="END_LINK" /></translation>
<translation id="1847960401032164406">Vortex ਵਿੱਚ Maps</translation>
<translation id="1867772173333403444">4. Vortex ਚੁਣੋ</translation>
<translation id="1965068424387304464">Vortex ਨੁਕਤਾ: ਪਾਸਵਰਡ ਰੱਖਿਅਤ ਕਰੋ</translation>
<translation id="2006345422933397527">Vortex ਅੱਪਡੇਟਾਂ ਲਈ ਜਾਂਚ ਨਹੀਂ ਕਰ ਸਕਿਆ। ਆਪਣੇ ਇੰਟਰਨੈੱਟ ਕਨੈਕਸ਼ਨ ਦੀ ਜਾਂਚ ਕਰਕੇ ਦੇਖੋ।</translation>
<translation id="2042889939382983733">ਆਪਣਾ Vortex ਇਤਿਹਾਸ ਦੇਖੋ</translation>
<translation id="2052320862053429062">Vortex ਨਿਯਮਿਤ ਤੌਰ 'ਤੇ ਆਨਲਾਈਨ ਪ੍ਰਕਾਸ਼ਿਤ ਕੀਤੀਆਂ ਗਈਆਂ ਸੂਚੀਆਂ ਨਾਲ ਤੁਹਾਡੇ ਪਾਸਵਰਡਾਂ ਦੀ ਜਾਂਚ ਕਰਦਾ ਹੈ। ਅਜਿਹਾ ਕਰਨ ਵੇਲੇ, ਤੁਹਾਡੇ ਪਾਸਵਰਡ ਅਤੇ ਵਰਤੋਂਕਾਰ ਨਾਮ ਇਨਕ੍ਰਿਪਟ ਕੀਤੇ ਜਾਂਦੇ ਹਨ, ਇਸ ਲਈ ਉਹ Google ਸਮੇਤ ਕਿਸੇ ਵੱਲੋਂ ਵੀ ਪੜ੍ਹੇ ਨਹੀਂ ਜਾ ਸਕਦੇ।</translation>
<translation id="2059365270911640413">Vortex ਦਾ ਸੈੱਟਅੱਪ ਪੂਰਾ ਕਰੋ</translation>
<translation id="2168108852149185974">ਕੁਝ ਐਡ-ਆਨ ਨਾਲ Vortex ਕ੍ਰੈਸ਼ ਹੋ ਜਾਂਦਾ ਹੈ। ਕਿਰਪਾ ਕਰਕੇ ਅਣਸਥਾਪਤ ਕਰੋ:</translation>
<translation id="2168593389981132306">Vortex ਨੂੰ ਬਿਹਤਰ ਬਣਾਓ</translation>
<translation id="2178608107313874732">Vortex ਇਸ ਸਮੇਂ ਤੁਹਾਡੇ ਕੈਮਰੇ ਦੀ ਵਰਤੋਂ ਨਹੀਂ ਕਰ ਸਕਦਾ ਹੈ</translation>
<translation id="2195025571279539885">ਕੀ ਤੁਸੀਂ ਚਾਹੋਗੇ ਕਿ Vortex ਅਗਲੀ ਵਾਰ ਇਸ ਸਾਈਟ ਦੇ <ph name="LANGUAGE_NAME" /> ਪੰਨਿਆਂ ਦਾ ਅਨੁਵਾਦ ਕਰਨ ਦੀ ਪੇਸ਼ਕਸ਼ ਕਰੇ?</translation>
<translation id="22313767259766852">ਇਹ ਪਤਾ ਫ਼ਿਲਹਾਲ Vortex 'ਤੇ ਰੱਖਿਅਤ ਹੈ। ਸਾਰੇ Google ਉਤਪਾਦਾਂ ਵਿੱਚ ਵਰਤਣ ਲਈ, ਇਸਨੂੰ ਆਪਣੇ Google ਖਾਤੇ, <ph name="USER_EMAIL" />, ਵਿੱਚ ਰੱਖਿਅਤ ਕਰੋ।</translation>
<translation id="2236584955986023187">ਇਸਦਾ ਮਤਲਬ ਹੈ ਕਿ Vortex ਹਰ ਵਾਰ ਡੈਸਕਟਾਪ ਸਾਈਟ ਲਈ ਬੇਨਤੀ ਕਰੇਗਾ।</translation>
<translation id="2245694534483711162">Gemini ਤੁਹਾਡੇ ਸਟੀਕ ਟਿਕਾਣੇ ਨੂੰ ਵਰਤ ਸਕਦਾ ਹੈ, ਜੋ ਤੁਹਾਡੇ ਵੱਲੋਂ Vortex ਨੂੰ ਪਹਿਲਾਂ ਤੋਂ ਦਿੱਤੀ ਗਈ ਇਜਾਜ਼ਤ 'ਤੇ ਨਿਰਭਰ ਕਰਦਾ ਹੈ</translation>
<translation id="2270466829363945454">ਖਰੀਦੋ</translation>
<translation id="2313870531055795960">Vortex ਵਿੱਚ ਸਟੋਰ ਕੀਤੀਆਂ ਅਸੁਰੱਖਿਅਤ ਸਾਈਟਾਂ ਦੀ ਸੂਚੀ ਦੇ ਨਾਲ URL ਦੀ ਜਾਂਚ ਕੀਤੀ ਜਾਂਦੀ ਹੈ। ਜੇ ਕੋਈ ਸਾਈਟ ਤੁਹਾਡੇ ਪਾਸਵਰਡ ਨੂੰ ਚੋਰੀ ਕਰਨ ਦੀ ਕੋਸ਼ਿਸ਼ ਕਰਦੀ ਹੈ ਜਾਂ ਜਦੋਂ ਤੁਸੀਂ ਕੋਈ ਨੁਕਸਾਨਦੇਹ ਫ਼ਾਈਲ ਡਾਊਨਲੋਡ ਕਰਦੇ ਹੋ, ਤਾਂ Vortex ਸੁਰੱਖਿਅਤ ਬ੍ਰਾਊਜ਼ਿੰਗ ਨੂੰ ਪੰਨੇ ਦੀ ਥੋੜ੍ਹੀ ਸਮੱਗਰੀ ਸਮੇਤ URL ਵੀ ਭੇਜ ਸਕਦਾ ਹੈ।</translation>
<translation id="2314220608288760290">Vortex, YouTube ਦੇ ਇਨਕੋਗਨਿਟੋ ਲਿੰਕਾਂ ਨੂੰ ਇਨਕੋਗਨਿਟੋ ਮੋਡ ਵਿੱਚ ਸਵੈਚਲਿਤ ਤੌਰ 'ਤੇ ਖੋਲ੍ਹਦਾ ਹੈ।</translation>
<translation id="231828342043114302">ਆਪਣੀਆਂ ਦਿਲਚਸਪੀਆਂ ਦੇ ਆਧਾਰ 'ਤੇ ਵਿਅਕਤੀਗਤ ਸਮੱਗਰੀ ਪ੍ਰਾਪਤ ਕਰਨ ਲਈ, Vortex ਵਿੱਚ ਸਾਈਨ-ਇਨ ਕਰੋ।</translation>
<translation id="2326738825692478496">ਤੁਹਾਡੇ ਕੁਝ Vortex ਡਾਟੇ ਨੂੰ ਹਾਲੇ ਤੁਹਾਡੇ Google ਖਾਤੇ ਵਿੱਚ ਰੱਖਿਅਤ ਨਹੀਂ ਕੀਤਾ ਗਿਆ ਹੈ।

ਸਾਈਨ-ਆਊਟ ਕਰਨ ਤੋਂ ਪਹਿਲਾਂ ਕੁਝ ਮਿੰਟਾਂ ਦੀ ਉਡੀਕ ਕਰ ਕੇ ਦੇਖੋ। ਜੇ ਤੁਸੀਂ ਹੁਣੇ ਸਾਈਨ-ਆਊਟ ਕਰਦੇ ਹੋ, ਤਾਂ ਇਸ ਡਾਟੇ ਨੂੰ ਮਿਟਾਇਆ ਜਾਵੇਗਾ।</translation>
<translation id="2337722506862731008">Vortex ਸਾਂਝਾ ਕਰੋ</translation>
<translation id="2340423701577464731">Vortex ਦੀ ਪੜ੍ਹਨ-ਸੂਚੀ ਵਿੱਚ ਆਈਟਮ ਸ਼ਾਮਲ ਕਰੋ</translation>
<translation id="2374627437126809292">Vortex ਤੁਹਾਨੂੰ ਪਛਾਣੇ ਗਏ ਪਤਿਆਂ 'ਤੇ ਦਿਸ਼ਾਵਾਂ ਅਤੇ ਸਥਾਨਕ ਜਾਣਕਾਰੀ ਦੇਣ ਲਈ Google Maps ਦੀ ਵਰਤੋਂ ਕਰਦਾ ਹੈ।</translation>
<translation id="2386292341327187942">ਖੋਜ ਵਿਜੇਟ ਬਾਕਸ ਵਿੱਚ, Vortex ਦਾਖਲ ਕਰੋ</translation>
<translation id="2389827884654658221">ਆਪਣੇ iPad ਦੀ ਹੋਮ ਸਕ੍ਰੀਨ ਤੋਂ Vortex ਤੱਕ ਵਧੇਰੇ ਤੇਜ਼ੀ ਨਾਲ ਪਹੁੰਚ ਕਰੋ।</translation>
<translation id="2426113998523353159">ਤੁਹਾਡੀ ਸੰਸਥਾ ਲਈ Vortex ਵਰਤਣ ਵਾਸਤੇ ਤੁਹਾਨੂੰ ਸਾਈਨ-ਇਨ ਕਰਨ ਦੀ ਲੋੜ ਹੈ।</translation>
<translation id="2450140762465183767">ਤੁਸੀਂ ਹੁਣ ਸੁਨੇਹੇ, ਦਸਤਾਵੇਜ਼ ਅਤੇ ਹੋਰ ਐਪਾਂ ਵਿਚਲੇ ਲਿੰਕਾਂ 'ਤੇ ਟੈਪ ਕਰਕੇ ਕਿਸੇ ਵੇਲੇ ਵੀ Vortex ਵਰਤ ਸਕਦੇ ਹੋ।</translation>
<translation id="2459183986985456602">Vortex ਵਿੱਚ 'ਮੇਰੀ ਨਵੀਨਤਮ ਟੈਬ' ਖੋਲ੍ਹੋ।</translation>
<translation id="2476409803017965813">ਤੁਸੀਂ ਕਦੇ ਵੀ Vortex ਸੈਟਿੰਗਾਂ ਵਿੱਚ ਆਪਣੀਆਂ ਚੋਣਾਂ ਨੂੰ ਅੱਪਡੇਟ ਕਰ ਸਕਦੇ ਹੋ।</translation>
<translation id="2478931088402984578"><ph name="BEGIN_BOLD" />Vortex<ph name="END_BOLD" /> ਚੁਣੋ</translation>
<translation id="2485774047568879945">Vortex ਨੂੰ ਆਪਣੇ ਪੂਰਵ-ਨਿਰਧਾਰਿਤ ਬ੍ਰਾਊਜ਼ਰ ਵਜੋਂ ਸੈੱਟ ਕਰੋ, ਤਾਂ ਜੋ ਤੁਸੀਂ ਲਿੰਕਾਂ ਨੂੰ ਆਸਾਨੀ ਨਾਲ ਸਾਂਝਾ ਕਰ ਸਕੋ ਅਤੇ ਖੋਲ੍ਹ ਸਕੋ</translation>
<translation id="2512597191798760956">Vortex ਪ੍ਰਤੀਕ ਨੂੰ ਦਬਾਈ ਰੱਖੋ ਅਤੇ "ਹੋਮ ਸਕ੍ਰੀਨ ਦਾ ਸੰਪਾਦਨ ਕਰੋ" 'ਤੇ ਕਲਿੱਕ ਕਰੋ</translation>
<translation id="2517624234762908348">ਆਪਣੇ Vortex ਡਾਟੇ ਦਾ ਸਿੰਕ ਕਰੋ</translation>
<translation id="2575968074225731646">ਆਪਣੇ iPhone ਦੇ ਡੌਕ ਤੋਂ Vortex ਤੱਕ ਵਧੇਰੇ ਤੇਜ਼ੀ ਨਾਲ ਪਹੁੰਚ ਕਰੋ।</translation>
<translation id="2592940277904433508">Vortex ਨੂੰ ਵਰਤਣਾ ਜਾਰੀ ਰੱਖੋ</translation>
<translation id="2607609479243848905">ਜੇ ਤੁਸੀਂ ਆਪਣਾ ਪਾਸਫਰੇਜ਼ ਭੁੱਲ ਗਏ ਹੋ ਜਾਂ ਇਸ ਸੈਟਿੰਗ ਨੂੰ ਬਦਲਣਾ ਚਾਹੁੰਦੇ ਹੋ, ਤਾਂ <ph name="BEGIN_LINK" />ਆਪਣੇ ਖਾਤੇ ਵਿੱਚ Vortex ਡਾਟੇ ਨੂੰ ਮਿਟਾਓ<ph name="END_LINK" />।</translation>
<translation id="2640367368802736659">Vortex ਨੁਕਤਾ: ਜੋ ਵੀ ਤੁਹਾਨੂੰ ਦਿਖਾਈ ਦਿੰਦਾ ਹੈ, ਉਸਨੂੰ Google Lens ਨਾਲ ਖੋਜੋ</translation>
<translation id="2650312721222849884">ਜਿਸ ਡੀਵਾਈਸ 'ਤੇ ਵੀ ਤੁਸੀਂ Vortex ਵਰਤਦੇ ਹੋ, ਉੱਥੇ ਆਪਣੀਆਂ ਟੈਬਾਂ ਦੇਖਣ ਲਈ ਸਿੰਕ ਚਾਲੂ ਕਰੋ</translation>
<translation id="2684230048001240293">ਆਪਣੇ ਸਾਰੇ ਡੀਵਾਈਸਾਂ 'ਤੇ ਆਪਣੀਆਂ ਟੈਬਾਂ, ਪਾਸਵਰਡਾਂ ਅਤੇ ਭੁਗਤਾਨ ਜਾਣਕਾਰੀ ਦਾ ਸਿੰਕ ਕਰਨ ਲਈ Vortex ਨੂੰ ਪੂਰਵ-ਨਿਰਧਾਰਿਤ ਬ੍ਰਾਊਜ਼ਰ ਦੇ ਤੌਰ 'ਤੇ ਸੈੱਟ ਕਰੋ</translation>
<translation id="2729836253097154631">ਆਪਣੀ ਸਮੱਗਰੀ ਪ੍ਰਾਪਤ ਕਰਨ ਲਈ Vortex ਵਿੱਚ ਸਾਈਨ-ਇਨ ਕਰੋ</translation>
<translation id="2730884209570016437">ਤੁਹਾਡੇ ਕੈਮਰੇ ਦੀ ਕਿਸੇ ਹੋਰ ਐਪਲੀਕੇਸ਼ਨ ਵੱਲੋਂ ਵਰਤੋਂ ਕੀਤੇ ਜਾਣ ਕਾਰਨ Vortex ਤੁਹਾਡੇ ਕੈਮਰੇ ਦੀ ਵਰਤੋਂ ਨਹੀਂ ਕਰ ਸਕਦਾ ਹੈ</translation>
<translation id="2742952311155593352">ਤੁਸੀਂ Vortex ਦਾ ਸੈੱਟਅੱਪ ਲਗਭਗ ਪੂਰਾ ਕਰ ਲਿਆ ਹੈ!</translation>
<translation id="2798503587425057129">Vortex ਦੀ ਪੜ੍ਹਨ-ਸੂਚੀ ਨੂੰ ਖੋਲ੍ਹਦਾ ਹੈ।</translation>
<translation id="28276745681323897">ਤੁਹਾਡੇ Google ਖਾਤੇ ਵਿੱਚ <ph name="BEGIN_LINK" />ਕਿਹੜਾ Vortex ਡਾਟਾ ਰੱਖਿਅਤ ਕੀਤਾ ਜਾਂਦਾ ਹੈ, ਤੁਸੀਂ ਇਸਦਾ ਪ੍ਰਬੰਧਨ ਕਰ ਸਕਦੇ ਹੋ<ph name="END_LINK" />।

ਤੁਹਾਡੇ Vortex ਦੇ ਅਨੁਭਵ ਨੂੰ ਬਿਹਤਰ ਬਣਾਉਣ ਲਈ ਡਾਟੇ ਦੀ ਵਰਤੋਂ ਕਰਨ ਵਾਲੀਆਂ ਹੋਰ ਸੈਟਿੰਗਾਂ ਵਾਸਤੇ, <ph name="BEGIN_LINK" />Google ਸੇਵਾਵਾਂ<ph name="END_LINK" /> 'ਤੇ ਜਾਓ।</translation>
<translation id="2832168932648876507">Vortex ਵਿੱਚ ਅਵਾਜ਼ ਨਾਲ ਖੋਜੋ।</translation>
<translation id="2843571538056574338">ਆਟੋਫਿਲ ਲਈ Vortex ਵਰਤੋ</translation>
<translation id="2918709798697875261">ਤੁਹਾਡੀ ਸੰਸਥਾ ਲਈ ਤੁਹਾਨੂੰ Vortex ਤੋਂ ਸਾਈਨ-ਆਊਟ ਰਹਿਣ ਦੀ ਲੋੜ ਹੈ।</translation>
<translation id="2942241131342758843">ਲਿੰਕਾਂ ਨੂੰ ਖੋਲ੍ਹਣ, ਵਿਜੇਟਾਂ ਤੋਂ ਖੋਜ ਕਰਨ ਅਤੇ ਹੋਰ ਐਪਾਂ ਵਿੱਚ ਆਟੋਫਿਲ ਪਾਸਵਰਡਾਂ ਲਈ ਪੂਰਵ-ਨਿਰਧਾਰਿਤ ਤੌਰ 'ਤੇ Vortex ਦੀ ਵਰਤੋਂ ਕਰੋ</translation>
<translation id="2977470724722393594">Vortex ਅੱਪ ਟੂ ਡੇਟ ਹੈ</translation>
<translation id="3044857325852340337">Vortex ਡਾਟਾ ਮਿਟਾਇਆ ਗਿਆ</translation>
<translation id="3054480780637153380">iOS 'ਤੇ Vortex Settings ਖੋਲ੍ਹੋ, ਫਿਰ "Default Browser App" 'ਤੇ ਟੈਪ ਕਰੋ ਅਤੇ Vortex ਚੁਣੋ।</translation>
<translation id="3115956258722352278">ਕੀ Vortex ਨੂੰ ਆਪਣਾ ਪੂਰਵ-ਨਿਰਧਾਰਿਤ ਬ੍ਰਾਊਜ਼ਰ ਬਣਾਉਣਾ ਹੈ?</translation>
<translation id="3180939591219927904">"Vortex ਬੰਦ ਕਰਨ 'ਤੇ ਇਨਕੋਗਨਿਟੋ ਟੈਬਾਂ ਨੂੰ ਲਾਕ ਕਰੋ" ਨੂੰ ਚਾਲੂ ਕਰੋ</translation>
<translation id="328933489847748230">{count,plural, =1{ਹੁਣ 1 Vortex ਵਿੰਡੋ ਦਿਖਾਈ ਜਾ ਰਹੀ ਹੈ}one{ਹੁਣ {count} Vortex ਵਿੰਡੋ ਦਿਖਾਈ ਜਾ ਰਹੀ ਹੈ}other{ਹੁਣ {count} Vortex ਵਿੰਡੋਆਂ ਦਿਖਾਈਆਂ ਜਾ ਰਹੀਆਂ ਹਨ}}</translation>
<translation id="3344973607274501920">Vortex ਤੁਹਾਡੇ ਪਾਸਵਰਡਾਂ ਦੀ ਜਾਂਚ ਨਹੀਂ ਕਰ ਸਕਿਆ। ਆਪਣੇ ਇੰਟਰਨੈੱਟ ਕਨੈਕਸ਼ਨ ਦੀ ਜਾਂਚ ਕਰਕੇ ਦੇਖੋ।</translation>
<translation id="3366305173356742781">ਤੁਹਾਡੇ ਖਾਤੇ ਵਿੱਚ Vortex ਡਾਟਾ</translation>
<translation id="3387107508582892610">{THRESHOLD,plural, =1{ਅਜਿਹਾ ਉਦੋਂ ਹੁੰਦਾ ਹੈ, ਜਦੋਂ {THRESHOLD} ਮਿੰਟ ਲਈ Vortex ਦੀ ਵਰਤੋਂ ਨਹੀਂ ਕੀਤੀ ਜਾਂਦੀ। ਇਸ ਵਿੱਚ ਇਤਿਹਾਸ ਅਤੇ ਆਟੋਫਿਲ ਸ਼ਾਮਲ ਹੋ ਸਕਦਾ ਹੈ।}one{ਅਜਿਹਾ ਉਦੋਂ ਹੁੰਦਾ ਹੈ, ਜਦੋਂ {THRESHOLD} ਮਿੰਟ ਲਈ Vortex ਦੀ ਵਰਤੋਂ ਨਹੀਂ ਕੀਤੀ ਜਾਂਦੀ। ਇਸ ਵਿੱਚ ਇਤਿਹਾਸ ਅਤੇ ਆਟੋਫਿਲ ਸ਼ਾਮਲ ਹੋ ਸਕਦਾ ਹੈ।}other{ਅਜਿਹਾ ਉਦੋਂ ਹੁੰਦਾ ਹੈ, ਜਦੋਂ {THRESHOLD} ਮਿੰਟ ਲਈ Vortex ਦੀ ਵਰਤੋਂ ਨਹੀਂ ਕੀਤੀ ਜਾਂਦੀ। ਇਸ ਵਿੱਚ ਇਤਿਹਾਸ ਅਤੇ ਆਟੋਫਿਲ ਸ਼ਾਮਲ ਹੋ ਸਕਦਾ ਹੈ।}}</translation>
<translation id="3410395242749598859">ਤੁਹਾਡੇ ਕੁਝ Vortex ਡਾਟੇ ਨੂੰ ਹਾਲੇ <ph name="EMAIL" /> ਵਿੱਚ ਰੱਖਿਅਤ ਨਹੀਂ ਕੀਤਾ ਗਿਆ ਹੈ।
ਖਾਤੇ ਸਵਿੱਚ ਕਰਨ ਤੋਂ ਪਹਿਲਾਂ ਕੁਝ ਮਿੰਟਾਂ ਦੀ ਉਡੀਕ ਕਰ ਕੇ ਦੇਖੋ। ਜੇ ਤੁਸੀਂ ਹੁਣੇ ਖਾਤੇ ਸਵਿੱਚ ਕਰਦੇ ਹੋ, ਤਾਂ ਇਸ ਡਾਟੇ ਨੂੰ ਮਿਟਾ ਦਿੱਤਾ ਜਾਵੇਗਾ।</translation>
<translation id="3420586870838853527">Vortex ਨੁਕਤਾ: ਵਿਸਤ੍ਰਿਤ ਸੁਰੱਖਿਅਤ ਬ੍ਰਾਊਜ਼ਿੰਗ ਤੁਹਾਡਾ ਦਿਨ ਬਚਾਏਗੀ</translation>
<translation id="3440830787838130530">Google Password Manager ਵਿੱਚ ਆਪਣੇ ਪਰਿਵਾਰ ਗਰੁੱਪ ਨਾਲ ਪਾਸਵਰਡ ਦੀ ਕਾਪੀ ਨੂੰ ਆਸਾਨੀ ਅਤੇ ਸੁਰੱਖਿਅਤ ਢੰਗ ਨਾਲ ਸਾਂਝਾ ਕਰੋ</translation>
<translation id="3472200483164753384">Vortex Canary 'ਤੇ ਸਮਰਥਿਤ ਨਹੀਂ</translation>
<translation id="347967311580159871">ਤੁਹਾਡੇ Vortex ਦੇ ਅਨੁਭਵ ਨੂੰ ਬਿਹਤਰ ਬਣਾਉਣ ਲਈ ਡਾਟੇ ਦੀ ਵਰਤੋਂ ਕਰਨ ਵਾਲੀਆਂ ਹੋਰ ਸੈਟਿੰਗਾਂ ਲਈ, <ph name="BEGIN_LINK" />Google ਸੇਵਾਵਾਂ<ph name="END_LINK" /> 'ਤੇ ਜਾਓ।</translation>
<translation id="3512168799938877162">ਤੁਹਾਡਾ ਪਾਸਵਰਡ ਸਾਂਝਾ ਨਹੀਂ ਕੀਤਾ ਗਿਆ ਸੀ। ਆਪਣੇ ਇੰਟਰਨੈੱਟ ਕਨੈਕਸ਼ਨ ਦੀ ਜਾਂਚ ਕਰੋ ਅਤੇ ਪੱਕਾ ਕਰੋ ਕਿ ਤੁਸੀਂ Vortex ਵਿੱਚ ਸਾਈਨ-ਇਨ ਕੀਤਾ ਹੋਇਆ ਹੈ। ਫਿਰ, ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰੋ।</translation>
<translation id="3529798650269984835">"Vortex ਨੂੰ ਬੰਦ ਕਰਨ 'ਤੇ ਇਨਕੋਗਨਿਟੋ ਟੈਬਾਂ ਨੂੰ ਲਾਕ ਕਰੋ" ਨੂੰ ਚਾਲੂ ਕਰੋ।</translation>
<translation id="3541247799006476453">ਆਟੋਫਿਲ ਲਈ Vortex ਨਾਲ ਆਪਣੇ ਪਾਸਵਰਡ ਅਤੇ ਪਾਸਕੀਆਂ ਤੱਕ ਆਸਾਨੀ ਨਾਲ ਪਹੁੰਚ ਪ੍ਰਾਪਤ ਕਰੋ</translation>
<translation id="3567399274263440288">Vortex ਦਾ ਵੱਧ ਤੋਂ ਵੱਧ ਲਾਹਾ ਲੈਣ ਲਈ, ਆਪਣੇ Google ਖਾਤੇ ਨਾਲ Vortex ਵਿੱਚ ਸਾਈਨ-ਇਨ ਕਰੋ।</translation>
<translation id="3581385059720151202">Vortex ਵਿੱਚ ਦ੍ਰਿਸ਼ਾਂ ਨੂੰ ਖੋਜੋ</translation>
<translation id="3582640969619785896">Vortex ਤੁਹਾਡੇ ਪਾਸਵਰਡ ਨੂੰ ਰੱਖਿਅਤ ਕਰਨ ਦੀ ਪੇਸ਼ਕਸ਼ ਕਰੇਗਾ</translation>
<translation id="3594315078412605236">Vortex ਵਿੱਚ ਭੁਗਤਾਨ ਵਿਧੀਆਂ ਦਾ ਪ੍ਰਬੰਧਨ ਕਰੋ</translation>
<translation id="3617143087229977194">iOS ਵਿੱਚ ਪੂਰਵ-ਨਿਰਧਾਰਿਤ ਐਪ ਸੈਟਿੰਗਾਂ ਖੋਲ੍ਹੋ, ਫਿਰ "ਬ੍ਰਾਊਜ਼ਰ ਐਪ" 'ਤੇ ਟੈਪ ਕਰੋ ਅਤੇ Vortex ਚੁਣੋ।</translation>
<translation id="3634039384458740619">Vortex ਸੈਟਿੰਗਾਂ ਖੋਲ੍ਹੋ</translation>
<translation id="3639997914391704523">ਤੁਹਾਡੇ ਵੱਲੋਂ ਆਪਣੇ Google ਖਾਤੇ ਵਿੱਚ ਸਾਈਨ-ਇਨ ਕਰਨ 'ਤੇ Vortex ਤੁਹਾਡੇ ਪਾਸਵਰਡਾਂ ਦੀ ਜਾਂਚ ਕਰ ਸਕਦਾ ਹੈ।</translation>
<translation id="372658070733623520">ਆਪਣੇ Google ਖਾਤੇ ਵਿੱਚ Vortex ਡਾਟੇ ਨੂੰ ਵਰਤਣ ਅਤੇ ਰੱਖਿਅਤ ਕਰਨ ਲਈ, ਆਪਣੀ ਪਛਾਣ ਦੀ ਪੁਸ਼ਟੀ ਕਰੋ।</translation>
<translation id="3728124580182886854">ਵਿਅਕਤੀਗਤਕਰਨ ਅਤੇ ਹੋਰ ਉਦੇਸ਼ਾਂ ਲਈ Vortex ਅਤੇ ਹੋਰ Google ਸੇਵਾਵਾਂ ਨੂੰ ਲਿੰਕ ਕਰੋ</translation>
<translation id="377649297473651452">Vortex ਆਟੋਫਿਲ ਦਾ ਵਿਸਤ੍ਰਿਤ ਦ੍ਰਿਸ਼</translation>
<translation id="3780779443901618967">ਇਹ ਸੁਵਿਧਾ ਮਿਆਰੀ ਸੁਰੱਖਿਆ ਨਾਲੋਂ ਜ਼ਿਆਦਾ ਡਾਟੇ ਦਾ ਵਿਸ਼ਲੇਸ਼ਣ ਕਰ ਕੇ ਤੁਹਾਨੂੰ ਅਜਿਹੀਆਂ ਖਤਰਨਾਕ ਸਾਈਟਾਂ ਬਾਰੇ ਚਿਤਾਵਨੀ ਦਿੰਦੀ ਹੈ ਜਿਨ੍ਹਾਂ ਬਾਰੇ Google ਨੂੰ ਪਹਿਲਾਂ ਨਹੀਂ ਪਤਾ ਸੀ। ਤੁਸੀਂ Vortex ਚਿਤਾਵਨੀਆਂ ਨੂੰ ਛੱਡਣ ਦੀ ਚੋਣ ਕਰ ਸਕਦੇ ਹੋ।</translation>
<translation id="3805899903892079518">Vortex ਦੀ ਤੁਹਾਡੀਆਂ ਫ਼ੋਟੋਆਂ ਜਾਂ ਵੀਡੀਓ ਤੱਕ ਪਹੁੰਚ ਨਹੀਂ ਹੈ। iOS ਸੈਟਿੰਗਾਂ &gt; ਪਰਦੇਦਾਰੀ &gt; ਫ਼ੋਟੋਆਂ ਵਿੱਚ ਪਹੁੰਚ ਨੂੰ ਚਾਲੂ ਕਰੋ।</translation>
<translation id="3816686541346279443">Vortex ਤੁਹਾਡੇ ਪਾਸਵਰਡ ਨੂੰ ਰੱਖਿਅਤ ਕਰਨ ਦੀ ਪੇਸ਼ਕਸ਼ ਕਰੇਗਾ।</translation>
<translation id="3827545470516145620">ਤੁਸੀਂ ਇਸ ਡੀਵਾਈਸ 'ਤੇ ਮਿਆਰੀ ਸੁਰੱਖਿਆ ਪ੍ਰਾਪਤ ਕਰ ਰਹੇ ਹੋ</translation>
<translation id="3833326979834193417">Vortex ਤੁਹਾਨੂੰ ਡਾਟਾ ਉਲੰਘਣਾਵਾਂ, ਅਸੁਰੱਖਿਅਤ ਵੈੱਬਸਾਈਟਾਂ ਅਤੇ ਹੋਰ ਚੀਜ਼ਾਂ ਤੋਂ ਸੁਰੱਖਿਅਤ ਰੱਖਣ ਲਈ ਸਵੈਚਲਿਤ ਤੌਰ 'ਤੇ ਰੋਜ਼ਾਨਾ 'ਸੁਰੱਖਿਆ ਜਾਂਚ' ਵਿਸ਼ੇਸ਼ਤਾ ਨੂੰ ਚਲਾਉਂਦਾ ਹੈ। ਤੁਸੀਂ ਸੈਟਿੰਗਾਂ ਵਿੱਚ ਜਾ ਕੇ ਸੁਰੱਖਿਆ ਜਾਂਚ ਬਾਰੇ ਹੋਰ ਜਾਣਕਾਰੀ ਲੱਭ ਸਕਦੇ ਹੋ।</translation>
<translation id="3837584850181228767">Vortex ਨੁਕਤਾ: ਵਿਸਤ੍ਰਿਤ ਸੁਰੱਖਿਅਤ ਬ੍ਰਾਊਜ਼ਿੰਗ</translation>
<translation id="3845223911364528001">ਆਪਣੀ ਫ਼ਾਈਲ ਅੱਪਲੋਡ ਕਰਨ ਲਈ Vortex 'ਤੇ ਵਾਪਸ ਜਾਓ</translation>
<translation id="3855938650519180865">Vortex ਵਿੱਚ ਨਵਾਂ ਕੀ ਹੈ</translation>
<translation id="3886689467633467988">ਆਪਣੇ ਸਾਰੇ ਡੀਵਾਈਸਾਂ 'ਤੇ ਆਪਣੇ ਬੁੱਕਮਾਰਕ ਅਤੇ ਹੋਰ ਬਹੁਤ ਕੁਝ ਪ੍ਰਾਪਤ ਕਰਨ ਲਈ ਇਸ ਸਾਈਟ ਅਤੇ Vortex ਵਿੱਚ ਸਾਈਨ-ਇਨ ਕਰੋ।</translation>
<translation id="3949514465204582407">Vortex ਸੰਬੰਧੀ ਨੁਕਤਾ: ਕਿਸੇ ਵੀ ਐਪ ਵਿੱਚ ਆਪਣੇ ਪਾਸਵਰਡ ਪ੍ਰਾਪਤ ਕਰੋ</translation>
<translation id="4005283307739974863">ਇਸ ਨਾਲ Vortex ਵਿੱਚ ਸੁਰੱਖਿਆ ਜਾਂਚ ਖੁੱਲ੍ਹਦੀ ਅਤੇ ਚੱਲਦੀ ਹੈ।</translation>
<translation id="4043291146360695975">ਪਾਸਵਰਡ ਸਿਰਫ਼ ਇਸ ਡੀਵਾਈਸ 'ਤੇ ਪਾਸਵਰਡ ਪ੍ਰਬੰਧਕ ਵਿੱਚ ਰੱਖਿਅਤ ਕੀਤੇ ਗਏ ਹਨ।</translation>
<translation id="4066426933127344530">Vortex ਨੂੰ ਪੂਰਵ-ਨਿਰਧਾਰਿਤ ਤੌਰ 'ਤੇ ਵਰਤੋ</translation>
<translation id="4087314024407094071">Vortex ਵਿੱਚ ਸੈਟਿੰਗਾਂ ਨੂੰ ਖੋਲ੍ਹਦਾ ਹੈ।</translation>
<translation id="4099085513035183040">Vortex ਬੀਟਾ 'ਤੇ ਸਮਰਥਿਤ ਨਹੀਂ</translation>
<translation id="4106512142782407609"><ph name="EMAIL" /> ਵਜੋਂ ਸਾਈਨ-ਇਨ ਕੀਤਾ ਗਿਆ।

ਤੁਹਾਡਾ ਡਾਟਾ ਤੁਹਾਡੇ ਪਾਸਫਰੇਜ਼ ਨਾਲ ਇਨਕ੍ਰਿਪਟ ਕੀਤਾ ਗਿਆ ਹੈ। ਆਪਣੇ Google ਖਾਤੇ ਵਿੱਚ Vortex ਡਾਟੇ ਨੂੰ ਵਰਤਣ ਅਤੇ ਰੱਖਿਅਤ ਕਰਨ ਲਈ ਇਸਨੂੰ ਦਾਖਲ ਕਰੋ।</translation>
<translation id="4118287192800900567">Vortex ਨੁਕਤਾ: Vortex ਵਿੱਚ ਸਾਈਨ-ਇਨ ਕਰੋ</translation>
<translation id="4195557071150719219">Vortex ਹਾਲੀਆ ਟੈਬਾਂ ਦੇਖੋ</translation>
<translation id="420541179527342563">Vortex ਵਿੱਚ ਲਾਕਡਾਊਨ ਮੋਡ ਨੂੰ ਬੰਦ ਕਰਨ ਲਈ, ਆਪਣੇ iPad 'ਤੇ ਇਸਨੂੰ ਬੰਦ ਕਰੋ।</translation>
<translation id="4272892696084633551">Vortex ਦੀਆਂ ਵਿਸ਼ੇਸ਼ਤਾਵਾਂ ਅਤੇ ਕਾਰਗੁਜ਼ਾਰੀ ਨੂੰ ਬਿਹਤਰ ਬਣਾਉਣ ਵਿੱਚ ਮਦਦ ਕਰੋ</translation>
<translation id="4302397443352897529">Vortex ਸੈਟਿੰਗਾਂ</translation>
<translation id="4304713468139749426">ਪਾਸਵਰਡ ਪ੍ਰਬੰਧਕ</translation>
<translation id="4408912345039114853">Vortex ਸੁਰੱਖਿਆ ਜਾਂਚ ਚਲਾਓ</translation>
<translation id="4432744876818348753">Vortex ਦਾ ਵੱਧ ਤੋਂ ਵੱਧ ਲਾਹਾ ਲੈਣ ਲਈ ਸਾਈਨ-ਇਨ ਕਰੋ।</translation>
<translation id="4445228361214254027">ਤੁਹਾਡੀ ਸੰਸਥਾ ਨੇ ਤੁਹਾਡੇ Google ਖਾਤੇ ਵਿੱਚ Vortex ਡਾਟੇ ਨੂੰ ਵਰਤਣ ਅਤੇ ਰੱਖਿਅਤ ਕਰਨ ਦੀ ਯੋਗਤਾ ਨੂੰ ਬੰਦ ਕਰ ਦਿੱਤਾ। ਨਵੇਂ ਬੁੱਕਮਾਰਕਾਂ, ਪਾਸਵਰਡਾਂ ਅਤੇ ਹੋਰ ਬਹੁਤ ਕੁਝ ਨੂੰ ਸਿਰਫ਼ ਇਸ ਡੀਵਾਈਸ 'ਤੇ ਰੱਖਿਅਤ ਕੀਤਾ ਜਾਵੇਗਾ।</translation>
<translation id="4498832288620833153">ਤੁਹਾਡੇ Vortex ਦੀ ਪੜ੍ਹਨ-ਸੂਚੀ ਵਿੱਚ ਇਨਪੁੱਟ ਕੀਤੇ URL ਸ਼ਾਮਲ ਕਰਦਾ ਹੈ।</translation>
<translation id="4508268628669724828">Vortex ਦਾ ਵੱਧ ਤੋਂ ਵੱਧ ਲਾਹਾ ਲੈਣ ਲਈ ਹੋਰ ਉਪਯੋਗੀ ਸੁਝਾਵਾਂ ਵਾਸਤੇ ਇੱਥੇ ਦੇਖੋ।</translation>
<translation id="452436063477828504">ਪੱਕਾ ਕਰੋ ਕਿ ਤੁਸੀਂ ਆਪਣੇ Google ਖਾਤੇ ਵਿੱਚ ਕਦੇ ਵੀ Vortex ਡਾਟਾ ਵਰਤ ਸਕਦੇ ਹੋ</translation>
<translation id="4527452566931097835">ਕੀ Vortex ਨੂੰ ਪੂਰਵ-ਨਿਰਧਾਰਿਤ ਵਜੋਂ ਸੈੱਟ ਕਰਨਾ ਹੈ?</translation>
<translation id="4555020257205549924">ਜਦੋਂ ਇਹ ਵਿਸ਼ੇਸ਼ਤਾ ਚਾਲੂ ਹੁੰਦੀ ਹੈ, ਤਾਂ Vortex ਹੋਰਾਂ ਭਾਸ਼ਾਵਾਂ ਵਿੱਚ ਲਿਖੇ ਪੰਨਿਆਂ ਨੂੰ Google Translate ਵਰਤਦੇ ਹੋਏ ਅਨੁਵਾਦ ਕਰਨ ਦੀ ਪੇਸ਼ਕਸ਼ ਕਰੇਗਾ। <ph name="BEGIN_LINK" />ਹੋਰ ਜਾਣੋ<ph name="END_LINK" /></translation>
<translation id="4572441104543926904">ਪਾਸਫਰੇਜ਼ ਇਨਕ੍ਰਿਪਸ਼ਨ ਵਿੱਚ ਭੁਗਤਾਨ ਵਿਧੀਆਂ ਅਤੇ ਪਤੇ ਸ਼ਾਮਲ ਨਹੀਂ ਹਨ।

ਇਸ ਸੈਟਿੰਗ ਨੂੰ ਬਦਲਣ ਲਈ, <ph name="BEGIN_LINK" />ਆਪਣੇ ਖਾਤੇ ਵਿੱਚ Vortex ਡਾਟੇ ਨੂੰ ਮਿਟਾਓ<ph name="END_LINK" />।</translation>
<translation id="4578500311756617174">Vortex ਨੁਕਤਾ: Vortex ਨੂੰ ਪੂਰਵ-ਨਿਰਧਾਰਿਤ ਤੌਰ 'ਤੇ ਵਰਤੋ</translation>
<translation id="458786853569524949">ਤੁਸੀਂ ਹੁਣ ਈਮੇਲਾਂ, ਦਸਤਾਵੇਜ਼ਾਂ ਅਤੇ ਹੋਰ ਐਪਾਂ ਵਿਚਲੇ ਲਿੰਕਾਂ 'ਤੇ ਟੈਪ ਕਰ ਕੇ, ਕਿਸੇ ਵੀ ਸਮੇਂ Vortex ਦੀ ਵਰਤੋਂ ਕਰ ਸਕਦੇ ਹੋ।</translation>
<translation id="4633738821577273991">ਇਸ Vortex ਪ੍ਰੋਫਾਈਲ ਲਈ ਵੀ ਵਿਸਤ੍ਰਿਤ ਸੁਰੱਖਿਅਤ ਬ੍ਰਾਊਜ਼ਿੰਗ ਵਿਸ਼ੇਸ਼ਤਾ ਨੂੰ ਪ੍ਰਾਪਤ ਕਰੋ</translation>
<translation id="4654936625574199632">ਐਪ ਨੂੰ ਬਿਹਤਰ ਬਣਾਉਣ ਵਿੱਚ ਮਦਦ ਕਰਨ ਲਈ, Vortex ਵਰਤੋਂ ਅਤੇ ਕ੍ਰੈਸ਼ ਡਾਟਾ Google ਨੂੰ ਭੇਜਦਾ ਹੈ। <ph name="BEGIN_LINK" />ਪ੍ਰਬੰਧਨ ਕਰੋ<ph name="END_LINK" /></translation>
<translation id="4681781466797808448">Vortex ਸਕੈਨਰ ਚਾਲੂ ਕਰੋ</translation>
<translation id="4685611756167369067">Vortex ਇਨਕੋਗਨਿਟੋ ਟੈਬ ਖੋਲ੍ਹੋ</translation>
<translation id="4736424910885271643">ਤੁਹਾਡੇ ਖਾਤੇ ਦਾ ਪ੍ਰਬੰਧਨ <ph name="HOSTED_DOMAIN" /> ਵੱਲੋਂ ਕੀਤਾ ਜਾਂਦਾ ਹੈ, ਇਸ ਲਈ ਇਸ ਡੀਵਾਈਸ ਤੋਂ ਤੁਹਾਡਾ Vortex ਡਾਟਾ ਕਲੀਅਰ ਕਰ ਦਿੱਤਾ ਜਾਵੇਗਾ</translation>
<translation id="4790638144988730920">ਆਪਣੇ Google ਖਾਤੇ ਵਿੱਚ Vortex ਡਾਟਾ ਵਰਤਣਾ ਜਾਰੀ ਰੱਖੋ।</translation>
<translation id="4828317641996116749">Vortex ਸਾਰੇ ਪਾਸਵਰਡਾਂ ਦੀ ਜਾਂਚ ਨਹੀਂ ਕਰ ਸਕਿਆ। ਬਾਅਦ ਵਿੱਚ ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰੋ।</translation>
<translation id="4856138222358683580">Vortex ਕਾਰਵਾਈਆਂ</translation>
<translation id="4904452304169763785">Vortex ਵੱਲੋਂ ਤੁਹਾਡੇ ਲਈ ਪਛਾਣੀਆਂ ਗਈਆਂ ਕਿਸੇ ਵੀ ਤਰ੍ਹਾਂ ਦੀਆਂ ਪਰਦੇਦਾਰੀ ਜਾਂ ਸੁਰੱਖਿਆ ਸਮੱਸਿਆਵਾਂ ਸੰਬੰਧੀ ਅਲਰਟ।</translation>
<translation id="4908570938463711775">Vortex ਸੰਬੰਧੀ ਲਾਹੇਵੰਦ ਮੁੱਢਲੀ ਜਾਣਕਾਰੀ ਪਾਓ, ਤਾਂ ਜੋ ਤੁਸੀਂ ਇਸਦੀ ਵਰਤੋਂ ਕਰਨਾ ਸ਼ੁਰੂ ਕਰ ਸਕੋ</translation>
<translation id="4962295957157529683">ਤੁਸੀਂ ਆਪਣੀ ਦੂਜੀ ਖੁੱਲ੍ਹੀ Vortex ਵਿੰਡੋ ਵਿੱਚ ਜੋ ਕੰਮ ਕਰ ਰਹੇ ਸੀ, ਉਸਨੂੰ ਪੂਰਾ ਕਰੋ।</translation>
<translation id="4985291216379576555">ਆਫ਼ਲਾਈਨ, Vortex ਅੱਪਡੇਟਾਂ ਲਈ ਜਾਂਚ ਨਹੀਂ ਕਰ ਸਕਦਾ</translation>
<translation id="4996471330284142407">ਸਧਾਰਨ, ਸੁੱਰਖਿਅਤ ਅਤੇ ਪਹਿਲਾਂ ਨਾਲੋਂ ਵੱਧ ਤੇਜ਼ Vortex ਨਾਲ ਹੋਰ ਬਹੁਤ ਕੁਝ ਕਰੋ।</translation>
<translation id="4999538639245140991">ਕਿਉਂਕਿ ਤੁਸੀਂ <ph name="SIGNOUT_MANAGED_DOMAIN" /> ਵੱਲੋਂ ਪ੍ਰਬੰਧਿਤ ਕੀਤੇ ਕਿਸੇ ਖਾਤੇ ਵਿੱਚੋਂ ਸਾਈਨ-ਆਊਟ ਕਰ ਰਹੇ ਹੋ, ਇਸ ਲਈ ਇਸ ਡੀਵਾਈਸ ਤੋਂ ਤੁਹਾਡੇ Vortex ਡਾਟੇ ਨੂੰ ਮਿਟਾ ਦਿੱਤਾ ਜਾਵੇਗਾ। ਤੁਹਾਡਾ ਡਾਟਾ ਤੁਹਾਡੇ Google ਖਾਤੇ ਵਿੱਚ ਰਹੇਗਾ।</translation>
<translation id="5042011327527167688">“Vortex 'ਤੇ Google Maps ਨਾਲ ਦੇਖੋ” 'ਤੇ ਟੈਪ ਕਰੋ।</translation>
<translation id="5044871537677053278">Vortex ਪਤਿਆਂ ਬਾਰੇ ਪਤਾ ਲਗਾਉਂਦਾ ਹੈ ਅਤੇ ਤੁਹਾਨੂੰ ਦਿਸ਼ਾਵਾਂ ਅਤੇ ਸਥਾਨਕ ਜਾਣਕਾਰੀ ਦੇਣ ਲਈ Google Maps ਦੀ ਵਰਤੋਂ ਕਰਦਾ ਹੈ।</translation>
<translation id="5048140766121299007">"<ph name="TEXT_OF_THE_SETTINGS_MENU_ITEM" />" ਸੈਟਿੰਗਾਂ ਤੋਂ, "Vortex" ਚਾਲੂ ਕਰੋ ਨੂੰ ਟੌਗਲ ਕਰੋ</translation>
<translation id="5053429694249468757">Vortex ਡਾਟਾ ਮਿਟਾਇਆ ਜਾ ਰਿਹਾ ਹੈ…</translation>
<translation id="5071749685031362629">iOS ਲਈ Vortex</translation>
<translation id="5124429847818367226">ਤੁਸੀਂ ਹੁਣ ਤੁਹਾਡੇ ਵੱਲੋਂ ਸੁਨੇਹਿਆਂ, ਦਸਤਾਵੇਜ਼ਾਂ ਅਤੇ ਹੋਰ ਐਪਾਂ ਵਿਚਲੇ ਲਿੰਕਾਂ ਨੂੰ ਬ੍ਰਾਊਜ਼ ਕਰ ਕੇ ਜਾਂ ਉਨ੍ਹਾਂ 'ਤੇ ਟੈਪ ਕਰ ਕੇ ਕਦੇ ਵੀ Vortex ਦੀ ਵਰਤੋਂ ਕਰ ਸਕਦੇ ਹੋ।</translation>
<translation id="5131565040785979529">ਤੁਹਾਡੀ ਸੰਸਥਾ, <ph name="DOMAIN" />, ਤੁਹਾਡੇ ਵੱਲੋਂ ਸਾਈਨ-ਇਨ ਕੀਤੇ ਖਾਤੇ ਅਤੇ Vortex ਦੇ ਵਰਤੇ ਜਾਣ ਦੇ ਤਰੀਕੇ ਦਾ ਪ੍ਰਬੰਧਨ ਕਰਦੀ ਹੈ।</translation>
<translation id="5134464247000681876">Gmail, Maps, YouTube ਅਤੇ ਹੋਰ ਐਪਾਂ ਦੇ ਲਿੰਕਾਂ ਨੂੰ Vortex ਵਿੱਚ ਖੋਲ੍ਹੋ</translation>
<translation id="5203244847421322551">Vortex ਵਿੱਚ ਪਾਸਵਰਡ ਨੂੰ ਰੱਖਿਅਤ ਕਰੋ ਅਤੇ ਆਟੋਫਿਲ ਕਰੋ</translation>
<translation id="5218806323985098884">ਦੇਖੋ ਕਿ Vortex ਵਿੱਚ ਨਵਾਂ ਕੀ ਹੈ</translation>
<translation id="5224391634244552924">ਕੋਈ ਰੱਖਿਅਤ ਕੀਤਾ ਪਾਸਵਰਡ ਨਹੀਂ। ਤੁਹਾਡੇ ਵੱਲੋਂ ਆਪਣੇ ਪਾਸਵਰਡ ਰੱਖਿਅਤ ਕਰਨ 'ਤੇ Vortex ਉਹਨਾਂ ਦੀ ਜਾਂਚ ਕਰ ਸਕਦਾ ਹੈ।</translation>
<translation id="5259423875997548710">Vortex ਵਿੱਚ ਦ੍ਰਿਸ਼ਾਂ ਨੂੰ ਖੋਜੋ।</translation>
<translation id="5284913972719948193">Vortex 'ਤੇ ਆਪਣੇ ਪਾਸਵਰਡ, ਇਤਿਹਾਸ, ਬੁੱਕਮਾਰਕ ਅਤੇ ਕ੍ਰੈਡਿਟ ਕਾਰਡ ਵਰਤਣ ਲਈ ਆਪਣਾ ਡਾਟਾ ਆਯਾਤ ਕਰੋ</translation>
<translation id="5308226104666789935">Vortex ਅੱਪਡੇਟਾਂ ਲਈ ਜਾਂਚ ਨਹੀਂ ਕਰ ਸਕਦਾ</translation>
<translation id="5311557153294205270">ਤੁਹਾਡੇ Vortex ਬੁੱਕਮਾਰਕਾਂ ਵਿੱਚ ਇਨਪੁੱਟ ਕੀਤੇ URL ਸ਼ਾਮਲ ਕਰਦਾ ਹੈ।</translation>
<translation id="5383251701169024761">ਆਪਣੇ ਰੱਖਿਅਤ ਕੀਤੇ ਪਾਸਵਰਡ ਹੋਰ ਐਪਾਂ ਵਿੱਚ ਆਸਾਨੀ ਨਾਲ ਪ੍ਰਾਪਤ ਕਰਨ ਵਾਸਤੇ, ਆਟੋਫਿਲ ਲਈ Vortex ਨੂੰ ਚੁਣੋ।</translation>
<translation id="538767207339317086">Vortex ਵਿੱਚ ਸਾਈਨ-ਇਨ ਕਰਨ ਦਿਓ</translation>
<translation id="5389058611415066188">Vortex ਨਾਲ ਸੁਰੱਖਿਅਤ ਰਹੋ</translation>
<translation id="5414059596208264343">Vortex ਨੁਕਤਾ: ਆਪਣੇ ਪਾਸਵਰਡ ਪ੍ਰਾਪਤ ਕਰੋ</translation>
<translation id="5415273218238091735">Vortex ਲਈ ਨੁਕਤਾ</translation>
<translation id="5427571867875391349">Vortex ਨੂੰ ਆਪਣੇ ਪੂਰਵ-ਨਿਰਧਾਰਤ ਬ੍ਰਾਊਜ਼ਰ ਦੇ ਤੌਰ 'ਤੇ ਸੈੱਟ ਕਰੋ</translation>
<translation id="5434562575369834882">Vortex ਦੀ ਇਨਕੋਗਨਿਟੋ ਟੈਬ ਵਿੱਚ ਖੋਲ੍ਹੋ</translation>
<translation id="5453478652154926037">Vortex ਤੁਹਾਡੇ ਪਾਸਵਰਡਾਂ ਦੀ ਜਾਂਚ ਨਹੀਂ ਕਰ ਸਕਦਾ।</translation>
<translation id="5479292367402350143">Vortex ਨੂੰ ਆਪਣਾ ਪੂਰਵ-ਨਿਰਧਾਰਿਤ ਬ੍ਰਾਊਜ਼ਰ ਬਣਾਉਣ ਲਈ:
1. ਸੈਟਿੰਗਾਂ ਖੋਲ੍ਹੋ
2. ਪੂਰਵ-ਨਿਰਧਾਰਿਤ ਬ੍ਰਾਊਜ਼ਰ ਐਪ 'ਤੇ ਟੈਪ ਕਰੋ
3. Vortex ਚੁਣੋ</translation>
<translation id="5482686278086727777">Vortex ਤੋਂ ਟੈਬ ਰਿਮਾਈਂਡਰ ਪ੍ਰਾਪਤ ਕਰਨ ਲਈ, ਆਪਣੀਆਂ iOS ਸੈਟਿੰਗਾਂ ਵਿੱਚ ਜਾ ਕੇ ਸੂਚਨਾਵਾਂ ਚਾਲੂ ਕਰੋ।</translation>
<translation id="5521125884468363740">ਜਿਸ ਡੀਵਾਈਸ 'ਤੇ ਵੀ ਤੁਸੀਂ Vortex ਵਰਤਦੇ ਹੋ, ਉੱਥੇ ਆਪਣੀਆਂ ਟੈਬਾਂ ਦੇਖਣ ਲਈ ਸਾਈਨ-ਇਨ ਕਰਕੇ ਸਮਾਲੀਕਰਨ ਕਰੋ</translation>
<translation id="5534584691915394889">ਇਸਦੀ ਵਰਤੋਂ Vortex ਅਤੇ Google Lens ਤੋਂ ਤੁਹਾਡੇ Apple Calendar ਵਿੱਚ ਇਵੈਂਟ ਬਣਾਉਣ ਲਈ ਕੀਤੀ ਜਾਵੇਗੀ।</translation>
<translation id="5571094606370987472">Vortex ਹਾਲੀਆ ਟੈਬਾਂ ਖੋਲ੍ਹਦਾ ਹੈ।</translation>
<translation id="5596644122344097310">ਆਪਣੇ iPhone 'ਤੇ Vortex ਦਾ ਵੱਧ ਤੋਂ ਵੱਧ ਲਾਹਾ ਲੈਣ ਲਈ ਇੱਥੇ ਟੈਪ ਕਰੋ।</translation>
<translation id="5603085937604338780">chromium</translation>
<translation id="5657280937522795751">Vortex ਟੌਗਲ ਕਰੋ</translation>
<translation id="5664395081284292058">Vortex ਵਿੱਚ 'ਮੇਰੀ ਨਵੀਨਤਮ ਟੈਬ' ਖੋਲ੍ਹੋ</translation>
<translation id="5671188105328420281">Vortex ਸੰਬੰਧੀ ਨੁਕਤੇ</translation>
<translation id="5688047395118852662">ਇਹ ਕਾਰਡ ਤੁਹਾਨੂੰ Vortex ਦਾ ਵੱਧ ਤੋਂ ਵੱਧ ਲਾਹਾ ਲੈਣ ਦੇ ਤਰੀਕੇ ਬਾਰੇ ਸੁਝਾਅ ਦਿਖਾਉਂਦਾ ਹੈ।</translation>
<translation id="5700709190537129682">Vortex ਤੁਹਾਡੇ ਪਾਸਵਰਡਾਂ ਦੀ ਜਾਂਚ ਨਹੀਂ ਕਰ ਸਕਦਾ</translation>
<translation id="5731004036450828399">ਆਪਣੀਆਂ ਪਾਸਕੀਆਂ ਨੂੰ ਸੁਰੱਖਿਅਤ ਰੱਖਣ ਲਈ, ਤੁਹਾਨੂੰ ਪਹਿਲਾਂ ਇੱਕ ਰਿਕਵਰੀ ਪਿੰਨ ਬਣਾਉਣ ਦੀ ਲੋੜ ਪਵੇਗੀ।

        ਪਾਸਕੀਆਂ ਨੂੰ Password Manager ਵਿੱਚ ਰੱਖਿਅਤ ਕੀਤਾ ਜਾਂਦਾ ਹੈ, ਜਿਸ ਨਾਲ ਤੁਸੀਂ ਕਿਸੇ ਵੀ ਡੀਵਾਈਸ 'ਤੇ Vortex ਵਿੱਚ ਉਨ੍ਹਾਂ ਦੀ ਵਰਤੋਂ ਕਰ ਸਕਦੇ ਹੋ।</translation>
<translation id="584550191241316896">Vortex ਵਿੱਚ ਸਾਈਨ-ਇਨ ਕੀਤਾ ਗਿਆ</translation>
<translation id="5862307444128926510">Vortex ਵਿੱਚ ਸੁਆਗਤ ਹੈ</translation>
<translation id="5889847953983052353">ਚਾਲੂ ਹੋਣ 'ਤੇ:
<ph name="BEGIN_INDENT" />  • ਉਨ੍ਹਾਂ ਲੋਕਾਂ ਲਈ Vortex ਨੂੰ ਬਿਹਤਰ ਬਣਾਉਣ ਵਿੱਚ ਮਦਦ ਕਰੋ ਜੋ ਇਸਨੂੰ ਤੁਹਾਡੇ ਤਰੀਕੇ ਮੁਤਾਬਕ ਵਰਤਦੇ ਹਨ।<ph name="END_INDENT" />

ਵਿਚਾਰੇ ਜਾਣ ਵਾਲੀਆਂ ਚੀਜ਼ਾਂ:
<ph name="BEGIN_INDENT" />  • ਤੁਹਾਡੀ Vortex ਵਰਤੋਂ ਦੀ ਜਾਣਕਾਰੀ Google ਨੂੰ ਭੇਜੀ ਜਾਂਦੀ ਹੈ ਪਰ ਇਹ ਤੁਹਾਡੇ ਨਾਲ ਸੰਬੰਧਿਤ ਨਹੀਂ ਹੁੰਦੀ।

  • ਜੇ Vortex ਕ੍ਰੈਸ਼ ਹੋ ਜਾਂਦੀ ਹੈ, ਤਾਂ ਕ੍ਰੈਸ਼ ਦੇ ਵੇਰਵਿਆਂ ਵਿੱਚ ਕੁਝ ਨਿੱਜੀ ਜਾਣਕਾਰੀ ਸ਼ਾਮਲ ਹੋ ਸਕਦੀ ਹੈ।

  • ਜੇ ਤੁਸੀਂ ਆਪਣੇ Google ਖਾਤੇ ਨਾਲ ਆਪਣੇ ਇਤਿਹਾਸ ਨੂੰ ਸਿੰਕ ਕਰਦੇ ਹੋ, ਤਾਂ ਮਾਪਕਾਂ ਵਿੱਚ ਉਨ੍ਹਾਂ URL ਬਾਰੇ ਵੀ ਜਾਣਕਾਰੀ ਸ਼ਾਮਲ ਹੋ ਸਕਦੀ ਹੈ ਜਿਨ੍ਹਾਂ 'ਤੇ ਤੁਸੀਂ ਜਾਂਦੇ ਹੋ।<ph name="END_INDENT" /></translation>
<translation id="5932787118589620366">Vortex ਤੋਂ ਬ੍ਰਾਊਜ਼ਿੰਗ ਡਾਟਾ ਮਿਟਾਓ।</translation>
<translation id="593808800391107017">Vortex ਵੱਲੋਂ ਸਵੈਚਲਿਤ ਤੌਰ 'ਤੇ ਤੁਹਾਡੇ ਲਈ ਪਛਾਣੀਆਂ ਗਈਆਂ ਕਿਸੇ ਵੀ ਤਰ੍ਹਾਂ ਦੀਆਂ ਪਰਦੇਦਾਰੀ ਜਾਂ ਸੁਰੱਖਿਆ ਸਮੱਸਿਆਵਾਂ ਸੰਬੰਧੀ ਅਲਰਟ ਪ੍ਰਾਪਤ ਕਰੋ।</translation>
<translation id="5951593919357934226">Vortex ਦਾ ਵੱਧ ਤੋਂ ਵੱਧ ਲਾਹਾ ਲੈਣ ਲਓ।</translation>
<translation id="5985254578475526217">Vortex ਤੋਂ ਸੂਚਨਾਵਾਂ ਪ੍ਰਾਪਤ ਕਰਨ ਲਈ, ਆਪਣੀਆਂ iOS ਸੈਟਿੰਗਾਂ ਵਿੱਚ ਸੂਚਨਾਵਾਂ ਨੂੰ ਚਾਲੂ ਕਰੋ।</translation>
<translation id="6041226255405329731">ਟੈਬ ਗਰੁੱਪਾਂ ਨੂੰ ਸਾਂਝਾ ਕਰਨ ਅਤੇ ਉਨ੍ਹਾਂ ਵਿੱਚ ਸ਼ਾਮਲ ਹੋਣ ਲਈ ਅਤੇ ਜੁਗਤਾਂ 'ਤੇ ਇਕੱਠੇ ਮਿਲ ਕੇ ਕੰਮ ਕਰਨ ਲਈ Vortex ਵਿੱਚ ਸਾਈਨ-ਇਨ ਕਰੋ</translation>
<translation id="6104024151682120539">Vortex ਵਿੱਚ ਖੋਲ੍ਹੋ</translation>
<translation id="61109258320235597">ਆਪਣੇ Google ਖਾਤੇ ਵਿੱਚ Vortex ਡਾਟੇ ਨੂੰ ਵਰਤਣ ਅਤੇ ਰੱਖਿਅਤ ਕਰਨ ਲਈ, ਆਪਣਾ ਪਾਸਫਰੇਜ਼ ਦਾਖਲ ਕਰੋ।</translation>
<translation id="6132149203299792222">ਆਪਣੇ ਪਾਸਵਰਡਾਂ, ਬੁੱਕਮਾਰਕਾਂ ਅਤੇ ਹੋਰ ਚੀਜ਼ਾਂ ਨੂੰ ਸਿੰਕ ਕਰਨ ਲਈ ਆਪਣੇ Google ਖਾਤੇ ਨਾਲ ਸਾਈਨ-ਇਨ ਕਰੋ।</translation>
<translation id="6148377327556085395">Vortex ਵਿੱਚ ਬੁੱਕਮਾਰਕ ਸ਼ਾਮਲ ਕਰੋ</translation>
<translation id="6154098560469640583">ਸੁਨੇਹਿਆਂ, ਦਸਤਾਵੇਜ਼ਾਂ ਅਤੇ ਹੋਰ ਐਪਾਂ ਵਿੱਚ ਦਿੱਤੇ ਲਿੰਕਾਂ 'ਤੇ ਟੈਪ ਕਰ ਕੇ ਕਿਸੇ ਵੀ ਵੇਲੇ Vortex ਦੀ ਵਰਤੋਂ ਕਰੋ।</translation>
<translation id="6157162508956739031">Vortex ਤੋਂ ਆਪਣੇ ਪਾਸਵਰਡਾਂ ਅਤੇ ਪਾਸਕੀਆਂ ਨੂੰ ਆਟੋਫਿਲ ਕਰਨ ਦੀ ਸੁਵਿਧਾ ਨੂੰ ਚਾਲੂ ਕਰ ਕੇ ਐਪਾਂ ਅਤੇ ਸਾਈਟਾਂ ਵਿੱਚ ਤੇਜ਼ੀ ਨਾਲ ਸਾਈਨ-ਇਨ ਕਰੋ</translation>
<translation id="6170619162539716595">ਪਛਾਣੇ ਗਏ ਪਤਿਆਂ 'ਤੇ ਤੁਹਾਨੂੰ ਦਿਸ਼ਾਵਾਂ ਅਤੇ ਸਥਾਨਕ ਜਾਣਕਾਰੀ ਦੇਣ ਲਈ, Vortex ਨੂੰ Google Maps ਵਰਤਣ ਦੀ ਆਗਿਆ ਦਿਓ।</translation>
<translation id="6244277266078678766">ਤੁਹਾਡੇ ਡਾਟੇ ਨੂੰ <ph name="USER_EMAIL" /> ਲਈ Password Manager ਵਿੱਚ ਰੱਖਿਅਤ ਕੀਤਾ ਜਾਵੇਗਾ</translation>
<translation id="6268381023930128611">ਕੀ Vortex ਤੋਂ ਸਾਈਨ-ਆਊਟ ਹੋਣਾ ਹੈ?</translation>
<translation id="6301717043141881464">ਆਪਣੇ ਰੱਖਿਅਤ ਕੀਤੇ ਪਾਸਵਰਡ ਆਪਣੀਆਂ ਹੋਰ ਐਪਾਂ ਵਿੱਚ ਆਸਾਨੀ ਨਾਲ ਪ੍ਰਾਪਤ ਕਰਨ ਵਾਸਤੇ, ਆਟੋਫਿਲ ਲਈ Vortex ਦੀ ਚੋਣ ਕਰੋ</translation>
<translation id="6324041800010509197">Vortex ਵਿੱਚ ਟੈਬ ਗਰਿੱਡ 'ਤੇ ਜਾਓ</translation>
<translation id="6325378625795868881">ਸੁਨੇਹੇ ਅਤੇ ਹੋਰ ਐਪਾਂ ਵਿਚਲੇ ਲਿੰਕਾਂ 'ਤੇ ਟੈਪ ਕਰ ਕੇ ਕਿਸੇ ਵੇਲੇ ਵੀ Vortex ਦੀ ਵਰਤੋਂ ਕਰੋ।</translation>
<translation id="6387994184698195448">Vortex ਦੇ ਲਾਹੇਵੰਦ ਨੁਕਤਿਆਂ ਅਤੇ ਹੋਰ ਚੀਜ਼ਾਂ ਬਾਰੇ ਜਾਣੂ ਰਹੋ।</translation>
<translation id="6424492062988593837">Vortex ਬਿਹਤਰ ਬਣ ਗਿਆ ਹੈ! ਇੱਕ ਨਵਾਂ ਵਰਜਨ ਉਪਲਬਧ ਹੈ।</translation>
<translation id="6433172051771630690">Vortex ਦਾ ਵੱਧ ਤੋਂ ਵੱਧ ਲਾਹਾ ਲੈਣ ਸੰਬੰਧੀ ਨੁਕਤੇ।</translation>
<translation id="65045991564554105">Vortex ਬੁੱਕਮਾਰਕਾਂ ਨੂੰ ਦੇਖੋ</translation>
<translation id="6519797228806907665">ਆਪਣੇ iPhone ਦੀ ਹੋਮ ਸਕ੍ਰੀਨ ਤੋਂ Vortex ਤੱਕ ਵਧੇਰੇ ਤੇਜ਼ੀ ਨਾਲ ਪਹੁੰਚ ਕਰੋ।</translation>
<translation id="6538713818758208754">ਇਸ ਨਾਲ Vortex ਵਿੱਚ ਭੁਗਤਾਨ ਵਿਧੀ ਸੈਟਿੰਗ ਪੰਨਾ ਖੁੱਲ੍ਹਦਾ ਹੈ।</translation>
<translation id="6540186279384079894">Vortex ਵਿੱਚ ਨਵੀਂ ਟੈਬ ਖੋਲ੍ਹੋ</translation>
<translation id="6563921047760808519"><ph name="BEGIN_LINK" />Vortex ਤੁਹਾਡੇ ਡਾਟੇ ਨੂੰ ਨਿੱਜੀ ਕਿਵੇਂ ਰੱਖਦਾ ਹੈ<ph name="END_LINK" /> ਇਸ ਬਾਰੇ ਹੋਰ ਜਾਣੋ</translation>
<translation id="6564769014061914792">ਆਪਣੇ iPad 'ਤੇ Vortex ਦਾ ਵੱਧ ਤੋਂ ਵੱਧ ਲਾਹਾ ਲੈਣ ਲਈ ਇੱਥੇ ਟੈਪ ਕਰੋ।</translation>
<translation id="6566303693324540692">Vortex ਨੁਕਤਾ: Vortex ਨੂੰ ਆਪਣੀ ਹੋਮ ਸਕ੍ਰੀਨ 'ਤੇ ਲਿਜਾਓ</translation>
<translation id="6574750762636192517">Vortex ਵਿੱਚ ਪਾਸਵਰਡਾਂ ਦਾ ਪ੍ਰਬੰਧਨ ਕਰੋ</translation>
<translation id="6590232959690355435">ਇਸ ਨਾਲ ਤੁਹਾਡਾ Vortex ਇਤਿਹਾਸ ਪੰਨਾ ਖੁੱਲ੍ਹਦਾ ਹੈ।</translation>
<translation id="6649269674808477353">ਆਪਣੇ iPhone 'ਤੇ ਬ੍ਰਾਊਜ਼ ਕਰਨ ਲਈ ਤਿਆਰ ਹੋਣ 'ਤੇ, Vortex ਨੂੰ ਤੇਜ਼ੀ ਨਾਲ ਖੋਲ੍ਹੋ।</translation>
<translation id="6674470628873622334">ਇਸ ਨਾਲ ਨਵੀਂ Vortex ਇਨਕੋਗਨਿਟੋ ਟੈਬ ਖੁੱਲ੍ਹਦੀ ਹੈ।</translation>
<translation id="6680609900732453726">ਤੁਹਾਡੇ ਵੱਲੋਂ Vortex ਨੂੰ ਬੰਦ ਕਰਨ 'ਤੇ ਡੀਵਾਈਸ ਪ੍ਰਮਾਣੀਕਰਨ ਨਾਲ ਆਪਣੀ ਬ੍ਰਾਊਜ਼ਿੰਗ ਨੂੰ ਨਿੱਜੀ ਰੱਖੋ</translation>
<translation id="6752854822223394465">ਤੁਹਾਡੀ ਸੰਸਥਾ Vortex ਦਾ ਸੈੱਟਅੱਪ ਕਰ ਰਹੀ ਹੈ...</translation>
<translation id="6794054469102824109">Vortex Dino ਗੇਮ ਨੂੰ ਖੋਲ੍ਹਦਾ ਹੈ।</translation>
<translation id="6820823224820483452">Vortex ਸਾਰੇ ਪਾਸਵਰਡਾਂ ਦੀ ਜਾਂਚ ਨਹੀਂ ਕਰ ਸਕਿਆ। ਕੱਲ੍ਹ ਨੂੰ ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰੋ।</translation>
<translation id="6830782797004194206">Vortex ਆਟੋਫਿਲ ਨਾਲ ਛੇਤੀ ਸਾਈਨ-ਇਨ ਕਰੋ</translation>
<translation id="6831043979455480757">ਅਨੁਵਾਦ ਕਰੋ</translation>
<translation id="6852419005633611413">ਆਪਣੇ ਹੋਮ ਸਕ੍ਰੀਨ ਡੌਕ ਤੋਂ Vortex ਤੱਕ ਵਧੇਰੇ ਤੇਜ਼ੀ ਨਾਲ ਪਹੁੰਚ ਕਰੋ</translation>
<translation id="6852799557929001644">ਇਸ ਡੀਵਾਈਸ 'ਤੇ ਮੌਜੂਦ ਹੋਰ ਐਪਾਂ ਵਿੱਚ ਆਪਣੇ Vortex ਪਾਸਵਰਡਾਂ ਅਤੇ ਹੋਰ ਚੀਜ਼ਾਂ ਤੱਕ ਪਹੁੰਚ ਕਰੋ।</translation>
<translation id="6887138405044152640">ਇਸ ਟੈਬ ਨੂੰ ਕਿਸੇ ਹੋਰ ਡੀਵਾਈਸ 'ਤੇ ਭੇਜਣ ਲਈ ਉਸ ਡੀਵਾਈਸ 'ਤੇ Vortex ਵਿੱਚ ਸਾਈਨ-ਇਨ ਕਰੋ।</translation>
<translation id="6911341667534646387">ਆਪਣੇ Google ਖਾਤੇ ਵਿੱਚ Vortex ਡਾਟਾ ਵਰਤਣਾ ਜਾਰੀ ਰੱਖੋ</translation>
<translation id="7018284295775193585">Vortex ਨੂੰ ਅੱਪਡੇਟ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ</translation>
<translation id="7055269218854630176">ਤੁਹਾਡੀ ਸੰਸਥਾ, <ph name="DOMAIN" />, ਤੁਹਾਡੇ ਵੱਲੋਂ ਸਾਈਨ-ਇਨ ਕੀਤੇ ਜਾਣ ਵਾਲੇ ਖਾਤੇ ਅਤੇ Vortex ਦੇ ਵਰਤੇ ਜਾਣ ਦੇ ਤਰੀਕੇ ਦਾ ਪ੍ਰਬੰਧਨ ਕਰਦੀ ਹੈ। ਤੁਹਾਡਾ ਪ੍ਰਸ਼ਾਸਕ ਕੁਝ ਖਾਸ ਵਿਸ਼ੇਸ਼ਤਾਵਾਂ ਦਾ ਸੈੱਟਅੱਪ ਜਾਂ ਉਨ੍ਹਾਂ ਨੂੰ ਪ੍ਰਤਿਬੰਧਿਤ ਕਰ ਸਕਦਾ ਹੈ।</translation>
<translation id="7099326575020694068">Vortex ਸਪਲਿਟ ਦ੍ਰਿਸ਼ ਮੋਡ ਤੁਹਾਡੇ ਕੈਮਰੇ ਦੀ ਵਰਤੋਂ ਨਹੀਂ ਕਰ ਸਕਦਾ ਹੈ</translation>
<translation id="7165402419892018581">ਆਟੋਫਿਲ ਲਈ Vortex ਚੁਣੋ</translation>
<translation id="7175400662502680481">ਤੁਹਾਡੇ ਪਾਸਵਰਡ ਦਾ ਕਿਸੇ ਡਾਟਾ ਉਲੰਘਣਾ ਵਿੱਚ ਖੁਲਾਸਾ ਹੋਇਆ ਸੀ। ਪਾਸਵਰਡ ਪ੍ਰਬੰਧਕ ਇਸਨੂੰ ਹੁਣੇ ਬਦਲਣ ਦੀ ਸਿਫ਼ਾਰਸ਼ ਕਰਦਾ ਹੈ।</translation>
<translation id="7185731475720473450">ਭੁਗਤਾਨ ਵਿਧੀਆਂ ਅਤੇ ਪਤਿਆਂ ਨੂੰ ਇਨਕ੍ਰਿਪਟ ਨਹੀਂ ਕੀਤਾ ਜਾਵੇਗਾ। Vortex ਦੇ ਬ੍ਰਾਊਜ਼ਿੰਗ ਇਤਿਹਾਸ ਨੂੰ ਸਿੰਕ ਨਹੀਂ ਕੀਤਾ ਜਾਵੇਗਾ।

ਸਿਰਫ਼ ਤੁਹਾਡੇ ਪਾਸਫਰੇਜ਼ ਨਾਲ ਹੀ ਕੋਈ ਤੁਹਾਡੇ ਇਨਕ੍ਰਿਪਟਡ ਡਾਟੇ ਨੂੰ ਪੜ੍ਹ ਸਕਦਾ ਹੈ। ਪਾਸਫਰੇਜ਼ Google ਨੂੰ ਨਹੀਂ ਭੇਜਿਆ ਜਾਂਦਾ ਜਾਂ ਇਸ ਵੱਲੋਂ ਸਟੋਰ ਨਹੀਂ ਕੀਤਾ ਜਾਂਦਾ। ਜੇ ਤੁਸੀਂ ਆਪਣਾ ਪਾਸਫਰੇਜ਼ ਭੁੱਲ ਜਾਂਦੇ ਹੋ ਜਾਂ ਇਸ ਸੈਟਿੰਗ ਨੂੰ ਬਦਲਣਾ ਚਾਹੁੰਦੇ ਹੋ, ਤਾਂ <ph name="BEGIN_LINK" />ਆਪਣੇ ਖਾਤੇ ਵਿੱਚ Vortex ਡਾਟੇ ਨੂੰ ਮਿਟਾਓ<ph name="END_LINK" />।</translation>
<translation id="7192111075364461693">ਤੁਹਾਡੇ ਡੀਵਾਈਸ ਦੀਆਂ ਸੈਟਿੰਗਾਂ ਵਿੱਚ Vortex ਦੀਆਂ ਸੂਚਨਾਵਾਂ ਫ਼ਿਲਹਾਲ ਬੰਦ ਹਨ।</translation>
<translation id="7195217321165708458">Vortex ਵਿੱਚ Gemini</translation>
<translation id="7219205286115692265">ਆਪਣੇ iPad ਦੀ ਹੋਮ ਸਕ੍ਰੀਨ ਡੌਕ ਤੋਂ Vortex ਤੱਕ ਵਧੇਰੇ ਤੇਜ਼ੀ ਨਾਲ ਪਹੁੰਚ ਕਰੋ।</translation>
<translation id="7222001353246886083">Vortex ਵਿੱਚ ${searchPhrase} ਖੋਜੋ</translation>
<translation id="7228180817326917122">Vortex ਨੁਕਤਾ: ਆਪਣੀ ਪਤਾ ਬਾਰ ਸਥਿਤੀ ਨੂੰ ਚੁਣੋ</translation>
<translation id="725427773388857052">ਡਾਟਾ ਉਲੰਘਣਾਵਾਂ, ਅਸੁਰੱਖਿਅਤ ਵੈੱਬਸਾਈਟਾਂ ਅਤੇ ਹੋਰ ਚੀਜ਼ਾਂ ਤੋਂ ਸੁਰੱਖਿਅਤ ਰਹਿਣ ਵਿੱਚ Vortex ਤੁਹਾਡੀ ਮਦਦ ਕਰ ਸਕਦਾ ਹੈ।</translation>
<translation id="7269362888766543920">ਕੁਝ ਐਡ-ਆਨ Vortex ਨੂੰ ਕ੍ਰੈਸ਼ ਕਰ ਦਿੰਦੇ ਹਨ। ਕਿਰਪਾ ਕਰਕੇ ਉਹਨਾਂ ਨੂੰ ਅਣਸਥਾਪਤ ਕਰਨ ਦੀ ਕੋਸ਼ਿਸ਼ ਕਰੋ।</translation>
<translation id="7285031092584344905">ਆਪਣੇ Vortex ਪਾਸਵਰਡਾਂ ਅਤੇ ਹੋਰ ਐਪਾਂ ਵਿੱਚ ਹੋਰ ਚੀਜ਼ਾਂ ਤੱਕ ਪਹੁੰਚ ਕਰੋ।</translation>
<translation id="7337881442233988129">Vortex</translation>
<translation id="7395825497086981028">ਤੁਹਾਡੇ ਪਾਸਵਰਡ ਨੂੰ <ph name="EMAIL" /> ਲਈ ਪਾਸਵਰਡ ਪ੍ਰਬੰਧਕ ਵਿੱਚ ਰੱਖਿਅਤ ਕੀਤਾ ਜਾਵੇਗਾ।</translation>
<translation id="7434848749522628428">ਇਸ ਪਾਸਕੀ ਨੂੰ <ph name="USER_EMAIL" /> ਲਈ Password Manager ਵਿੱਚ ਰੱਖਿਅਤ ਕੀਤਾ ਜਾਵੇਗਾ</translation>
<translation id="7504829997542308412">Vortex ਖੋਲ੍ਹੋ</translation>
<translation id="7531461704633548377">Vortex ਤੋਂ</translation>
<translation id="7554983317097061001">Vortex ਨੁਕਤਾ: Vortex ਨੂੰ ਡੌਕ 'ਤੇ ਲਿਜਾਓ</translation>
<translation id="7576863740961052505">Vortex ਸੈਟਿੰਗਾਂ ਦਾ ਪ੍ਰਬੰਧਨ ਕਰੋ</translation>
<translation id="7674213385180944843">ਸੈਟਿੰਗਾਂ &gt; ਪਰਦੇਦਾਰੀ &gt; ਕੈਮਰਾ &gt; Vortex ਖੋਲ੍ਹੋ ਅਤੇ ਕੈਮਰਾ ਚਾਲੂ ਕਰੋ।</translation>
<translation id="7685160423563372998">Vortex ਵਿੱਚ Gemini ਨਾਲ ਚਿੱਤਰ ਬਣਾਓ</translation>
<translation id="7733418656985455268">Vortex ਦਾ ਨੁਕਤਾ: Lens ਰਾਹੀਂ ਖੋਜੋ</translation>
<translation id="7747820849741499258">Vortex ਵਿੱਚ ਖੋਜੋ</translation>
<translation id="7753923083404296545">Vortex ਇਨਕੋਗਨਿਟੋ ਵਿੱਚ ਖੋਲ੍ਹਿਆ ਗਿਆ</translation>
<translation id="7762622637388462191">Vortex ਤੋਂ ਬਾਹਰ ਨਿਕਲਣ ਜਾਂ ਕਿਸੇ ਵੱਖਰੀ ਐਪ 'ਤੇ ਸਵਿੱਚ ਕਰਨ ਦੌਰਾਨ ਆਪਣੀਆਂ ਇਨਕੋਗਨਿਟੋ ਟੈਬਾਂ ਨੂੰ ਲਾਕ ਕਰੋ।</translation>
<translation id="7763454117143368771">ਖਤਰਨਾਕ ਸਾਈਟਾਂ ਤੋਂ ਸੁਰੱਖਿਅਤ ਰਹਿਣ ਅਤੇ ਆਪਣੇ ਪਾਸਵਰਡ ਸੁਰੱਖਿਅਤ ਰੱਖਣ ਲਈ Vortex ਨੂੰ ਆਪਣੇ ਪੂਰਵ-ਨਿਰਧਾਰਿਤ ਬ੍ਰਾਊਜ਼ਰ ਵਜੋਂ ਵਰਤੋ</translation>
<translation id="7784950022329154821">ਤੁਹਾਡੇ ਵੱਲੋਂ Vortex ਨੂੰ ਬੰਦ ਕੀਤੇ ਜਾਣ 'ਤੇ ਇਨਕੋਗਨਿਟੋ ਟੈਬਾਂ ਨੂੰ ਲਾਕ ਕਰੋ</translation>
<translation id="78025249032851484">ਤੁਹਾਡੇ Vortex ਦਾ ਵਰਜਨ ਪੁਰਾਣਾ ਹੈ।</translation>
<translation id="7859018312476869945">ਤੁਹਾਡੇ ਵੱਲੋਂ ਪਤਾ ਬਾਰ ਜਾਂ ਖੋਜ ਬਾਕਸ ਵਿੱਚ ਟਾਈਪ ਕਰਨ ਵੇਲੇ, Vortex ਉਸਨੂੰ ਤੁਹਾਡੇ ਪੂਰਵ-ਨਿਰਧਾਰਿਤ ਖੋਜ ਇੰਜਣ ਵਿੱਚ ਭੇਜਦਾ ਹੈ, ਤਾਂ ਜੋ ਬਿਹਤਰ ਸੁਝਾਅ ਪ੍ਰਾਪਤ ਕੀਤੇ ਜਾ ਸਕਣ। ਇਹ ਇਨਕੋਗਨਿਟੋ ਵਿੱਚ ਬੰਦ ਹੈ।</translation>
<translation id="7890287942691234100">Vortex ਸਕੈਨਰ ਵਰਤਣਾ ਸ਼ੁਰੂ ਕਰੋ</translation>
<translation id="7905064834449738336">ਜਦੋਂ ਤੁਸੀਂ ਪਾਸਵਰਡ ਵਰਤਦੇ ਹੋ, ਤਾਂ Vortex ਉਸਦੇ ਆਨਲਾਈਨ ਪ੍ਰਕਾਸ਼ਿਤ ਹੋਣ ਦੀ ਸਥਿਤੀ ਵਿੱਚ ਤੁਹਾਨੂੰ ਚਿਤਾਵਨੀ ਦਿੰਦਾ ਹੈ। ਅਜਿਹਾ ਕਰਨ ਵੇਲੇ, ਤੁਹਾਡੇ ਪਾਸਵਰਡ ਅਤੇ ਵਰਤੋਂਕਾਰ ਨਾਮ ਇਨਕ੍ਰਿਪਟ ਕੀਤੇ ਜਾਂਦੇ ਹਨ, ਇਸ ਲਈ ਉਹ Google ਸਮੇਤ ਕਿਸੇ ਵੱਲੋਂ ਵੀ ਪੜ੍ਹੇ ਨਹੀਂ ਜਾ ਸਕਦੇ।</translation>
<translation id="7928628054454574139">ਜਦੋਂ ਵੀ ਤੁਸੀਂ ਹੋਰ ਐਪਾਂ ਵਿਚਲੇ ਲਿੰਕਾਂ 'ਤੇ ਟੈਪ ਕਰਦੇ ਹੋ, ਤਾਂ Vortex ਖੋਲ੍ਹੋ</translation>
<translation id="7934404985878918282">Vortex ਦੀ ਪੜ੍ਹਨ-ਸੂਚੀ ਦੇਖੋ</translation>
<translation id="7935734571048689933">Vortex ਦਾ ਪ੍ਰਬੰਧਨ ਕੀਤਾ ਜਾ ਰਿਹਾ ਹੈ</translation>
<translation id="7951793218148208717">Vortex ਵਿੱਚ ਨਵੀਂ ਟੈਬ ਖੋਲ੍ਹਦਾ ਹੈ।</translation>
<translation id="7957726318578167662">ਸੁਨੇਹੇ ਜਾਂ ਹੋਰ ਐਪਾਂ ਵਿਚਲੇ ਲਿੰਕਾਂ 'ਤੇ ਟੈਪ ਕਰ ਕੇ ਕਿਸੇ ਵੇਲੇ ਵੀ ਆਸਾਨੀ ਨਾਲ Vortex ਦੀ ਵਰਤੋਂ ਕਰੋ।</translation>
<translation id="7980860476903281594">Vortex ਤੁਹਾਡੇ ਵੱਲੋਂ ਆਗਿਆ ਦਿੱਤੀਆਂ ਸਾਈਟਾਂ ਨਾਲ ਤੁਹਾਡਾ ਟਿਕਾਣਾ ਸਾਂਝਾ ਕਰਦਾ ਹੈ।</translation>
<translation id="7994322153108931467">ਲਾਹੇਵੰਦ Vortex ਨੁਕਤੇ ਪ੍ਰਾਪਤ ਕਰਨ ਲਈ, ਆਪਣੀਆਂ iOS ਸੈਟਿੰਗਾਂ ਵਿੱਚ ਸੂਚਨਾਵਾਂ ਚਾਲੂ ਕਰੋ।</translation>
<translation id="7997159823054171568">Vortex ਨੂੰ ਪੂਰਵ-ਨਿਰਧਾਰਿਤ ਬ੍ਰਾਊਜ਼ਰ ਵਜੋਂ ਸੈੱਟ ਕਰੋ</translation>
<translation id="800380310260616129">Vortex ਨੂੰ ਇੱਥੋਂ ਡਾਊਨਲੋਡ ਕਰੋ।</translation>
<translation id="8013573822802650211">ਜਿਸ ਡੀਵਾਈਸ 'ਤੇ ਵੀ ਤੁਸੀਂ Vortex ਵਰਤਦੇ ਹੋ, ਉੱਥੇ ਆਪਣੀਆਂ ਟੈਬਾਂ ਦੇਖਣ ਲਈ ਸਾਈਨ-ਇਨ ਕਰੋ</translation>
<translation id="8014091604604659473">Vortex ਸਾਈਨ-ਆਊਟ ਕੀਤਾ ਗਿਆ ਹੈ</translation>
<translation id="8104697640054703121">ਹਾਨੀਕਾਰਕ ਸਾਈਟਾਂ ਤੋਂ Vortex ਦੀ ਸਭ ਤੋਂ ਮਜ਼ਬੂਤ ਸੁਰੱਖਿਆ ਪ੍ਰਾਪਤ ਕਰੋ</translation>
<translation id="8119542592987737574">ਆਪਣੇ iPhone ਦੀ ਹੋਮ ਸਕ੍ਰੀਨ ਡੌਕ ਤੋਂ Vortex ਤੱਕ ਵਧੇਰੇ ਤੇਜ਼ੀ ਨਾਲ ਪਹੁੰਚ ਕਰੋ।</translation>
<translation id="8164086860209325020">Vortex ਸੈਟਿੰਗਾਂ 'ਤੇ ਜਾਓ</translation>
<translation id="8197822717502700527">ਤੁਸੀਂ ਹੁਣ ਆਪਣੇ ਡੀਵਾਈਸ 'ਤੇ Vortex ਦਾ ਵੱਧ ਤੋਂ ਵੱਧ ਲਾਹਾ ਲਓਗੇ।</translation>
<translation id="8236210361418193126">Password Manager ਵਿੱਚ ਆਯਾਤ ਕਰੋ</translation>
<translation id="8254729934443216898">ਨਵੀਆਂ ਵਿਸ਼ੇਸ਼ਤਾਵਾਂ ਦੀ ਪੜਚੋਲ ਕਰੋ ਜੋ Vortex ਦਾ ਵੱਧ ਤੋਂ ਵੱਧ ਲਾਹਾ ਲੈਣ ਵਿੱਚ ਤੁਹਾਡੀ ਮਦਦ ਕਰਦੀਆਂ ਹਨ।</translation>
<translation id="8293572045658095405">ਤੁਸੀਂ Vortex ਦੇ ਇਨਕੋਗਨਿਟੋ ਮੋਡ ਵਿੱਚ ਹੋ</translation>
<translation id="830951810931292870">Vortex ਵਿੱਚ ਦਾਖਲ ਕੀਤੇ URL ਨੂੰ ਇਨਕੋਗਨਿਟੋ ਵਿੱਚ ਖੋਲ੍ਹਦਾ ਹੈ।</translation>
<translation id="8385503371191508165">Password Manager ਨਾਲ ਪਾਸਕੀਆਂ ਰੱਖਿਅਤ ਕਰਨਾ ਸ਼ੁਰੂ ਕਰੋ</translation>
<translation id="8390323835464055390">ਆਟੋਫਿਲ ਲਈ Vortex ਦੀ ਵਰਤੋਂ ਕਰਦਿਆਂ ਕਿਸੇ ਐਪ ਤੋਂ ਆਪਣੇ ਰੱਖਿਅਤ ਕੀਤੇ ਪਾਸਵਰਡ ਅਤੇ ਪਾਸਕੀਆਂ ਨਾਲ ਸਾਈਨ-ਇਨ ਕਰੋ</translation>
<translation id="8409374867500149834">ਤੁਹਾਡੇ ਕੋਲ ਨੁਕਸਾਨਦੇਹ ਵੈੱਬਸਾਈਟਾਂ ਦੇ ਵਿਰੁੱਧ Vortex ਦੀ ਸਭ ਤੋਂ ਮਜ਼ਬੂਤ ਸੁਰੱਖਿਆ ਹੈ</translation>
<translation id="8543509361021925846">{THRESHOLD,plural, =1{ਅਜਿਹਾ ਉਦੋਂ ਹੁੰਦਾ ਹੈ, ਜਦੋਂ {THRESHOLD} ਮਿੰਟ ਲਈ Vortex ਦੀ ਵਰਤੋਂ ਨਹੀਂ ਕੀਤੀ ਜਾਂਦੀ। ਸਾਈਨ-ਇਨ ਰਹਿਣ ਦੌਰਾਨ, ਸਿਰਫ਼ ਇਸ ਡੀਵਾਈਸ 'ਤੇ ਰੱਖਿਅਤ ਕੀਤਾ ਗਿਆ ਡਾਟਾ ਮਿਟਾ ਦਿੱਤਾ ਜਾਵੇਗਾ। ਇਸ ਵਿੱਚ ਇਤਿਹਾਸ ਅਤੇ ਪਾਸਵਰਡ ਸ਼ਾਮਲ ਹੋ ਸਕਦੇ ਹਨ।}one{ਅਜਿਹਾ ਉਦੋਂ ਹੁੰਦਾ ਹੈ, ਜਦੋਂ {THRESHOLD} ਮਿੰਟ ਲਈ Vortex ਦੀ ਵਰਤੋਂ ਨਹੀਂ ਕੀਤੀ ਜਾਂਦੀ। ਸਾਈਨ-ਇਨ ਰਹਿਣ ਦੌਰਾਨ, ਸਿਰਫ਼ ਇਸ ਡੀਵਾਈਸ 'ਤੇ ਰੱਖਿਅਤ ਕੀਤਾ ਗਿਆ ਡਾਟਾ ਮਿਟਾ ਦਿੱਤਾ ਜਾਵੇਗਾ। ਇਸ ਵਿੱਚ ਇਤਿਹਾਸ ਅਤੇ ਪਾਸਵਰਡ ਸ਼ਾਮਲ ਹੋ ਸਕਦੇ ਹਨ।}other{ਅਜਿਹਾ ਉਦੋਂ ਹੁੰਦਾ ਹੈ, ਜਦੋਂ {THRESHOLD} ਮਿੰਟਾਂ ਲਈ Vortex ਦੀ ਵਰਤੋਂ ਨਹੀਂ ਕੀਤੀ ਜਾਂਦੀ। ਸਾਈਨ-ਇਨ ਰਹਿਣ ਦੌਰਾਨ, ਸਿਰਫ਼ ਇਸ ਡੀਵਾਈਸ 'ਤੇ ਰੱਖਿਅਤ ਕੀਤਾ ਗਿਆ ਡਾਟਾ ਮਿਟਾ ਦਿੱਤਾ ਜਾਵੇਗਾ। ਇਸ ਵਿੱਚ ਇਤਿਹਾਸ ਅਤੇ ਪਾਸਵਰਡ ਸ਼ਾਮਲ ਹੋ ਸਕਦੇ ਹਨ।}}</translation>
<translation id="8586442755830160949">ਕਾਪੀਰਾਈਟ <ph name="YEAR" /> The Vortex Authors. ਸਾਰੇ ਹੱਕ ਰਾਖਵੇਂ ਹਨ।</translation>
<translation id="8602103377623855616">Vortex ਪੰਨਾ</translation>
<translation id="865600487977764604">ਤੁਹਾਡੇ ਸਾਈਨ-ਇਨ ਹੋਣ 'ਤੇ, ਤੁਹਾਨੂੰ Vortex ਵਿੱਚ ਸੁਰੱਖਿਅਤ ਰੱਖਿਆ ਜਾਂਦਾ ਹੈ ਅਤੇ ਸ਼ਾਇਦ ਹੋਰ Google ਐਪਾਂ ਵਿੱਚ ਤੁਹਾਡੀ ਸੁਰੱਖਿਆ ਨੂੰ ਬਿਹਤਰ ਬਣਾਉਣ ਲਈ ਵਰਤਿਆ ਜਾ ਸਕਦਾ ਹੈ।</translation>
<translation id="8663480472502753423">Vortex ਨੂੰ ਅੱਪ-ਟੂ-ਡੇਟ ਰੱਖੋ</translation>
<translation id="8685813584220679697">ਇਸ ਸਾਈਟ ਅਤੇ Vortex ਵਿੱਚ ਸਾਈਨ-ਇਨ ਕਰੋ।</translation>
<translation id="8698780336333802489">Vortex 'ਤੇ ਆਯਾਤ ਕਰੋ</translation>
<translation id="8730503818204408000">Vortex ਨੂੰ ਪੂਰਵ-ਨਿਰਧਾਰਿਤ ਬ੍ਰਾਊਜ਼ਰ ਵਜੋਂ ਸੈੱਟ ਕਰਨ ਲਈ Vortex ਸੈਟਿੰਗ ਨੂੰ ਖੋਲ੍ਹਦਾ ਹੈ।</translation>
<translation id="8754966941001340678">Vortex ਵਿਸਤ੍ਰਿਤ ਸੁਰੱਖਿਆ ਦੀ ਸਿਫ਼ਾਰਸ਼ ਕਰਦਾ ਹੈ</translation>
<translation id="8759037115129007407">ਫ਼ਿਲਹਾਲ ਤੁਹਾਡਾ ਪਰਿਵਾਰਕ ਮੈਂਬਰ ਪਾਸਵਰਡ ਪ੍ਰਾਪਤ ਨਹੀਂ ਕਰ ਸਕਦਾ। ਉਨ੍ਹਾਂ ਨੂੰ Vortex ਅੱਪਡੇਟ ਕਰ ਕੇ ਉਨ੍ਹਾਂ ਦੇ ਪਾਸਵਰਡ ਸਿੰਕ ਕਰਨ ਲਈ ਕਹੋ। <ph name="BEGIN_LINK" />ਹੋਰ ਜਾਣੋ<ph name="END_LINK" /></translation>
<translation id="8769418653786388149">ਆਪਣੇ Vortex ਨੂੰ ਆਪਣੇ ਨਾਲ ਲਿਜਾਓ</translation>
<translation id="8776843108004031667">Vortex ਤੋਂ ਇਸ ਖਾਤੇ ਅਤੇ ਕਿਸੇ ਵੀ ਅਣਰੱਖਿਅਤ ਡਾਟੇ ਨੂੰ ਹਟਾ ਦਿੱਤਾ ਜਾਵੇਗਾ।</translation>
<translation id="8793333988063379360">ਤੁਸੀਂ ਇੱਥੇ Vortex ਸੈਟਿੰਗਾਂ ਅਤੇ ਹੋਰ ਬਹੁਤ ਕੁਝ ਲੱਭ ਸਕਦੇ ਹੋ</translation>
<translation id="8805148242934787134">Vortex ਨੂੰ ਪੂਰਵ-ਨਿਰਧਾਰਿਤ ਬ੍ਰਾਊਜ਼ਰ ਵਜੋਂ ਸੈੱਟ ਕਰੋ</translation>
<translation id="8826789549860004832">ਆਪਣੇ ਬ੍ਰਾਊਜ਼ਰ ਦਾ ਸੈੱਟਅੱਪ ਕਰਨਾ ਜਾਰੀ ਰੱਖ ਕੇ Vortex ਦਾ ਵੱਧ ਤੋਂ ਵੱਧ ਲਾਹਾ ਲਓ।</translation>
<translation id="88376265765385899">Vortex ਬੁੱਕਮਾਰਕਾਂ ਨੂੰ ਖੋਲ੍ਹਦਾ ਹੈ।</translation>
<translation id="8860548555286245440">Vortex ਵਿੱਚ URL ਨੂੰ ਇਨਕੋਗਨਿਟੋ ਵਿੱਚ ਖੋਲ੍ਹੋ</translation>
<translation id="8880024619507699923">ਤੁਹਾਡੀ ਸੰਸਥਾ ਲਈ Vortex ਵਰਤਣ ਵਾਸਤੇ ਤੁਹਾਨੂੰ ਸਾਈਨ-ਇਨ ਕਰਨ ਦੀ ਲੋੜ ਹੈ। <ph name="BEGIN_LINK" />ਹੋਰ ਜਾਣੋ<ph name="END_LINK" /></translation>
<translation id="8900052431807804054">Vortex ਦੀ ਸਭ ਤੋਂ ਮਜਬੂਤ ਸੁਰੱਖਿਆ ਪ੍ਰਾਪਤ ਕਰੋ</translation>
<translation id="8908791447256515663">ਆਪਣੇ iPad ਦੇ ਡੌਕ ਤੋਂ Vortex ਤੱਕ ਵਧੇਰੇ ਤੇਜ਼ੀ ਨਾਲ ਪਹੁੰਚ ਕਰੋ।</translation>
<translation id="8925569192291721236">ਕੀਮਤ ਸੰਬੰਧੀ ਟਰੈਕਿੰਗ ਦੇ ਅੱਪਡੇਟਾਂ ਅਤੇ Vortex ਨੁਕਤਿਆਂ ਬਾਰੇ ਜਾਣੂ ਰਹੋ।</translation>
<translation id="8950326149985259075">{THRESHOLD,plural, =1{ਅਜਿਹਾ ਉਦੋਂ ਹੁੰਦਾ ਹੈ, ਜਦੋਂ {THRESHOLD} ਮਿੰਟ ਲਈ Vortex ਦੀ ਵਰਤੋਂ ਨਹੀਂ ਕੀਤੀ ਜਾਂਦੀ}one{ਅਜਿਹਾ ਉਦੋਂ ਹੁੰਦਾ ਹੈ, ਜਦੋਂ {THRESHOLD} ਮਿੰਟ ਲਈ Vortex ਦੀ ਵਰਤੋਂ ਨਹੀਂ ਕੀਤੀ ਜਾਂਦੀ}other{ਅਜਿਹਾ ਉਦੋਂ ਹੁੰਦਾ ਹੈ, ਜਦੋਂ {THRESHOLD} ਮਿੰਟ ਲਈ Vortex ਦੀ ਵਰਤੋਂ ਨਹੀਂ ਕੀਤੀ ਜਾਂਦੀ}}</translation>
<translation id="8963279154877372067">ਕੀਮਤ ਘਟਣ ਸੰਬੰਧੀ ਅਲਰਟ ਪ੍ਰਾਪਤ ਕਰਨ ਲਈ Vortex ਸੂਚਨਾਵਾਂ ਨੂੰ ਆਗਿਆ ਦਿਓ</translation>
<translation id="8975812008711371178">Vortex ਵਿੱਚ ਅਵਾਜ਼ ਨਾਲ ਖੋਜੋ</translation>
<translation id="900560297598578021"><ph name="EMAIL" /> ਵਜੋਂ ਸਾਈਨ-ਇਨ ਕੀਤਾ ਗਿਆ।

ਤੁਹਾਡਾ ਡਾਟਾ ਤੁਹਾਡੇ ਪਾਸਫਰੇਜ਼ ਨਾਲ <ph name="TIME" /> ਨੂੰ ਇਨਕ੍ਰਿਪਟ ਕੀਤਾ ਗਿਆ ਸੀ। ਆਪਣੇ Google ਖਾਤੇ ਵਿੱਚ Vortex ਡਾਟੇ ਨੂੰ ਵਰਤਣ ਅਤੇ ਰੱਖਿਅਤ ਕਰਨ ਲਈ ਇਸਨੂੰ ਦਾਖਲ ਕਰੋ।</translation>
<translation id="9022552996538154597">Vortex ਵਿੱਚ ਸਾਈਨ-ਇਨ ਕਰੋ</translation>
<translation id="9031260906956926157">ਤੁਹਾਡੇ ਕੁਝ Vortex ਡਾਟੇ ਨੂੰ ਹਾਲੇ ਤੁਹਾਡੇ Google ਖਾਤੇ ਵਿੱਚ ਰੱਖਿਅਤ ਨਹੀਂ ਕੀਤਾ ਗਿਆ ਹੈ।
ਸਾਈਨ-ਆਊਟ ਕਰਨ ਤੋਂ ਪਹਿਲਾਂ ਕੁਝ ਮਿੰਟਾਂ ਦੀ ਉਡੀਕ ਕਰ ਕੇ ਦੇਖੋ। ਜੇ ਤੁਸੀਂ ਹੁਣੇ ਸਾਈਨ-ਆਊਟ ਕਰਦੇ ਹੋ, ਤਾਂ ਇਸ ਡਾਟੇ ਨੂੰ ਮਿਟਾਇਆ ਜਾਵੇਗਾ।</translation>
<translation id="9050790730841755540">ਹੋਰ ਐਪਾਂ ਵਿਚਲੇ ਲਿੰਕਾਂ 'ਤੇ ਟੈਪ ਕਰ ਕੇ ਕਿਸੇ ਵੇਲੇ ਵੀ Vortex ਦੀ ਵਰਤੋਂ ਕਰੋ।</translation>
<translation id="9059693977935746710">ਤੁਹਾਨੂੰ ਇਸ ਪਾਸਵਰਡ ਨੂੰ ਯਾਦ ਰੱਖਣ ਦੀ ਲੋੜ ਨਹੀਂ ਹੋਵੇਗੀ। ਇਸਨੂੰ <ph name="EMAIL" /> ਦੇ ਪਾਸਵਰਡ ਪ੍ਰਬੰਧਕ ਵਿੱਚ ਰੱਖਿਅਤ ਕੀਤਾ ਜਾਵੇਗਾ</translation>
<translation id="9089354809943900324">Vortex ਪੁਰਾਣਾ ਹੈ</translation>
<translation id="9105645282262300612">Vortex ਨੁਕਤਾ: ਜੋ ਵੀ ਤੁਹਾਨੂੰ ਦਿਖਾਈ ਦਿੰਦਾ ਹੈ ਉਸਨੂੰ ਖੋਜੋ</translation>
<translation id="9152995302810511799">Vortex ਦਾ ਨੁਕਤਾ: Vortex ਦੀ ਸਭ ਤੋਂ ਮਜ਼ਬੂਤ ਸੁਰੱਖਿਆ ਪ੍ਰਾਪਤ ਕਰੋ</translation>
<translation id="9177628952266852500"><ph name="EMAIL" />. Vortex ਦਾ ਪ੍ਰਬੰਧਨ ਕੀਤਾ ਜਾ ਰਿਹਾ ਹੈ।</translation>
<translation id="921174536258924340">Vortex ਸਾਰੇ ਪਾਸਵਰਡਾਂ ਦੀ ਜਾਂਚ ਨਹੀਂ ਕਰ ਸਕਿਆ। ਕੱਲ੍ਹ ਨੂੰ ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰੋ ਜਾਂ <ph name="BEGIN_LINK" />ਆਪਣੇ Google ਖਾਤੇ ਵਿੱਚ ਪਾਸਵਰਡਾਂ ਦੀ ਜਾਂਚ ਕਰੋ।<ph name="END_LINK" /></translation>
<translation id="924957577793602335">ਸਾਈਨ-ਇਨ ਕਰ ਕੇ Vortex ਨੂੰ ਆਪਣੇ ਮੁਤਾਬਕ ਵਿਉਂਤਬੱਧ ਕਰੋ</translation>
<translation id="981812233959540767">Vortex Dino ਗੇਮ ਖੇਡੋ</translation>
<translation id="985602178874221306">The Vortex Authors</translation>
</translationbundle>