import("//build/config/ios/config.gni")

# Model classes for VPN server data.
source_set("model") {
  sources = [
    "vortex_vpn_server.h",
    "vortex_vpn_server.mm",
  ]

  deps = [ "//base" ]

  frameworks = [ "Foundation.framework" ]
}

# Display models and UI components.
source_set("vortex_vpn_servers") {
  sources = [
    "vortex_vpn_server_item.h",
    "vortex_vpn_server_item.mm",
    "vortex_vpn_servers_consumer.h",
    "vortex_vpn_servers_coordinator.h",
    "vortex_vpn_servers_coordinator.mm",
    "vortex_vpn_servers_mediator.h",
    "vortex_vpn_servers_mediator.mm",
    "vortex_vpn_servers_mutator.h",
    "vortex_vpn_servers_view_controller.h",
    "vortex_vpn_servers_view_controller.mm",
  ]

  deps = [
    ":model",
    "//base",
    "//ios/chrome/app/strings:ios_strings_grit",
    "//ios/chrome/browser/shared/coordinator/chrome_coordinator:chrome_coordinator",
    "//ios/chrome/browser/shared/model/browser",
    "//ios/chrome/browser/vortex_plus:vortex_plus",
    "//ios/chrome/browser/vortex_vpn:vortex_vpn",
    "//ui/base:base",
  ]

  frameworks = [ "UIKit.framework" ]
}

source_set("unit_tests") {
  testonly = true
  sources = [ "vortex_vpn_servers_mediator_unittest.mm" ]

  deps = [
    ":model",
    ":vortex_vpn_servers",
    "//base",
    "//base/test:test_support",
    "//testing/gtest",
    "//third_party/ocmock",
  ]
}
