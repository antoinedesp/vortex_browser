source_set("model") {
  sources = [
    "active_download_item.h",
    "active_download_item.mm",
    "drive_browser_item.h",
    "drive_browser_item.mm",
    "drive_browser_service.h",
    "drive_browser_service.mm",
    "drive_browser_service_factory.h",
    "drive_browser_service_factory.mm",
  ]

  deps = [
    "//base",
    "//components/keyed_service/core",
