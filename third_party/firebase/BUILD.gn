# Copyright 2025 Vortex Softwares Ltd
# Firebase Analytics integration for iOS via Carthage
#
# Setup:
#   cd third_party/firebase
#   carthage update --use-xcframeworks --platform iOS
#
# Note: Firebase Carthage distribution provides static libraries (.a archives
# inside .framework bundles), NOT dynamic frameworks. These are linked directly
# into the executable, not bundled into Frameworks/.

import("//build/config/ios/config.gni")
import("//build/config/ios/rules.gni")

if (target_environment == "device") {
  _firebase_arch_dir = "ios-arm64"
} else {
  _firebase_arch_dir = "ios-arm64_x86_64-simulator"
}

_firebase_base = "//third_party/firebase/Carthage/Build"

config("firebase_ios_config") {
  # Header include paths
  include_dirs = [
    "$_firebase_base/FirebaseCore.xcframework/$_firebase_arch_dir/FirebaseCore.framework/Headers",
    "$_firebase_base/FirebaseAnalytics.xcframework/$_firebase_arch_dir/FirebaseAnalytics.framework/Headers",
    "$_firebase_base/FirebaseCoreInternal.xcframework/$_firebase_arch_dir/FirebaseCoreInternal.framework/Headers",
    "$_firebase_base/FirebaseInstallations.xcframework/$_firebase_arch_dir/FirebaseInstallations.framework/Headers",
    "$_firebase_base/GoogleAppMeasurement.xcframework/$_firebase_arch_dir/GoogleAppMeasurement.framework/Headers",
    "$_firebase_base/GoogleAppMeasurementIdentitySupport.xcframework/$_firebase_arch_dir/GoogleAppMeasurementIdentitySupport.framework/Headers",
    "$_firebase_base/GoogleUtilities.xcframework/$_firebase_arch_dir/GoogleUtilities.framework/Headers",
    "$_firebase_base/nanopb.xcframework/$_firebase_arch_dir/nanopb.framework/Headers",
    "$_firebase_base/FBLPromises.xcframework/$_firebase_arch_dir/FBLPromises.framework/Headers",
  ]

  # Framework search paths - needed for auto-linking metadata in static libs
  framework_dirs = [
    "$_firebase_base/FirebaseCore.xcframework/$_firebase_arch_dir",
    "$_firebase_base/FirebaseAnalytics.xcframework/$_firebase_arch_dir",
    "$_firebase_base/FirebaseCoreInternal.xcframework/$_firebase_arch_dir",
    "$_firebase_base/FirebaseInstallations.xcframework/$_firebase_arch_dir",
    "$_firebase_base/GoogleAppMeasurement.xcframework/$_firebase_arch_dir",
    "$_firebase_base/GoogleAppMeasurementIdentitySupport.xcframework/$_firebase_arch_dir",
    "$_firebase_base/GoogleUtilities.xcframework/$_firebase_arch_dir",
    "$_firebase_base/nanopb.xcframework/$_firebase_arch_dir",
    "$_firebase_base/FBLPromises.xcframework/$_firebase_arch_dir",
  ]

  # Linker flags to link the static libraries
  libs = [
    "Carthage/Build/FirebaseAnalytics.xcframework/$_firebase_arch_dir/FirebaseAnalytics.framework/FirebaseAnalytics",
    "Carthage/Build/FirebaseCore.xcframework/$_firebase_arch_dir/FirebaseCore.framework/FirebaseCore",
    "Carthage/Build/FirebaseCoreInternal.xcframework/$_firebase_arch_dir/FirebaseCoreInternal.framework/FirebaseCoreInternal",
    "Carthage/Build/FirebaseInstallations.xcframework/$_firebase_arch_dir/FirebaseInstallations.framework/FirebaseInstallations",
    "Carthage/Build/GoogleAppMeasurement.xcframework/$_firebase_arch_dir/GoogleAppMeasurement.framework/GoogleAppMeasurement",
    "Carthage/Build/GoogleAppMeasurementIdentitySupport.xcframework/$_firebase_arch_dir/GoogleAppMeasurementIdentitySupport.framework/GoogleAppMeasurementIdentitySupport",
    "Carthage/Build/GoogleUtilities.xcframework/$_firebase_arch_dir/GoogleUtilities.framework/GoogleUtilities",
    "Carthage/Build/nanopb.xcframework/$_firebase_arch_dir/nanopb.framework/nanopb",
    "Carthage/Build/FBLPromises.xcframework/$_firebase_arch_dir/FBLPromises.framework/FBLPromises",
  ]

  # System frameworks required by Firebase
  frameworks = [
    "StoreKit.framework",
    "SystemConfiguration.framework",
    "UIKit.framework",
    "Foundation.framework",
    "Security.framework",
  ]
}

source_set("firebase_analytics_ios") {
  sources = [
    "ios/vortex_firebase_analytics_shim.h",
    "ios/vortex_firebase_analytics_shim.mm",
  ]

  public_configs = [ ":firebase_ios_config" ]

  # No bundle_data deps needed - static libs are linked, not bundled
}

# GoogleService-Info.plist bundle
bundle_data("google_service_info_plist") {
  sources = [ "GoogleService-Info.plist" ]
  outputs = [ "{{bundle_resources_dir}}/{{source_file_part}}" ]
}
